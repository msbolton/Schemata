{
  "openapi": "3.1.0",
  "info": {
    "title": "cfg.catalog",
    "version": "1.0.0",
    "description": "A catalog of products."
  },
  "servers": [
    {
      "url": "https://api.example.com/cfg_catalog"
    }
  ],
  "tags": [
    {
      "name": "Products",
