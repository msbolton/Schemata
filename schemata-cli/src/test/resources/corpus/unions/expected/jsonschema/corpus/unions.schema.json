{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemata:corpus.unions",
  "title": "corpus.unions",
  "$defs": {
    "Card": {
      "type": "object",
      "properties": {
        "last4": {
          "type": "string",
          "maxLength": 4
        }
      },
      "required": [
        "last4"
      ],
      "additionalProperties": false
    },
    "Cash": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Payment": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "card": {
              "$ref": "#/$defs/Card"
            }
          },
          "required": [
            "card"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cash": {
              "$ref": "#/$defs/Cash"
            }
          },
          "required": [
            "cash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "required": [
            "uuid"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Order": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "payment": {
          "$ref": "#/$defs/Payment"
        },
        "refund": {
          "anyOf": [
            {
              "$ref": "#/$defs/Payment"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived": {
          "$ref": "#/$defs/Payment"
        }
      },
      "required": [
        "id",
        "payment",
        "archived"
      ],
      "additionalProperties": false
    }
  }
}
