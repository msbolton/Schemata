{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemata:corpus.union_payload",
  "title": "corpus.union_payload",
  "$defs": {
    "Customer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "Order": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "total": {
          "type": "string",
          "pattern": "^-?[0-9]{1,10}(\\.[0-9]{1,2})?$"
        }
      },
      "required": [
        "id",
        "total"
      ],
      "additionalProperties": false
    },
    "Hit": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "customer": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "required": [
            "customer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "order": {
              "$ref": "#/$defs/Order"
            }
          },
          "required": [
            "order"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Query": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "Saved": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "hit": {
          "$ref": "#/$defs/Hit"
        }
      },
      "required": [
        "id",
        "hit"
      ],
      "additionalProperties": false
    }
  }
}
