{
  "openapi": "3.1.0",
  "info": {
    "title": "corpus.union_payload",
    "version": "1.0.0",
    "description": "A union carries keys wherever it stands, a payload included; a member written `{ embed }`\ncarries the whole record instead."
  },
  "tags": [
    {
      "name": "Search"
    }
  ],
  "paths": {
    "/search": {
      "get": {
        "operationId": "Search_find",
        "tags": [
          "Search"
        ],
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/corpus.union_payload.Hit"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "corpus.union_payload.Hit": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "customer": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            },
            "required": [
              "customer"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "order": {
                "$ref": "#/components/schemas/corpus.union_payload.Order"
              }
            },
            "required": [
              "order"
            ],
            "additionalProperties": false
          }
        ]
      },
      "corpus.union_payload.Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "total": {
            "type": "string",
            "pattern": "^-?[0-9]{1,10}(\\.[0-9]{1,2})?$"
          }
        },
        "required": [
          "id",
          "total"
        ],
        "additionalProperties": false
      }
    }
  }
}
