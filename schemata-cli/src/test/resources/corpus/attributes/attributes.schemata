/// Attributes and roots.
schema corpus.attributes

enum Kind { @xsd(name: "Personal") #1 personal #2 work }

/// Not a document root on its own.
model Address {
  #1 country string { max 2 } @xsd(attribute)
  #2 street  string

  @@xsd(root: false)
}

model Contact {
  #1 id   int64   @xsd(attribute)
  #2 kind Kind    @xsd(attribute) = personal
  #3 nick string? @xsd(attribute)
  #4 name string  @xsd(name: "full-name")
  #5 home Address
}
