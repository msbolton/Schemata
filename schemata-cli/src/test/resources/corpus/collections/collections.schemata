schema corpus.collections

enum Color { red green }

model Item { #1 name string }

model Collections {
  #1 tags    string[]
  #2 items   Item[]
  #3 colors  Color[]
  #4 maybe   string[]?
  #5 holes   string?[]
  #6 counts  map<string, int32>
  #7 by_id   map<int64, Item>
  #8 sparse  map<string, int32?>
  #9 limited string[]            { maxItems 2, max 3 }
}
