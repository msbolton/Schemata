/// Orders whose operations share their payloads' names.
schema corpus.shadow_rpc

model PlaceOrder { #1 customer_id int64 { id } }

model Order {
  #1 id   int64  { id }
  #2 note string

  model Line { #1 sku string { id }  #2 quantity int32 }
}

model OrderId { #1 id int64 { id } }

model Receipt { #1 count int64 { id } }

/// Place, amend, and cancel orders.
service Orders {
  #1 place_order(PlaceOrder): Order
  #2 order(Order.Line): Order
  #3 cancel(OrderId): Receipt
}
