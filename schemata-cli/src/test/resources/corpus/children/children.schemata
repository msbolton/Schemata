namespace corpus.children

/// One purchasable item.
record Line {
  #1 sku: string(max = 64)
  #2 quantity: int32(min = 1)
}

record Order {
  @sql(key) #1 id: uuid
  #2 lines: list<Line>
  #3 tags: list<string(max = 16)>
  @sql(strategy = table) #4 codes: list<string(max = 8)>
  #5 attributes: map<string, string>
  @sql(strategy = table) #6 prices: map<string, decimal(10, 2)>
}
