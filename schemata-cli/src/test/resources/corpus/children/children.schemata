schema corpus.children

/// One purchasable item.
model Line { #1 sku string { max 64 }  #2 quantity int32 { min 1 } }

model Order {
  #1 id         uuid                        { id }
  #2 lines      Line[]
  #3 tags       string[]                    { max 16 }
  #4 codes      string[]                    { max 8 } @sql(strategy: table)
  #5 attributes map<string, string>
  #6 prices     map<string, decimal(10, 2)> @sql(strategy: table)
}
