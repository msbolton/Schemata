{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemata:corpus.naming",
  "title": "corpus.naming",
  "$defs": {
    "HTTPStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "reason"
      ],
      "additionalProperties": false
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "order": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "a_very_long_field_name_that_goes_well_beyond_the_sixty_three_character_limit_of_postgres": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "order",
        "a_very_long_field_name_that_goes_well_beyond_the_sixty_three_character_limit_of_postgres"
      ],
      "additionalProperties": false
    },
    "IOError": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
}
