schema corpus.naming @sql(schema: "naming_v1")

model HTTPStatus {
  #1 code   int32  { id }
  #2 reason string @sql(column: "reason_phrase")

  @@sql(table: "http_status_codes")
}

model User {
  #1 id                                                                                       uuid  { id }
  #2 order                                                                                    int32
  #3 a_very_long_field_name_that_goes_well_beyond_the_sixty_three_character_limit_of_postgres bool
}

model IOError { #1 id uuid { id } }
