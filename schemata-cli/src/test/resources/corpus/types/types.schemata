namespace corpus.types

enum Status { pending, paid }

record Everything {
  @sql(key)
  #1 id: uuid
  #2 flag: bool = true
  #3 small: int32(min = 0, max = 100) = 3
  #4 big: int64(min = 1)
  #5 ratio: float32
  #6 exact: float64(max = 1.5)
  #7 money: decimal(19, 4) = 1.25
  #8 name: string(min = 2, max = 8)
  #9 email: string(pattern = "^[^@]+@[^@]+$")
  #10 code: string(max = 4)?
  #11 note: string = "n/a"
  #12 blob: bytes(max = 1024)
  #13 day: date
  #14 tod: time
  #15 at: instant
  #16 took: duration
  #17 status: Status = pending
  @sql(type = "varchar(36)")
  #18 legacy: uuid?
}
