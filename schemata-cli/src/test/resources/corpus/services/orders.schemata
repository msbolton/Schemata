/// Orders and their lines.
schema corpus.services

model OrderId { #1 id uuid { id } }

model ListOrders { #1 status Status?  #2 limit int32 { id, min 1, max 200 } = 50 }

model PlaceOrder { #1 customer_id uuid { id }  #2 lines Order.Line[] { minItems 1 } }

model Order {
  #1 id     uuid           { id }
  #2 status Status
  #3 lines  Line[]
  #4 total  decimal(12, 2)

  model Line { #1 sku string { max 64 }  #2 quantity int32 { min 1 } }
}

enum Status { pending paid shipped cancelled }

model Chunk { #1 bytes bytes { id } }

model Receipt { #1 count int64 { id } }

/// Verbs stay legal names outside a binding.
model Verbs { #1 get string { id }  #2 post int32 }

/// Place and read orders.
service Orders {
  /// Fetch one order.
  #1 get(OrderId): Order  get "/orders/{id}"
  /// Orders matching a filter, newest first.
  #2 list(ListOrders): stream Order  get "/orders"
  #3 place(PlaceOrder): Order  post "/orders"
  #4 cancel(OrderId)  delete "/orders/{id}"
  #5 upload(stream Chunk): Receipt
  reserved #6, "archive"
}
