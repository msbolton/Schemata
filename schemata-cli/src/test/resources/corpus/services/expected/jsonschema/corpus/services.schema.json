{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemata:corpus.services",
  "title": "corpus.services",
  "$defs": {
    "OrderId": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "ListOrders": {
      "type": "object",
      "properties": {
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "additionalProperties": false
    },
    "PlaceOrder": {
      "type": "object",
      "properties": {
        "customer_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Order.Line"
          },
          "minItems": 1
        }
      },
      "required": [
        "customer_id",
        "lines"
      ],
      "additionalProperties": false
    },
    "Order": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Order.Line"
          }
        },
        "total": {
          "type": "string",
          "pattern": "^-?[0-9]{1,10}(\\.[0-9]{1,2})?$"
        }
      },
      "required": [
        "id",
        "status",
        "lines",
        "total"
      ],
      "additionalProperties": false
    },
    "Order.Line": {
      "type": "object",
      "properties": {
        "sku": {
          "type": "string",
          "maxLength": 64
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "sku",
        "quantity"
      ],
      "additionalProperties": false
    },
    "Status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "cancelled"
      ]
    },
    "Chunk": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "bytes"
      ],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "count"
      ],
      "additionalProperties": false
    },
    "Verbs": {
      "description": "Verbs stay legal names outside a binding.",
      "type": "object",
      "properties": {
        "get": {
          "type": "string"
        },
        "post": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "required": [
        "get",
        "post"
      ],
      "additionalProperties": false
    }
  }
}
