{
  "openapi": "3.1.0",
  "info": {
    "title": "corpus.services",
    "version": "1.0.0",
    "description": "Orders and their lines."
  },
  "tags": [
    {
      "name": "Orders",
      "description": "Place and read orders."
    }
  ],
  "paths": {
    "/orders/{id}": {
      "get": {
        "operationId": "Orders_get",
        "tags": [
          "Orders"
        ],
        "summary": "Fetch one order.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/corpus.services.Order"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "Orders_cancel",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No content"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "Orders_list",
        "tags": [
          "Orders"
        ],
        "summary": "Orders matching a filter, newest first.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/corpus.services.Status"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stream of Order",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/corpus.services.Order"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "Orders_place",
        "tags": [
          "Orders"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/corpus.services.PlaceOrder"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/corpus.services.Order"
                }
              }
            }
          }
        }
      }
    },
    "/Orders/upload": {
      "post": {
        "operationId": "Orders_upload",
        "tags": [
          "Orders"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-ndjson": {
              "schema": {
                "$ref": "#/components/schemas/corpus.services.Chunk"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/corpus.services.Receipt"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "corpus.services.Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "status": {
            "$ref": "#/components/schemas/corpus.services.Status"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/corpus.services.Order.Line"
            }
          },
          "total": {
            "type": "string",
            "pattern": "^-?[0-9]{1,10}(\\.[0-9]{1,2})?$"
          }
        },
        "required": [
          "id",
          "status",
          "lines",
          "total"
        ],
        "additionalProperties": false
      },
      "corpus.services.Order.Line": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": false
      },
      "corpus.services.Status": {
        "type": "string",
        "enum": [
          "pending",
          "paid",
          "shipped",
          "cancelled"
        ]
      },
      "corpus.services.PlaceOrder": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/corpus.services.Order.Line"
            },
            "minItems": 1
          }
        },
        "required": [
          "customer_id",
          "lines"
        ],
        "additionalProperties": false
      },
      "corpus.services.Chunk": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "string",
            "contentEncoding": "base64"
          }
        },
        "required": [
          "bytes"
        ],
        "additionalProperties": false
      },
      "corpus.services.Receipt": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "count"
        ],
        "additionalProperties": false
      }
    }
  }
}
