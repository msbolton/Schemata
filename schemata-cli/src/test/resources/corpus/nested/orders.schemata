schema corpus.orders @proto(package: "corp.orders.v1")

import corpus.people

model Order {
  #1 customer Person
  #2 lines    Line[]
  #3 parent   Order?
  #4 note     Note
  #5 kind     Kind

  model Line { #1 sku string  #2 gift Note  #3 order Order }

  model Note { #1 text string }

  enum Kind { #1 retail #2 wholesale }
}

model Audit { #1 line Order.Line  #2 who Person  #3 again corpus.people.Person  #4 kind Order.Kind }
