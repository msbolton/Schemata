schema kitchen.oneofs

import kitchen.enums

model Card { #1 last4 string }

model Cash {}

/// How the customer paid.
union Payment =
  /// Paid by card.
  #1 Card |
  #2 Cash |
  #3 uuid |
  #4 kitchen.enums.Status

/// A oneof whose names differ from the ones the target writes.
union Tender = #1 Card | #2 Cash

/// A oneof beside other fields.
model Shipment { #1 id string  #2 address string?  #3 pickup_card Card? }

/// Two members of one type cannot be told apart in a union.
model Contact { #1 email string?  #2 phone string? }
