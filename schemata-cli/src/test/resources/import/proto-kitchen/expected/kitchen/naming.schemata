schema kitchen.naming

/// A message whose name is not upper camel case.
model LineItem {
  #1 foo_baz      string @proto(name: "FooBaz")
  #2 record_value string @proto(name: "record")
  /// a trailing comment joins the doc
  #3 http_code    int32  @proto(name: "HTTPCode")

  @@proto(name: "line_item")
}

model HTTPFrame { #1 item LineItem }

union Holder = #1 LineItem | #2 HTTPFrame
