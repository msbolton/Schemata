schema schema_value @sql(schema: "shop")

model Customers { tenant_id uuid { id }  code string { id, max 16 }  name string { min 1 } }

/// An order, one row per checkout.
model Orders {
  id       uuid      { id }
  status   Status    { index } = pending
  qty      int32     { min 1 } @sql(type: "smallint")
  /// A note for the courier.
  note     string?   { unique, max 500 }
  customer Customers
  seq      int32     @sql(type: "serial")
  n        int32
  /// How the order was paid.
  payment  Payment
  lines    Line[]

  union Payment = Card | Cash

  model Card { last4 string { max 4 }  brand string { max 32 } }

  model Cash {}

  enum Status { pending paid }

  /// One purchasable item.
  model Line { sku string { max 64 }  quantity int32 { min 1 } }
}
