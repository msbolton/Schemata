schema smil20_language @xsd(namespace: "http://www.w3.org/2001/SMIL20/Language")

import smil20

model Animate {
  attribute_name         string                     @xsd(name: "attributeName") @xsd(attribute)
  attribute_type         AttributeType              @xsd(name: "attributeType") @xsd(attribute) = auto
  additive               Additive                   @xsd(attribute) = replace
  accumulate             Accumulate                 @xsd(attribute) = none
  to                     string?                    @xsd(attribute)
  from                   string?                    @xsd(attribute)
  by                     string?                    @xsd(attribute)
  values                 string?                    @xsd(attribute)
  any                    string                     @xsd(any) @xsd(wildcard: "##other")
  id                     string?                    @xsd(attribute)
  class                  string?                    @xsd(attribute)
  /// lang (as an attribute name)
  ///
  /// denotes an attribute whose value
  /// is a language code for the natural language of the content of
  /// any element; its value is inherited.  This name is reserved
  /// by virtue of its definition in the XML specification.
  ///
  ///
  ///
  /// Notes
  ///
  /// Attempting to install the relevant ISO 2- and 3-letter
  /// codes as the enumerated possible values is probably never
  /// going to be a realistic possibility.
  ///
  ///
  /// See BCP 47 at
  /// http://www.rfc-editor.org/rfc/bcp/bcp47.txt
  /// and the IANA language subtag registry at
  ///
  /// http://www.iana.org/assignments/language-subtag-registry
  /// for further information.
  ///
  ///
  /// The union allows for the 'un-declaration' of xml:lang with
  /// the empty string.
  lang                   string?                    @xsd(attribute)
  alt                    string?                    @xsd(attribute)
  longdesc               string?                    @xsd(attribute)
  begin                  string?                    @xsd(attribute)
  end                    string?                    @xsd(attribute)
  dur                    string?                    @xsd(attribute)
  repeat_dur             string?                    @xsd(name: "repeatDur") @xsd(attribute)
  repeat_count           decimal(38, 9)?            { min 0.0 } @xsd(name: "repeatCount") @xsd(attribute)
  repeat                 int64?                     { min 0 } @xsd(attribute)
  min                    string?                    @xsd(attribute)
  max                    string?                    @xsd(attribute)
  sync_behavior          smil20.SyncBehavior        @xsd(name: "syncBehavior") @xsd(attribute) = default
  sync_tolerance         string?                    @xsd(name: "syncTolerance") @xsd(attribute)
  sync_behavior_default  smil20.SyncBehaviorDefault @xsd(name: "syncBehaviorDefault") @xsd(attribute) = inherit
  sync_tolerance_default string                     @xsd(name: "syncToleranceDefault") @xsd(attribute) = "inherit"
  restart                smil20.RestartTiming       @xsd(attribute) = default
  restart_default        smil20.RestartDefault      @xsd(name: "restartDefault") @xsd(attribute) = inherit
  fill                   smil20.FillTimingAttrs     @xsd(attribute) = default
  fill_default           smil20.FillDefault         @xsd(name: "fillDefault") @xsd(attribute) = inherit
  target_element         string?                    @xsd(name: "targetElement") @xsd(attribute)
  calc_mode              CalcMode                   @xsd(name: "calcMode") @xsd(attribute) = linear
  skip_content           bool                       @xsd(name: "skip-content") @xsd(attribute) = true
  attributes             map<string, string>        @xsd(any_attribute) @xsd(process: "strict")

  enum AttributeType { @xsd(name: "XML") xml @xsd(name: "CSS") css auto }

  enum Additive { replace sum }

  enum Accumulate { none sum }

  enum CalcMode { discrete linear paced }

  @@xsd(name: "animate")
}

model AnimateMotion {
  additive               Additive                   @xsd(attribute) = replace
  accumulate             Accumulate                 @xsd(attribute) = none
  to                     string?                    @xsd(attribute)
  from                   string?                    @xsd(attribute)
  by                     string?                    @xsd(attribute)
  values                 string?                    @xsd(attribute)
  origin                 string?                    @xsd(attribute)
  any                    string                     @xsd(any) @xsd(wildcard: "##other")
  id                     string?                    @xsd(attribute)
  class                  string?                    @xsd(attribute)
  /// lang (as an attribute name)
  ///
  /// denotes an attribute whose value
  /// is a language code for the natural language of the content of
  /// any element; its value is inherited.  This name is reserved
  /// by virtue of its definition in the XML specification.
  ///
  ///
  ///
  /// Notes
  ///
  /// Attempting to install the relevant ISO 2- and 3-letter
  /// codes as the enumerated possible values is probably never
  /// going to be a realistic possibility.
  ///
  ///
  /// See BCP 47 at
  /// http://www.rfc-editor.org/rfc/bcp/bcp47.txt
  /// and the IANA language subtag registry at
  ///
  /// http://www.iana.org/assignments/language-subtag-registry
  /// for further information.
  ///
  ///
  /// The union allows for the 'un-declaration' of xml:lang with
  /// the empty string.
  lang                   string?                    @xsd(attribute)
  alt                    string?                    @xsd(attribute)
  longdesc               string?                    @xsd(attribute)
  begin                  string?                    @xsd(attribute)
  end                    string?                    @xsd(attribute)
  dur                    string?                    @xsd(attribute)
  repeat_dur             string?                    @xsd(name: "repeatDur") @xsd(attribute)
  repeat_count           decimal(38, 9)?            { min 0.0 } @xsd(name: "repeatCount") @xsd(attribute)
  repeat                 int64?                     { min 0 } @xsd(attribute)
  min                    string?                    @xsd(attribute)
  max                    string?                    @xsd(attribute)
  sync_behavior          smil20.SyncBehavior        @xsd(name: "syncBehavior") @xsd(attribute) = default
  sync_tolerance         string?                    @xsd(name: "syncTolerance") @xsd(attribute)
  sync_behavior_default  smil20.SyncBehaviorDefault @xsd(name: "syncBehaviorDefault") @xsd(attribute) = inherit
  sync_tolerance_default string                     @xsd(name: "syncToleranceDefault") @xsd(attribute) = "inherit"
  restart                smil20.RestartTiming       @xsd(attribute) = default
  restart_default        smil20.RestartDefault      @xsd(name: "restartDefault") @xsd(attribute) = inherit
  fill                   smil20.FillTimingAttrs     @xsd(attribute) = default
  fill_default           smil20.FillDefault         @xsd(name: "fillDefault") @xsd(attribute) = inherit
  target_element         string?                    @xsd(name: "targetElement") @xsd(attribute)
  calc_mode              CalcMode                   @xsd(name: "calcMode") @xsd(attribute) = linear
  skip_content           bool                       @xsd(name: "skip-content") @xsd(attribute) = true
  attributes             map<string, string>        @xsd(any_attribute) @xsd(process: "strict")

  enum Additive { replace sum }

  enum Accumulate { none sum }

  enum CalcMode { discrete linear paced }

  @@xsd(name: "animateMotion")
}

