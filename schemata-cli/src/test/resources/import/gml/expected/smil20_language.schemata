@xsd(namespace = "http://www.w3.org/2001/SMIL20/Language")
namespace smil20_language

import smil20

@xsd(name = "animate")
record Animate {
  @xsd(name = "attributeName")
  @xsd(attribute)
  attribute_name:         string
  @xsd(name = "attributeType")
  @xsd(attribute)
  attribute_type:         AttributeType = auto
  @xsd(attribute) additive:               Additive = replace
  @xsd(attribute) accumulate:             Accumulate = none
  @xsd(attribute) to:                     string?
  @xsd(attribute) from:                   string?
  @xsd(attribute) by:                     string?
  @xsd(attribute) values:                 string?
  @xsd(any)
  @xsd(wildcard = "##other")
  any:                    string
  @xsd(attribute) id:                     string?
  @xsd(attribute) class:                  string?
  /// lang (as an attribute name)
  ///
  /// denotes an attribute whose value
  /// is a language code for the natural language of the content of
  /// any element; its value is inherited.  This name is reserved
  /// by virtue of its definition in the XML specification.
  ///
  ///
  ///
  /// Notes
  ///
  /// Attempting to install the relevant ISO 2- and 3-letter
  /// codes as the enumerated possible values is probably never
  /// going to be a realistic possibility.
  ///
  ///
  /// See BCP 47 at
  /// http://www.rfc-editor.org/rfc/bcp/bcp47.txt
  /// and the IANA language subtag registry at
  ///
  /// http://www.iana.org/assignments/language-subtag-registry
  /// for further information.
  ///
  ///
  /// The union allows for the 'un-declaration' of xml:lang with
  /// the empty string.
  @xsd(attribute) lang:                   string?
  @xsd(attribute) alt:                    string?
  @xsd(attribute) longdesc:               string?
  @xsd(attribute) begin:                  string?
  @xsd(attribute) end:                    string?
  @xsd(attribute) dur:                    string?
  @xsd(name = "repeatDur")
  @xsd(attribute)
  repeat_dur:             string?
  @xsd(name = "repeatCount")
  @xsd(attribute)
  repeat_count:           decimal(38, 9, min = 0.0)?
  @xsd(attribute) repeat:                 int64(min = 0)?
  @xsd(attribute) min:                    string?
  @xsd(attribute) max:                    string?
  @xsd(name = "syncBehavior")
  @xsd(attribute)
  sync_behavior:          smil20.SyncBehavior = default
  @xsd(name = "syncTolerance")
  @xsd(attribute)
  sync_tolerance:         string?
  @xsd(name = "syncBehaviorDefault")
  @xsd(attribute)
  sync_behavior_default:  smil20.SyncBehaviorDefault = inherit
  @xsd(name = "syncToleranceDefault")
  @xsd(attribute)
  sync_tolerance_default: string = "inherit"
  @xsd(attribute) restart:                smil20.RestartTiming = default
  @xsd(name = "restartDefault")
  @xsd(attribute)
  restart_default:        smil20.RestartDefault = inherit
  @xsd(attribute) fill:                   smil20.FillTimingAttrs = default
  @xsd(name = "fillDefault")
  @xsd(attribute)
  fill_default:           smil20.FillDefault = inherit
  @xsd(name = "targetElement")
  @xsd(attribute)
  target_element:         string?
  @xsd(name = "calcMode")
  @xsd(attribute)
  calc_mode:              CalcMode = linear
  @xsd(name = "skip-content")
  @xsd(attribute)
  skip_content:           bool = true
  @xsd(any_attribute)
  @xsd(process = "strict")
  attributes:             map<string, string>

  enum AttributeType { @xsd(name = "XML") xml, @xsd(name = "CSS") css, auto }

  enum Additive { replace, sum }

  enum Accumulate { none, sum }

  enum CalcMode { discrete, linear, paced }
}

@xsd(name = "animateMotion")
record AnimateMotion {
  @xsd(attribute) additive:               Additive = replace
  @xsd(attribute) accumulate:             Accumulate = none
  @xsd(attribute) to:                     string?
  @xsd(attribute) from:                   string?
  @xsd(attribute) by:                     string?
  @xsd(attribute) values:                 string?
  @xsd(attribute) origin:                 string?
  @xsd(any)
  @xsd(wildcard = "##other")
  any:                    string
  @xsd(attribute) id:                     string?
  @xsd(attribute) class:                  string?
  /// lang (as an attribute name)
  ///
  /// denotes an attribute whose value
  /// is a language code for the natural language of the content of
  /// any element; its value is inherited.  This name is reserved
  /// by virtue of its definition in the XML specification.
  ///
  ///
  ///
  /// Notes
  ///
  /// Attempting to install the relevant ISO 2- and 3-letter
  /// codes as the enumerated possible values is probably never
  /// going to be a realistic possibility.
  ///
  ///
  /// See BCP 47 at
  /// http://www.rfc-editor.org/rfc/bcp/bcp47.txt
  /// and the IANA language subtag registry at
  ///
  /// http://www.iana.org/assignments/language-subtag-registry
  /// for further information.
  ///
  ///
  /// The union allows for the 'un-declaration' of xml:lang with
  /// the empty string.
  @xsd(attribute) lang:                   string?
  @xsd(attribute) alt:                    string?
  @xsd(attribute) longdesc:               string?
  @xsd(attribute) begin:                  string?
  @xsd(attribute) end:                    string?
  @xsd(attribute) dur:                    string?
  @xsd(name = "repeatDur")
  @xsd(attribute)
  repeat_dur:             string?
  @xsd(name = "repeatCount")
  @xsd(attribute)
  repeat_count:           decimal(38, 9, min = 0.0)?
  @xsd(attribute) repeat:                 int64(min = 0)?
  @xsd(attribute) min:                    string?
  @xsd(attribute) max:                    string?
  @xsd(name = "syncBehavior")
  @xsd(attribute)
  sync_behavior:          smil20.SyncBehavior = default
  @xsd(name = "syncTolerance")
  @xsd(attribute)
  sync_tolerance:         string?
  @xsd(name = "syncBehaviorDefault")
  @xsd(attribute)
  sync_behavior_default:  smil20.SyncBehaviorDefault = inherit
  @xsd(name = "syncToleranceDefault")
  @xsd(attribute)
  sync_tolerance_default: string = "inherit"
  @xsd(attribute) restart:                smil20.RestartTiming = default
  @xsd(name = "restartDefault")
  @xsd(attribute)
  restart_default:        smil20.RestartDefault = inherit
  @xsd(attribute) fill:                   smil20.FillTimingAttrs = default
  @xsd(name = "fillDefault")
  @xsd(attribute)
  fill_default:           smil20.FillDefault = inherit
  @xsd(name = "targetElement")
  @xsd(attribute)
  target_element:         string?
  @xsd(name = "calcMode")
  @xsd(attribute)
  calc_mode:              CalcMode = linear
  @xsd(name = "skip-content")
  @xsd(attribute)
  skip_content:           bool = true
  @xsd(any_attribute)
  @xsd(process = "strict")
  attributes:             map<string, string>

  enum Additive { replace, sum }

  enum Accumulate { none, sum }

  enum CalcMode { discrete, linear, paced }
}

