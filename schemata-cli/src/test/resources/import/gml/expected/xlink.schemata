/// This schema document provides attribute declarations and
/// attribute group, complex type and simple type definitions which can be used in
/// the construction of user schemas to define the structure of particular linking
/// constructs, e.g.
///
/// <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
/// xmlns:xl="http://www.w3.org/1999/xlink">
///
/// <xs:import namespace="http://www.w3.org/1999/xlink"
/// location="http://www.w3.org/1999/xlink.xsd">
///
/// <xs:element name="mySimple">
/// <xs:complexType>
/// ...
/// <xs:attributeGroup ref="xl:simpleAttrs"/>
/// ...
/// </xs:complexType>
/// </xs:element>
/// ...
/// </xs:schema>
schema xlink @xsd(namespace: "http://www.w3.org/1999/xlink") @xsd(element_form: "unqualified")

@xsd(name: "type")
enum Type { simple extended title resource locator arc }

@xsd(name: "show")
enum Show { new replace embed other none }

@xsd(name: "actuate")
enum Actuate { @xsd(name: "onLoad") on_load @xsd(name: "onRequest") on_request other none }

/// Intended for use as the type of user-declared elements to make them
/// simple links.
model Simple {
  any     string[] @xsd(any)
  text    string?  @xsd(mixed)
  type    Type     @xsd(attribute) = simple
  href    string?  @xsd(attribute)
  role    string?  { min 1 } @xsd(attribute)
  arcrole string?  { min 1 } @xsd(attribute)
  title   string?  @xsd(attribute)
  show    Show?    @xsd(attribute)
  actuate Actuate? @xsd(attribute)

  @@xsd(root: false)
}

/// Intended for use as the type of user-declared elements to make them
/// extended links.
/// Note that the elements referenced in the content model are all abstract.
/// The intention is that by simply declaring elements with these as their
/// substitutionGroup, all the right things will happen.
model Extended {
  title           TitleElt[]
  resource        Resource[]
  locator         Locator[]
  arc             Arc[]
  type            Type       @xsd(attribute) = extended
  role            string?    { min 1 } @xsd(attribute)
  title_attribute string?    @xsd(attribute)

  @@xsd(root: false)
}

model TitleElt {
  any  string[] @xsd(any)
  text string?  @xsd(mixed)
  type Type     @xsd(attribute) = title
  /// xml:lang is not required, but provides much of the
  /// motivation for title elements in addition to attributes, and so
  /// is provided here for convenience.
  lang string?  @xsd(attribute)

  @@xsd(name: "titleElt")
}

model Resource {
  any   string[] @xsd(any)
  text  string?  @xsd(mixed)
  type  Type     @xsd(attribute) = resource
  role  string?  { min 1 } @xsd(attribute)
  title string?  @xsd(attribute)
  label string?  @xsd(attribute)

  @@xsd(name: "resource")
}

model Locator {
  title           TitleElt[]
  type            Type       @xsd(attribute) = locator
  href            string     @xsd(attribute)
  role            string?    { min 1 } @xsd(attribute)
  title_attribute string?    @xsd(attribute)
  /// label is not required, but locators have no particular
  /// XLink function if they are not labeled.
  label           string?    @xsd(attribute)

  @@xsd(name: "locator")
}

model Arc {
  title           TitleElt[]
  type            Type       @xsd(attribute) = arc
  arcrole         string?    { min 1 } @xsd(attribute)
  title_attribute string?    @xsd(attribute)
  show            Show?      @xsd(attribute)
  actuate         Actuate?   @xsd(attribute)
  from            string?    @xsd(attribute)
  /// from and to have default behavior when values are missing
  to              string?    @xsd(attribute)

  @@xsd(name: "arc")
}
