  @xsd(attribute)
  srs_dimension:         int64(min = 1)?
  @xsd(name = "axisLabels")
  @xsd(list)
  @xsd(attribute)
  axis_labels:           list<string>?
  @xsd(name = "uomLabels")
  @xsd(list)
  @xsd(attribute)
  uom_labels:            list<string>?
  @xsd(name = "curveMember") curve_member:          list<CurveProperty>(min = 1)
