  /// The gml:name property provides a label or identifier for the object, commonly a descriptive name. An object may have several names, typically assigned by different authorities. gml:name uses the gml:CodeType content model.  The authority for a name is indicated by the value of its (optional) codeSpace attribute.  The name may or may not be unique, as determined by the rules of the organization responsible for the codeSpace.  In common usage there will be one name per authority, so a processing application may select the name from its preferred codeSpace.
  name:                  list<Code>
  /// The attribute gml:id supports provision of a handle for the XML element representing a GML Object. Its use is mandatory for all GML objects. It is of XML type ID, so is constrained to be unique in the XML document within which it occurs.
  @xsd(attribute) id:                    string
  remarks:               string?
  /// The gml:domainOfValidity property implements an association role to an EX_Extent object as encoded in ISO/TS 19139, either referencing or containing the definition of that extent.
  @xsd(name = "domainOfValidity") domain_of_validity:    list<DomainOfValidity>
  /// The gml:scope property provides a description of the usage, or limitations of usage, for which this CRS-related object is valid. If unknown, enter "not known".
  scope:                 list<string>(min = 1)
  /// gml:conversion is an association role to the coordinate conversion used to define the derived CRS.
  conversion:            GeneralConversionProperty
  /// gml:baseCRS is an association role to the coordinate reference system used by this derived CRS.
  @xsd(name = "baseCRS") base_crs:              SingleCRSProperty
  /// The gml:derivedCRSType property describes the type of a derived coordinate reference system. The required codeSpace attribute shall reference a source of information specifying the values and meanings of all the allowed string values for this property.
  @xsd(name = "derivedCRSType") derived_crs_type:      CodeWithAuthority
  /// An association role to the coordinate system used by this CRS.
  @xsd(name = "coordinateSystem") coordinate_system:     CoordinateSystemProperty

  record DomainOfValidity {
    @xsd(name = "EX_Extent") ex_extent:     gmd.EXExtent
    @xsd(attribute) type:          xlink.Type = simple
    @xsd(attribute) href:          string?
    @xsd(attribute) role:          string(min = 1)?
    @xsd(attribute) arcrole:       string(min = 1)?
    @xsd(attribute) title:         string?
    @xsd(attribute) show:          xlink.Show?
    @xsd(attribute) actuate:       xlink.Actuate?
    @xsd(name = "nilReason")
    @xsd(attribute)
    nil_reason:    string?
    @xsd(name = "remoteSchema")
    @xsd(attribute)
    remote_schema: string?
  }
}

@xsd(root = false)
record CountProperty {
