  parameter             AbstractGeneralOperationParameterProperty[] { minItems 2 }

  @@xsd(name: "OperationParameterGroup")
}

model GeocentricCRSProperty {
  geocentric_crs GeocentricCRS  @xsd(name: "GeocentricCRS")
  type           xlink.Type     @xsd(attribute) = simple
