  @xsd(attribute) show:           xlink.Show?
  @xsd(attribute) actuate:        xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:     string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema:  string?
}

/// [complexType of] The style descriptor for labels of a feature, geometry or topology.
