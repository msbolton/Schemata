@xsd(name = "ObliqueCartesianCS")
record ObliqueCartesianCS {
  @xsd(name = "metaDataProperty") meta_data_property:    list<MetaDataProperty>
  /// The value of this property is a text description of the object. gml:description uses gml:StringOrRefType as its content model, so it may contain a simple text string content, or carry a reference to an external description. The use of gml:description to reference an external description has been deprecated and replaced by the gml:descriptionReference property.
  description:           StringOrRef?
  /// The value of this property is a remote text description of the object. The xlink:href attribute of the gml:descriptionReference property references the external description.
  @xsd(name = "descriptionReference") description_reference: Reference?
  /// Often, a special identifier is assigned to an object by the maintaining authority with the intention that it is used in references to the object For such cases, the codeSpace shall be provided. That identifier is usually unique either globally or within an application domain. gml:identifier is a pre-defined property for such identifiers.
  identifier:            CodeWithAuthority
  /// The gml:name property provides a label or identifier for the object, commonly a descriptive name. An object may have several names, typically assigned by different authorities. gml:name uses the gml:CodeType content model.  The authority for a name is indicated by the value of its (optional) codeSpace attribute.  The name may or may not be unique, as determined by the rules of the organization responsible for the codeSpace.  In common usage there will be one name per authority, so a processing application may select the name from its preferred codeSpace.
  name:                  list<Code>
  /// The attribute gml:id supports provision of a handle for the XML element representing a GML Object. Its use is mandatory for all GML objects. It is of XML type ID, so is constrained to be unique in the XML document within which it occurs.
  @xsd(attribute) id:                    string
  remarks:               string?
  /// The gml:axis property is an association role (ordered sequence) to the coordinate system axes included in this coordinate system. The coordinate values in a coordinate tuple shall be recorded in the order in which the coordinate system axes associations are recorded, whenever those coordinates use a coordinate reference system that uses this coordinate system. The gml:AggregationAttributeGroup should be used to specify that the axis objects are ordered.
  axis:                  list<CoordinateSystemAxisProperty>(min = 1)
  @xsd(name = "aggregationType")
  @xsd(attribute)
  aggregation_type:      Aggregation?
}

@xsd(name = "ParameterValue")
record ParameterValue {
  /// gml:value is a numeric value of an operation parameter, with its associated unit of measure.
  value:               Measure?
  @xsd(name = "dmsAngleValue") dms_angle_value:     DMSAngle?
  /// gml:stringValue is a character string value of an operation parameter. A string value does not have an associated unit of measure.
  @xsd(name = "stringValue") string_value:        string?
  /// gml:integerValue is a positive integer value of an operation parameter, usually used for a count. An integer value does not have an associated unit of measure.
  @xsd(name = "integerValue") integer_value:       int64(min = 1)?
  /// gml:booleanValue is a boolean value of an operation parameter. A Boolean value does not have an associated unit of measure.
  @xsd(name = "booleanValue") boolean_value:       bool?
  /// gml:valueList is an ordered sequence of two or more numeric values of an operation parameter list, where each value has the same associated unit of measure. An element of this type contains a space-separated sequence of double values.
  @xsd(name = "valueList") value_list:          MeasureList?
  /// gml:integerValueList is an ordered sequence of two or more integer values of an operation parameter list, usually used for counts. These integer values do not have an associated unit of measure. An element of this type contains a space-separated sequence of integer values.
  @xsd(name = "integerValueList")
  @xsd(list)
  integer_value_list:  list<int32>?
  /// gml:valueFile is a reference to a file or a part of a file containing one or more parameter values, each numeric value with its associated unit of measure. When referencing a part of a file, that file shall contain multiple identified parts, such as an XML encoded document. Furthermore, the referenced file or part of a file may reference another part of the same or different files, as allowed in XML documents.
  @xsd(name = "valueFile") value_file:          string?
  /// gml:operationParameter is an association role to the operation parameter of which this is a value.
  @xsd(name = "operationParameter") operation_parameter: OperationParameterProperty
}

record TopoVolumeProperty {
  /// gml:TopoVolume represents a homogeneous topological expression, a set of directed topologic solids, which if realised are isomorphic to a geometric solid primitive. The intended use of gml:TopoVolume is to appear within a solid feature to express the structural and geometric relationships of this solid feature to other features via the shared solid definitions.
  @xsd(name = "TopoVolume") topo_volume: TopoVolume
  @xsd(attribute) owns:        bool = false
}

record ObliqueCartesianCSProperty {
  @xsd(name = "ObliqueCartesianCS") oblique_cartesian_cs: ObliqueCartesianCS
  @xsd(attribute) type:                 xlink.Type = simple
  @xsd(attribute) href:                 string?
  @xsd(attribute) role:                 string(min = 1)?
  @xsd(attribute) arcrole:              string(min = 1)?
  @xsd(attribute) title:                string?
  @xsd(attribute) show:                 xlink.Show?
  @xsd(attribute) actuate:              xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:           string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema:        string?
}

@xsd(name = "TopoComplex")
record TopoComplex {
  @xsd(name = "metaDataProperty") meta_data_property:     list<MetaDataProperty>
  /// The value of this property is a text description of the object. gml:description uses gml:StringOrRefType as its content model, so it may contain a simple text string content, or carry a reference to an external description. The use of gml:description to reference an external description has been deprecated and replaced by the gml:descriptionReference property.
  description:            StringOrRef?
  /// The value of this property is a remote text description of the object. The xlink:href attribute of the gml:descriptionReference property references the external description.
  @xsd(name = "descriptionReference") description_reference:  Reference?
  /// Often, a special identifier is assigned to an object by the maintaining authority with the intention that it is used in references to the object For such cases, the codeSpace shall be provided. That identifier is usually unique either globally or within an application domain. gml:identifier is a pre-defined property for such identifiers.
  identifier:             CodeWithAuthority?
  /// The gml:name property provides a label or identifier for the object, commonly a descriptive name. An object may have several names, typically assigned by different authorities. gml:name uses the gml:CodeType content model.  The authority for a name is indicated by the value of its (optional) codeSpace attribute.  The name may or may not be unique, as determined by the rules of the organization responsible for the codeSpace.  In common usage there will be one name per authority, so a processing application may select the name from its preferred codeSpace.
  name:                   list<Code>
  /// The attribute gml:id supports provision of a handle for the XML element representing a GML Object. Its use is mandatory for all GML objects. It is of XML type ID, so is constrained to be unique in the XML document within which it occurs.
  @xsd(attribute) id:                     string?
  /// The property elements gml:subComplex, gml:superComplex and gml:maximalComplex provide an encoding for relationships between topology complexes as described for gml:TopoComplex above.
  @xsd(name = "maximalComplex") maximal_complex:        TopoComplexProperty
  /// The property elements gml:subComplex, gml:superComplex and gml:maximalComplex provide an encoding for relationships between topology complexes as described for gml:TopoComplex above.
  @xsd(name = "superComplex") super_complex:          list<TopoComplexProperty>
  /// The property elements gml:subComplex, gml:superComplex and gml:maximalComplex provide an encoding for relationships between topology complexes as described for gml:TopoComplex above.
  @xsd(name = "subComplex") sub_complex:            list<TopoComplexProperty>
  /// The gml:topoPrimitiveMember property element encodes for the relationship between a topology complex and a single topology primitive.
  @xsd(name = "topoPrimitiveMember") topo_primitive_member:  list<TopoPrimitiveMember>
  /// The gml:topoPrimitiveMembers property element encodes the relationship between a topology complex and an arbitrary number of topology primitives.
  @xsd(name = "topoPrimitiveMembers") topo_primitive_members: TopoPrimitiveArrayAssociation?
  @xsd(name = "isMaximal")
  @xsd(attribute)
  is_maximal:             bool = false
  @xsd(name = "aggregationType")
  @xsd(attribute)
  aggregation_type:       Aggregation?
}

@xsd(name = "BSpline")
record BSpline {
  @xsd(name = "numDerivativesAtStart")
  @xsd(attribute)
  num_derivatives_at_start: int32 = 0
  @xsd(name = "numDerivativesAtEnd")
  @xsd(attribute)
  num_derivatives_at_end:   int32 = 0
  @xsd(name = "numDerivativeInterior")
  @xsd(attribute)
  num_derivative_interior:  int32 = 0
  pos:                      DirectPosition?
  /// This property element either references a point via the XLink-attributes or contains the point element. pointProperty is the predefined property which may be used by GML Application Schemas whenever a GML feature has a property with a value that is substitutable for Point.
  @xsd(name = "pointProperty") point_property:           PointProperty?
  @xsd(name = "pointRep") point_rep:                PointProperty?
  @xsd(name = "posList") pos_list:                 DirectPositionList?
  coordinates:              Coordinates?
  degree:                   int64(min = 0)
  knot:                     list<KnotProperty>(min = 2)
  @xsd(attribute) interpolation:            CurveInterpolation = polynomial_spline
  @xsd(name = "isPolynomial")
  @xsd(attribute)
  is_polynomial:            bool?
  @xsd(name = "knotType")
  @xsd(attribute)
  knot_type:                KnotTypes?
}

/// [complexType of] The style descriptor for a graph consisting of a number of features. Describes graph-specific style attributes.
@xsd(name = "GraphStyle")
record GraphStyle {
  @xsd(name = "metaDataProperty") meta_data_property:    list<MetaDataProperty>
  /// The value of this property is a text description of the object. gml:description uses gml:StringOrRefType as its content model, so it may contain a simple text string content, or carry a reference to an external description. The use of gml:description to reference an external description has been deprecated and replaced by the gml:descriptionReference property.
  description:           StringOrRef?
  /// The value of this property is a remote text description of the object. The xlink:href attribute of the gml:descriptionReference property references the external description.
  @xsd(name = "descriptionReference") description_reference: Reference?
  /// Often, a special identifier is assigned to an object by the maintaining authority with the intention that it is used in references to the object For such cases, the codeSpace shall be provided. That identifier is usually unique either globally or within an application domain. gml:identifier is a pre-defined property for such identifiers.
  identifier:            CodeWithAuthority?
  /// The gml:name property provides a label or identifier for the object, commonly a descriptive name. An object may have several names, typically assigned by different authorities. gml:name uses the gml:CodeType content model.  The authority for a name is indicated by the value of its (optional) codeSpace attribute.  The name may or may not be unique, as determined by the rules of the organization responsible for the codeSpace.  In common usage there will be one name per authority, so a processing application may select the name from its preferred codeSpace.
  name:                  list<Code>
  /// The attribute gml:id supports provision of a handle for the XML element representing a GML Object. Its use is mandatory for all GML objects. It is of XML type ID, so is constrained to be unique in the XML document within which it occurs.
  @xsd(attribute) id:                    string?
  @xsd(name = "spatialResolution") spatial_resolution:    Scale?
  @xsd(name = "styleVariation") style_variation:       list<StyleVariation>
  animate:               list<smil20_language.Animate>
  @xsd(name = "animateMotion") animate_motion:        list<smil20_language.AnimateMotion>
  @xsd(name = "animateColor") animate_color:         list<smil20_language.AnimateColor>
  set:                   list<smil20_language.Set>
  planar:                bool?
  directed:              bool?
  grid:                  bool?
  @xsd(name = "minDistance") min_distance:          float64?
  @xsd(name = "minAngle") min_angle:             float64?
  @xsd(name = "graphType") graph_type:            GraphType?
  @xsd(name = "drawingType") drawing_type:          DrawingType?
  @xsd(name = "lineType") line_type:             LineType?
  @xsd(name = "aestheticCriteria") aesthetic_criteria:    list<AesheticCriteria>
}

/// gml:ImageCRSPropertyType is a property type for association roles to an image coordinate reference system, either referencing or containing the definition of that reference system.
record ImageCRSProperty {
  /// gml:ImageCRS is an engineering coordinate reference system applied to locations in images. Image coordinate reference systems are treated as a separate sub-type because the definition of the associated image datum contains two attributes not relevant to other engineering datums.
  @xsd(name = "ImageCRS") image_crs:     ImageCRS
  @xsd(attribute) type:          xlink.Type = simple
  @xsd(attribute) href:          string?
  @xsd(attribute) role:          string(min = 1)?
  @xsd(attribute) arcrole:       string(min = 1)?
  @xsd(attribute) title:         string?
  @xsd(attribute) show:          xlink.Show?
  @xsd(attribute) actuate:       xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:    string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema: string?
}

@xsd(name = "TemporalCRS")
record TemporalCRS {
  @xsd(name = "metaDataProperty") meta_data_property:    list<MetaDataProperty>
  /// The value of this property is a text description of the object. gml:description uses gml:StringOrRefType as its content model, so it may contain a simple text string content, or carry a reference to an external description. The use of gml:description to reference an external description has been deprecated and replaced by the gml:descriptionReference property.
  description:           StringOrRef?
  /// The value of this property is a remote text description of the object. The xlink:href attribute of the gml:descriptionReference property references the external description.
  @xsd(name = "descriptionReference") description_reference: Reference?
  /// Often, a special identifier is assigned to an object by the maintaining authority with the intention that it is used in references to the object For such cases, the codeSpace shall be provided. That identifier is usually unique either globally or within an application domain. gml:identifier is a pre-defined property for such identifiers.
  identifier:            CodeWithAuthority
  /// The gml:name property provides a label or identifier for the object, commonly a descriptive name. An object may have several names, typically assigned by different authorities. gml:name uses the gml:CodeType content model.  The authority for a name is indicated by the value of its (optional) codeSpace attribute.  The name may or may not be unique, as determined by the rules of the organization responsible for the codeSpace.  In common usage there will be one name per authority, so a processing application may select the name from its preferred codeSpace.
  name:                  list<Code>
  /// The attribute gml:id supports provision of a handle for the XML element representing a GML Object. Its use is mandatory for all GML objects. It is of XML type ID, so is constrained to be unique in the XML document within which it occurs.
  @xsd(attribute) id:                    string
  remarks:               string?
  /// The gml:domainOfValidity property implements an association role to an EX_Extent object as encoded in ISO/TS 19139, either referencing or containing the definition of that extent.
  @xsd(name = "domainOfValidity") domain_of_validity:    list<DomainOfValidity>
  /// The gml:scope property provides a description of the usage, or limitations of usage, for which this CRS-related object is valid. If unknown, enter "not known".
  scope:                 list<string>(min = 1)
  /// gml:timeCS is an association role to the time coordinate system used by this CRS.
  @xsd(name = "timeCS") time_cs:               TimeCSProperty?
  @xsd(name = "usesTemporalCS") uses_temporal_cs:      TemporalCSProperty?
  /// gml:temporalDatum is an association role to the temporal datum used by this CRS.
  @xsd(name = "temporalDatum") temporal_datum:        TemporalDatumProperty

  record DomainOfValidity {
    @xsd(name = "EX_Extent") ex_extent:     gmd.EXExtent
    @xsd(attribute) type:          xlink.Type = simple
    @xsd(attribute) href:          string?
    @xsd(attribute) role:          string(min = 1)?
    @xsd(attribute) arcrole:       string(min = 1)?
    @xsd(attribute) title:         string?
    @xsd(attribute) show:          xlink.Show?
    @xsd(attribute) actuate:       xlink.Actuate?
    @xsd(name = "nilReason")
    @xsd(attribute)
    nil_reason:    string?
    @xsd(name = "remoteSchema")
    @xsd(attribute)
    remote_schema: string?
  }
}

/// [complexType of] The symbol property. Allows for remote referencing of symbols.
record Symbol {
  @xsd(any)
  @xsd(process = "skip")
  any:           list<string>
  @xsd(name = "symbolType")
  @xsd(attribute)
  symbol_type:   SymbolTypeEnumeration
  /// Defines the geometric transformation of entities. There is no particular grammar defined for this value.
  @xsd(attribute) transform:     string?
  @xsd(attribute) about:         string?
  @xsd(attribute) type:          xlink.Type = simple
  @xsd(attribute) href:          string?
  @xsd(attribute) role:          string(min = 1)?
  @xsd(attribute) arcrole:       string(min = 1)?
  @xsd(attribute) title:         string?
  @xsd(attribute) show:          xlink.Show?
  @xsd(attribute) actuate:       xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:    string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema: string?
}

@xsd(root = false)
record Knot { value: float64 multiplicity: int64(min = 0) weight: float64 }

/// gml:KnotPropertyType encapsulates a knot to use it in a geometric type.
@xsd(root = false)
record KnotProperty {
  /// A knot is a breakpoint on a piecewise spline curve.
  /// value is the value of the parameter at the knot of the spline (see ISO 19107:2003, 6.4.24.2).
  /// multiplicity is the multiplicity of this knot used in the definition of the spline (with the same weight).
  /// weight is the value of the averaging weight used for this knot of the spline.
  @xsd(name = "Knot") knot: Knot
}

record TopoPrimitiveMember {
  /// gml:AbstractTopoPrimitive acts as the base type for all topological primitives. Topology primitives are the atomic (smallest possible) units of a topology complex.
  /// Each topology primitive may contain references to other topology primitives of codimension 2 or more (gml:isolated). Conversely, nodes may have faces as containers and nodes and edges may have solids as containers (gml:container).
  @xsd(name = "AbstractTopoPrimitive") abstract_topo_primitive: AbstractTopoPrimitive
  @xsd(attribute) type:                    xlink.Type = simple
  @xsd(attribute) href:                    string?
  @xsd(attribute) role:                    string(min = 1)?
  @xsd(attribute) arcrole:                 string(min = 1)?
  @xsd(attribute) title:                   string?
  @xsd(attribute) show:                    xlink.Show?
  @xsd(attribute) actuate:                 xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:              string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema:           string?
  @xsd(attribute) owns:                    bool = false
}

/// Used to specify the type of the symbol used.
enum SymbolTypeEnumeration { svg, xpath, other }

/// gml:TemporalCRSPropertyType is a property type for association roles to a temporal coordinate reference system, either referencing or containing the definition of that reference system.
record TemporalCRSProperty {
  /// gml:TemporalCRS is a 1D coordinate reference system used for the recording of time.
  @xsd(name = "TemporalCRS") temporal_crs:  TemporalCRS
  @xsd(attribute) type:          xlink.Type = simple
  @xsd(attribute) href:          string?
  @xsd(attribute) role:          string(min = 1)?
  @xsd(attribute) arcrole:       string(min = 1)?
  @xsd(attribute) title:         string?
  @xsd(attribute) show:          xlink.Show?
  @xsd(attribute) actuate:       xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:    string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema: string?
}

@xsd(name = "ParameterValueGroup")
record ParameterValueGroup {
  /// gml:parameterValue is a composition association to a parameter value or group of parameter values used by a coordinate operation.
  @xsd(name = "parameterValue") parameter_value: list<AbstractGeneralParameterValueProperty>(min = 2)
  /// gml:group is an association role to the operation parameter group for which this element provides parameter values.
  group:           OperationParameterGroupProperty
}

/// This enumeration type specifies values for the knots' type (see ISO 19107:2003, 6.4.25).
enum KnotTypes {
  uniform
  @xsd(name = "quasiUniform") quasi_uniform
  @xsd(name = "piecewiseBezier") piecewise_bezier
}

/// Label is mixed -- composed of text and XPath expressions used to extract the useful information from the feature.
@xsd(root = false)
record Label {
  @xsd(name = "LabelExpression") label_expression: list<string>
  @xsd(mixed) text:             string?
  /// Defines the geometric transformation of entities. There is no particular grammar defined for this value.
  @xsd(attribute) transform:        string?
}

record TopoPrimitiveArrayAssociation {
  /// gml:AbstractTopoPrimitive acts as the base type for all topological primitives. Topology primitives are the atomic (smallest possible) units of a topology complex.
  /// Each topology primitive may contain references to other topology primitives of codimension 2 or more (gml:isolated). Conversely, nodes may have faces as containers and nodes and edges may have solids as containers (gml:container).
  @xsd(name = "AbstractTopoPrimitive") abstract_topo_primitive: AbstractTopoPrimitive
  @xsd(attribute) owns:                    bool = false
}

record TopoComplexProperty {
  /// gml:TopoComplex is a collection of topological primitives.
  /// Each complex holds a reference to its maximal complex (gml:maximalComplex) and optionally to sub- or super-complexes (gml:subComplex, gml:superComplex).
  /// A topology complex contains its primitive and sub-complex members.
  @xsd(name = "TopoComplex") topo_complex:  TopoComplex
  @xsd(attribute) type:          xlink.Type = simple
  @xsd(attribute) href:          string?
  @xsd(attribute) role:          string(min = 1)?
  @xsd(attribute) arcrole:       string(min = 1)?
  @xsd(attribute) title:         string?
  @xsd(attribute) show:          xlink.Show?
  @xsd(attribute) actuate:       xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:    string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema: string?
}

@xsd(name = "Bezier")
record Bezier {
  pos:                      DirectPosition?
  /// This property element either references a point via the XLink-attributes or contains the point element. pointProperty is the predefined property which may be used by GML Application Schemas whenever a GML feature has a property with a value that is substitutable for Point.
  @xsd(name = "pointProperty") point_property:           PointProperty?
  @xsd(name = "pointRep") point_rep:                PointProperty?
  @xsd(name = "posList") pos_list:                 DirectPositionList?
  coordinates:              Coordinates?
  degree:                   int64(min = 0)
  knot:                     list<KnotProperty>(min = 2, max = 2)
  @xsd(attribute) interpolation:            CurveInterpolation = polynomial_spline
  @xsd(name = "isPolynomial")
  @xsd(attribute)
  is_polynomial:            bool = true
  @xsd(name = "numDerivativesAtStart")
  @xsd(attribute)
  num_derivatives_at_start: int32 = 0
  @xsd(name = "numDerivativesAtEnd")
  @xsd(attribute)
  num_derivatives_at_end:   int32 = 0
  @xsd(name = "numDerivativeInterior")
  @xsd(attribute)
  num_derivative_interior:  int32 = 0
}

/// Used to vary individual graphic parameters and attributes of the style, symbol or text.
@xsd(root = false)
record StyleVariation {
  value:                  string
  @xsd(name = "styleProperty")
  @xsd(attribute)
  style_property:         string
  @xsd(name = "featurePropertyRange")
  @xsd(attribute)
  feature_property_range: string?
}

@xsd(name = "OperationMethod")
record OperationMethod {
  @xsd(name = "metaDataProperty") meta_data_property:    list<MetaDataProperty>
  /// The value of this property is a text description of the object. gml:description uses gml:StringOrRefType as its content model, so it may contain a simple text string content, or carry a reference to an external description. The use of gml:description to reference an external description has been deprecated and replaced by the gml:descriptionReference property.
  description:           StringOrRef?
  /// The value of this property is a remote text description of the object. The xlink:href attribute of the gml:descriptionReference property references the external description.
  @xsd(name = "descriptionReference") description_reference: Reference?
  /// Often, a special identifier is assigned to an object by the maintaining authority with the intention that it is used in references to the object For such cases, the codeSpace shall be provided. That identifier is usually unique either globally or within an application domain. gml:identifier is a pre-defined property for such identifiers.
  identifier:            CodeWithAuthority
  /// The gml:name property provides a label or identifier for the object, commonly a descriptive name. An object may have several names, typically assigned by different authorities. gml:name uses the gml:CodeType content model.  The authority for a name is indicated by the value of its (optional) codeSpace attribute.  The name may or may not be unique, as determined by the rules of the organization responsible for the codeSpace.  In common usage there will be one name per authority, so a processing application may select the name from its preferred codeSpace.
  name:                  list<Code>
  /// The attribute gml:id supports provision of a handle for the XML element representing a GML Object. Its use is mandatory for all GML objects. It is of XML type ID, so is constrained to be unique in the XML document within which it occurs.
  @xsd(attribute) id:                    string
  remarks:               string?
  /// gml:formulaCitation provides a reference to a publication giving the formula(s) or procedure used by an coordinate operation method.
  @xsd(name = "formulaCitation") formula_citation:      FormulaCitation?
  /// gml:formula Formula(s) or procedure used by an operation method. The use of the codespace attribite has been deprecated. The property value shall be a character string.
  formula:               Code?
  /// gml:sourceDimensions is the number of dimensions in the source CRS of this operation method.
  @xsd(name = "sourceDimensions") source_dimensions:     int64(min = 1)?
  /// gml:targetDimensions is the number of dimensions in the target CRS of this operation method.
  @xsd(name = "targetDimensions") target_dimensions:     int64(min = 1)?
  /// gml:parameter is an association to an operation parameter or parameter group.
  parameter:             list<AbstractGeneralOperationParameterProperty>

  record FormulaCitation {
    @xsd(name = "CI_Citation") ci_citation:   gmd.CICitation
    @xsd(attribute) type:          xlink.Type = simple
    @xsd(attribute) href:          string?
    @xsd(attribute) role:          string(min = 1)?
    @xsd(attribute) arcrole:       string(min = 1)?
    @xsd(attribute) title:         string?
    @xsd(attribute) show:          xlink.Show?
    @xsd(attribute) actuate:       xlink.Actuate?
    @xsd(name = "nilReason")
    @xsd(attribute)
    nil_reason:    string?
    @xsd(name = "remoteSchema")
    @xsd(attribute)
    remote_schema: string?
  }
}

/// Graph-specific styling property.
enum GraphType { @xsd(name = "TREE") tree, @xsd(name = "BICONNECTED") biconnected }

/// Graph-specific styling property.
enum DrawingType { @xsd(name = "POLYLINE") polyline, @xsd(name = "ORTHOGONAL") orthogonal }

@xsd(name = "OffsetCurve")
record OffsetCurve {
  @xsd(name = "numDerivativesAtStart")
  @xsd(attribute)
  num_derivatives_at_start: int32 = 0
  @xsd(name = "numDerivativesAtEnd")
  @xsd(attribute)
  num_derivatives_at_end:   int32 = 0
  @xsd(name = "numDerivativeInterior")
  @xsd(attribute)
  num_derivative_interior:  int32 = 0
  @xsd(name = "offsetBase") offset_base:              CurveProperty
  distance:                 Length
  @xsd(name = "refDirection") ref_direction:            Vector?
}

/// Graph-specific styling property.
enum LineType { @xsd(name = "STRAIGHT") straight, @xsd(name = "BENT") bent }

@xsd(name = "AffinePlacement")
record AffinePlacement {
  location:      DirectPosition
  @xsd(name = "refDirection") ref_direction: list<Vector>(min = 1)
  @xsd(name = "inDimension") in_dimension:  int64(min = 1)
  @xsd(name = "outDimension") out_dimension: int64(min = 1)
}

/// Graph-specific styling property.
enum AesheticCriteria {
  @xsd(name = "MIN_CROSSINGS") min_crossings
  @xsd(name = "MIN_AREA") min_area
  @xsd(name = "MIN_BENDS") min_bends
  @xsd(name = "MAX_BENDS") max_bends
  @xsd(name = "UNIFORM_BENDS") uniform_bends
  @xsd(name = "MIN_SLOPES") min_slopes
  @xsd(name = "MIN_EDGE_LENGTH") min_edge_length
  @xsd(name = "MAX_EDGE_LENGTH") max_edge_length
  @xsd(name = "UNIFORM_EDGE_LENGTH") uniform_edge_length
  @xsd(name = "MAX_ANGULAR_RESOLUTION") max_angular_resolution
  @xsd(name = "MIN_ASPECT_RATIO") min_aspect_ratio
  @xsd(name = "MAX_SYMMETRIES") max_symmetries
}

/// gml:OperationMethodPropertyType is a property type for association roles to a concrete general-purpose operation method, either referencing or containing the definition of that method.
record OperationMethodProperty {
  /// gml:OperationMethod is a method (algorithm or procedure) used to perform a coordinate operation. Most operation methods use a number of operation parameters, although some coordinate conversions use none. Each coordinate operation using the method assigns values to these parameters.
  /// The parameter elements are an unordered list of associations to the set of operation parameters and parameter groups used by this operation method.
  @xsd(name = "OperationMethod") operation_method: OperationMethod
  @xsd(attribute) type:             xlink.Type = simple
  @xsd(attribute) href:             string?
  @xsd(attribute) role:             string(min = 1)?
  @xsd(attribute) arcrole:          string(min = 1)?
  @xsd(attribute) title:            string?
  @xsd(attribute) show:             xlink.Show?
  @xsd(attribute) actuate:          xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:       string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema:    string?
}

@xsd(name = "Clothoid")
record Clothoid {
  @xsd(name = "numDerivativesAtStart")
  @xsd(attribute)
  num_derivatives_at_start: int32 = 0
  @xsd(name = "numDerivativesAtEnd")
  @xsd(attribute)
  num_derivatives_at_end:   int32 = 0
  @xsd(name = "numDerivativeInterior")
  @xsd(attribute)
  num_derivative_interior:  int32 = 0
  @xsd(name = "refLocation") ref_location:             RefLocation
  @xsd(name = "scaleFactor") scale_factor:             decimal(38, 9)
  @xsd(name = "startParameter") start_parameter:          float64
  @xsd(name = "endParameter") end_parameter:            float64
  @xsd(attribute) interpolation:            CurveInterpolation = clothoid

  record RefLocation {
    /// location, refDirection, inDimension and outDimension have the same meaning as specified in ISO 19107:2003, 6.4.21.
    @xsd(name = "AffinePlacement") affine_placement: AffinePlacement
  }
}

union AbstractGeneralOperationParameter = OperationParameter | OperationParameterGroup

@xsd(name = "GeographicCRS")
