  point_rep                PointProperty[]     @xsd(name: "pointRep")
  pos_list                 DirectPositionList? @xsd(name: "posList")
  coordinates              Coordinates?
  vector_at_start          Vector              @xsd(name: "vectorAtStart")
  vector_at_end            Vector              @xsd(name: "vectorAtEnd")
  interpolation            CurveInterpolation  @xsd(attribute) = cubic_spline
  degree                   int32               @xsd(attribute) = 3

