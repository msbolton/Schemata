  id                    string             @xsd(attribute)
  /// gml:origin is the date and time origin of this temporal datum.
  origin                instant

  model DomainOfValidity {
    ex_extent     gmd.EXExtent   @xsd(name: "EX_Extent")
    type          xlink.Type     @xsd(attribute) = simple
    href          string?        @xsd(attribute)
    role          string?        { min 1 } @xsd(attribute)
