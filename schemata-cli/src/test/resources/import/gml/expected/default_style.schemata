  @xsd(name = "minimumOccurs") minimum_occurs:        int64(min = 0)?
  /// gml:maximumOccurs is the maximum number of times that values for this parameter group may be included. If this attribute is omitted, the maximum number shall be one.
  @xsd(name = "maximumOccurs") maximum_occurs:        int64(min = 1)?
  /// gml:parameter is an association to an operation parameter or parameter group.
  parameter:             list<AbstractGeneralOperationParameterProperty>(min = 2)
}

record GeocentricCRSProperty {
  @xsd(name = "GeocentricCRS") geocentric_crs: GeocentricCRS
  @xsd(attribute) type:           xlink.Type = simple
  @xsd(attribute) href:           string?
  @xsd(attribute) role:           string(min = 1)?
  @xsd(attribute) arcrole:        string(min = 1)?
  @xsd(attribute) title:          string?
  @xsd(attribute) show:           xlink.Show?
  @xsd(attribute) actuate:        xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:     string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema:  string?
}

@xsd(name = "OrientableSurface")
record OrientableSurface {
  @xsd(name = "metaDataProperty") meta_data_property:    list<MetaDataProperty>
  /// The value of this property is a text description of the object. gml:description uses gml:StringOrRefType as its content model, so it may contain a simple text string content, or carry a reference to an external description. The use of gml:description to reference an external description has been deprecated and replaced by the gml:descriptionReference property.
  description:           StringOrRef?
  /// The value of this property is a remote text description of the object. The xlink:href attribute of the gml:descriptionReference property references the external description.
  @xsd(name = "descriptionReference") description_reference: Reference?
  /// Often, a special identifier is assigned to an object by the maintaining authority with the intention that it is used in references to the object For such cases, the codeSpace shall be provided. That identifier is usually unique either globally or within an application domain. gml:identifier is a pre-defined property for such identifiers.
  identifier:            CodeWithAuthority?
  /// The gml:name property provides a label or identifier for the object, commonly a descriptive name. An object may have several names, typically assigned by different authorities. gml:name uses the gml:CodeType content model.  The authority for a name is indicated by the value of its (optional) codeSpace attribute.  The name may or may not be unique, as determined by the rules of the organization responsible for the codeSpace.  In common usage there will be one name per authority, so a processing application may select the name from its preferred codeSpace.
  name:                  list<Code>
  /// The attribute gml:id supports provision of a handle for the XML element representing a GML Object. Its use is mandatory for all GML objects. It is of XML type ID, so is constrained to be unique in the XML document within which it occurs.
  @xsd(attribute) id:                    string?
  @xsd(name = "srsName")
  @xsd(attribute)
  srs_name:              string?
  @xsd(name = "srsDimension")
  @xsd(attribute)
  srs_dimension:         int64(min = 1)?
  @xsd(name = "axisLabels")
  @xsd(list)
  @xsd(attribute)
  axis_labels:           list<string>?
  @xsd(name = "uomLabels")
  @xsd(list)
  @xsd(attribute)
  uom_labels:            list<string>?
  /// The property baseSurface references or contains the base surface. The property baseSurface either references the base surface via the XLink-attributes or contains the surface element. A surface element is any element which is substitutable for gml:AbstractSurface. The base surface has positive orientation.
  @xsd(name = "baseSurface") base_surface:          SurfaceProperty
  @xsd(attribute) orientation:           Sign = plus
}

/// gml:OperationParameterPropertyType is a property type for association roles to an operation parameter group, either referencing or containing the definition of that parameter group.
record OperationParameterGroupProperty {
  /// gml:OperationParameterGroup is the definition of a group of parameters used by an operation method. This complex type is expected to be used or extended for all applicable operation methods, without defining operation-method-specialized element names.
  /// The generalOperationParameter elements are an unordered list of associations to the set of operation parameters that are members of this group.
  @xsd(name = "OperationParameterGroup") operation_parameter_group: OperationParameterGroup
  @xsd(attribute) type:                      xlink.Type = simple
  @xsd(attribute) href:                      string?
  @xsd(attribute) role:                      string(min = 1)?
  @xsd(attribute) arcrole:                   string(min = 1)?
  @xsd(attribute) title:                     string?
  @xsd(attribute) show:                      xlink.Show?
  @xsd(attribute) actuate:                   xlink.Actuate?
  @xsd(name = "nilReason")
  @xsd(attribute)
  nil_reason:                string?
  @xsd(name = "remoteSchema")
  @xsd(attribute)
  remote_schema:             string?
}

enum Succession { substitution, division, fusion, initiation }

union AbstractSurfacePatch = PolygonPatch | Triangle | Rectangle | Cone | Cylinder | Sphere

record DMSAngle {
  degrees:         Degrees
  @xsd(name = "decimalMinutes") decimal_minutes: decimal(38, 9, min = 0.00)?
  minutes_group:   MinutesGroup?

  record MinutesGroup { minutes: int64(max = 59) seconds: decimal(38, 9, min = 0.00)? }
}

/// gml:SurfacePatchArrayPropertyType is a container for a sequence of surface patches.
record SurfacePatchArrayProperty {
  /// A surface patch defines a homogenuous portion of a surface.
  /// The AbstractSurfacePatch element is the abstract head of the substituition group for all surface patch elements describing a continuous portion of a surface.
  /// All surface patches shall have an attribute interpolation (declared in the types derived from gml:AbstractSurfacePatchType) specifying the interpolation mechanism used for the patch using gml:SurfaceInterpolationType.
  @xsd(name = "AbstractSurfacePatch") abstract_surface_patch: AbstractSurfacePatch
}

/// gml:SurfaceInterpolationType is a list of codes that may be used to identify the interpolation mechanisms specified by an application schema.
enum SurfaceInterpolation {
  none
  planar
  spherical
  elliptical
  conic
  tin
  @xsd(name = "parametricCurve") parametric_curve
  @xsd(name = "polynomialSpline") polynomial_spline
  @xsd(name = "rationalSpline") rational_spline
  @xsd(name = "triangulatedSpline") triangulated_spline
}

record Degrees {
  value:     int64
  @xsd(attribute) direction: Direction?

  enum Direction {
    @xsd(name = "N") n
    @xsd(name = "E") e
    @xsd(name = "S") s
    @xsd(name = "W") w
    plus
    minus
  }
}

@xsd(name = "PolygonPatch")
record PolygonPatch {
  /// A boundary of a surface consists of a number of rings. In the normal 2D case, one of these rings is distinguished as being the exterior boundary. In a general manifold this is not always possible, in which case all boundaries shall be listed as interior boundaries, and the exterior will be empty.
  exterior:      AbstractRingProperty?
  /// A boundary of a surface consists of a number of rings. The "interior" rings separate the surface / surface patch from the area enclosed by the rings.
  interior:      list<AbstractRingProperty>
  @xsd(attribute) interpolation: SurfaceInterpolation = planar
}

@xsd(name = "Triangle")
record Triangle {
  /// A boundary of a surface consists of a number of rings. In the normal 2D case, one of these rings is distinguished as being the exterior boundary. In a general manifold this is not always possible, in which case all boundaries shall be listed as interior boundaries, and the exterior will be empty.
  exterior:      AbstractRingProperty
  @xsd(attribute) interpolation: SurfaceInterpolation = planar
}

@xsd(name = "Rectangle")
record Rectangle {
  /// A boundary of a surface consists of a number of rings. In the normal 2D case, one of these rings is distinguished as being the exterior boundary. In a general manifold this is not always possible, in which case all boundaries shall be listed as interior boundaries, and the exterior will be empty.
  exterior:      AbstractRingProperty
  @xsd(attribute) interpolation: SurfaceInterpolation = planar
}

