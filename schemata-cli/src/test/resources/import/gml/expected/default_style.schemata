  /// gml:sphericalCS is an association role to the spherical coordinate system used by this CRS.
  spherical_cs          SphericalCSProperty?      @xsd(name: "sphericalCS")
  /// gml:userDefinedCS is an association role to the user defined coordinate system used by this CRS.
  user_defined_cs       UserDefinedCSProperty?    @xsd(name: "userDefinedCS")
  /// An association role to the coordinate system used by this CRS.
  coordinate_system     CoordinateSystemProperty? @xsd(name: "coordinateSystem")
  /// gml:engineeringDatum is an association role to the engineering datum used by this CRS.
  engineering_datum     EngineeringDatumProperty  @xsd(name: "engineeringDatum")

  model DomainOfValidity {
    ex_extent     gmd.EXExtent   @xsd(name: "EX_Extent")
    type          xlink.Type     @xsd(attribute) = simple
    href          string?        @xsd(attribute)
    role          string?        { min 1 } @xsd(attribute)
