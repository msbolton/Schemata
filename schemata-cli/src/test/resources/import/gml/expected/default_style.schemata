  title         string?        @xsd(attribute)
  show          xlink.Show?    @xsd(attribute)
  actuate       xlink.Actuate? @xsd(attribute)
  nil_reason    string?        @xsd(name: "nilReason") @xsd(attribute)
  remote_schema string?        @xsd(name: "remoteSchema") @xsd(attribute)
}

/// gml:MeasureListType provides for a list of quantities.
model MeasureList { value float64[] @xsd(list)  uom string @xsd(attribute) }

/// gml:PolarCSPropertyType is a property type for association roles to a polar coordinate system, either referencing or containing the definition of that coordinate system.
