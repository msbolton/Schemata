  @xsd(attribute)
  remote_schema: string?
}

/// These directions are necessarily approximate, giving direction with a precision of 22.5°. It is thus generally unnecessary to specify the reference frame, though this may be detailed in the definition of a GML application language.
enum CompassPointEnumeration {
  @xsd(name = "N") n
  @xsd(name = "NNE") nne
  @xsd(name = "NE") ne
  @xsd(name = "ENE") ene
  @xsd(name = "E") e
  @xsd(name = "ESE") ese
  @xsd(name = "SE") se
  @xsd(name = "SSE") sse
  @xsd(name = "S") s
  @xsd(name = "SSW") ssw
  @xsd(name = "SW") sw
  @xsd(name = "WSW") wsw
  @xsd(name = "W") w
  @xsd(name = "WNW") wnw
  @xsd(name = "NW") nw
  @xsd(name = "NNW") nnw
}

