  @xsd(name = "pointProperty") point_property:           PointProperty?
  @xsd(name = "pointRep") point_rep:                PointProperty?
  @xsd(name = "posList") pos_list:                 DirectPositionList?
  coordinates:              Coordinates?
  @xsd(attribute) interpolation:            CurveInterpolation = linear
}

/// gml:CoordinateSystemPropertyType is a property type for association roles to a coordinate system, either referencing or containing the definition of that coordinate system.
