  @xsd(name = "usesEllipsoidalCS") uses_ellipsoidal_cs:   EllipsoidalCSProperty
  @xsd(name = "usesGeodeticDatum") uses_geodetic_datum:   GeodeticDatumProperty

  record DomainOfValidity {
