  @xsd(name = "aggregationType")
  @xsd(attribute)
  aggregation_type:      Aggregation?
}

@xsd(name = "ArcByBulge")
record ArcByBulge {
  pos:                      DirectPosition?
  /// This property element either references a point via the XLink-attributes or contains the point element. pointProperty is the predefined property which may be used by GML Application Schemas whenever a GML feature has a property with a value that is substitutable for Point.
  @xsd(name = "pointProperty") point_property:           PointProperty?
  @xsd(name = "pointRep") point_rep:                PointProperty?
  @xsd(name = "posList") pos_list:                 DirectPositionList?
  coordinates:              Coordinates?
  bulge:                    float64
  normal:                   Vector
  @xsd(name = "numArc")
  @xsd(attribute)
  num_arc:                  int32 = 1
  @xsd(attribute) interpolation:            CurveInterpolation = circular_arc2_point_with_bulge
  @xsd(name = "numDerivativesAtStart")
  @xsd(attribute)
  num_derivatives_at_start: int32 = 0
  @xsd(name = "numDerivativesAtEnd")
  @xsd(attribute)
  num_derivatives_at_end:   int32 = 0
  @xsd(name = "numDerivativeInterior")
  @xsd(attribute)
  num_derivative_interior:  int32 = 0
}

/// gml:PointArrayPropertyType is a container for an array of points. The elements are always contained inline in the array property, referencing geometry elements or arrays of geometry elements via XLinks is not supported.
record PointArrayProperty {
  /// A Point is defined by a single coordinate tuple. The direct position of a point is specified by the pos element which is of type DirectPositionType.
  @xsd(name = "Point") point: Point
  @xsd(attribute) owns:  bool = false
}

record TopologyStyleProperty {
  /// The style descriptor for topologies of a feature. Describes individual topology elements styles.
  @xsd(name = "TopologyStyle") topology_style: TopologyStyle?
  @xsd(attribute) about:          string?
  @xsd(attribute) type:           xlink.Type = simple
  @xsd(attribute) href:           string?
