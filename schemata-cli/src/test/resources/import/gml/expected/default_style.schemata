    @xsd(attribute) actuate:       xlink.Actuate?
    @xsd(name = "nilReason")
    @xsd(attribute)
    nil_reason:    string?
    @xsd(name = "remoteSchema")
    @xsd(attribute)
    remote_schema: string?
  }

  record CoordinateOperationAccuracy {
    @xsd(name = "AbstractDQ_PositionalAccuracy") abstract_dq_positional_accuracy: gmd.AbstractDQPositionalAccuracy
    @xsd(attribute) type:                            xlink.Type = simple
    @xsd(attribute) href:                            string?
    @xsd(attribute) role:                            string(min = 1)?
    @xsd(attribute) arcrole:                         string(min = 1)?
    @xsd(attribute) title:                           string?
    @xsd(attribute) show:                            xlink.Show?
    @xsd(attribute) actuate:                         xlink.Actuate?
    @xsd(name = "nilReason")
    @xsd(attribute)
    nil_reason:                      string?
    @xsd(name = "remoteSchema")
    @xsd(attribute)
    remote_schema:                   string?
