  num_derivatives_at_end   int32               @xsd(name: "numDerivativesAtEnd") @xsd(attribute) = 0
  num_derivative_interior  int32               @xsd(name: "numDerivativeInterior") @xsd(attribute) = 0

  @@xsd(name: "CircleByCenterPoint")
}

