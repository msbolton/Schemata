  /// The attribute gml:id supports provision of a handle for the XML element representing a GML Object. Its use is mandatory for all GML objects. It is of XML type ID, so is constrained to be unique in the XML document within which it occurs.
  @xsd(attribute) id:                    string
  remarks:               string?
  /// The gml:domainOfValidity property implements an association role to an EX_Extent object as encoded in ISO/TS 19139, either referencing or containing the definition of that extent.
  @xsd(name = "domainOfValidity") domain_of_validity:    list<DomainOfValidity>
  /// The gml:scope property provides a description of the usage, or limitations of usage, for which this CRS-related object is valid. If unknown, enter "not known".
  scope:                 list<string>(min = 1)
  /// gml:affineCS is an association role to the affine coordinate system used by this CRS.
  @xsd(name = "affineCS") affine_cs:             AffineCSProperty?
  /// gml:cartesianCS is an association role to the Cartesian coordinate system used by this CRS.
  @xsd(name = "cartesianCS") cartesian_cs:          CartesianCSProperty?
  /// gml:cylindricalCS is an association role to the cylindrical coordinate system used by this CRS.
  @xsd(name = "cylindricalCS") cylindrical_cs:        CylindricalCSProperty?
  /// gml:linearCS is an association role to the linear coordinate system used by this CRS.
  @xsd(name = "linearCS") linear_cs:             LinearCSProperty?
  /// gml:polarCS is an association role to the polar coordinate system used by this CRS.
  @xsd(name = "polarCS") polar_cs:              PolarCSProperty?
  /// gml:sphericalCS is an association role to the spherical coordinate system used by this CRS.
  @xsd(name = "sphericalCS") spherical_cs:          SphericalCSProperty?
  /// gml:userDefinedCS is an association role to the user defined coordinate system used by this CRS.
  @xsd(name = "userDefinedCS") user_defined_cs:       UserDefinedCSProperty?
  /// An association role to the coordinate system used by this CRS.
  @xsd(name = "coordinateSystem") coordinate_system:     CoordinateSystemProperty?
  /// gml:engineeringDatum is an association role to the engineering datum used by this CRS.
  @xsd(name = "engineeringDatum") engineering_datum:     EngineeringDatumProperty

  record DomainOfValidity {
    @xsd(name = "EX_Extent") ex_extent:     gmd.EXExtent
    @xsd(attribute) type:          xlink.Type = simple
    @xsd(attribute) href:          string?
    @xsd(attribute) role:          string(min = 1)?
    @xsd(attribute) arcrole:       string(min = 1)?
    @xsd(attribute) title:         string?
    @xsd(attribute) show:          xlink.Show?
    @xsd(attribute) actuate:       xlink.Actuate?
    @xsd(name = "nilReason")
    @xsd(attribute)
    nil_reason:    string?
    @xsd(name = "remoteSchema")
    @xsd(attribute)
    remote_schema: string?
  }
}

record TimeIntervalLength {
  value:  decimal(38, 9)
  @xsd(attribute) unit:   string
  @xsd(attribute) radix:  int64(min = 1)?
  @xsd(attribute) factor: int32?
}

