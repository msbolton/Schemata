  /// UNDT000007-SC8
  /// SC
  /// Language. Identifier
  /// The identifier of the language used in the code name.
  /// Language
  /// Identification
  /// Identifier
  /// string
  @xsd(name = "languageID")
  @xsd(attribute)
  language_id:      string?
  /// UNDT000007-SC9
