@xsd(namespace = "urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2")
namespace ubl_common_extension_components_2_1

import ubl_unqualified_data_types_2_1
import ubl_common_basic_components_2_1
import ubl_common_signature_components_2_1

@xsd(name = "ExtensionContent")
record ExtensionContent {
  @xsd(any)
  @xsd(wildcard = "##other")
  any: string
}

/// A container for all extensions present in the document.
@xsd(name = "UBLExtensions")
record UBLExtensions {
  /// A single extension for private use.
  @xsd(name = "UBLExtension") ubl_extension: list<UBLExtension>(min = 1)
}

/// A single extension for private use.
@xsd(name = "UBLExtension")
record UBLExtension {
  /// An identifier for the Extension assigned by the creator of the extension.
  @xsd(name = "ID") id:                    ubl_common_basic_components_2_1.ID?
  /// A name for the Extension assigned by the creator of the extension.
  @xsd(name = "Name") name:                  ubl_common_basic_components_2_1.Name?
  /// An agency that maintains one or more Extensions.
  @xsd(name = "ExtensionAgencyID") extension_agency_id:   ExtensionAgencyID?
  /// The name of the agency that maintains the Extension.
  @xsd(name = "ExtensionAgencyName") extension_agency_name: ExtensionAgencyName?
  /// The version of the Extension.
  @xsd(name = "ExtensionVersionID") extension_version_id:  ExtensionVersionID?
  /// A URI for the Agency that maintains the Extension.
  @xsd(name = "ExtensionAgencyURI") extension_agency_uri:  ExtensionAgencyURI?
  /// A URI for the Extension.
  @xsd(name = "ExtensionURI") extension_uri:         ExtensionURI?
  /// A code for reason the Extension is being included.
  @xsd(name = "ExtensionReasonCode") extension_reason_code: ExtensionReasonCode?
  /// A description of the reason for the Extension.
  @xsd(name = "ExtensionReason") extension_reason:      ExtensionReason?
  /// The definition of the extension content.
  @xsd(name = "ExtensionContent") extension_content:     ExtensionContent
}

@xsd(name = "ExtensionAgencyID")
record ExtensionAgencyID {
  value:              string
  /// UNDT000011-SC2
  /// SC
  /// Identification Scheme. Identifier
  /// The identification of the identification scheme.
  /// Identification Scheme
  /// Identification
  /// Identifier
  /// string
  @xsd(name = "schemeID")
  @xsd(attribute)
  scheme_id:          string?
  /// UNDT000011-SC3
  /// SC
  /// Identification Scheme. Name. Text
  /// The name of the identification scheme.
  /// Identification Scheme
  /// Name
  /// Text
  /// string
  @xsd(name = "schemeName")
  @xsd(attribute)
  scheme_name:        string?
  /// UNDT000011-SC4
  /// SC
  /// Identification Scheme Agency. Identifier
  /// The identification of the agency that maintains the identification scheme.
  /// Identification Scheme Agency
  /// Identification
  /// Identifier
  /// string
  /// Defaults to the UN/EDIFACT data element 3055 code list.
  @xsd(name = "schemeAgencyID")
  @xsd(attribute)
  scheme_agency_id:   string?
  /// UNDT000011-SC5
  /// SC
  /// Identification Scheme Agency. Name. Text
  /// The name of the agency that maintains the identification scheme.
  /// Identification Scheme Agency
  /// Agency Name
  /// Text
  /// string
  @xsd(name = "schemeAgencyName")
  @xsd(attribute)
  scheme_agency_name: string?
  /// UNDT000011-SC6
  /// SC
  /// Identification Scheme. Version. Identifier
  /// The version of the identification scheme.
  /// Identification Scheme
  /// Version
  /// Identifier
  /// string
  @xsd(name = "schemeVersionID")
  @xsd(attribute)
  scheme_version_id:  string?
  /// UNDT000011-SC7
  /// SC
  /// Identification Scheme Data. Uniform Resource. Identifier
  /// The Uniform Resource Identifier that identifies where the identification scheme data is located.
  /// Identification Scheme Data
  /// Uniform Resource Identifier
  /// Identifier
  /// string
  @xsd(name = "schemeDataURI")
  @xsd(attribute)
  scheme_data_uri:    string?
  /// UNDT000011-SC8
  /// SC
  /// Identification Scheme. Uniform Resource. Identifier
  /// The Uniform Resource Identifier that identifies where the identification scheme is located.
  /// Identification Scheme
  /// Uniform Resource Identifier
  /// Identifier
  /// string
  @xsd(name = "schemeURI")
  @xsd(attribute)
  scheme_uri:         string?
}

@xsd(name = "ExtensionAgencyName")
record ExtensionAgencyName {
  value:              string
  /// UNDT000019-SC2
  /// SC
  /// Language. Identifier
  /// The identifier of the language used in the content component.
  /// Language
  /// Identification
  /// Identifier
  /// string
  @xsd(name = "languageID")
  @xsd(attribute)
  language_id:        string?
  /// UNDT000019-SC3
  /// SC
  /// Language. Locale. Identifier
  /// The identification of the locale of the language.
  /// Language
  /// Locale
  /// Identifier
  /// string
  @xsd(name = "languageLocaleID")
  @xsd(attribute)
  language_locale_id: string?
}

