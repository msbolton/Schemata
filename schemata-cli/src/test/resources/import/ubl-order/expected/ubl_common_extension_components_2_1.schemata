  language_locale_id string? @xsd(name: "languageLocaleID") @xsd(attribute)

  @@xsd(name: "ExtensionReason")
}

model ExtensionReasonCode {
  value            string
  /// UNDT000007-SC2
  /// SC
  /// Code List. Identifier
  /// The identification of a list of codes.
  /// Code List
  /// Identification
  /// Identifier
  /// string
  list_id          string? @xsd(name: "listID") @xsd(attribute)
  /// UNDT000007-SC3
  /// SC
  /// Code List. Agency. Identifier
  /// An agency that maintains one or more lists of codes.
  /// Code List
  /// Agency
  /// Identifier
  /// string
  /// Defaults to the UN/EDIFACT data element 3055 code list.
  list_agency_id   string? @xsd(name: "listAgencyID") @xsd(attribute)
  /// UNDT000007-SC4
  /// SC
  /// Code List. Agency Name. Text
  /// The name of the agency that maintains the list of codes.
  /// Code List
  /// Agency Name
  /// Text
  /// string
  list_agency_name string? @xsd(name: "listAgencyName") @xsd(attribute)
  /// UNDT000007-SC5
  /// SC
  /// Code List. Name. Text
  /// The name of a list of codes.
  /// Code List
  /// Name
  /// Text
  /// string
  list_name        string? @xsd(name: "listName") @xsd(attribute)
  /// UNDT000007-SC6
  /// SC
  /// Code List. Version. Identifier
  /// The version of the list of codes.
  /// Code List
  /// Version
  /// Identifier
  /// string
  list_version_id  string? @xsd(name: "listVersionID") @xsd(attribute)
  /// UNDT000007-SC7
  /// SC
  /// Code. Name. Text
  /// The textual equivalent of the code content component.
  /// Code
  /// Name
  /// Text
  /// string
  name             string? @xsd(attribute)
  /// UNDT000007-SC8
  /// SC
  /// Language. Identifier
  /// The identifier of the language used in the code name.
  /// Language
  /// Identification
  /// Identifier
  /// string
  language_id      string? @xsd(name: "languageID") @xsd(attribute)
  /// UNDT000007-SC9
  /// SC
  /// Code List. Uniform Resource. Identifier
  /// The Uniform Resource Identifier that identifies where the code list is located.
  /// Code List
  /// Uniform Resource Identifier
  /// Identifier
  /// string
  list_uri         string? @xsd(name: "listURI") @xsd(attribute)
  /// UNDT000007-SC10
  /// SC
  /// Code List Scheme. Uniform Resource. Identifier
  /// The Uniform Resource Identifier that identifies where the code list scheme is located.
  /// Code List Scheme
  /// Uniform Resource Identifier
  /// Identifier
  /// string
  list_scheme_uri  string? @xsd(name: "listSchemeURI") @xsd(attribute)

  @@xsd(name: "ExtensionReasonCode")
}

