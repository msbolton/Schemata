schema ubl_common_extension_components_2_1 @xsd(namespace: "urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2")

import ubl_unqualified_data_types_2_1
import ubl_common_basic_components_2_1
import ubl_common_signature_components_2_1

model ExtensionContent {
  any string @xsd(any) @xsd(wildcard: "##other")

  @@xsd(name: "ExtensionContent")
}

/// A container for all extensions present in the document.
model UBLExtensions {
  /// A single extension for private use.
  ubl_extension UBLExtension[] { minItems 1 } @xsd(name: "UBLExtension")

  @@xsd(name: "UBLExtensions")
}

/// A single extension for private use.
model UBLExtension {
  /// An identifier for the Extension assigned by the creator of the extension.
  id                    ubl_common_basic_components_2_1.ID?   @xsd(name: "ID")
  /// A name for the Extension assigned by the creator of the extension.
  name                  ubl_common_basic_components_2_1.Name? @xsd(name: "Name")
  /// An agency that maintains one or more Extensions.
  extension_agency_id   ExtensionAgencyID?                    @xsd(name: "ExtensionAgencyID")
  /// The name of the agency that maintains the Extension.
  extension_agency_name ExtensionAgencyName?                  @xsd(name: "ExtensionAgencyName")
  /// The version of the Extension.
  extension_version_id  ExtensionVersionID?                   @xsd(name: "ExtensionVersionID")
  /// A URI for the Agency that maintains the Extension.
  extension_agency_uri  ExtensionAgencyURI?                   @xsd(name: "ExtensionAgencyURI")
  /// A URI for the Extension.
  extension_uri         ExtensionURI?                         @xsd(name: "ExtensionURI")
  /// A code for reason the Extension is being included.
  extension_reason_code ExtensionReasonCode?                  @xsd(name: "ExtensionReasonCode")
  /// A description of the reason for the Extension.
  extension_reason      ExtensionReason?                      @xsd(name: "ExtensionReason")
  /// The definition of the extension content.
  extension_content     ExtensionContent                      @xsd(name: "ExtensionContent")

  @@xsd(name: "UBLExtension")
}

model ExtensionAgencyID {
  value              string
  /// UNDT000011-SC2
  /// SC
  /// Identification Scheme. Identifier
  /// The identification of the identification scheme.
  /// Identification Scheme
  /// Identification
  /// Identifier
  /// string
  scheme_id          string? @xsd(name: "schemeID") @xsd(attribute)
  /// UNDT000011-SC3
  /// SC
  /// Identification Scheme. Name. Text
  /// The name of the identification scheme.
  /// Identification Scheme
  /// Name
  /// Text
  /// string
  scheme_name        string? @xsd(name: "schemeName") @xsd(attribute)
  /// UNDT000011-SC4
  /// SC
  /// Identification Scheme Agency. Identifier
  /// The identification of the agency that maintains the identification scheme.
  /// Identification Scheme Agency
  /// Identification
  /// Identifier
  /// string
  /// Defaults to the UN/EDIFACT data element 3055 code list.
  scheme_agency_id   string? @xsd(name: "schemeAgencyID") @xsd(attribute)
  /// UNDT000011-SC5
  /// SC
  /// Identification Scheme Agency. Name. Text
  /// The name of the agency that maintains the identification scheme.
  /// Identification Scheme Agency
  /// Agency Name
  /// Text
  /// string
  scheme_agency_name string? @xsd(name: "schemeAgencyName") @xsd(attribute)
  /// UNDT000011-SC6
  /// SC
  /// Identification Scheme. Version. Identifier
  /// The version of the identification scheme.
  /// Identification Scheme
  /// Version
  /// Identifier
  /// string
  scheme_version_id  string? @xsd(name: "schemeVersionID") @xsd(attribute)
  /// UNDT000011-SC7
  /// SC
  /// Identification Scheme Data. Uniform Resource. Identifier
  /// The Uniform Resource Identifier that identifies where the identification scheme data is located.
  /// Identification Scheme Data
  /// Uniform Resource Identifier
  /// Identifier
  /// string
  scheme_data_uri    string? @xsd(name: "schemeDataURI") @xsd(attribute)
  /// UNDT000011-SC8
  /// SC
  /// Identification Scheme. Uniform Resource. Identifier
  /// The Uniform Resource Identifier that identifies where the identification scheme is located.
  /// Identification Scheme
  /// Uniform Resource Identifier
  /// Identifier
  /// string
  scheme_uri         string? @xsd(name: "schemeURI") @xsd(attribute)

  @@xsd(name: "ExtensionAgencyID")
}

model ExtensionAgencyName {
  value              string
  /// UNDT000019-SC2
  /// SC
  /// Language. Identifier
  /// The identifier of the language used in the content component.
  /// Language
  /// Identification
  /// Identifier
  /// string
  language_id        string? @xsd(name: "languageID") @xsd(attribute)
  /// UNDT000019-SC3
  /// SC
  /// Language. Locale. Identifier
  /// The identification of the locale of the language.
  /// Language
  /// Locale
  /// Identifier
  /// string
  language_locale_id string? @xsd(name: "languageLocaleID") @xsd(attribute)

  @@xsd(name: "ExtensionAgencyName")
}

