schema ubl_xmldsig_core_schema_2_1 @xsd(namespace: "http://www.w3.org/2000/09/xmldsig#")

model Signature {
  signed_info     SignedInfo     @xsd(name: "SignedInfo")
  signature_value SignatureValue @xsd(name: "SignatureValue")
  key_info        KeyInfo?       @xsd(name: "KeyInfo")
  object          Object[]       @xsd(name: "Object")
  id              string?        @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "Signature")
}

model SignatureValue {
  value bytes
  id    string? @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "SignatureValue")
}

model SignedInfo {
  canonicalization_method CanonicalizationMethod @xsd(name: "CanonicalizationMethod")
  signature_method        SignatureMethod        @xsd(name: "SignatureMethod")
  reference               Reference[]            { minItems 1 } @xsd(name: "Reference")
  id                      string?                @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "SignedInfo")
}

model CanonicalizationMethod {
  any       string[] @xsd(any) @xsd(process: "strict")
  text      string?  @xsd(mixed)
  algorithm string   @xsd(name: "Algorithm") @xsd(attribute)

  @@xsd(name: "CanonicalizationMethod")
}

model SignatureMethod {
  hmac_output_length int32?   @xsd(name: "HMACOutputLength")
  any                string[] @xsd(any) @xsd(process: "strict") @xsd(wildcard: "##other")
  text               string?  @xsd(mixed)
  algorithm          string   @xsd(name: "Algorithm") @xsd(attribute)

  @@xsd(name: "SignatureMethod")
}

model Reference {
  transforms    Transforms?  @xsd(name: "Transforms")
  digest_method DigestMethod @xsd(name: "DigestMethod")
  digest_value  bytes        @xsd(name: "DigestValue")
  id            string?      @xsd(name: "Id") @xsd(attribute)
  uri           string?      @xsd(name: "URI") @xsd(attribute)
  type          string?      @xsd(name: "Type") @xsd(attribute)

  @@xsd(name: "Reference")
}

model Transforms {
  transform Transform[] { minItems 1 } @xsd(name: "Transform")

  @@xsd(name: "Transforms")
}

model Transform {
  any       string[] @xsd(any) @xsd(wildcard: "##other")
  x_path    string[] @xsd(name: "XPath")
  text      string?  @xsd(mixed)
  algorithm string   @xsd(name: "Algorithm") @xsd(attribute)

  @@xsd(name: "Transform")
}

model DigestMethod {
  any       string[] @xsd(any) @xsd(wildcard: "##other")
  text      string?  @xsd(mixed)
  algorithm string   @xsd(name: "Algorithm") @xsd(attribute)

  @@xsd(name: "DigestMethod")
}

model KeyInfo {
  key_name         string[]          @xsd(name: "KeyName")
  key_value        KeyValue[]        @xsd(name: "KeyValue")
  retrieval_method RetrievalMethod[] @xsd(name: "RetrievalMethod")
  x509_data        X509Data[]        @xsd(name: "X509Data")
  pgp_data         PGPData[]         @xsd(name: "PGPData")
  spki_data        SPKIData[]        @xsd(name: "SPKIData")
  mgmt_data        string[]          @xsd(name: "MgmtData")
  any              string[]          @xsd(any) @xsd(wildcard: "##other")
  text             string?           @xsd(mixed)
  id               string?           @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "KeyInfo")
}

model KeyValue {
  dsa_key_value DSAKeyValue? @xsd(name: "DSAKeyValue")
  rsa_key_value RSAKeyValue? @xsd(name: "RSAKeyValue")
  any           string?      @xsd(any) @xsd(wildcard: "##other")
  text          string?      @xsd(mixed)

  @@xsd(name: "KeyValue")
}

model RetrievalMethod {
  transforms Transforms? @xsd(name: "Transforms")
  uri        string?     @xsd(name: "URI") @xsd(attribute)
  type       string?     @xsd(name: "Type") @xsd(attribute)

  @@xsd(name: "RetrievalMethod")
}

model X509Data {
  x509_issuer_serial X509IssuerSerial? @xsd(name: "X509IssuerSerial")
  x509_ski           bytes?            @xsd(name: "X509SKI")
  x509_subject_name  string?           @xsd(name: "X509SubjectName")
  x509_certificate   bytes?            @xsd(name: "X509Certificate")
  x509_crl           bytes?            @xsd(name: "X509CRL")
  any                string?           @xsd(any) @xsd(wildcard: "##other")

  @@xsd(name: "X509Data")
}

model X509IssuerSerial {
  x509_issuer_name   string @xsd(name: "X509IssuerName")
  x509_serial_number int32  @xsd(name: "X509SerialNumber")

  @@xsd(root: false)
}

union PGPData = PGPKeyIDGroup | PGPKeyPacketGroup

model PGPKeyIDGroup {
  pgp_key_id     bytes    @xsd(name: "PGPKeyID")
  pgp_key_packet bytes?   @xsd(name: "PGPKeyPacket")
  any            string[] @xsd(any) @xsd(wildcard: "##other")

  @@xsd(root: false)
}

model PGPKeyPacketGroup {
  pgp_key_packet bytes    @xsd(name: "PGPKeyPacket")
  any            string[] @xsd(any) @xsd(wildcard: "##other")

  @@xsd(root: false)
}

model SPKIData {
  spki_sexp bytes   @xsd(name: "SPKISexp")
  any       string? @xsd(any) @xsd(wildcard: "##other")

  @@xsd(name: "SPKIData")
}

model Object {
  any       string  @xsd(any)
  text      string? @xsd(mixed)
  id        string? @xsd(name: "Id") @xsd(attribute)
  mime_type string? @xsd(name: "MimeType") @xsd(attribute)
  encoding  string? @xsd(name: "Encoding") @xsd(attribute)

  @@xsd(name: "Object")
}

model Manifest {
  reference Reference[] { minItems 1 } @xsd(name: "Reference")
  id        string?     @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "Manifest")
}

model SignatureProperties {
  signature_property SignatureProperty[] { minItems 1 } @xsd(name: "SignatureProperty")
  id                 string?             @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "SignatureProperties")
}

model SignatureProperty {
  any    string[] { minItems 1 } @xsd(any) @xsd(wildcard: "##other")
  text   string?  @xsd(mixed)
  target string   @xsd(name: "Target") @xsd(attribute)
  id     string?  @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "SignatureProperty")
}

model DSAKeyValue {
  p_group    PGroup?
  g          bytes?     @xsd(name: "G")
  y          bytes      @xsd(name: "Y")
  j          bytes?     @xsd(name: "J")
  seed_group SeedGroup?

  model PGroup { p bytes @xsd(name: "P")  q bytes @xsd(name: "Q") }

  model SeedGroup { seed bytes @xsd(name: "Seed")  pgen_counter bytes @xsd(name: "PgenCounter") }

  @@xsd(name: "DSAKeyValue")
}

model RSAKeyValue {
  modulus  bytes @xsd(name: "Modulus")
  exponent bytes @xsd(name: "Exponent")

  @@xsd(name: "RSAKeyValue")
}
