schema ubl_x_ad_e_sv132_2_1 @xsd(namespace: "http://uri.etsi.org/01903/v1.3.2#")

import ubl_xmldsig_core_schema_2_1

model Any {
  any        string              @xsd(any)
  text       string?             @xsd(mixed)
  attributes map<string, string> @xsd(any_attribute) @xsd(process: "strict")

  @@xsd(name: "Any")
}

model ObjectIdentifier {
  identifier               Identifier               @xsd(name: "Identifier")
  description              string?                  @xsd(name: "Description")
  documentation_references DocumentationReferences? @xsd(name: "DocumentationReferences")

  @@xsd(name: "ObjectIdentifier")
}

model Identifier {
  value     string
  qualifier Qualifier? @xsd(name: "Qualifier") @xsd(attribute)

  @@xsd(root: false)
}

enum Qualifier { @xsd(name: "OIDAsURI") oid_as_uri @xsd(name: "OIDAsURN") oid_as_urn }

model DocumentationReferences {
  documentation_reference string @xsd(name: "DocumentationReference")

  @@xsd(root: false)
}

model EncapsulatedPKIData {
  value    bytes
  id       string? @xsd(name: "Id") @xsd(attribute)
  encoding string? @xsd(name: "Encoding") @xsd(attribute)

  @@xsd(name: "EncapsulatedPKIData")
}

model Include {
  uri             string @xsd(name: "URI") @xsd(attribute)
  referenced_data bool?  @xsd(name: "referencedData") @xsd(attribute)

  @@xsd(name: "Include")
}

model ReferenceInfo {
  digest_method ubl_xmldsig_core_schema_2_1.DigestMethod @xsd(name: "DigestMethod")
  digest_value  bytes                                    @xsd(name: "DigestValue")
  id            string?                                  @xsd(name: "Id") @xsd(attribute)
  uri           string?                                  @xsd(name: "URI") @xsd(attribute)

  @@xsd(name: "ReferenceInfo")
}

union GenericTimeStamp = XAdESTimeStamp | OtherTimeStamp

model XAdESTimeStamp {
  include                 Include[]                                           @xsd(name: "Include")
  canonicalization_method ubl_xmldsig_core_schema_2_1.CanonicalizationMethod? @xsd(name: "CanonicalizationMethod")
  choice                  XAdESTimeStampChoice[]                              { minItems 1 }
  id                      string?                                             @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "XAdESTimeStamp")
}

union XAdESTimeStampChoice = EncapsulatedPKIData | Any

model OtherTimeStamp {
  reference_info          ReferenceInfo[]                                     { minItems 1 } @xsd(name: "ReferenceInfo")
  canonicalization_method ubl_xmldsig_core_schema_2_1.CanonicalizationMethod? @xsd(name: "CanonicalizationMethod")
  choice                  OtherTimeStampChoice
  id                      string?                                             @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "OtherTimeStamp")
}

union OtherTimeStampChoice = EncapsulatedPKIData | Any

model QualifyingProperties {
  signed_properties   SignedProperties?   @xsd(name: "SignedProperties")
  unsigned_properties UnsignedProperties? @xsd(name: "UnsignedProperties")
  target              string              @xsd(name: "Target") @xsd(attribute)
  id                  string?             @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "QualifyingProperties")
}

model SignedProperties {
  signed_signature_properties   SignedSignatureProperties?  @xsd(name: "SignedSignatureProperties")
  signed_data_object_properties SignedDataObjectProperties? @xsd(name: "SignedDataObjectProperties")
  id                            string?                     @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "SignedProperties")
}

model UnsignedProperties {
  unsigned_signature_properties   UnsignedSignatureProperties?  @xsd(name: "UnsignedSignatureProperties")
  unsigned_data_object_properties UnsignedDataObjectProperties? @xsd(name: "UnsignedDataObjectProperties")
  id                              string?                       @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "UnsignedProperties")
}

model SignedSignatureProperties {
  signing_time                instant?                   @xsd(name: "SigningTime")
  signing_certificate         CertIDList?                @xsd(name: "SigningCertificate")
  signature_policy_identifier SignaturePolicyIdentifier? @xsd(name: "SignaturePolicyIdentifier")
  signature_production_place  SignatureProductionPlace?  @xsd(name: "SignatureProductionPlace")
  signer_role                 SignerRole?                @xsd(name: "SignerRole")
  id                          string?                    @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "SignedSignatureProperties")
}

model SignedDataObjectProperties {
  data_object_format                 DataObjectFormat[]         @xsd(name: "DataObjectFormat")
  commitment_type_indication         CommitmentTypeIndication[] @xsd(name: "CommitmentTypeIndication")
  all_data_objects_time_stamp        XAdESTimeStamp[]           @xsd(name: "AllDataObjectsTimeStamp")
  individual_data_objects_time_stamp XAdESTimeStamp[]           @xsd(name: "IndividualDataObjectsTimeStamp")
  id                                 string?                    @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "SignedDataObjectProperties")
}

model UnsignedSignatureProperties {
  choice UnsignedSignaturePropertiesChoice[] { minItems 1 }
  id     string?                             @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "UnsignedSignatureProperties")
}

model SignatureTimeStamp {
  value XAdESTimeStamp

  @@xsd(root: false)
}

model CompleteCertificateRefs2 {
  value CompleteCertificateRefs

  @@xsd(root: false)
}

model CompleteRevocationRefs2 {
  value CompleteRevocationRefs

  @@xsd(root: false)
}

model AttributeCertificateRefs {
  value CompleteCertificateRefs

  @@xsd(root: false)
}

model AttributeRevocationRefs {
  value CompleteRevocationRefs

  @@xsd(root: false)
}

model SigAndRefsTimeStamp {
  value XAdESTimeStamp

  @@xsd(root: false)
}

model RefsOnlyTimeStamp {
  value XAdESTimeStamp

  @@xsd(root: false)
}

model CertificateValues2 {
  value CertificateValues

  @@xsd(root: false)
}

model RevocationValues2 {
  value RevocationValues

  @@xsd(root: false)
}

model AttrAuthoritiesCertValues {
  value CertificateValues

  @@xsd(root: false)
}

model AttributeRevocationValues {
  value RevocationValues

  @@xsd(root: false)
}

model ArchiveTimeStamp {
  value XAdESTimeStamp

  @@xsd(root: false)
}

union UnsignedSignaturePropertiesChoice =
  CounterSignature |
  SignatureTimeStamp |
  CompleteCertificateRefs2 |
  CompleteRevocationRefs2 |
  AttributeCertificateRefs |
  AttributeRevocationRefs |
  SigAndRefsTimeStamp |
  RefsOnlyTimeStamp |
  CertificateValues2 |
  RevocationValues2 |
  AttrAuthoritiesCertValues |
  AttributeRevocationValues |
  ArchiveTimeStamp

model UnsignedDataObjectProperties {
  unsigned_data_object_property Any[]   { minItems 1 } @xsd(name: "UnsignedDataObjectProperty")
  id                            string? @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "UnsignedDataObjectProperties")
}

model QualifyingPropertiesReference {
  uri string  @xsd(name: "URI") @xsd(attribute)
  id  string? @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "QualifyingPropertiesReference")
}

model CertIDList { cert CertID[] { minItems 1 } @xsd(name: "Cert") }

model CertID {
  cert_digest   DigestAlgAndValue                            @xsd(name: "CertDigest")
  issuer_serial ubl_xmldsig_core_schema_2_1.X509IssuerSerial @xsd(name: "IssuerSerial")
  uri           string?                                      @xsd(name: "URI") @xsd(attribute)

  @@xsd(root: false)
}

model DigestAlgAndValue {
  digest_method ubl_xmldsig_core_schema_2_1.DigestMethod @xsd(name: "DigestMethod")
  digest_value  bytes                                    @xsd(name: "DigestValue")

  @@xsd(root: false)
}

union SignaturePolicyIdentifier = SignaturePolicyId | string

model SignaturePolicyId {
  sig_policy_id         ObjectIdentifier                        @xsd(name: "SigPolicyId")
  transforms            ubl_xmldsig_core_schema_2_1.Transforms? @xsd(name: "Transforms")
  sig_policy_hash       DigestAlgAndValue                       @xsd(name: "SigPolicyHash")
  sig_policy_qualifiers SigPolicyQualifiersList?                @xsd(name: "SigPolicyQualifiers")

  @@xsd(root: false)
}

model SigPolicyQualifiersList {
  sig_policy_qualifier Any[] { minItems 1 } @xsd(name: "SigPolicyQualifier")

  @@xsd(root: false)
}

model SPUserNotice {
  notice_ref    NoticeReference? @xsd(name: "NoticeRef")
  explicit_text string?          @xsd(name: "ExplicitText")

  @@xsd(name: "SPUserNotice")
}

model NoticeReference {
  organization   string      @xsd(name: "Organization")
  notice_numbers IntegerList @xsd(name: "NoticeNumbers")

  @@xsd(root: false)
}

model IntegerList {
  int int32[]

  @@xsd(root: false)
}

model CounterSignature {
  signature ubl_xmldsig_core_schema_2_1.Signature @xsd(name: "Signature")

  @@xsd(name: "CounterSignature")
}

model DataObjectFormat {
  description       string?           @xsd(name: "Description")
  object_identifier ObjectIdentifier? @xsd(name: "ObjectIdentifier")
  mime_type         string?           @xsd(name: "MimeType")
  encoding          string?           @xsd(name: "Encoding")
  object_reference  string            @xsd(name: "ObjectReference") @xsd(attribute)

  @@xsd(name: "DataObjectFormat")
}

model CommitmentTypeIndication {
  commitment_type_id         ObjectIdentifier              @xsd(name: "CommitmentTypeId")
  object_reference           string[]                      @xsd(name: "ObjectReference")
  all_signed_data_objects    string?                       @xsd(name: "AllSignedDataObjects") @xsd(any_type)
  commitment_type_qualifiers CommitmentTypeQualifiersList? @xsd(name: "CommitmentTypeQualifiers")

  @@xsd(name: "CommitmentTypeIndication")
}

model CommitmentTypeQualifiersList {
  commitment_type_qualifier Any[] @xsd(name: "CommitmentTypeQualifier")

  @@xsd(root: false)
}

model SignatureProductionPlace {
  city              string? @xsd(name: "City")
  state_or_province string? @xsd(name: "StateOrProvince")
  postal_code       string? @xsd(name: "PostalCode")
  country_name      string? @xsd(name: "CountryName")

  @@xsd(name: "SignatureProductionPlace")
}

model SignerRole {
  claimed_roles   ClaimedRolesList?   @xsd(name: "ClaimedRoles")
  certified_roles CertifiedRolesList? @xsd(name: "CertifiedRoles")

  @@xsd(name: "SignerRole")
}

model ClaimedRolesList {
  claimed_role Any[] { minItems 1 } @xsd(name: "ClaimedRole")

  @@xsd(root: false)
}

model CertifiedRolesList {
  certified_role EncapsulatedPKIData[] { minItems 1 } @xsd(name: "CertifiedRole")

  @@xsd(root: false)
}

model CompleteCertificateRefs {
  cert_refs CertIDList @xsd(name: "CertRefs")
  id        string?    @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "CompleteCertificateRefs")
}

model CompleteRevocationRefs {
  crl_refs   CRLRefs?             @xsd(name: "CRLRefs")
  ocsp_refs  OCSPRefs?            @xsd(name: "OCSPRefs")
  other_refs OtherCertStatusRefs? @xsd(name: "OtherRefs")
  id         string?              @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "CompleteRevocationRefs")
}

model CRLRefs {
  crl_ref CRLRef[] { minItems 1 } @xsd(name: "CRLRef")

  @@xsd(root: false)
}

model CRLRef {
  digest_alg_and_value DigestAlgAndValue @xsd(name: "DigestAlgAndValue")
  crl_identifier       CRLIdentifier?    @xsd(name: "CRLIdentifier")

  @@xsd(root: false)
}

model CRLIdentifier {
  issuer     string  @xsd(name: "Issuer")
  issue_time instant @xsd(name: "IssueTime")
  number     int32?  @xsd(name: "Number")
  uri        string? @xsd(name: "URI") @xsd(attribute)

  @@xsd(root: false)
}

model OCSPRefs {
  ocsp_ref OCSPRef[] { minItems 1 } @xsd(name: "OCSPRef")

  @@xsd(root: false)
}

model OCSPRef {
  ocsp_identifier      OCSPIdentifier     @xsd(name: "OCSPIdentifier")
  digest_alg_and_value DigestAlgAndValue? @xsd(name: "DigestAlgAndValue")

  @@xsd(root: false)
}

union ResponderID = string | bytes

model OCSPIdentifier {
  responder_id ResponderID @xsd(name: "ResponderID")
  produced_at  instant     @xsd(name: "ProducedAt")
  uri          string?     @xsd(name: "URI") @xsd(attribute)

  @@xsd(root: false)
}

model OtherCertStatusRefs {
  other_ref Any[] { minItems 1 } @xsd(name: "OtherRef")

  @@xsd(root: false)
}

model CertificateValues {
  choice CertificateValuesChoice[]
  id     string?                   @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "CertificateValues")
}

union CertificateValuesChoice = EncapsulatedPKIData | Any

model RevocationValues {
  crl_values   CRLValues?             @xsd(name: "CRLValues")
  ocsp_values  OCSPValues?            @xsd(name: "OCSPValues")
  other_values OtherCertStatusValues? @xsd(name: "OtherValues")
  id           string?                @xsd(name: "Id") @xsd(attribute)

  @@xsd(name: "RevocationValues")
}

model CRLValues {
  encapsulated_crl_value EncapsulatedPKIData[] { minItems 1 } @xsd(name: "EncapsulatedCRLValue")

  @@xsd(root: false)
}

model OCSPValues {
  encapsulated_ocsp_value EncapsulatedPKIData[] { minItems 1 } @xsd(name: "EncapsulatedOCSPValue")

  @@xsd(root: false)
}

model OtherCertStatusValues {
  other_value Any[] { minItems 1 } @xsd(name: "OtherValue")

  @@xsd(root: false)
}
