schema ubl_unqualified_data_types_2_1 @xsd(namespace: "urn:oasis:names:specification:ubl:schema:xsd:UnqualifiedDataTypes-2")

import ccts_cct_schema_module_2_1

/// UBLUDT000001
/// UDT
/// Amount. Type
/// 1.0
/// A number of monetary units specified using a given unit of currency.
/// Amount
model Amount {
  value                         decimal(38, 9)
  /// UNDT000001-SC2
  /// SC
  /// Amount. Currency. Identifier
  /// The currency of the amount.
  /// Amount Currency
  /// Identification
  /// Identifier
  /// string
  /// Reference UNECE Rec 9, using 3-letter alphabetic codes.
  currency_id                   string         @xsd(name: "currencyID") @xsd(attribute)
  /// UNDT000001-SC3
  /// SC
  /// Amount Currency. Code List Version. Identifier
  /// The VersionID of the UN/ECE Rec9 code list.
  /// Amount Currency
  /// Code List Version
  /// Identifier
  /// string
  currency_code_list_version_id string?        @xsd(name: "currencyCodeListVersionID") @xsd(attribute)

  @@xsd(root: false)
}

/// UBLUDT000002
/// UDT
/// Binary Object. Type
/// 1.0
/// A set of finite-length sequences of binary octets.
/// Binary Object
/// binary
model BinaryObject {
  value              bytes
  /// UNDT000002-SC3
  /// SC
  /// Binary Object. Mime. Code
  /// The mime type of the binary object.
  /// Binary Object
  /// Mime
  /// Code
  /// string
  mime_code          string  @xsd(name: "mimeCode") @xsd(attribute)
  /// UNDT000002-SC2
  /// SC
  /// Binary Object. Format. Text
  /// The format of the binary content.
  /// Binary Object
  /// Format
  /// Text
  /// string
  format             string? @xsd(attribute)
  /// UNDT000002-SC4
  /// SC
  /// Binary Object. Encoding. Code
  /// Specifies the decoding algorithm of the binary object.
  /// Binary Object
  /// Encoding
  /// Code
  /// string
  encoding_code      string? @xsd(name: "encodingCode") @xsd(attribute)
  /// UNDT000002-SC5
  /// SC
  /// Binary Object. Character Set. Code
  /// The character set of the binary object if the mime type is text.
  /// Binary Object
  /// Character Set
  /// Code
  /// string
  character_set_code string? @xsd(name: "characterSetCode") @xsd(attribute)
  /// UNDT000002-SC6
  /// SC
  /// Binary Object. Uniform Resource. Identifier
  /// The Uniform Resource Identifier that identifies where the binary object is located.
  /// Binary Object
  /// Uniform Resource Identifier
  /// Identifier
  /// string
  uri                string? @xsd(attribute)
  /// UNDT000002-SC7
  /// SC
  /// Binary Object. Filename.Text
  /// The filename of the binary object.
  /// Binary Object
  /// Filename
  /// Text
  /// string
  filename           string? @xsd(attribute)

  @@xsd(root: false)
}

/// UBLUDT000003
/// UDT
/// Graphic. Type
/// 1.0
/// A diagram, graph, mathematical curve, or similar representation.
/// Graphic
/// binary
model Graphic {
  value              bytes
  /// UNDT000003-SC3
  /// SC
  /// Graphic. Mime. Code
  /// The mime type of the graphic object.
  /// Graphic
  /// Mime
  /// Code
  /// normalizedString
  mime_code          string  @xsd(name: "mimeCode") @xsd(attribute)
  /// UNDT000002-SC2
  /// SC
  /// Binary Object. Format. Text
  /// The format of the binary content.
  /// Binary Object
  /// Format
  /// Text
  /// string
  format             string? @xsd(attribute)
  /// UNDT000002-SC4
  /// SC
  /// Binary Object. Encoding. Code
  /// Specifies the decoding algorithm of the binary object.
  /// Binary Object
  /// Encoding
  /// Code
  /// string
  encoding_code      string? @xsd(name: "encodingCode") @xsd(attribute)
  /// UNDT000002-SC5
  /// SC
  /// Binary Object. Character Set. Code
  /// The character set of the binary object if the mime type is text.
  /// Binary Object
  /// Character Set
  /// Code
  /// string
  character_set_code string? @xsd(name: "characterSetCode") @xsd(attribute)
  /// UNDT000002-SC6
  /// SC
  /// Binary Object. Uniform Resource. Identifier
  /// The Uniform Resource Identifier that identifies where the binary object is located.
  /// Binary Object
  /// Uniform Resource Identifier
  /// Identifier
  /// string
  uri                string? @xsd(attribute)
  /// UNDT000002-SC7
  /// SC
  /// Binary Object. Filename.Text
  /// The filename of the binary object.
  /// Binary Object
  /// Filename
  /// Text
  /// string
  filename           string? @xsd(attribute)

  @@xsd(root: false)
}

