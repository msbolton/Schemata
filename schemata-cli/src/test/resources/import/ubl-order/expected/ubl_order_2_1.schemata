  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  @xsd(name = "RequestedInvoiceCurrencyCode") requested_invoice_currency_code: ubl_common_basic_components_2_1.RequestedInvoiceCurrencyCode?
  /// BBIE
