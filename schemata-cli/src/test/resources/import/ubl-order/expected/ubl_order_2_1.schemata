  /// 0..n
  /// Order
  /// Delivery Terms
  /// Delivery Terms
  /// Delivery Terms
  @xsd(name = "DeliveryTerms") delivery_terms:                  list<ubl_common_aggregate_components_2_1.DeliveryTerms>
  /// ASBIE
