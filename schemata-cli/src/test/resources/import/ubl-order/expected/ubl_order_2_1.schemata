  /// 0..1
  /// Order
  /// Copy
  /// Indicator
  /// Indicator
  /// Indicator. Type
  @xsd(name = "CopyIndicator") copy_indicator:                  ubl_common_basic_components_2_1.CopyIndicator?
  /// BBIE
