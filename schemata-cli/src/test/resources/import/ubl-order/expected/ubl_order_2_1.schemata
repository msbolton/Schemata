  /// 0..1
  /// Order
  /// Catalogue Reference
  /// Catalogue Reference
  /// Catalogue Reference
  @xsd(name = "CatalogueReference") catalogue_reference:             ubl_common_aggregate_components_2_1.CatalogueReference?
  /// ASBIE
