schema ubl_order_2_1 @xsd(namespace: "urn:oasis:names:specification:ubl:schema:xsd:Order-2")

import ubl_common_aggregate_components_2_1
import ubl_common_basic_components_2_1
import ubl_common_extension_components_2_1

/// ABIE
/// Order. Details
/// A document used to order goods and services.
/// Order
/// Purchase Order
model Order {
  /// A container for all extensions present in the document.
  ubl_extensions                  ubl_common_extension_components_2_1.UBLExtensions?            @xsd(name: "UBLExtensions")
  /// BBIE
  /// Order. UBL Version Identifier. Identifier
  /// Identifies the earliest version of the UBL 2 schema for this document type that defines all of the elements that might be encountered in the current instance.
  /// 0..1
  /// Order
  /// UBL Version Identifier
  /// Identifier
  /// Identifier. Type
  /// 2.0.5
  ubl_version_id                  ubl_common_basic_components_2_1.UBLVersionID?                 @xsd(name: "UBLVersionID")
  /// BBIE
  /// Order. Customization Identifier. Identifier
  /// Identifies a user-defined customization of UBL for a specific use.
  /// 0..1
  /// Order
  /// Customization Identifier
  /// Identifier
  /// Identifier. Type
  /// NES
  customization_id                ubl_common_basic_components_2_1.CustomizationID?              @xsd(name: "CustomizationID")
  /// BBIE
  /// Order. Profile Identifier. Identifier
  /// Identifies a user-defined profile of the customization of UBL being used.
  /// 0..1
  /// Order
  /// Profile Identifier
  /// Identifier
  /// Identifier. Type
  /// BasicProcurementProcess
  profile_id                      ubl_common_basic_components_2_1.ProfileID?                    @xsd(name: "ProfileID")
  /// BBIE
  /// Order. Profile Execution Identifier. Identifier
  /// Identifies an instance of executing a profile, to associate all transactions in a collaboration.
  /// 0..1
  /// Order
  /// Profile Execution Identifier
  /// Identifier
  /// Identifier. Type
  /// BPP-1001
  profile_execution_id            ubl_common_basic_components_2_1.ProfileExecutionID?           @xsd(name: "ProfileExecutionID")
  /// BBIE
  /// Order. Identifier
  /// An identifier for this document, assigned by the sender.
  /// 1
  /// Order
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// Purchase Order Number, Order Number
  id                              ubl_common_basic_components_2_1.ID                            @xsd(name: "ID")
  /// BBIE
  /// Order. Sales_ Order Identifier. Identifier
  /// An identifier for the Order, assigned by the seller.
  /// 0..1
  /// Order
  /// Sales
  /// Order Identifier
  /// Identifier
  /// Identifier. Type
  sales_order_id                  ubl_common_basic_components_2_1.SalesOrderID?                 @xsd(name: "SalesOrderID")
  /// BBIE
  /// Order. Copy_ Indicator. Indicator
  /// Indicates whether this document is a copy (true) or not (false).
  /// 0..1
  /// Order
  /// Copy
  /// Indicator
  /// Indicator
  /// Indicator. Type
  copy_indicator                  ubl_common_basic_components_2_1.CopyIndicator?                @xsd(name: "CopyIndicator")
  /// BBIE
  /// Order. UUID. Identifier
  /// A universally unique identifier for an instance of this document.
  /// 0..1
  /// Order
  /// UUID
  /// Identifier
  /// Identifier. Type
  uuid                            ubl_common_basic_components_2_1.UUID?                         @xsd(name: "UUID")
  /// BBIE
  /// Order. Issue Date. Date
  /// The date, assigned by the sender, on which this document was issued.
  /// 1
  /// Order
  /// Issue Date
  /// Date
  /// Date. Type
  /// Order Date
  issue_date                      ubl_common_basic_components_2_1.IssueDate                     @xsd(name: "IssueDate")
  /// BBIE
  /// Order. Issue Time. Time
  /// The time, assigned by the sender, at which this document was issued.
  /// 0..1
  /// Order
  /// Issue Time
  /// Time
  /// Time. Type
  issue_time                      ubl_common_basic_components_2_1.IssueTime?                    @xsd(name: "IssueTime")
  /// BBIE
  /// Order. Order Type Code. Code
  /// A code signifying the type of Order.
  /// 0..1
  /// Order
  /// Order Type Code
  /// Code
  /// Code. Type
  order_type_code                 ubl_common_basic_components_2_1.OrderTypeCode?                @xsd(name: "OrderTypeCode")
  /// BBIE
  /// Order. Note. Text
  /// Free-form text pertinent to this document, conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Order
  /// Note
  /// Text
  /// Text. Type
  note                            ubl_common_basic_components_2_1.Note[]                        @xsd(name: "Note")
  /// BBIE
  /// Order. Requested Invoice_ Currency Code. Code
  /// A code signifying the currency requested for amount totals in Invoices related to this Order.
  /// 0..1
  /// Order
  /// Requested Invoice
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  requested_invoice_currency_code ubl_common_basic_components_2_1.RequestedInvoiceCurrencyCode? @xsd(name: "RequestedInvoiceCurrencyCode")
  /// BBIE
  /// Order. Document_ Currency Code. Code
  /// A code signifying the default currency for this document.
  /// 0..1
  /// Order
  /// Document
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  document_currency_code          ubl_common_basic_components_2_1.DocumentCurrencyCode?         @xsd(name: "DocumentCurrencyCode")
  /// BBIE
  /// Order. Pricing_ Currency Code. Code
  /// A code signifying the currency used for all prices in the Order.
  /// 0..1
  /// Order
  /// Pricing
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  pricing_currency_code           ubl_common_basic_components_2_1.PricingCurrencyCode?          @xsd(name: "PricingCurrencyCode")
  /// BBIE
  /// Order. Tax_ Currency Code. Code
  /// A code signifying the currency requested for tax amounts in Invoices related to this Order.
  /// 0..1
  /// Order
  /// Tax
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  tax_currency_code               ubl_common_basic_components_2_1.TaxCurrencyCode?              @xsd(name: "TaxCurrencyCode")
  /// BBIE
  /// Order. Customer_ Reference. Text
  /// A supplementary reference for the Order.
  /// 0..1
  /// Order
  /// Customer
  /// Reference
  /// Text
  /// Text. Type
  customer_reference              ubl_common_basic_components_2_1.CustomerReference?            @xsd(name: "CustomerReference")
  /// BBIE
  /// Order. Accounting Cost Code. Code
  /// The buyer's accounting code, applied to the Order as a whole.
  /// 0..1
  /// Order
  /// Accounting Cost Code
  /// Code
  /// Code. Type
  accounting_cost_code            ubl_common_basic_components_2_1.AccountingCostCode?           @xsd(name: "AccountingCostCode")
  /// BBIE
  /// Order. Accounting Cost. Text
  /// The buyer's accounting cost centre, applied to the Order as a whole, expressed as text.
  /// 0..1
  /// Order
  /// Accounting Cost
  /// Text
  /// Text. Type
  accounting_cost                 ubl_common_basic_components_2_1.AccountingCost?               @xsd(name: "AccountingCost")
