  /// 0..n
  /// Order
  /// Order
  /// Document Reference
  /// Document Reference
  /// Document Reference
  @xsd(name = "OrderDocumentReference") order_document_reference:        list<ubl_common_aggregate_components_2_1.DocumentReference>
  /// ASBIE
  /// Order. Originator_ Document Reference. Document Reference
