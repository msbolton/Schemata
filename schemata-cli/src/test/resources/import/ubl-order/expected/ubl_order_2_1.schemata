  /// 0..1
  /// Order
  /// Pricing
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  @xsd(name = "PricingCurrencyCode") pricing_currency_code:           ubl_common_basic_components_2_1.PricingCurrencyCode?
  /// BBIE
  /// Order. Tax_ Currency Code. Code
  /// A code signifying the currency requested for tax amounts in Invoices related to this Order.
  /// 0..1
  /// Order
  /// Tax
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  @xsd(name = "TaxCurrencyCode") tax_currency_code:               ubl_common_basic_components_2_1.TaxCurrencyCode?
