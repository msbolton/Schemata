  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  @xsd(name = "DocumentCurrencyCode") document_currency_code:          ubl_common_basic_components_2_1.DocumentCurrencyCode?
  /// BBIE
