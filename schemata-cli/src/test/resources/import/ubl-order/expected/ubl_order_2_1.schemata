  /// 0..1
  /// Order
  /// UBL Version Identifier
  /// Identifier
  /// Identifier. Type
  /// 2.0.5
  @xsd(name = "UBLVersionID") ubl_version_id:                  ubl_common_basic_components_2_1.UBLVersionID?
  /// BBIE
