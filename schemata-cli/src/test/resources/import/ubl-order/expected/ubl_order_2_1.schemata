  /// 1
  /// Order
  /// Issue Date
  /// Date
  /// Date. Type
  /// Order Date
  @xsd(name = "IssueDate") issue_date:                      ubl_common_basic_components_2_1.IssueDate
  /// BBIE
  /// Order. Issue Time. Time
  /// The time, assigned by the sender, at which this document was issued.
  /// 0..1
  /// Order
  /// Issue Time
  /// Time
  /// Time. Type
  @xsd(name = "IssueTime") issue_time:                      ubl_common_basic_components_2_1.IssueTime?
  /// BBIE
