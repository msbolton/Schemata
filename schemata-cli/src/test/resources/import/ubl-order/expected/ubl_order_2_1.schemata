  /// 0..1
  /// Order
  /// Sales
  /// Order Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "SalesOrderID") sales_order_id:                  ubl_common_basic_components_2_1.SalesOrderID?
  /// BBIE
