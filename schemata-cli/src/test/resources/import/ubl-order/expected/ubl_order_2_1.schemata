  /// 0..1
  /// Order
  /// Customer
  /// Reference
  /// Text
  /// Text. Type
  @xsd(name = "CustomerReference") customer_reference:              ubl_common_basic_components_2_1.CustomerReference?
  /// BBIE
  /// Order. Accounting Cost Code. Code
