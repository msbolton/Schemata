  @xsd(name = "ProjectReference") project_reference:               list<ubl_common_aggregate_components_2_1.ProjectReference>
  /// ASBIE
  /// Order. Signature
  /// A signature applied to this document.
  /// 0..n
  /// Order
  /// Signature
  /// Signature
  /// Signature
  @xsd(name = "Signature") signature:                       list<ubl_common_aggregate_components_2_1.Signature>
  /// ASBIE
  /// Order. Buyer_ Customer Party. Customer Party
  /// The buyer.
  /// 1
  /// Order
  /// Buyer
  /// Customer Party
  /// Customer Party
  /// Customer Party
  @xsd(name = "BuyerCustomerParty") buyer_customer_party:            ubl_common_aggregate_components_2_1.CustomerParty
  /// ASBIE
