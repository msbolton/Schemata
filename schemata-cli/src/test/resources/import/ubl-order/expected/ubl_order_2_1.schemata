  /// 0..n
  /// Order
  /// Validity
  /// Period
  /// Period
  /// Period
  validity_period                 ubl_common_aggregate_components_2_1.Period[]                  @xsd(name: "ValidityPeriod")
  /// ASBIE
  /// Order. Quotation_ Document Reference. Document Reference
  /// A reference to a Quotation.
  /// 0..1
  /// Order
  /// Quotation
  /// Document Reference
  /// Document Reference
  /// Document Reference
  quotation_document_reference    ubl_common_aggregate_components_2_1.DocumentReference?        @xsd(name: "QuotationDocumentReference")
  /// ASBIE
  /// Order. Order_ Document Reference. Document Reference
  /// A reference to another Order.
  /// 0..n
  /// Order
  /// Order
  /// Document Reference
  /// Document Reference
  /// Document Reference
  order_document_reference        ubl_common_aggregate_components_2_1.DocumentReference[]       @xsd(name: "OrderDocumentReference")
  /// ASBIE
  /// Order. Originator_ Document Reference. Document Reference
  /// A reference to an originator document associated with this document.
  /// 0..1
  /// Order
  /// Originator
  /// Document Reference
  /// Document Reference
  /// Document Reference
  originator_document_reference   ubl_common_aggregate_components_2_1.DocumentReference?        @xsd(name: "OriginatorDocumentReference")
  /// ASBIE
  /// Order. Catalogue Reference
  /// A reference to the Catalogue on which this Order is based.
  /// 0..1
  /// Order
  /// Catalogue Reference
  /// Catalogue Reference
  /// Catalogue Reference
  catalogue_reference             ubl_common_aggregate_components_2_1.CatalogueReference?       @xsd(name: "CatalogueReference")
  /// ASBIE
  /// Order. Additional_ Document Reference. Document Reference
  /// A reference to an additional document associated with this document.
  /// 0..n
  /// Order
  /// Additional
  /// Document Reference
  /// Document Reference
  /// Document Reference
  additional_document_reference   ubl_common_aggregate_components_2_1.DocumentReference[]       @xsd(name: "AdditionalDocumentReference")
  /// ASBIE
  /// Order. Contract
  /// A contracts associated with this Order.
  /// 0..n
  /// Order
  /// Contract
  /// Contract
  /// Contract
  contract                        ubl_common_aggregate_components_2_1.Contract[]                @xsd(name: "Contract")
  /// ASBIE
  /// Order. Project Reference
  /// A project with which this Order is associated.
  /// 0..n
  /// Order
  /// Project Reference
  /// Project Reference
  /// Project Reference
  project_reference               ubl_common_aggregate_components_2_1.ProjectReference[]        @xsd(name: "ProjectReference")
  /// ASBIE
  /// Order. Signature
  /// A signature applied to this document.
  /// 0..n
  /// Order
  /// Signature
  /// Signature
  /// Signature
  signature                       ubl_common_aggregate_components_2_1.Signature[]               @xsd(name: "Signature")
  /// ASBIE
  /// Order. Buyer_ Customer Party. Customer Party
  /// The buyer.
  /// 1
  /// Order
  /// Buyer
  /// Customer Party
  /// Customer Party
  /// Customer Party
  buyer_customer_party            ubl_common_aggregate_components_2_1.CustomerParty             @xsd(name: "BuyerCustomerParty")
  /// ASBIE
  /// Order. Seller_ Supplier Party. Supplier Party
  /// The seller.
  /// 1
  /// Order
  /// Seller
  /// Supplier Party
  /// Supplier Party
  /// Supplier Party
  seller_supplier_party           ubl_common_aggregate_components_2_1.SupplierParty             @xsd(name: "SellerSupplierParty")
  /// ASBIE
  /// Order. Originator_ Customer Party. Customer Party
  /// The originator.
  /// 0..1
  /// Order
  /// Originator
  /// Customer Party
  /// Customer Party
  /// Customer Party
  originator_customer_party       ubl_common_aggregate_components_2_1.CustomerParty?            @xsd(name: "OriginatorCustomerParty")
  /// ASBIE
  /// Order. Freight Forwarder_ Party. Party
  /// A freight forwarder or carrier.
  /// 0..1
  /// Order
  /// Freight Forwarder
  /// Party
  /// Party
  /// Party
  /// Carrier
  freight_forwarder_party         ubl_common_aggregate_components_2_1.Party?                    @xsd(name: "FreightForwarderParty")
  /// ASBIE
  /// Order. Accounting_ Customer Party. Customer Party
  /// The accounting customer party.
  /// 0..1
  /// Order
  /// Accounting
  /// Customer Party
  /// Customer Party
  /// Customer Party
  accounting_customer_party       ubl_common_aggregate_components_2_1.CustomerParty?            @xsd(name: "AccountingCustomerParty")
  /// ASBIE
  /// Order. Delivery
  /// A delivery associated with this document.
  /// 0..n
  /// Order
  /// Delivery
  /// Delivery
  /// Delivery
  delivery                        ubl_common_aggregate_components_2_1.Delivery[]                @xsd(name: "Delivery")
  /// ASBIE
  /// Order. Delivery Terms
  /// A set of delivery terms associated with this document.
  /// 0..n
  /// Order
  /// Delivery Terms
  /// Delivery Terms
  /// Delivery Terms
  delivery_terms                  ubl_common_aggregate_components_2_1.DeliveryTerms[]           @xsd(name: "DeliveryTerms")
  /// ASBIE
  /// Order. Payment Means
  /// Expected means of payment.
  /// 0..n
  /// Order
  /// Payment Means
  /// Payment Means
  /// Payment Means
  payment_means                   ubl_common_aggregate_components_2_1.PaymentMeans[]            @xsd(name: "PaymentMeans")
  /// ASBIE
  /// Order. Payment Terms
  /// A set of payment terms associated with this document.
  /// 0..n
  /// Order
  /// Payment Terms
  /// Payment Terms
  /// Payment Terms
  payment_terms                   ubl_common_aggregate_components_2_1.PaymentTerms[]            @xsd(name: "PaymentTerms")
  /// ASBIE
  /// Order. Transaction Conditions
  /// A specification of purchasing or sales conditions applying to the whole Order.
  /// 0..1
  /// Order
  /// Transaction Conditions
  /// Transaction Conditions
  /// Transaction Conditions
  /// Sales condition, procurement condition
  transaction_conditions          ubl_common_aggregate_components_2_1.TransactionConditions?    @xsd(name: "TransactionConditions")
  /// ASBIE
  /// Order. Allowance Charge
  /// A discount or charge that applies to a price component.
  /// 0..n
  /// Order
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  allowance_charge                ubl_common_aggregate_components_2_1.AllowanceCharge[]         @xsd(name: "AllowanceCharge")
  /// ASBIE
  /// Order. Tax_ Exchange Rate. Exchange Rate
  /// The exchange rate between the document currency and the tax currency.
  /// 0..1
  /// Order
  /// Tax
  /// Exchange Rate
  /// Exchange Rate
  /// Exchange Rate
  tax_exchange_rate               ubl_common_aggregate_components_2_1.ExchangeRate?             @xsd(name: "TaxExchangeRate")
  /// ASBIE
  /// Order. Pricing_ Exchange Rate. Exchange Rate
  /// The exchange rate between the document currency and the pricing currency.
  /// 0..1
  /// Order
  /// Pricing
  /// Exchange Rate
  /// Exchange Rate
  /// Exchange Rate
  pricing_exchange_rate           ubl_common_aggregate_components_2_1.ExchangeRate?             @xsd(name: "PricingExchangeRate")
  /// ASBIE
  /// Order. Payment_ Exchange Rate. Exchange Rate
  /// The exchange rate between the document currency and the payment currency.
  /// 0..1
  /// Order
  /// Payment
  /// Exchange Rate
  /// Exchange Rate
  /// Exchange Rate
  payment_exchange_rate           ubl_common_aggregate_components_2_1.ExchangeRate?             @xsd(name: "PaymentExchangeRate")
  /// ASBIE
  /// Order. Destination_ Country. Country
  /// The country of destination (for customs purposes).
  /// 0..1
  /// Order
  /// Destination
  /// Country
  /// Country
  /// Country
  destination_country             ubl_common_aggregate_components_2_1.Country?                  @xsd(name: "DestinationCountry")
  /// ASBIE
  /// Order. Tax Total
  /// The total amount of a specific type of tax.
  /// 0..n
  /// Order
  /// Tax Total
  /// Tax Total
  /// Tax Total
  tax_total                       ubl_common_aggregate_components_2_1.TaxTotal[]                @xsd(name: "TaxTotal")
  /// ASBIE
  /// Order. Anticipated_ Monetary Total. Monetary Total
  /// The total amount for the Order anticipated by the buyer.
  /// 0..1
  /// Order
  /// Anticipated
  /// Monetary Total
  /// Monetary Total
  /// Monetary Total
  anticipated_monetary_total      ubl_common_aggregate_components_2_1.MonetaryTotal?            @xsd(name: "AnticipatedMonetaryTotal")
  /// ASBIE
  /// Order. Order Line
  /// A line associated with a line in the Catalogue and specifying a kind of item being ordered.
  /// 1..n
  /// Order
  /// Order Line
  /// Order Line
  /// Order Line
  order_line                      ubl_common_aggregate_components_2_1.OrderLine[]               { minItems 1 } @xsd(name: "OrderLine")

  @@xsd(name: "Order")
}
