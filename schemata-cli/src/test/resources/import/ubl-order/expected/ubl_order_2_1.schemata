  /// 0..1
  /// Order
  /// Customization Identifier
  /// Identifier
  /// Identifier. Type
  /// NES
  @xsd(name = "CustomizationID") customization_id:                ubl_common_basic_components_2_1.CustomizationID?
  /// BBIE
