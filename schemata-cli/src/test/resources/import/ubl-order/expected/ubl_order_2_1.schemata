  /// A reference to an additional document associated with this document.
  /// 0..n
  /// Order
  /// Additional
  /// Document Reference
  /// Document Reference
  /// Document Reference
  @xsd(name = "AdditionalDocumentReference") additional_document_reference:   list<ubl_common_aggregate_components_2_1.DocumentReference>
