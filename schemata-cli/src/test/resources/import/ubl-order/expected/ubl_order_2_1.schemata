  /// 0..n
  /// Order
  /// Validity
  /// Period
  /// Period
  /// Period
  @xsd(name = "ValidityPeriod") validity_period:                 list<ubl_common_aggregate_components_2_1.Period>
  /// ASBIE
  /// Order. Quotation_ Document Reference. Document Reference
