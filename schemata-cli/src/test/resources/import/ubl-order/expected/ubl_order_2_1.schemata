  /// 0..1
  /// Order
  /// Originator
  /// Document Reference
  /// Document Reference
  /// Document Reference
  @xsd(name = "OriginatorDocumentReference") originator_document_reference:   ubl_common_aggregate_components_2_1.DocumentReference?
  /// ASBIE
