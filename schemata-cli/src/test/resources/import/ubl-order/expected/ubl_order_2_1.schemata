@xsd(namespace = "urn:oasis:names:specification:ubl:schema:xsd:Order-2")
namespace ubl_order_2_1

import ubl_common_aggregate_components_2_1
import ubl_common_basic_components_2_1
import ubl_common_extension_components_2_1

/// ABIE
/// Order. Details
/// A document used to order goods and services.
/// Order
/// Purchase Order
@xsd(name = "Order")
record Order {
  /// A container for all extensions present in the document.
  @xsd(name = "UBLExtensions") ubl_extensions:                  ubl_common_extension_components_2_1.UBLExtensions?
