  /// 1
  /// Order
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// Purchase Order Number, Order Number
  @xsd(name = "ID") id:                              ubl_common_basic_components_2_1.ID
  /// BBIE
  /// Order. Sales_ Order Identifier. Identifier
