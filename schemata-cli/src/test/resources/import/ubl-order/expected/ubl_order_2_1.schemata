  /// A code signifying the type of Order.
  /// 0..1
  /// Order
  /// Order Type Code
  /// Code
  /// Code. Type
  @xsd(name = "OrderTypeCode") order_type_code:                 ubl_common_basic_components_2_1.OrderTypeCode?
  /// BBIE
