  /// Signature Information
  /// Signature Information
  /// Signature Information
  signature_information ubl_signature_aggregate_components_2_1.SignatureInformation[] { minItems 1 } @xsd(name: "SignatureInformation")

  @@xsd(name: "UBLDocumentSignatures")
}
