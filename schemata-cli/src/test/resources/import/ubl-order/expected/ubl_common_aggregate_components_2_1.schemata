  /// 0..1
  /// Hazardous Item
  /// Flashpoint
  /// Temperature
  /// Temperature
  /// Temperature
  @xsd(name = "FlashpointTemperature") flashpoint_temperature:         Temperature?
  /// ASBIE
  /// Hazardous Item. Additional_ Temperature. Temperature
