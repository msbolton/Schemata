/// ABIE
/// Consumption. Details
/// A class to describe the consumption of a utility.
/// Consumption
@xsd(name = "Consumption")
record Consumption {
  /// BBIE
  /// Consumption. Utility Statement Type Code. Code
  /// A code identifying the type of the Utility Statement required for this consumption. Explains the kind of utility the statement is about, e.g.. "gas", "electricity", "telephone"
  /// 0..1
  /// Consumption
  /// Utility Statement Type Code
  /// Code
  /// Code. Type
  /// Electricity
  @xsd(name = "UtilityStatementTypeCode") utility_statement_type_code: ubl_common_basic_components_2_1.UtilityStatementTypeCode?
  /// ASBIE
  /// Consumption. Main_ Period. Period
  /// The period of consumption.
  /// 0..1
  /// Consumption
  /// Main
  /// Period
  /// Period
  /// Period
  @xsd(name = "MainPeriod") main_period:                 Period?
  /// ASBIE
  /// Consumption. Allowance Charge
  /// An allowance or charges that may apply with this consumption.
  /// 0..n
  /// Consumption
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  @xsd(name = "AllowanceCharge") allowance_charge:            list<AllowanceCharge>
  /// ASBIE
  /// Consumption. Tax Total
  /// The total of taxes for each tax type covering the consumption.
  /// 0..n
  /// Consumption
  /// Tax Total
  /// Tax Total
  /// Tax Total
  @xsd(name = "TaxTotal") tax_total:                   list<TaxTotal>
  /// ASBIE
  /// Consumption. Energy Water Supply
  /// The details of any energy or water consumption.
  /// 0..1
  /// Consumption
  /// Energy Water Supply
  /// Energy Water Supply
  /// Energy Water Supply
  @xsd(name = "EnergyWaterSupply") energy_water_supply:         EnergyWaterSupply?
  /// ASBIE
  /// Consumption. Telecommunications Supply
  /// The details of any telecommunications consumption.
  /// 0..1
  /// Consumption
  /// Telecommunications Supply
  /// Telecommunications Supply
  /// Telecommunications Supply
  @xsd(name = "TelecommunicationsSupply") telecommunications_supply:   TelecommunicationsSupply?
  /// ASBIE
  /// Consumption. Legal_ Monetary Total. Monetary Total
  /// The total amount payable on this consumption, including any allowances, charges, or taxes.
  /// 1
  /// Consumption
  /// Legal
  /// Monetary Total
  /// Monetary Total
  /// Monetary Total
  @xsd(name = "LegalMonetaryTotal") legal_monetary_total:        MonetaryTotal
}

/// ABIE
/// Consumption Average. Details
/// A class to define an average consumption as a monetary amount.
/// Consumption Average
@xsd(name = "ConsumptionAverage")
record ConsumptionAverage {
  /// BBIE
  /// Consumption Average. Average_ Amount. Amount
  /// The average monetary amount of the consumption.
  /// 0..1
  /// Consumption Average
  /// Average
  /// Amount
  /// Amount
  /// Amount. Type
  /// 1.65
  @xsd(name = "AverageAmount") average_amount: ubl_common_basic_components_2_1.AverageAmount?
  /// BBIE
  /// Consumption Average. Description. Text
  /// A description of the average consumed.
  /// 0..n
  /// Consumption Average
  /// Description
  /// Text
  /// Text. Type
  /// Average price incl. value added tax per kilowatt-hour in the billing period.
  @xsd(name = "Description") description:    list<ubl_common_basic_components_2_1.Description>
}

/// ABIE
/// Consumption Correction. Details
/// The Statement of correction, for examples heating correction.
/// Consumption Correction
@xsd(name = "ConsumptionCorrection")
record ConsumptionCorrection {
  /// BBIE
  /// Consumption Correction. Correction Type. Text
  /// Statement for the correction type.
  /// 0..1
  /// Consumption Correction
  /// Correction Type
  /// Text
  /// Text. Type
  /// Heating Correction
  @xsd(name = "CorrectionType") correction_type:                           ubl_common_basic_components_2_1.CorrectionType?
  /// BBIE
  /// Consumption Correction. Correction Type Code. Code
  /// Statement at the code for the correction type.
  /// 0..1
  /// Consumption Correction
  /// Correction Type Code
  /// Code
  /// Code. Type
  /// HeatingCorrection
  @xsd(name = "CorrectionTypeCode") correction_type_code:                      ubl_common_basic_components_2_1.CorrectionTypeCode?
  /// BBIE
  /// Consumption Correction. Meter Number. Text
  /// Statement for meter number.
  /// 0..1
  /// Consumption Correction
  /// Meter Number
  /// Text
  /// Text. Type
  /// 530071575
  @xsd(name = "MeterNumber") meter_number:                              ubl_common_basic_components_2_1.MeterNumber?
  /// BBIE
  /// Consumption Correction. Gas Pressure. Quantity
  /// Correction of the gas pressure.
  /// 0..1
  /// Consumption Correction
  /// Gas Pressure
  /// Quantity
  /// Quantity. Type
  @xsd(name = "GasPressureQuantity") gas_pressure_quantity:                     ubl_common_basic_components_2_1.GasPressureQuantity?
  /// BBIE
  /// Consumption Correction. Actual_ Temperature Reduction. Quantity
  /// Statement for the actuel heating correction temperature.
  /// 0..1
  /// Consumption Correction
  /// Actual
  /// Temperature Reduction
  /// Quantity
  /// Quantity. Type
  /// -36.69
  @xsd(name = "ActualTemperatureReductionQuantity") actual_temperature_reduction_quantity:     ubl_common_basic_components_2_1.ActualTemperatureReductionQuantity?
  /// BBIE
  /// Consumption Correction. Normal_ Temperature Reduction. Quantity
  /// Statement for the standard for heating correction temperature.
  /// 0..1
  /// Consumption Correction
  /// Normal
  /// Temperature Reduction
  /// Quantity
  /// Quantity. Type
  /// -37.00
  @xsd(name = "NormalTemperatureReductionQuantity") normal_temperature_reduction_quantity:     ubl_common_basic_components_2_1.NormalTemperatureReductionQuantity?
  /// BBIE
  /// Consumption Correction. Difference_ Temperature Reduction. Quantity
  /// Deviation from standard heating correction.
  /// 0..1
  /// Consumption Correction
  /// Difference
  /// Temperature Reduction
  /// Quantity
  /// Quantity. Type
  /// 0.31
  @xsd(name = "DifferenceTemperatureReductionQuantity") difference_temperature_reduction_quantity: ubl_common_basic_components_2_1.DifferenceTemperatureReductionQuantity?
  /// BBIE
  /// Consumption Correction. Description. Text
  /// Description related to the corrections.
  /// 0..n
  /// Consumption Correction
  /// Description
  /// Text
  /// Text. Type
  @xsd(name = "Description") description:                               list<ubl_common_basic_components_2_1.Description>
  /// BBIE
  /// Consumption Correction. Correction Unit Amount. Amount
  /// Correction per MWH per degree C.
  /// 0..1
  /// Consumption Correction
  /// Correction Unit Amount
  /// Amount
  /// Amount. Type
  /// 0.0000
  @xsd(name = "CorrectionUnitAmount") correction_unit_amount:                    ubl_common_basic_components_2_1.CorrectionUnitAmount?
  /// BBIE
  /// Consumption Correction. Consumption Energy. Quantity
  /// Your consumpt for district heating energy.
  /// 0..1
  /// Consumption Correction
  /// Consumption Energy
  /// Quantity
  /// Quantity. Type
  /// 563.6240
  @xsd(name = "ConsumptionEnergyQuantity") consumption_energy_quantity:               ubl_common_basic_components_2_1.ConsumptionEnergyQuantity?
  /// BBIE
  /// Consumption Correction. Consumption Water. Quantity
  /// Your consumpt for district heating water.
  /// 0..1
  /// Consumption Correction
  /// Consumption Water
  /// Quantity
  /// Quantity. Type
  /// 13212.14
  @xsd(name = "ConsumptionWaterQuantity") consumption_water_quantity:                ubl_common_basic_components_2_1.ConsumptionWaterQuantity?
  /// BBIE
  /// Consumption Correction. Correction Amount. Amount
  /// Your correction for heating correction.
  /// 0..1
  /// Consumption Correction
  /// Correction Amount
  /// Amount
  /// Amount. Type
  /// 0.00
  @xsd(name = "CorrectionAmount") correction_amount:                         ubl_common_basic_components_2_1.CorrectionAmount?
}

/// ABIE
/// Consumption History. Details
/// A class to describe the measurement of a type of consumption during a particular period, used for the subscriber to get an overview of his consumption
/// Consumption History
@xsd(name = "ConsumptionHistory")
record ConsumptionHistory {
  /// BBIE
  /// Consumption History. Meter Number. Text
  /// A text identifier for the meter measuring the consumption.
  /// 0..1
  /// Consumption History
  /// Meter Number
  /// Text
  /// Text. Type
  /// 61722x
  @xsd(name = "MeterNumber") meter_number:           ubl_common_basic_components_2_1.MeterNumber?
  /// BBIE
  /// Consumption History. Quantity
  /// The quantity consumed.
  /// 1
  /// Consumption History
  /// Quantity
  /// Quantity
  /// Quantity. Type
  /// 7621.00
  @xsd(name = "Quantity") quantity:               ubl_common_basic_components_2_1.Quantity
  /// BBIE
  /// Consumption History. Amount
  /// The monetary amount to be charged for the quantity consumed.
  /// 0..1
  /// Consumption History
  /// Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "Amount") amount:                 ubl_common_basic_components_2_1.Amount?
  /// BBIE
  /// Consumption History. Consumption Level Code. Code
  /// The consumption level, expressed as a code used explain the consumption quantity, e.g.. diversion from the normal.
  /// 0..1
  /// Consumption History
  /// Consumption Level Code
  /// Code
  /// Code. Type
  /// B
  @xsd(name = "ConsumptionLevelCode") consumption_level_code: ubl_common_basic_components_2_1.ConsumptionLevelCode?
  /// BBIE
  /// Consumption History. Consumption Level Text. Text
  /// The consumption level, expressed as text, used explain the consumption quantity, e.g.. diversion from the normal.
  /// 0..1
  /// Consumption History
  /// Consumption Level Text
  /// Text
  /// Text. Type
  /// Average
  @xsd(name = "ConsumptionLevel") consumption_level:      ubl_common_basic_components_2_1.ConsumptionLevel?
  /// BBIE
  /// Consumption History. Description. Text
  /// Text describing the consumption itself.
  /// 0..n
  /// Consumption History
  /// Description
  /// Text
  /// Text. Type
  /// 2004/2005
  @xsd(name = "Description") description:            list<ubl_common_basic_components_2_1.Description>
  /// ASBIE
  /// Consumption History. Period
  /// The period during which the consumption took place.
  /// 1
  /// Consumption History
  /// Period
  /// Period
  /// Period
  @xsd(name = "Period") period:                 Period
}

/// ABIE
/// Consumption Line. Details
/// A class to describe a line item for utility consumption. To specify more than one utility item, use separate consumption lines.
/// Consumption Line
@xsd(name = "ConsumptionLine")
record ConsumptionLine {
  /// BBIE
  /// Consumption Line. Identifier
  /// An identifier for this consumption line.
  /// 1
  /// Consumption Line
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// 1
  @xsd(name = "ID") id:                                ubl_common_basic_components_2_1.ID
  /// BBIE
  /// Consumption Line. Parent_ Document Line Reference Identifier. Identifier
  /// An identifier for the transaction line on a related document (such as an invoice) that covers this consumption line.
  /// 0..1
  /// Consumption Line
  /// Parent
  /// Document Line Reference Identifier
  /// Identifier
  /// Identifier. Type
  /// Consumption
  @xsd(name = "ParentDocumentLineReferenceID") parent_document_line_reference_id: ubl_common_basic_components_2_1.ParentDocumentLineReferenceID?
  /// BBIE
  /// Consumption Line. Invoiced_ Quantity. Quantity
  /// The quantity invoiced.
  /// 1
  /// Consumption Line
  /// Invoiced
  /// Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "InvoicedQuantity") invoiced_quantity:                 ubl_common_basic_components_2_1.InvoicedQuantity
  /// BBIE
  /// Consumption Line. Line Extension Amount. Amount
  /// The monetary amount, including discount, to be charged for this consumption line.
  /// 1
  /// Consumption Line
  /// Line Extension Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "LineExtensionAmount") line_extension_amount:             ubl_common_basic_components_2_1.LineExtensionAmount
  /// ASBIE
  /// Consumption Line. Period
  /// The period of time covered by this consumption line.
  /// 0..1
  /// Consumption Line
  /// Period
  /// Period
  /// Period
  @xsd(name = "Period") period:                            Period?
  /// ASBIE
  /// Consumption Line. Delivery
  /// A delivery of the utility item on this consumption line.
  /// 0..n
  /// Consumption Line
  /// Delivery
  /// Delivery
  /// Delivery
  @xsd(name = "Delivery") delivery:                          list<Delivery>
  /// ASBIE
  /// Consumption Line. Allowance Charge
  /// An allowance or charge that applies to this consumption line.
  /// 0..n
  /// Consumption Line
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  @xsd(name = "AllowanceCharge") allowance_charge:                  list<AllowanceCharge>
  /// ASBIE
  /// Consumption Line. Tax Total
  /// A total amount of taxes of a particular kind applicable to this consumption line.
  /// 0..n
  /// Consumption Line
  /// Tax Total
  /// Tax Total
  /// Tax Total
  @xsd(name = "TaxTotal") tax_total:                         list<TaxTotal>
  /// ASBIE
  /// Consumption Line. Utility Item
  /// The utility item consumed.
  /// 1
  /// Consumption Line
  /// Utility Item
  /// Utility Item
  /// Utility Item
  @xsd(name = "UtilityItem") utility_item:                      UtilityItem
  /// ASBIE
  /// Consumption Line. Price
  /// The price associated with this consumption line, expressed in a data structure containing multiple properties.
  /// 0..1
  /// Consumption Line
  /// Price
  /// Price
  /// Price
  @xsd(name = "Price") price:                             Price?
  /// ASBIE
  /// Consumption Line. Unstructured Price
  /// The price associated with this consumption line expressed in a less structured form that includes just the amount and the time of use.
  /// 0..1
  /// Consumption Line
  /// Unstructured Price
  /// Unstructured Price
  /// Unstructured Price
  @xsd(name = "UnstructuredPrice") unstructured_price:                UnstructuredPrice?
}

/// ABIE
/// Consumption Point. Details
/// A class to define the point of consumption for a utility, such as a meter.
/// Consumption Point
@xsd(name = "ConsumptionPoint")
record ConsumptionPoint {
  /// BBIE
  /// Consumption Point. Identifier
  /// An identifier for this point of consumption.
  /// 1
  /// Consumption Point
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// 7411013716x
  @xsd(name = "ID") id:                       ubl_common_basic_components_2_1.ID
  /// BBIE
  /// Consumption Point. Description. Text
  /// Text describing this consumption point.
  /// 0..n
  /// Consumption Point
  /// Description
  /// Text
  /// Text. Type
  /// Additional informations concerning the consumption point
  @xsd(name = "Description") description:              list<ubl_common_basic_components_2_1.Description>
  /// BBIE
  /// Consumption Point. Subscriber Identifier. Identifier
  /// An identifier for the subscriber responsible for the consumption at this consumption point.
  /// 0..1
  /// Consumption Point
  /// Subscriber Identifier
  /// Identifier
  /// Identifier. Type
  /// 98143211
  @xsd(name = "SubscriberID") subscriber_id:            ubl_common_basic_components_2_1.SubscriberID?
  /// BBIE
  /// Consumption Point. Subscriber Type. Text
  /// The type of subscriber, expressed as text.
  /// 0..1
  /// Consumption Point
  /// Subscriber Type
  /// Text
  /// Text. Type
  @xsd(name = "SubscriberType") subscriber_type:          ubl_common_basic_components_2_1.SubscriberType?
  /// BBIE
  /// Consumption Point. Subscriber Type Code. Code
  /// The type of subscriber, expressed as a code.
  /// 0..1
  /// Consumption Point
  /// Subscriber Type Code
  /// Code
  /// Code. Type
  /// APL
  @xsd(name = "SubscriberTypeCode") subscriber_type_code:     ubl_common_basic_components_2_1.SubscriberTypeCode?
  /// BBIE
  /// Consumption Point. Total_ Delivered Quantity. Quantity
  /// The total quantity delivered, calculated at this consumption point.
  /// 0..1
  /// Consumption Point
  /// Total
  /// Delivered Quantity
  /// Quantity
  /// Quantity. Type
  /// 5761.00
  @xsd(name = "TotalDeliveredQuantity") total_delivered_quantity: ubl_common_basic_components_2_1.TotalDeliveredQuantity?
  /// ASBIE
  /// Consumption Point. Address
  /// The address of this consumption point.
  /// 0..1
  /// Consumption Point
  /// Address
  /// Address
  /// Address
  @xsd(name = "Address") address:                  Address?
  /// ASBIE
  /// Consumption Point. Web Site Access
  /// Access information for the website of this consumption point.
  /// 0..1
  /// Consumption Point
  /// Web Site Access
  /// Web Site Access
  /// Web Site Access
  @xsd(name = "WebSiteAccess") web_site_access:          WebSiteAccess?
  /// ASBIE
  /// Consumption Point. Utility_ Meter. Meter
  /// A meter at this consumption point.
  /// 0..n
  /// Consumption Point
  /// Utility
  /// Meter
  /// Meter
  /// Meter
  @xsd(name = "UtilityMeter") utility_meter:            list<Meter>
}

/// ABIE
/// Consumption Report. Details
/// A class to describe utility consumption, including details of the environment in which consumption takes place.
/// Consumption Report
@xsd(name = "ConsumptionReport")
record ConsumptionReport {
  /// BBIE
  /// Consumption Report. Identifier
  /// An identifier for this consumption report.
  /// 1
  /// Consumption Report
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// n/a
  @xsd(name = "ID") id:                           ubl_common_basic_components_2_1.ID
  /// BBIE
  /// Consumption Report. Consumption Type. Text
  /// The type of consumption, expressed as text.
  /// 0..1
  /// Consumption Report
  /// Consumption Type
  /// Text
  /// Text. Type
  /// Consumption
  @xsd(name = "ConsumptionType") consumption_type:             ubl_common_basic_components_2_1.ConsumptionType?
  /// BBIE
  /// Consumption Report. Consumption Type Code. Code
  /// The type of consumption, expressed as a code.
  /// 0..1
  /// Consumption Report
  /// Consumption Type Code
  /// Code
  /// Code. Type
  /// Consumption
  @xsd(name = "ConsumptionTypeCode") consumption_type_code:        ubl_common_basic_components_2_1.ConsumptionTypeCode?
  /// BBIE
  /// Consumption Report. Description. Text
  /// Text reporting utility consumption.
  /// 0..n
  /// Consumption Report
  /// Description
  /// Text
  /// Text. Type
  /// This report contain the latest year consumption
  @xsd(name = "Description") description:                  list<ubl_common_basic_components_2_1.Description>
  /// BBIE
  /// Consumption Report. Total_ Consumed Quantity. Quantity
  /// The total quantity consumed.
  /// 0..1
  /// Consumption Report
  /// Total
  /// Consumed Quantity
  /// Quantity
  /// Quantity. Type
  /// 20479.00
  @xsd(name = "TotalConsumedQuantity") total_consumed_quantity:      ubl_common_basic_components_2_1.TotalConsumedQuantity?
  /// BBIE
  /// Consumption Report. Basic_ Consumed Quantity. Quantity
  /// The basic quantity consumed, excluding additional consumption.
  /// 0..1
  /// Consumption Report
  /// Basic
  /// Consumed Quantity
  /// Quantity
  /// Quantity. Type
  /// 20000.00
  @xsd(name = "BasicConsumedQuantity") basic_consumed_quantity:      ubl_common_basic_components_2_1.BasicConsumedQuantity?
  /// BBIE
  /// Consumption Report. Resident_ Occupants Numeric. Numeric
  /// The number of people occupying the residence covered by this report.
  /// 0..1
  /// Consumption Report
  /// Resident
  /// Occupants Numeric
  /// Numeric
  /// Numeric. Type
  /// 4.0
  @xsd(name = "ResidentOccupantsNumeric") resident_occupants_numeric:   ubl_common_basic_components_2_1.ResidentOccupantsNumeric?
  /// BBIE
  /// Consumption Report. Consumers_ Energy Level Code. Code
  /// The level of energy consumed, compared to the average for this residence type and the number of people living in the residence, expressed as a code.
  /// 0..1
  /// Consumption Report
  /// Consumers
  /// Energy Level Code
  /// Code
  /// Code. Type
  /// B
  @xsd(name = "ConsumersEnergyLevelCode") consumers_energy_level_code:  ubl_common_basic_components_2_1.ConsumersEnergyLevelCode?
  /// BBIE
  /// Consumption Report. Consumers_ Energy Level. Text
  /// The level of energy consumed, compared to the average for this residence type and the number of people living in the residence, expressed as text.
  /// 0..1
  /// Consumption Report
  /// Consumers
  /// Energy Level
  /// Text
  /// Text. Type
  /// Middel
  @xsd(name = "ConsumersEnergyLevel") consumers_energy_level:       ubl_common_basic_components_2_1.ConsumersEnergyLevel?
  /// BBIE
  /// Consumption Report. Residence Type. Text
  /// The type of residence (house, apartment, etc.) covered in this report, expressed as text.
  /// 0..1
  /// Consumption Report
  /// Residence Type
  /// Text
  /// Text. Type
  /// House
  @xsd(name = "ResidenceType") residence_type:               ubl_common_basic_components_2_1.ResidenceType?
  /// BBIE
  /// Consumption Report. Residence Type Code. Code
  /// The type of residence (house, apartment, etc.) covered in this report, expressed as a code.
  /// 0..1
  /// Consumption Report
  /// Residence Type Code
  /// Code
  /// Code. Type
  /// House
  @xsd(name = "ResidenceTypeCode") residence_type_code:          ubl_common_basic_components_2_1.ResidenceTypeCode?
  /// BBIE
  /// Consumption Report. Heating Type. Text
  /// The type of heating in the residence covered in this report, expressed as text.
  /// 0..1
  /// Consumption Report
  /// Heating Type
  /// Text
  /// Text. Type
  /// District heating
  @xsd(name = "HeatingType") heating_type:                 ubl_common_basic_components_2_1.HeatingType?
  /// BBIE
  /// Consumption Report. Heating Type Code. Code
  /// The type of heating in the residence covered in this report, expressed as a code.
  /// 0..1
  /// Consumption Report
  /// Heating Type Code
  /// Code
  /// Code. Type
  /// DistrictHeating
  @xsd(name = "HeatingTypeCode") heating_type_code:            ubl_common_basic_components_2_1.HeatingTypeCode?
  /// ASBIE
  /// Consumption Report. Period
  /// The period of consumption covered in this report.
  /// 0..1
  /// Consumption Report
  /// Period
  /// Period
  /// Period
  @xsd(name = "Period") period:                       Period?
  /// ASBIE
  /// Consumption Report. Guidance_ Document Reference. Document Reference
  /// A reference to a document providing an explanation of this kind of report.
  /// 0..1
  /// Consumption Report
  /// Guidance
  /// Document Reference
  /// Document Reference
  /// Document Reference
  @xsd(name = "GuidanceDocumentReference") guidance_document_reference:  DocumentReference?
  /// ASBIE
  /// Consumption Report. Document Reference
  /// A reference to some other document (for example, this report in another format).
  /// 0..1
  /// Consumption Report
  /// Document Reference
  /// Document Reference
  /// Document Reference
  @xsd(name = "DocumentReference") document_reference:           DocumentReference?
  /// ASBIE
  /// Consumption Report. Consumption Report Reference
  /// A reference to a previous consumption report.
  /// 0..n
  /// Consumption Report
  /// Consumption Report Reference
  /// Consumption Report Reference
  /// Consumption Report Reference
  @xsd(name = "ConsumptionReportReference") consumption_report_reference: list<ConsumptionReportReference>
  /// ASBIE
  /// Consumption Report. Consumption History
  /// A report describing historical parameters relating to a specific instance of consumption.
  /// 0..n
  /// Consumption Report
  /// Consumption History
  /// Consumption History
  /// Consumption History
  @xsd(name = "ConsumptionHistory") consumption_history:          list<ConsumptionHistory>
}

/// ABIE
/// Consumption Report Reference. Details
/// A class to define a reference to an earlier consumption report (e.g., last year's consumption).
/// Consumption Report Reference
@xsd(name = "ConsumptionReportReference")
record ConsumptionReportReference {
  /// BBIE
  /// Consumption Report Reference. Consumption_ Report Identifier. Identifier
  /// An identifier for the referenced consumption report.
  /// 1
  /// Consumption Report Reference
  /// Consumption
  /// Report Identifier
  /// Identifier
  /// Identifier. Type
  /// n/a
  @xsd(name = "ConsumptionReportID") consumption_report_id:   ubl_common_basic_components_2_1.ConsumptionReportID
  /// BBIE
  /// Consumption Report Reference. Consumption Type. Text
  /// The reported consumption type, expressed as text.
  /// 0..1
  /// Consumption Report Reference
  /// Consumption Type
  /// Text
  /// Text. Type
  /// Consumption
  @xsd(name = "ConsumptionType") consumption_type:        ubl_common_basic_components_2_1.ConsumptionType?
  /// BBIE
  /// Consumption Report Reference. Consumption Type Code. Code
  /// The reported consumption type, expressed as a code.
  /// 0..1
  /// Consumption Report Reference
  /// Consumption Type Code
  /// Code
  /// Code. Type
  /// Consumption
  @xsd(name = "ConsumptionTypeCode") consumption_type_code:   ubl_common_basic_components_2_1.ConsumptionTypeCode?
  /// BBIE
  /// Consumption Report Reference. Total_ Consumed Quantity. Quantity
  /// The total quantity consumed during the period of the referenced report.
  /// 1
  /// Consumption Report Reference
  /// Total
  /// Consumed Quantity
  /// Quantity
  /// Quantity. Type
  /// 20479.00
  @xsd(name = "TotalConsumedQuantity") total_consumed_quantity: ubl_common_basic_components_2_1.TotalConsumedQuantity
  /// ASBIE
  /// Consumption Report Reference. Period
  /// The period of consumption covered by the referenced report.
  /// 1
  /// Consumption Report Reference
  /// Period
  /// Period
  /// Period
  @xsd(name = "Period") period:                  Period
}

/// ABIE
/// Contact. Details
/// A class to describe a contactable person or department in an organization.
/// Contact
record Contact {
  /// BBIE
  /// Contact. Identifier
  /// An identifier for this contact.
  /// 0..1
  /// Contact
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// Receivals Clerk
  @xsd(name = "ID") id:                  ubl_common_basic_components_2_1.ID?
  /// BBIE
  /// Contact. Name
  /// The name of this contact. It is recommended that this be used for a functional name and not a personal name.
  /// 0..1
  /// Contact
  /// Name
  /// Name
  /// Name. Type
  /// Delivery Dock
  @xsd(name = "Name") name:                ubl_common_basic_components_2_1.Name?
