  /// Line Reference
  @xsd(name = "LineReference") line_reference:               list<LineReference>
}

/// ABIE
/// Line Reference. Details
/// A class to define a reference to a line in a document.
/// Line Reference
record LineReference {
  /// BBIE
  /// Line Reference. Line Identifier. Identifier
  /// Identifies the referenced line in the document.
  /// 1
  /// Line Reference
  /// Line Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "LineID") line_id:            ubl_common_basic_components_2_1.LineID
  /// BBIE
  /// Line Reference. UUID. Identifier
  /// A universally unique identifier for this line reference.
  /// 0..1
  /// Line Reference
  /// UUID
  /// Identifier
  /// Identifier. Type
  @xsd(name = "UUID") uuid:               ubl_common_basic_components_2_1.UUID?
  /// BBIE
  /// Line Reference. Line Status Code. Code
  /// A code signifying the status of the referenced line with respect to its original state.
  /// 0..1
  /// Line Reference
  /// Line Status Code
  /// Code
  /// Line Status
  /// Line Status_ Code. Type
  @xsd(name = "LineStatusCode") line_status_code:   ubl_common_basic_components_2_1.LineStatusCode?
  /// ASBIE
  /// Line Reference. Document Reference
  /// A reference to the document containing the referenced line.
  /// 0..1
  /// Line Reference
  /// Document Reference
  /// Document Reference
  /// Document Reference
  @xsd(name = "DocumentReference") document_reference: DocumentReference?
}

/// ABIE
