  /// 0..1
  /// Catalogue Line
  /// Warranty Validity
  /// Period
  /// Period
  /// Period
  @xsd(name = "WarrantyValidityPeriod") warranty_validity_period:            Period?
  /// ASBIE
  /// Catalogue Line. Line Validity_ Period. Period
