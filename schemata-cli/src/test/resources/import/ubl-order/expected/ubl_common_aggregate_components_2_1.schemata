  /// Item
  /// Item
  /// Item
  @xsd(name = "Item") item:                      Item
}

/// ABIE
/// Catalogue Line. Details
/// A class to define a line in a Catalogue describing a purchasable item.
/// Catalogue Line
@xsd(name = "CatalogueLine")
record CatalogueLine {
  /// BBIE
  /// Catalogue Line. Identifier
  /// An identifier for the line in the catalogue.
  /// 1
  /// Catalogue Line
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// 1
  @xsd(name = "ID") id:                                  ubl_common_basic_components_2_1.ID
  /// BBIE
  /// Catalogue Line. Action Code. Code
