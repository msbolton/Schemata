  /// Measure
  /// Measure. Type
  @xsd(name = "ComparedValueMeasure") compared_value_measure:          ubl_common_basic_components_2_1.ComparedValueMeasure
  /// BBIE
  /// Exception Notification Line. Source Value. Measure
  /// The value used as the basis of comparison
  /// 1
  /// Exception Notification Line
  /// Source Value
  /// Measure
  /// Measure. Type
  @xsd(name = "SourceValueMeasure") source_value_measure:            ubl_common_basic_components_2_1.SourceValueMeasure
  /// BBIE
  /// Exception Notification Line. Variance. Quantity
  /// The variance of a data item from an expected value during a particular time interval.
  /// 0..1
  /// Exception Notification Line
  /// Variance
  /// Quantity
  /// Quantity. Type
  @xsd(name = "VarianceQuantity") variance_quantity:               ubl_common_basic_components_2_1.VarianceQuantity?
  /// BBIE
  /// Exception Notification Line. Supply Chain Activity Type Code. Code
  /// Establishes the criterion for one of the three types of exceptions: Operational, performance metric and forecast. This reports an exception notification about an operational exception. Description could be: A code used to identify an operational exception. Possible values are: CANCELED_ORDERS EMERGENCY_ORDERS ON_HAND ORDERS RECEIPTS SALES SHIPMENTS
  /// 0..1
  /// Exception Notification Line
  /// Supply Chain Activity Type Code
  /// Code
  /// Code. Type
  @xsd(name = "SupplyChainActivityTypeCode") supply_chain_activity_type_code: ubl_common_basic_components_2_1.SupplyChainActivityTypeCode?
  /// BBIE
  /// Exception Notification Line. Performance Metric Type Code. Code
  /// A code used to identify a measure of performance. It defines the type of the Performance Metric on which an exception criteria is being defined
  /// 0..1
  /// Exception Notification Line
  /// Performance Metric Type Code
  /// Code
  /// Code. Type
  @xsd(name = "PerformanceMetricTypeCode") performance_metric_type_code:    ubl_common_basic_components_2_1.PerformanceMetricTypeCode?
  /// ASBIE
  /// Exception Notification Line. Exception Observation_ Period. Period
  /// The period (start-end date) when this exception is observed
  /// 0..1
  /// Exception Notification Line
  /// Exception Observation
  /// Period
  /// Period
  /// Period
  @xsd(name = "ExceptionObservationPeriod") exception_observation_period:    Period?
  /// ASBIE
  /// Exception Notification Line. Document Reference
  /// A reference to Exception Criteria document can be provided.
  /// 0..n
  /// Exception Notification Line
  /// Document Reference
  /// Document Reference
  /// Document Reference
  @xsd(name = "DocumentReference") document_reference:              list<DocumentReference>
  /// ASBIE
  /// Exception Notification Line. Forecast Exception
  /// A forecast accuracy or comparison exception.
  /// 0..1
  /// Exception Notification Line
  /// Forecast Exception
  /// Forecast Exception
  /// Forecast Exception
  @xsd(name = "ForecastException") forecast_exception:              ForecastException?
  /// ASBIE
  /// Exception Notification Line. Supply_ Item. Item
  /// The product associated with this exception notification line.
  /// 1
  /// Exception Notification Line
  /// Supply
  /// Item
  /// Item
  /// Item
  @xsd(name = "SupplyItem") supply_item:                     Item
}

/// ABIE
/// Exchange Rate. Details
/// A class to define an exchange rate.
/// Exchange Rate
@xsd(name = "ExchangeRate")
record ExchangeRate {
  /// BBIE
  /// Exchange Rate. Source_ Currency Code. Code
  /// The reference currency for this exchange rate; the currency from which the exchange is being made.
  /// 1
  /// Exchange Rate
  /// Source
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  @xsd(name = "SourceCurrencyCode") source_currency_code:      ubl_common_basic_components_2_1.SourceCurrencyCode
  /// BBIE
