  /// 0..1
  /// Catalogue Pricing Update Line
  /// Seller
  /// Supplier Party
  /// Supplier Party
  /// Supplier Party
  seller_supplier_party           SupplierParty?                     @xsd(name: "SellerSupplierParty")
  /// ASBIE
