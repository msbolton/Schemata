  /// 0..1
  /// Supplier Party
  /// Data Sending Capability
  /// Text
  /// Text. Type
  @xsd(name = "DataSendingCapability") data_sending_capability:      ubl_common_basic_components_2_1.DataSendingCapability?
  /// ASBIE
  /// Supplier Party. Party
  /// The supplier party itself.
  /// 0..1
  /// Supplier Party
  /// Party
  /// Party
  /// Party
  @xsd(name = "Party") party:                        Party?
  /// ASBIE
  /// Supplier Party. Despatch_ Contact. Contact
  /// A contact at this supplier party for despatches (pickups).
  /// 0..1
  /// Supplier Party
  /// Despatch
  /// Contact
  /// Contact
  /// Contact
  @xsd(name = "DespatchContact") despatch_contact:             Contact?
  /// ASBIE
  /// Supplier Party. Accounting_ Contact. Contact
  /// A contact at this supplier party for accounting.
  /// 0..1
  /// Supplier Party
  /// Accounting
  /// Contact
  /// Contact
  /// Contact
  @xsd(name = "AccountingContact") accounting_contact:           Contact?
  /// ASBIE
  /// Supplier Party. Seller_ Contact. Contact
  /// The primary contact for this supplier party.
  /// 0..1
  /// Supplier Party
  /// Seller
  /// Contact
  /// Contact
  /// Contact
  @xsd(name = "SellerContact") seller_contact:               Contact?
}

/// ABIE
/// Tax Category. Details
/// A class to describe one of the tax categories within a taxation scheme (e.g., High Rate VAT, Low Rate VAT).
/// Tax Category
record TaxCategory {
  /// BBIE
  /// Tax Category. Identifier
  /// An identifier for this tax category.
  /// 0..1
  /// Tax Category
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// http://www.unece.org/uncefact/codelist/standard/UNECE_DutyorTaxorFeeCategoryCode_D09B.xsd
  @xsd(name = "ID") id:                        ubl_common_basic_components_2_1.ID?
  /// BBIE
  /// Tax Category. Name
  /// The name of this tax category.
  /// 0..1
  /// Tax Category
  /// Name
  /// Name
  /// Name. Type
  /// Luxury Goods , Wine Equalization , Exempt
  @xsd(name = "Name") name:                      ubl_common_basic_components_2_1.Name?
  /// BBIE
  /// Tax Category. Percent
  /// The tax rate for this category, expressed as a percentage.
  /// 0..1
  /// Tax Category
  /// Percent
  /// Percent
  /// Percent. Type
  @xsd(name = "Percent") percent:                   ubl_common_basic_components_2_1.Percent?
  /// BBIE
  /// Tax Category. Base Unit Measure. Measure
  /// A Unit of Measures used as the basic for the tax calculation applied at a certain rate per unit.
  /// 0..1
  /// Tax Category
  /// Base Unit Measure
  /// Measure
  /// Measure. Type
  @xsd(name = "BaseUnitMeasure") base_unit_measure:         ubl_common_basic_components_2_1.BaseUnitMeasure?
  /// BBIE
  /// Tax Category. Per Unit_ Amount. Amount
  /// Where a tax is applied at a certain rate per unit, the rate per unit applied.
  /// 0..1
  /// Tax Category
  /// Per Unit
  /// Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "PerUnitAmount") per_unit_amount:           ubl_common_basic_components_2_1.PerUnitAmount?
  /// BBIE
  /// Tax Category. Tax Exemption Reason Code. Code
  /// The reason for tax being exempted, expressed as a code.
  /// 0..1
  /// Tax Category
  /// Tax Exemption Reason Code
  /// Code
  /// Code. Type
  /// http://www.unece.org/uncefact/codelist/standard/UNECE_DutyTaxFeeTypeCode_D09B.xsd
  @xsd(name = "TaxExemptionReasonCode") tax_exemption_reason_code: ubl_common_basic_components_2_1.TaxExemptionReasonCode?
  /// BBIE
  /// Tax Category. Tax Exemption Reason. Text
  /// The reason for tax being exempted, expressed as text.
  /// 0..n
  /// Tax Category
  /// Tax Exemption Reason
  /// Text
  /// Text. Type
  @xsd(name = "TaxExemptionReason") tax_exemption_reason:      list<ubl_common_basic_components_2_1.TaxExemptionReason>
  /// BBIE
  /// Tax Category. Tier Range. Text
  /// Where a tax is tiered, the range of taxable amounts that determines the rate of tax applicable to this tax category.
  /// 0..1
  /// Tax Category
  /// Tier Range
  /// Text
  /// Text. Type
  @xsd(name = "TierRange") tier_range:                ubl_common_basic_components_2_1.TierRange?
  /// BBIE
  /// Tax Category. Tier Rate. Percent
  /// Where a tax is tiered, the tax rate that applies within the specified range of taxable amounts for this tax category.
  /// 0..1
  /// Tax Category
  /// Tier Rate
  /// Percent
  /// Percent. Type
  @xsd(name = "TierRatePercent") tier_rate_percent:         ubl_common_basic_components_2_1.TierRatePercent?
  /// ASBIE
  /// Tax Category. Tax Scheme
  /// The taxation scheme within which this tax category is defined.
  /// 1
  /// Tax Category
  /// Tax Scheme
  /// Tax Scheme
  /// Tax Scheme
  @xsd(name = "TaxScheme") tax_scheme:                TaxScheme
}

/// ABIE
/// Tax Scheme. Details
/// A class to describe a taxation scheme (e.g., VAT, State tax, County tax).
/// Tax Scheme
@xsd(name = "TaxScheme")
record TaxScheme {
  /// BBIE
  /// Tax Scheme. Identifier
  /// An identifier for this taxation scheme.
  /// 0..1
  /// Tax Scheme
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// http://www.unece.org/uncefact/codelist/standard/EDIFICASEU_TaxExemptionReason_D09B.xsd
  @xsd(name = "ID") id:                          ubl_common_basic_components_2_1.ID?
  /// BBIE
  /// Tax Scheme. Name
  /// The name of this taxation scheme.
  /// 0..1
  /// Tax Scheme
  /// Name
  /// Name
  /// Name. Type
  /// Value Added Tax , Wholesale Tax , Sales Tax , State Tax
  @xsd(name = "Name") name:                        ubl_common_basic_components_2_1.Name?
  /// BBIE
  /// Tax Scheme. Tax Type Code. Code
  /// A code signifying the type of tax.
  /// 0..1
  /// Tax Scheme
  /// Tax Type Code
  /// Code
  /// Code. Type
  /// Consumption , Sales
  @xsd(name = "TaxTypeCode") tax_type_code:               ubl_common_basic_components_2_1.TaxTypeCode?
  /// BBIE
  /// Tax Scheme. Currency Code. Code
  /// A code signifying the currency in which the tax is collected and reported.
  /// 0..1
  /// Tax Scheme
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  @xsd(name = "CurrencyCode") currency_code:               ubl_common_basic_components_2_1.CurrencyCode?
  /// ASBIE
  /// Tax Scheme. Jurisdiction Region_ Address. Address
  /// A geographic area in which this taxation scheme applies.
  /// 0..n
  /// Tax Scheme
  /// Jurisdiction Region
  /// Address
  /// Address
  /// Address
  @xsd(name = "JurisdictionRegionAddress") jurisdiction_region_address: list<Address>
}

/// ABIE
/// Tax Subtotal. Details
/// A class to define the subtotal for a particular tax category within a particular taxation scheme, such as standard rate within VAT.
/// Tax Subtotal
@xsd(name = "TaxSubtotal")
record TaxSubtotal {
  /// BBIE
  /// Tax Subtotal. Taxable_ Amount. Amount
  /// The net amount to which the tax percent (rate) is applied to calculate the tax amount.
  /// 0..1
  /// Tax Subtotal
  /// Taxable
  /// Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "TaxableAmount") taxable_amount:                  ubl_common_basic_components_2_1.TaxableAmount?
  /// BBIE
  /// Tax Subtotal. Tax Amount. Amount
  /// The amount of this tax subtotal.
  /// 1
  /// Tax Subtotal
  /// Tax Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "TaxAmount") tax_amount:                      ubl_common_basic_components_2_1.TaxAmount
  /// BBIE
  /// Tax Subtotal. Calculation Sequence. Numeric
  /// The number of this tax subtotal in the sequence of subtotals corresponding to the order in which multiple taxes are applied. If all taxes are applied to the same taxable amount (i.e., their order of application is inconsequential), then CalculationSequenceNumeric is 1 for all tax subtotals applied to a given amount.
  /// 0..1
  /// Tax Subtotal
  /// Calculation Sequence
  /// Numeric
  /// Numeric. Type
  @xsd(name = "CalculationSequenceNumeric") calculation_sequence_numeric:    ubl_common_basic_components_2_1.CalculationSequenceNumeric?
  /// BBIE
  /// Tax Subtotal. Transaction Currency_ Tax Amount. Amount
  /// The amount of this tax subtotal, expressed in the currency used for invoicing.
  /// 0..1
  /// Tax Subtotal
  /// Transaction Currency
  /// Tax Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "TransactionCurrencyTaxAmount") transaction_currency_tax_amount: ubl_common_basic_components_2_1.TransactionCurrencyTaxAmount?
  /// BBIE
  /// Tax Subtotal. Percent
  /// The tax rate of the tax category applied to this tax subtotal, expressed as a percentage.
  /// 0..1
  /// Tax Subtotal
  /// Percent
  /// Percent
  /// Percent. Type
  @xsd(name = "Percent") percent:                         ubl_common_basic_components_2_1.Percent?
  /// BBIE
  /// Tax Subtotal. Base Unit Measure. Measure
  /// The unit of measure on which the tax calculation is based
  /// 0..1
  /// Tax Subtotal
  /// Base Unit Measure
  /// Measure
  /// Measure. Type
  @xsd(name = "BaseUnitMeasure") base_unit_measure:               ubl_common_basic_components_2_1.BaseUnitMeasure?
  /// BBIE
  /// Tax Subtotal. Per Unit_ Amount. Amount
  /// Where a tax is applied at a certain rate per unit, the rate per unit applied.
  /// 0..1
  /// Tax Subtotal
  /// Per Unit
  /// Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "PerUnitAmount") per_unit_amount:                 ubl_common_basic_components_2_1.PerUnitAmount?
  /// BBIE
  /// Tax Subtotal. Tier Range. Text
  /// Where a tax is tiered, the range of taxable amounts that determines the rate of tax applicable to this tax subtotal.
  /// 0..1
  /// Tax Subtotal
  /// Tier Range
  /// Text
  /// Text. Type
  @xsd(name = "TierRange") tier_range:                      ubl_common_basic_components_2_1.TierRange?
  /// BBIE
  /// Tax Subtotal. Tier Rate. Percent
  /// Where a tax is tiered, the tax rate that applies within a specified range of taxable amounts for this tax subtotal.
  /// 0..1
  /// Tax Subtotal
  /// Tier Rate
  /// Percent
  /// Percent. Type
  @xsd(name = "TierRatePercent") tier_rate_percent:               ubl_common_basic_components_2_1.TierRatePercent?
  /// ASBIE
  /// Tax Subtotal. Tax Category
  /// The tax category applicable to this subtotal.
  /// 1
  /// Tax Subtotal
  /// Tax Category
  /// Tax Category
  /// Tax Category
  @xsd(name = "TaxCategory") tax_category:                    TaxCategory
}

/// ABIE
/// Tax Total. Details
/// A class to describe the total tax for a particular taxation scheme.
/// Tax Total
@xsd(name = "TaxTotal")
record TaxTotal {
  /// BBIE
  /// Tax Total. Tax Amount. Amount
  /// The total tax amount for a particular taxation scheme, e.g., VAT; the sum of the tax subtotals for each tax category within the taxation scheme.
  /// 1
  /// Tax Total
  /// Tax Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "TaxAmount") tax_amount:             ubl_common_basic_components_2_1.TaxAmount
  /// BBIE
  /// Tax Total. Rounding Amount. Amount
  /// The rounding amount (positive or negative) added to the calculated tax total to produce the rounded TaxAmount.
  /// 0..1
  /// Tax Total
  /// Rounding Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "RoundingAmount") rounding_amount:        ubl_common_basic_components_2_1.RoundingAmount?
  /// BBIE
  /// Tax Total. Tax Evidence_ Indicator. Indicator
  /// An indicator that this total is recognized as legal evidence for taxation purposes (true) or not (false).
  /// 0..1
  /// Tax Total
  /// Tax Evidence
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// default is negative
  @xsd(name = "TaxEvidenceIndicator") tax_evidence_indicator: ubl_common_basic_components_2_1.TaxEvidenceIndicator?
  /// BBIE
  /// Tax Total. Tax Included_ Indicator. Indicator
  /// An indicator that tax is included in the calculation (true) or not (false).
  /// 0..1
  /// Tax Total
  /// Tax Included
  /// Indicator
  /// Indicator
  /// Indicator. Type
  @xsd(name = "TaxIncludedIndicator") tax_included_indicator: ubl_common_basic_components_2_1.TaxIncludedIndicator?
  /// ASBIE
  /// Tax Total. Tax Subtotal
  /// One of the subtotals the sum of which equals the total tax amount for a particular taxation scheme.
  /// 0..n
  /// Tax Total
  /// Tax Subtotal
  /// Tax Subtotal
  /// Tax Subtotal
  @xsd(name = "TaxSubtotal") tax_subtotal:           list<TaxSubtotal>
}

/// ABIE
/// Telecommunications Service. Details
/// A class to describe a telecommunications service (e.g., a telephone call or a video on demand service).
/// Telecommunications Service
@xsd(name = "TelecommunicationsService")
record TelecommunicationsService {
  /// BBIE
  /// Telecommunications Service. Identifier
  /// An identifier for this telecommunications service.
  /// 0..1
  /// Telecommunications Service
  /// Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "ID") id:                                       ubl_common_basic_components_2_1.ID?
  /// BBIE
  /// Telecommunications Service. Call_ Date. Date
  /// In the case of a telephone call, the date of the call.
  /// 1
  /// Telecommunications Service
  /// Call
  /// Date
  /// Date
  /// Date. Type
  /// 2008-01-01
  @xsd(name = "CallDate") call_date:                                ubl_common_basic_components_2_1.CallDate
  /// BBIE
  /// Telecommunications Service. Call_ Time. Time
  /// In the case of a telephone call, the time of the call.
  /// 1
  /// Telecommunications Service
  /// Call
  /// Time
  /// Time
  /// Time. Type
  /// 00:01:00
  @xsd(name = "CallTime") call_time:                                ubl_common_basic_components_2_1.CallTime
  /// BBIE
  /// Telecommunications Service. Service Number Called. Text
  /// In the case of a telephone call, the phone number called.
  /// 1
  /// Telecommunications Service
  /// Service Number Called
  /// Text
  /// Text. Type
  /// 12345679
  @xsd(name = "ServiceNumberCalled") service_number_called:                    ubl_common_basic_components_2_1.ServiceNumberCalled
  /// BBIE
  /// Telecommunications Service. Telecommunications Service Category. Text
  /// The telecommunications category, expressed as text.
  /// 0..1
  /// Telecommunications Service
  /// Telecommunications Service Category
  /// Text
  /// Text. Type
  /// Subscription
  @xsd(name = "TelecommunicationsServiceCategory") telecommunications_service_category:      ubl_common_basic_components_2_1.TelecommunicationsServiceCategory?
  /// BBIE
  /// Telecommunications Service. Telecommunications Service Category Code. Code
  /// The telecommunications category, expressed as a code.
  /// 0..1
  /// Telecommunications Service
  /// Telecommunications Service Category Code
  /// Code
  /// Code. Type
  /// Subscription
  @xsd(name = "TelecommunicationsServiceCategoryCode") telecommunications_service_category_code: ubl_common_basic_components_2_1.TelecommunicationsServiceCategoryCode?
  /// BBIE
  /// Telecommunications Service. Movie Title. Text
  /// The title of a movie delivered via this telecommunications service.
  /// 0..1
  /// Telecommunications Service
  /// Movie Title
  /// Text
  /// Text. Type
  /// The Matrix
  @xsd(name = "MovieTitle") movie_title:                              ubl_common_basic_components_2_1.MovieTitle?
  /// BBIE
  /// Telecommunications Service. Roaming Partner Name. Name
  /// Statement of the roaming partner name.
  /// 0..1
  /// Telecommunications Service
  /// Roaming Partner Name
  /// Name
  /// Name. Type
  @xsd(name = "RoamingPartnerName") roaming_partner_name:                     ubl_common_basic_components_2_1.RoamingPartnerName?
  /// BBIE
  /// Telecommunications Service. Pay Per View. Text
  /// A pay-per-view delivered via this telecommunications service.
  /// 0..1
  /// Telecommunications Service
  /// Pay Per View
  /// Text
  /// Text. Type
  @xsd(name = "PayPerView") pay_per_view:                             ubl_common_basic_components_2_1.PayPerView?
  /// BBIE
  /// Telecommunications Service. Quantity
  /// The number of calls.
  /// 0..1
  /// Telecommunications Service
  /// Quantity
  /// Quantity
  /// Quantity. Type
