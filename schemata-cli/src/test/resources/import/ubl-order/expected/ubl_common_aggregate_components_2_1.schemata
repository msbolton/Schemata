  /// Hazardous Item
  /// Net
  /// Volume
  /// Measure
  /// Measure. Type
  @xsd(name = "NetVolumeMeasure") net_volume_measure:             ubl_common_basic_components_2_1.NetVolumeMeasure?
  /// BBIE
  /// Hazardous Item. Quantity
