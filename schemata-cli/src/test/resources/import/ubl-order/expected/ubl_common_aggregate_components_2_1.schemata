  /// 0..1
  /// Supplier Party
  /// Data Sending Capability
  /// Text
  /// Text. Type
  data_sending_capability      ubl_common_basic_components_2_1.DataSendingCapability?     @xsd(name: "DataSendingCapability")
  /// ASBIE
  /// Supplier Party. Party
  /// The supplier party itself.
  /// 0..1
  /// Supplier Party
  /// Party
  /// Party
  /// Party
  party                        Party?                                                     @xsd(name: "Party")
  /// ASBIE
  /// Supplier Party. Despatch_ Contact. Contact
  /// A contact at this supplier party for despatches (pickups).
  /// 0..1
  /// Supplier Party
  /// Despatch
  /// Contact
  /// Contact
  /// Contact
  despatch_contact             Contact?                                                   @xsd(name: "DespatchContact")
  /// ASBIE
  /// Supplier Party. Accounting_ Contact. Contact
  /// A contact at this supplier party for accounting.
  /// 0..1
  /// Supplier Party
  /// Accounting
  /// Contact
  /// Contact
  /// Contact
  accounting_contact           Contact?                                                   @xsd(name: "AccountingContact")
  /// ASBIE
