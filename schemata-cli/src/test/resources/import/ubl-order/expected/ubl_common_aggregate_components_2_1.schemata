  /// 0..1
  /// External Reference
  /// Hash Algorithm Method
  /// Text
  /// Text. Type
  @xsd(name = "HashAlgorithmMethod") hash_algorithm_method: ubl_common_basic_components_2_1.HashAlgorithmMethod?
  /// BBIE
  /// External Reference. Expiry Date. Date
