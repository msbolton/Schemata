  /// BBIE
  /// Qualification Resolution. Resolution. Text
  /// Text describing this qualification resolution.
  /// 0..n
  /// Qualification Resolution
  /// Resolution
  /// Text
  /// Text. Type
  resolution              ubl_common_basic_components_2_1.Resolution[]      @xsd(name: "Resolution")
  /// BBIE
  /// Qualification Resolution. Resolution Date. Date
  /// The date on which this qualification resolution was formalized.
  /// 1
  /// Qualification Resolution
  /// Resolution Date
  /// Date
  /// Date. Type
  resolution_date         ubl_common_basic_components_2_1.ResolutionDate    @xsd(name: "ResolutionDate")
  /// BBIE
  /// Qualification Resolution. Resolution Time. Time
  /// The time at which this qualification resolution was formalized.
  /// 0..1
  /// Qualification Resolution
  /// Resolution Time
  /// Time
  /// Time. Type
  resolution_time         ubl_common_basic_components_2_1.ResolutionTime?   @xsd(name: "ResolutionTime")
  /// ASBIE
