  /// 1
  /// Meter Reading
  /// Delivered
  /// Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "DeliveredQuantity") delivered_quantity:                 ubl_common_basic_components_2_1.DeliveredQuantity
}

/// ABIE
