  /// 0..1
  /// Line Item
  /// Maximum
  /// Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "MaximumQuantity") maximum_quantity:             ubl_common_basic_components_2_1.MaximumQuantity?
  /// BBIE
  /// Line Item. Minimum_ Backorder. Quantity
  /// The minimum back order quantity of the item associated with this line (where back order is allowed).
  /// 0..1
  /// Line Item
  /// Minimum
  /// Backorder
  /// Quantity
  /// Quantity. Type
  @xsd(name = "MinimumBackorderQuantity") minimum_backorder_quantity:   ubl_common_basic_components_2_1.MinimumBackorderQuantity?
  /// BBIE
  /// Line Item. Maximum_ Backorder. Quantity
