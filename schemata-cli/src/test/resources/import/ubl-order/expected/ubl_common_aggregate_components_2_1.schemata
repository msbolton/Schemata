  /// The primary contact for this supplier party.
  /// 0..1
  /// Supplier Party
  /// Seller
  /// Contact
  /// Contact
  /// Contact
  seller_contact               Contact?                                                   @xsd(name: "SellerContact")
}

/// ABIE
/// Tax Category. Details
/// A class to describe one of the tax categories within a taxation scheme (e.g., High Rate VAT, Low Rate VAT).
/// Tax Category
model TaxCategory {
  /// BBIE
  /// Tax Category. Identifier
  /// An identifier for this tax category.
  /// 0..1
  /// Tax Category
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// http://www.unece.org/uncefact/codelist/standard/UNECE_DutyorTaxorFeeCategoryCode_D09B.xsd
  id                        ubl_common_basic_components_2_1.ID?                     @xsd(name: "ID")
  /// BBIE
  /// Tax Category. Name
  /// The name of this tax category.
  /// 0..1
  /// Tax Category
  /// Name
  /// Name
  /// Name. Type
  /// Luxury Goods , Wine Equalization , Exempt
  name                      ubl_common_basic_components_2_1.Name?                   @xsd(name: "Name")
  /// BBIE
  /// Tax Category. Percent
  /// The tax rate for this category, expressed as a percentage.
  /// 0..1
  /// Tax Category
  /// Percent
  /// Percent
  /// Percent. Type
  percent                   ubl_common_basic_components_2_1.Percent?                @xsd(name: "Percent")
  /// BBIE
  /// Tax Category. Base Unit Measure. Measure
  /// A Unit of Measures used as the basic for the tax calculation applied at a certain rate per unit.
  /// 0..1
  /// Tax Category
  /// Base Unit Measure
  /// Measure
  /// Measure. Type
  base_unit_measure         ubl_common_basic_components_2_1.BaseUnitMeasure?        @xsd(name: "BaseUnitMeasure")
  /// BBIE
  /// Tax Category. Per Unit_ Amount. Amount
  /// Where a tax is applied at a certain rate per unit, the rate per unit applied.
  /// 0..1
  /// Tax Category
  /// Per Unit
  /// Amount
  /// Amount
  /// Amount. Type
  per_unit_amount           ubl_common_basic_components_2_1.PerUnitAmount?          @xsd(name: "PerUnitAmount")
  /// BBIE
  /// Tax Category. Tax Exemption Reason Code. Code
  /// The reason for tax being exempted, expressed as a code.
  /// 0..1
  /// Tax Category
  /// Tax Exemption Reason Code
  /// Code
  /// Code. Type
  /// http://www.unece.org/uncefact/codelist/standard/UNECE_DutyTaxFeeTypeCode_D09B.xsd
  tax_exemption_reason_code ubl_common_basic_components_2_1.TaxExemptionReasonCode? @xsd(name: "TaxExemptionReasonCode")
  /// BBIE
  /// Tax Category. Tax Exemption Reason. Text
  /// The reason for tax being exempted, expressed as text.
  /// 0..n
  /// Tax Category
  /// Tax Exemption Reason
  /// Text
  /// Text. Type
  tax_exemption_reason      ubl_common_basic_components_2_1.TaxExemptionReason[]    @xsd(name: "TaxExemptionReason")
  /// BBIE
  /// Tax Category. Tier Range. Text
  /// Where a tax is tiered, the range of taxable amounts that determines the rate of tax applicable to this tax category.
  /// 0..1
  /// Tax Category
  /// Tier Range
  /// Text
  /// Text. Type
  tier_range                ubl_common_basic_components_2_1.TierRange?              @xsd(name: "TierRange")
  /// BBIE
  /// Tax Category. Tier Rate. Percent
  /// Where a tax is tiered, the tax rate that applies within the specified range of taxable amounts for this tax category.
  /// 0..1
  /// Tax Category
  /// Tier Rate
  /// Percent
  /// Percent. Type
  tier_rate_percent         ubl_common_basic_components_2_1.TierRatePercent?        @xsd(name: "TierRatePercent")
  /// ASBIE
  /// Tax Category. Tax Scheme
  /// The taxation scheme within which this tax category is defined.
  /// 1
  /// Tax Category
  /// Tax Scheme
  /// Tax Scheme
  /// Tax Scheme
  tax_scheme                TaxScheme                                               @xsd(name: "TaxScheme")
}

/// ABIE
/// Tax Scheme. Details
/// A class to describe a taxation scheme (e.g., VAT, State tax, County tax).
/// Tax Scheme
model TaxScheme {
  /// BBIE
  /// Tax Scheme. Identifier
  /// An identifier for this taxation scheme.
  /// 0..1
  /// Tax Scheme
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// http://www.unece.org/uncefact/codelist/standard/EDIFICASEU_TaxExemptionReason_D09B.xsd
  id                          ubl_common_basic_components_2_1.ID?           @xsd(name: "ID")
  /// BBIE
  /// Tax Scheme. Name
  /// The name of this taxation scheme.
  /// 0..1
  /// Tax Scheme
  /// Name
  /// Name
  /// Name. Type
  /// Value Added Tax , Wholesale Tax , Sales Tax , State Tax
  name                        ubl_common_basic_components_2_1.Name?         @xsd(name: "Name")
  /// BBIE
  /// Tax Scheme. Tax Type Code. Code
  /// A code signifying the type of tax.
  /// 0..1
  /// Tax Scheme
  /// Tax Type Code
  /// Code
  /// Code. Type
  /// Consumption , Sales
  tax_type_code               ubl_common_basic_components_2_1.TaxTypeCode?  @xsd(name: "TaxTypeCode")
  /// BBIE
  /// Tax Scheme. Currency Code. Code
  /// A code signifying the currency in which the tax is collected and reported.
  /// 0..1
  /// Tax Scheme
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  currency_code               ubl_common_basic_components_2_1.CurrencyCode? @xsd(name: "CurrencyCode")
  /// ASBIE
  /// Tax Scheme. Jurisdiction Region_ Address. Address
  /// A geographic area in which this taxation scheme applies.
  /// 0..n
  /// Tax Scheme
  /// Jurisdiction Region
  /// Address
  /// Address
  /// Address
  jurisdiction_region_address Address[]                                     @xsd(name: "JurisdictionRegionAddress")

  @@xsd(name: "TaxScheme")
}

/// ABIE
/// Tax Subtotal. Details
/// A class to define the subtotal for a particular tax category within a particular taxation scheme, such as standard rate within VAT.
/// Tax Subtotal
model TaxSubtotal {
  /// BBIE
  /// Tax Subtotal. Taxable_ Amount. Amount
  /// The net amount to which the tax percent (rate) is applied to calculate the tax amount.
  /// 0..1
  /// Tax Subtotal
  /// Taxable
  /// Amount
  /// Amount
  /// Amount. Type
  taxable_amount                  ubl_common_basic_components_2_1.TaxableAmount?                @xsd(name: "TaxableAmount")
  /// BBIE
  /// Tax Subtotal. Tax Amount. Amount
  /// The amount of this tax subtotal.
  /// 1
  /// Tax Subtotal
  /// Tax Amount
  /// Amount
  /// Amount. Type
  tax_amount                      ubl_common_basic_components_2_1.TaxAmount                     @xsd(name: "TaxAmount")
  /// BBIE
  /// Tax Subtotal. Calculation Sequence. Numeric
  /// The number of this tax subtotal in the sequence of subtotals corresponding to the order in which multiple taxes are applied. If all taxes are applied to the same taxable amount (i.e., their order of application is inconsequential), then CalculationSequenceNumeric is 1 for all tax subtotals applied to a given amount.
  /// 0..1
  /// Tax Subtotal
  /// Calculation Sequence
  /// Numeric
  /// Numeric. Type
  calculation_sequence_numeric    ubl_common_basic_components_2_1.CalculationSequenceNumeric?   @xsd(name: "CalculationSequenceNumeric")
  /// BBIE
  /// Tax Subtotal. Transaction Currency_ Tax Amount. Amount
  /// The amount of this tax subtotal, expressed in the currency used for invoicing.
  /// 0..1
  /// Tax Subtotal
  /// Transaction Currency
  /// Tax Amount
  /// Amount
  /// Amount. Type
  transaction_currency_tax_amount ubl_common_basic_components_2_1.TransactionCurrencyTaxAmount? @xsd(name: "TransactionCurrencyTaxAmount")
  /// BBIE
  /// Tax Subtotal. Percent
  /// The tax rate of the tax category applied to this tax subtotal, expressed as a percentage.
  /// 0..1
  /// Tax Subtotal
  /// Percent
  /// Percent
  /// Percent. Type
  percent                         ubl_common_basic_components_2_1.Percent?                      @xsd(name: "Percent")
  /// BBIE
  /// Tax Subtotal. Base Unit Measure. Measure
  /// The unit of measure on which the tax calculation is based
  /// 0..1
  /// Tax Subtotal
  /// Base Unit Measure
  /// Measure
  /// Measure. Type
  base_unit_measure               ubl_common_basic_components_2_1.BaseUnitMeasure?              @xsd(name: "BaseUnitMeasure")
  /// BBIE
  /// Tax Subtotal. Per Unit_ Amount. Amount
  /// Where a tax is applied at a certain rate per unit, the rate per unit applied.
  /// 0..1
  /// Tax Subtotal
  /// Per Unit
  /// Amount
  /// Amount
  /// Amount. Type
  per_unit_amount                 ubl_common_basic_components_2_1.PerUnitAmount?                @xsd(name: "PerUnitAmount")
  /// BBIE
  /// Tax Subtotal. Tier Range. Text
  /// Where a tax is tiered, the range of taxable amounts that determines the rate of tax applicable to this tax subtotal.
  /// 0..1
  /// Tax Subtotal
  /// Tier Range
  /// Text
  /// Text. Type
  tier_range                      ubl_common_basic_components_2_1.TierRange?                    @xsd(name: "TierRange")
  /// BBIE
  /// Tax Subtotal. Tier Rate. Percent
  /// Where a tax is tiered, the tax rate that applies within a specified range of taxable amounts for this tax subtotal.
  /// 0..1
  /// Tax Subtotal
  /// Tier Rate
  /// Percent
  /// Percent. Type
  tier_rate_percent               ubl_common_basic_components_2_1.TierRatePercent?              @xsd(name: "TierRatePercent")
  /// ASBIE
  /// Tax Subtotal. Tax Category
  /// The tax category applicable to this subtotal.
  /// 1
  /// Tax Subtotal
  /// Tax Category
  /// Tax Category
  /// Tax Category
  tax_category                    TaxCategory                                                   @xsd(name: "TaxCategory")

  @@xsd(name: "TaxSubtotal")
}

/// ABIE
/// Tax Total. Details
/// A class to describe the total tax for a particular taxation scheme.
/// Tax Total
model TaxTotal {
  /// BBIE
  /// Tax Total. Tax Amount. Amount
  /// The total tax amount for a particular taxation scheme, e.g., VAT; the sum of the tax subtotals for each tax category within the taxation scheme.
  /// 1
  /// Tax Total
  /// Tax Amount
  /// Amount
  /// Amount. Type
  tax_amount             ubl_common_basic_components_2_1.TaxAmount             @xsd(name: "TaxAmount")
  /// BBIE
  /// Tax Total. Rounding Amount. Amount
  /// The rounding amount (positive or negative) added to the calculated tax total to produce the rounded TaxAmount.
  /// 0..1
  /// Tax Total
  /// Rounding Amount
  /// Amount
  /// Amount. Type
  rounding_amount        ubl_common_basic_components_2_1.RoundingAmount?       @xsd(name: "RoundingAmount")
  /// BBIE
  /// Tax Total. Tax Evidence_ Indicator. Indicator
  /// An indicator that this total is recognized as legal evidence for taxation purposes (true) or not (false).
  /// 0..1
  /// Tax Total
  /// Tax Evidence
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// default is negative
  tax_evidence_indicator ubl_common_basic_components_2_1.TaxEvidenceIndicator? @xsd(name: "TaxEvidenceIndicator")
  /// BBIE
  /// Tax Total. Tax Included_ Indicator. Indicator
  /// An indicator that tax is included in the calculation (true) or not (false).
  /// 0..1
  /// Tax Total
  /// Tax Included
  /// Indicator
  /// Indicator
  /// Indicator. Type
  tax_included_indicator ubl_common_basic_components_2_1.TaxIncludedIndicator? @xsd(name: "TaxIncludedIndicator")
  /// ASBIE
  /// Tax Total. Tax Subtotal
  /// One of the subtotals the sum of which equals the total tax amount for a particular taxation scheme.
  /// 0..n
  /// Tax Total
  /// Tax Subtotal
  /// Tax Subtotal
  /// Tax Subtotal
  tax_subtotal           TaxSubtotal[]                                         @xsd(name: "TaxSubtotal")

  @@xsd(name: "TaxTotal")
}

/// ABIE
/// Telecommunications Service. Details
/// A class to describe a telecommunications service (e.g., a telephone call or a video on demand service).
/// Telecommunications Service
model TelecommunicationsService {
  /// BBIE
  /// Telecommunications Service. Identifier
  /// An identifier for this telecommunications service.
  /// 0..1
  /// Telecommunications Service
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                                       ubl_common_basic_components_2_1.ID?                                    @xsd(name: "ID")
  /// BBIE
  /// Telecommunications Service. Call_ Date. Date
  /// In the case of a telephone call, the date of the call.
  /// 1
  /// Telecommunications Service
  /// Call
  /// Date
  /// Date
  /// Date. Type
  /// 2008-01-01
  call_date                                ubl_common_basic_components_2_1.CallDate                               @xsd(name: "CallDate")
  /// BBIE
  /// Telecommunications Service. Call_ Time. Time
  /// In the case of a telephone call, the time of the call.
  /// 1
  /// Telecommunications Service
  /// Call
  /// Time
  /// Time
  /// Time. Type
  /// 00:01:00
  call_time                                ubl_common_basic_components_2_1.CallTime                               @xsd(name: "CallTime")
  /// BBIE
  /// Telecommunications Service. Service Number Called. Text
  /// In the case of a telephone call, the phone number called.
  /// 1
  /// Telecommunications Service
  /// Service Number Called
  /// Text
  /// Text. Type
  /// 12345679
  service_number_called                    ubl_common_basic_components_2_1.ServiceNumberCalled                    @xsd(name: "ServiceNumberCalled")
  /// BBIE
  /// Telecommunications Service. Telecommunications Service Category. Text
  /// The telecommunications category, expressed as text.
  /// 0..1
  /// Telecommunications Service
  /// Telecommunications Service Category
  /// Text
  /// Text. Type
  /// Subscription
  telecommunications_service_category      ubl_common_basic_components_2_1.TelecommunicationsServiceCategory?     @xsd(name: "TelecommunicationsServiceCategory")
  /// BBIE
  /// Telecommunications Service. Telecommunications Service Category Code. Code
  /// The telecommunications category, expressed as a code.
  /// 0..1
  /// Telecommunications Service
  /// Telecommunications Service Category Code
  /// Code
  /// Code. Type
  /// Subscription
  telecommunications_service_category_code ubl_common_basic_components_2_1.TelecommunicationsServiceCategoryCode? @xsd(name: "TelecommunicationsServiceCategoryCode")
  /// BBIE
  /// Telecommunications Service. Movie Title. Text
  /// The title of a movie delivered via this telecommunications service.
  /// 0..1
  /// Telecommunications Service
  /// Movie Title
  /// Text
  /// Text. Type
  /// The Matrix
  movie_title                              ubl_common_basic_components_2_1.MovieTitle?                            @xsd(name: "MovieTitle")
  /// BBIE
  /// Telecommunications Service. Roaming Partner Name. Name
