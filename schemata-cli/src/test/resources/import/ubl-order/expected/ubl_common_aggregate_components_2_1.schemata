/// ABIE
/// Shipment. Details
/// A class defining an identifiable collection of one or more goods items to be transported between the seller party and the buyer party. This information may be defined within a commercial contract. A shipment can be transported in different consignments (e.g., split for logistical purposes).
/// Shipment
model Shipment {
  /// BBIE
  /// Shipment. Identifier
  /// An identifier for this shipment.
  /// 1
  /// Shipment
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// Waybill Number
  id                                     ubl_common_basic_components_2_1.ID                                  @xsd(name: "ID")
  /// BBIE
  /// Shipment. Shipping Priority Level Code. Code
  /// A code signifying the priority or level of service required for this shipment.
  /// 0..1
  /// Shipment
  /// Shipping Priority Level Code
  /// Code
  /// Code. Type
  /// Service Level, Service Priority
  shipping_priority_level_code           ubl_common_basic_components_2_1.ShippingPriorityLevelCode?          @xsd(name: "ShippingPriorityLevelCode")
  /// BBIE
  /// Shipment. Handling Code. Code
  /// The handling required for this shipment, expressed as a code.
  /// 0..1
  /// Shipment
  /// Handling Code
  /// Code
  /// Code. Type
  /// Special Handling
  handling_code                          ubl_common_basic_components_2_1.HandlingCode?                       @xsd(name: "HandlingCode")
  /// BBIE
  /// Shipment. Handling_ Instructions. Text
  /// The handling required for this shipment, expressed as text.
  /// 0..n
  /// Shipment
  /// Handling
  /// Instructions
  /// Text
  /// Text. Type
  handling_instructions                  ubl_common_basic_components_2_1.HandlingInstructions[]              @xsd(name: "HandlingInstructions")
  /// BBIE
  /// Shipment. Information. Text
  /// Free-form text pertinent to this shipment, conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Shipment
  /// Information
  /// Text
  /// Text. Type
  information                            ubl_common_basic_components_2_1.Information[]                       @xsd(name: "Information")
  /// BBIE
  /// Shipment. Gross_ Weight. Measure
  /// The total gross weight of a shipment; the weight of the goods plus packaging plus transport equipment.
  /// 0..1
  /// Shipment
  /// Gross
  /// Weight
  /// Measure
  /// Measure. Type
  gross_weight_measure                   ubl_common_basic_components_2_1.GrossWeightMeasure?                 @xsd(name: "GrossWeightMeasure")
  /// BBIE
  /// Shipment. Net_ Weight. Measure
  /// The net weight of this shipment, excluding packaging.
  /// 0..1
  /// Shipment
  /// Net
  /// Weight
  /// Measure
  /// Measure. Type
  net_weight_measure                     ubl_common_basic_components_2_1.NetWeightMeasure?                   @xsd(name: "NetWeightMeasure")
  /// BBIE
  /// Shipment. Net Net_ Weight. Measure
  /// The total net weight of this shipment, excluding packaging and transport equipment.
  /// 0..1
  /// Shipment
  /// Net Net
  /// Weight
  /// Measure
  /// Measure. Type
  net_net_weight_measure                 ubl_common_basic_components_2_1.NetNetWeightMeasure?                @xsd(name: "NetNetWeightMeasure")
  /// BBIE
  /// Shipment. Gross_ Volume. Measure
  /// The total volume of the goods in this shipment, including packaging.
  /// 0..1
  /// Shipment
  /// Gross
  /// Volume
  /// Measure
  /// Measure. Type
  gross_volume_measure                   ubl_common_basic_components_2_1.GrossVolumeMeasure?                 @xsd(name: "GrossVolumeMeasure")
  /// BBIE
  /// Shipment. Net_ Volume. Measure
  /// The total volume of the goods in this shipment, excluding packaging and transport equipment.
  /// 0..1
  /// Shipment
  /// Net
  /// Volume
  /// Measure
  /// Measure. Type
  net_volume_measure                     ubl_common_basic_components_2_1.NetVolumeMeasure?                   @xsd(name: "NetVolumeMeasure")
  /// BBIE
  /// Shipment. Total_ Goods Item Quantity. Quantity
  /// The total number of goods items in this shipment.
  /// 0..1
  /// Shipment
  /// Total
  /// Goods Item Quantity
  /// Quantity
  /// Quantity. Type
  total_goods_item_quantity              ubl_common_basic_components_2_1.TotalGoodsItemQuantity?             @xsd(name: "TotalGoodsItemQuantity")
  /// BBIE
  /// Shipment. Total_ Transport Handling Unit Quantity. Quantity
  /// The number of pieces of transport handling equipment (pallets, boxes, cases, etc.) in this shipment.
  /// 0..1
  /// Shipment
  /// Total
  /// Transport Handling Unit Quantity
  /// Quantity
  /// Quantity. Type
  /// Number of THUs
  total_transport_handling_unit_quantity ubl_common_basic_components_2_1.TotalTransportHandlingUnitQuantity? @xsd(name: "TotalTransportHandlingUnitQuantity")
  /// BBIE
  /// Shipment. Insurance_ Value. Amount
  /// The amount covered by insurance for this shipment.
  /// 0..1
  /// Shipment
  /// Insurance
  /// Value
  /// Amount
  /// Amount. Type
  /// Value Insured
  insurance_value_amount                 ubl_common_basic_components_2_1.InsuranceValueAmount?               @xsd(name: "InsuranceValueAmount")
  /// BBIE
  /// Shipment. Declared Customs_ Value. Amount
  /// The total declared value for customs purposes of those goods in this shipment that are subject to the same customs procedure and have the same tariff/statistical heading, country information, and duty regime.
  /// 0..1
  /// Shipment
  /// Declared Customs
  /// Value
  /// Amount
  /// Amount. Type
  declared_customs_value_amount          ubl_common_basic_components_2_1.DeclaredCustomsValueAmount?         @xsd(name: "DeclaredCustomsValueAmount")
  /// BBIE
  /// Shipment. Declared For Carriage_ Value. Amount
  /// The value of this shipment, declared by the shipper or his agent solely for the purpose of varying the carrier's level of liability from that provided in the contract of carriage, in case of loss or damage to goods or delayed delivery.
  /// 0..1
  /// Shipment
  /// Declared For Carriage
  /// Value
  /// Amount
  /// Amount. Type
  /// Declared value for carriage, Interest in delivery
  declared_for_carriage_value_amount     ubl_common_basic_components_2_1.DeclaredForCarriageValueAmount?     @xsd(name: "DeclaredForCarriageValueAmount")
  /// BBIE
  /// Shipment. Declared Statistics_ Value. Amount
  /// The value, declared for statistical purposes, of those goods in this shipment that have the same statistical heading.
  /// 0..1
  /// Shipment
  /// Declared Statistics
  /// Value
  /// Amount
  /// Amount. Type
  /// Statistical Value
  declared_statistics_value_amount       ubl_common_basic_components_2_1.DeclaredStatisticsValueAmount?      @xsd(name: "DeclaredStatisticsValueAmount")
  /// BBIE
  /// Shipment. Free On Board_ Value. Amount
  /// The monetary amount that has to be or has been paid as calculated under the applicable trade delivery.
  /// 0..1
  /// Shipment
  /// Free On Board
  /// Value
  /// Amount
  /// Amount. Type
  /// FOB Value
  free_on_board_value_amount             ubl_common_basic_components_2_1.FreeOnBoardValueAmount?             @xsd(name: "FreeOnBoardValueAmount")
  /// BBIE
  /// Shipment. Special_ Instructions. Text
  /// Special instructions relating to this shipment.
  /// 0..n
  /// Shipment
  /// Special
  /// Instructions
  /// Text
  /// Text. Type
  special_instructions                   ubl_common_basic_components_2_1.SpecialInstructions[]               @xsd(name: "SpecialInstructions")
  /// BBIE
  /// Shipment. Delivery_ Instructions. Text
  /// Delivery instructions relating to this shipment.
  /// 0..n
  /// Shipment
  /// Delivery
  /// Instructions
  /// Text
  /// Text. Type
  delivery_instructions                  ubl_common_basic_components_2_1.DeliveryInstructions[]              @xsd(name: "DeliveryInstructions")
  /// BBIE
  /// Shipment. Split Consignment_ Indicator. Indicator
  /// An indicator that the consignment has been split in transit (true) or not (false).
  /// 0..1
  /// Shipment
  /// Split Consignment
  /// Indicator
  /// Indicator
  /// Indicator. Type
  split_consignment_indicator            ubl_common_basic_components_2_1.SplitConsignmentIndicator?          @xsd(name: "SplitConsignmentIndicator")
  /// BBIE
  /// Shipment. Consignment_ Quantity. Quantity
  /// The total number of consignments within this shipment.
  /// 0..1
  /// Shipment
  /// Consignment
  /// Quantity
  /// Quantity
  /// Quantity. Type
  consignment_quantity                   ubl_common_basic_components_2_1.ConsignmentQuantity?                @xsd(name: "ConsignmentQuantity")
  /// ASBIE
  /// Shipment. Consignment
  /// A consignment covering this shipment.
  /// 0..n
  /// Shipment
  /// Consignment
  /// Consignment
  /// Consignment
  consignment                            Consignment[]                                                       @xsd(name: "Consignment")
  /// ASBIE
  /// Shipment. Goods Item
  /// A goods item included in this shipment.
  /// 0..n
  /// Shipment
  /// Goods Item
  /// Goods Item
  /// Goods Item
  goods_item                             GoodsItem[]                                                         @xsd(name: "GoodsItem")
  /// ASBIE
  /// Shipment. Shipment Stage
  /// A stage in the transport movement of this shipment.
  /// 0..n
  /// Shipment
  /// Shipment Stage
  /// Shipment Stage
  /// Shipment Stage
  shipment_stage                         ShipmentStage[]                                                     @xsd(name: "ShipmentStage")
  /// ASBIE
  /// Shipment. Delivery
  /// The delivery of this shipment.
  /// 0..1
  /// Shipment
  /// Delivery
  /// Delivery
  /// Delivery
  delivery                               Delivery?                                                           @xsd(name: "Delivery")
  /// ASBIE
  /// Shipment. Transport Handling Unit
  /// A transport handling unit associated with this shipment.
  /// 0..n
  /// Shipment
  /// Transport Handling Unit
  /// Transport Handling Unit
  /// Transport Handling Unit
  transport_handling_unit                TransportHandlingUnit[]                                             @xsd(name: "TransportHandlingUnit")
  /// ASBIE
  /// Shipment. Return_ Address. Address
  /// The address to which a shipment should be returned.
  /// 0..1
  /// Shipment
  /// Return
  /// Address
  /// Address
  /// Address
  return_address                         Address?                                                            @xsd(name: "ReturnAddress")
  /// ASBIE
  /// Shipment. Origin_ Address. Address
  /// The region in which the goods have been produced or manufactured, according to criteria laid down for the purposes of application of the customs tariff, or of quantitative restrictions, or of any other measure related to trade.
  /// 0..1
  /// Shipment
  /// Origin
  /// Address
  /// Address
  /// Address
  origin_address                         Address?                                                            @xsd(name: "OriginAddress")
  /// ASBIE
  /// Shipment. First Arrival Port_ Location. Location
  /// The first arrival location of a shipment. This would be a port for sea, an airport for air, a terminal for rail, or a border post for land crossing.
  /// 0..1
  /// Shipment
