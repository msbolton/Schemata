  /// 0..1
  /// Procurement Project
  /// Required
  /// Fee
  /// Amount
  /// Amount. Type
  required_fee_amount                 ubl_common_basic_components_2_1.RequiredFeeAmount?                @xsd(name: "RequiredFeeAmount")
  /// BBIE
  /// Procurement Project. Fee_ Description. Text
  /// Text describing the reimbursement fee for concession procurement projects.
  /// 0..n
  /// Procurement Project
  /// Fee
  /// Description
  /// Text
  /// Text. Type
  fee_description                     ubl_common_basic_components_2_1.FeeDescription[]                  @xsd(name: "FeeDescription")
  /// BBIE
  /// Procurement Project. Requested_ Delivery Date. Date
  /// The requested delivery date for this procurement project.
  /// 0..1
  /// Procurement Project
  /// Requested
  /// Delivery Date
  /// Date
  /// Date. Type
  requested_delivery_date             ubl_common_basic_components_2_1.RequestedDeliveryDate?            @xsd(name: "RequestedDeliveryDate")
  /// BBIE
  /// Procurement Project. Estimated_ Overall Contract. Quantity
  /// The estimated overall quantity for this procurement project.
  /// 0..1
  /// Procurement Project
  /// Estimated
  /// Overall Contract
  /// Quantity
  /// Quantity. Type
  estimated_overall_contract_quantity ubl_common_basic_components_2_1.EstimatedOverallContractQuantity? @xsd(name: "EstimatedOverallContractQuantity")
  /// BBIE
  /// Procurement Project. Note. Text
  /// Free-form text applying to the Procurement Project. This element may contain additional information about the lot/contract that is not contained explicitly in another structure.
  /// 0..n
  /// Procurement Project
  /// Note
  /// Text
  /// Text. Type
  note                                ubl_common_basic_components_2_1.Note[]                            @xsd(name: "Note")
  /// ASBIE
  /// Procurement Project. Requested Tender Total
  /// Budget monetary amounts for the project as whole.
  /// 0..1
  /// Procurement Project
  /// Requested Tender Total
  /// Requested Tender Total
  /// Requested Tender Total
  requested_tender_total              RequestedTenderTotal?                                             @xsd(name: "RequestedTenderTotal")
  /// ASBIE
  /// Procurement Project. Main_ Commodity Classification. Commodity Classification
