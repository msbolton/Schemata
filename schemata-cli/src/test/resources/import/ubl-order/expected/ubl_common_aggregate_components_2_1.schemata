/// ABIE
/// Catalogue Reference. Details
/// A class to define a reference to a catalogue.
/// Catalogue Reference
@xsd(name = "CatalogueReference")
record CatalogueReference {
  /// BBIE
  /// Catalogue Reference. Identifier
  /// An identifier for a specific catalogue.
  /// 1
  /// Catalogue Reference
  /// Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "ID") id:                  ubl_common_basic_components_2_1.ID
  /// BBIE
  /// Catalogue Reference. UUID. Identifier
  /// A universally unique identifier for a specific catalogue.
  /// 0..1
  /// Catalogue Reference
  /// UUID
  /// Identifier
  /// Identifier. Type
  @xsd(name = "UUID") uuid:                ubl_common_basic_components_2_1.UUID?
