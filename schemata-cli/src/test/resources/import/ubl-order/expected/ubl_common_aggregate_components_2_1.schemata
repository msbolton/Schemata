/// ABIE
/// Service Provider Party. Details
/// A class to describe a party contracting to provide services, such as transportation, finance, etc.
/// Service Provider Party
@xsd(name = "ServiceProviderParty")
record ServiceProviderParty {
  /// BBIE
  /// Service Provider Party. Identifier
  /// An identifier for this service provider.
  /// 0..1
  /// Service Provider Party
  /// Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "ID") id:                ubl_common_basic_components_2_1.ID?
  /// BBIE
  /// Service Provider Party. Service Type Code. Code
  /// The type of service provided, expressed as a code.
  /// 0..1
  /// Service Provider Party
  /// Service Type Code
  /// Code
  /// Code. Type
  @xsd(name = "ServiceTypeCode") service_type_code: ubl_common_basic_components_2_1.ServiceTypeCode?
  /// BBIE
  /// Service Provider Party. Service Type. Text
  /// The type of service provided, expressed as text.
  /// 0..n
  /// Service Provider Party
  /// Service Type
  /// Text
  /// Text. Type
  @xsd(name = "ServiceType") service_type:      list<ubl_common_basic_components_2_1.ServiceType>
  /// ASBIE
  /// Service Provider Party. Party
  /// The party providing the service.
  /// 1
  /// Service Provider Party
  /// Party
  /// Party
  /// Party
  @xsd(name = "Party") party:             Party
  /// ASBIE
  /// Service Provider Party. Seller_ Contact. Contact
  /// The contact for the service provider.
  /// 0..1
  /// Service Provider Party
  /// Seller
  /// Contact
  /// Contact
  /// Contact
  @xsd(name = "SellerContact") seller_contact:    Contact?
}

/// ABIE
/// Shareholder Party. Details
/// A class to describe a shareholder party.
/// Shareholder Party
@xsd(name = "ShareholderParty")
record ShareholderParty {
  /// BBIE
  /// Shareholder Party. Partecipation. Percent
  /// The shareholder participation, expressed as a percentage.
  /// 0..1
  /// Shareholder Party
  /// Partecipation
  /// Percent
  /// Percent. Type
  @xsd(name = "PartecipationPercent") partecipation_percent: ubl_common_basic_components_2_1.PartecipationPercent?
  /// ASBIE
  /// Shareholder Party. Party
  /// The shareholder party.
  /// 0..1
  /// Shareholder Party
  /// Party
  /// Party
  /// Party
  @xsd(name = "Party") party:                 Party?
}

/// ABIE
/// Shipment. Details
/// A class defining an identifiable collection of one or more goods items to be transported between the seller party and the buyer party. This information may be defined within a commercial contract. A shipment can be transported in different consignments (e.g., split for logistical purposes).
/// Shipment
record Shipment {
  /// BBIE
  /// Shipment. Identifier
  /// An identifier for this shipment.
  /// 1
  /// Shipment
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// Waybill Number
  @xsd(name = "ID") id:                                     ubl_common_basic_components_2_1.ID
  /// BBIE
  /// Shipment. Shipping Priority Level Code. Code
  /// A code signifying the priority or level of service required for this shipment.
  /// 0..1
  /// Shipment
  /// Shipping Priority Level Code
  /// Code
  /// Code. Type
  /// Service Level, Service Priority
  @xsd(name = "ShippingPriorityLevelCode") shipping_priority_level_code:           ubl_common_basic_components_2_1.ShippingPriorityLevelCode?
  /// BBIE
  /// Shipment. Handling Code. Code
  /// The handling required for this shipment, expressed as a code.
  /// 0..1
  /// Shipment
  /// Handling Code
  /// Code
  /// Code. Type
  /// Special Handling
  @xsd(name = "HandlingCode") handling_code:                          ubl_common_basic_components_2_1.HandlingCode?
  /// BBIE
  /// Shipment. Handling_ Instructions. Text
  /// The handling required for this shipment, expressed as text.
  /// 0..n
  /// Shipment
  /// Handling
  /// Instructions
  /// Text
  /// Text. Type
  @xsd(name = "HandlingInstructions") handling_instructions:                  list<ubl_common_basic_components_2_1.HandlingInstructions>
  /// BBIE
  /// Shipment. Information. Text
  /// Free-form text pertinent to this shipment, conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Shipment
  /// Information
  /// Text
  /// Text. Type
  @xsd(name = "Information") information:                            list<ubl_common_basic_components_2_1.Information>
  /// BBIE
  /// Shipment. Gross_ Weight. Measure
  /// The total gross weight of a shipment; the weight of the goods plus packaging plus transport equipment.
  /// 0..1
  /// Shipment
  /// Gross
  /// Weight
  /// Measure
  /// Measure. Type
  @xsd(name = "GrossWeightMeasure") gross_weight_measure:                   ubl_common_basic_components_2_1.GrossWeightMeasure?
  /// BBIE
  /// Shipment. Net_ Weight. Measure
  /// The net weight of this shipment, excluding packaging.
  /// 0..1
  /// Shipment
  /// Net
  /// Weight
  /// Measure
  /// Measure. Type
  @xsd(name = "NetWeightMeasure") net_weight_measure:                     ubl_common_basic_components_2_1.NetWeightMeasure?
  /// BBIE
  /// Shipment. Net Net_ Weight. Measure
  /// The total net weight of this shipment, excluding packaging and transport equipment.
  /// 0..1
  /// Shipment
  /// Net Net
  /// Weight
  /// Measure
  /// Measure. Type
  @xsd(name = "NetNetWeightMeasure") net_net_weight_measure:                 ubl_common_basic_components_2_1.NetNetWeightMeasure?
  /// BBIE
  /// Shipment. Gross_ Volume. Measure
  /// The total volume of the goods in this shipment, including packaging.
  /// 0..1
  /// Shipment
  /// Gross
  /// Volume
  /// Measure
  /// Measure. Type
  @xsd(name = "GrossVolumeMeasure") gross_volume_measure:                   ubl_common_basic_components_2_1.GrossVolumeMeasure?
  /// BBIE
  /// Shipment. Net_ Volume. Measure
  /// The total volume of the goods in this shipment, excluding packaging and transport equipment.
  /// 0..1
  /// Shipment
  /// Net
  /// Volume
  /// Measure
  /// Measure. Type
  @xsd(name = "NetVolumeMeasure") net_volume_measure:                     ubl_common_basic_components_2_1.NetVolumeMeasure?
  /// BBIE
  /// Shipment. Total_ Goods Item Quantity. Quantity
  /// The total number of goods items in this shipment.
  /// 0..1
  /// Shipment
  /// Total
  /// Goods Item Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "TotalGoodsItemQuantity") total_goods_item_quantity:              ubl_common_basic_components_2_1.TotalGoodsItemQuantity?
  /// BBIE
  /// Shipment. Total_ Transport Handling Unit Quantity. Quantity
  /// The number of pieces of transport handling equipment (pallets, boxes, cases, etc.) in this shipment.
  /// 0..1
  /// Shipment
  /// Total
  /// Transport Handling Unit Quantity
  /// Quantity
  /// Quantity. Type
  /// Number of THUs
  @xsd(name = "TotalTransportHandlingUnitQuantity") total_transport_handling_unit_quantity: ubl_common_basic_components_2_1.TotalTransportHandlingUnitQuantity?
  /// BBIE
  /// Shipment. Insurance_ Value. Amount
  /// The amount covered by insurance for this shipment.
  /// 0..1
  /// Shipment
  /// Insurance
  /// Value
  /// Amount
  /// Amount. Type
  /// Value Insured
  @xsd(name = "InsuranceValueAmount") insurance_value_amount:                 ubl_common_basic_components_2_1.InsuranceValueAmount?
  /// BBIE
  /// Shipment. Declared Customs_ Value. Amount
  /// The total declared value for customs purposes of those goods in this shipment that are subject to the same customs procedure and have the same tariff/statistical heading, country information, and duty regime.
  /// 0..1
  /// Shipment
  /// Declared Customs
  /// Value
  /// Amount
  /// Amount. Type
  @xsd(name = "DeclaredCustomsValueAmount") declared_customs_value_amount:          ubl_common_basic_components_2_1.DeclaredCustomsValueAmount?
  /// BBIE
  /// Shipment. Declared For Carriage_ Value. Amount
  /// The value of this shipment, declared by the shipper or his agent solely for the purpose of varying the carrier's level of liability from that provided in the contract of carriage, in case of loss or damage to goods or delayed delivery.
  /// 0..1
  /// Shipment
  /// Declared For Carriage
  /// Value
  /// Amount
  /// Amount. Type
  /// Declared value for carriage, Interest in delivery
  @xsd(name = "DeclaredForCarriageValueAmount") declared_for_carriage_value_amount:     ubl_common_basic_components_2_1.DeclaredForCarriageValueAmount?
  /// BBIE
  /// Shipment. Declared Statistics_ Value. Amount
  /// The value, declared for statistical purposes, of those goods in this shipment that have the same statistical heading.
  /// 0..1
  /// Shipment
  /// Declared Statistics
  /// Value
  /// Amount
  /// Amount. Type
  /// Statistical Value
  @xsd(name = "DeclaredStatisticsValueAmount") declared_statistics_value_amount:       ubl_common_basic_components_2_1.DeclaredStatisticsValueAmount?
  /// BBIE
  /// Shipment. Free On Board_ Value. Amount
  /// The monetary amount that has to be or has been paid as calculated under the applicable trade delivery.
  /// 0..1
  /// Shipment
  /// Free On Board
  /// Value
  /// Amount
  /// Amount. Type
  /// FOB Value
  @xsd(name = "FreeOnBoardValueAmount") free_on_board_value_amount:             ubl_common_basic_components_2_1.FreeOnBoardValueAmount?
  /// BBIE
  /// Shipment. Special_ Instructions. Text
  /// Special instructions relating to this shipment.
  /// 0..n
  /// Shipment
  /// Special
  /// Instructions
  /// Text
  /// Text. Type
  @xsd(name = "SpecialInstructions") special_instructions:                   list<ubl_common_basic_components_2_1.SpecialInstructions>
  /// BBIE
  /// Shipment. Delivery_ Instructions. Text
  /// Delivery instructions relating to this shipment.
  /// 0..n
  /// Shipment
  /// Delivery
  /// Instructions
  /// Text
  /// Text. Type
  @xsd(name = "DeliveryInstructions") delivery_instructions:                  list<ubl_common_basic_components_2_1.DeliveryInstructions>
  /// BBIE
  /// Shipment. Split Consignment_ Indicator. Indicator
  /// An indicator that the consignment has been split in transit (true) or not (false).
  /// 0..1
  /// Shipment
  /// Split Consignment
  /// Indicator
  /// Indicator
  /// Indicator. Type
  @xsd(name = "SplitConsignmentIndicator") split_consignment_indicator:            ubl_common_basic_components_2_1.SplitConsignmentIndicator?
  /// BBIE
  /// Shipment. Consignment_ Quantity. Quantity
  /// The total number of consignments within this shipment.
  /// 0..1
  /// Shipment
  /// Consignment
  /// Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "ConsignmentQuantity") consignment_quantity:                   ubl_common_basic_components_2_1.ConsignmentQuantity?
  /// ASBIE
  /// Shipment. Consignment
  /// A consignment covering this shipment.
  /// 0..n
  /// Shipment
  /// Consignment
  /// Consignment
  /// Consignment
  @xsd(name = "Consignment") consignment:                            list<Consignment>
  /// ASBIE
  /// Shipment. Goods Item
  /// A goods item included in this shipment.
  /// 0..n
  /// Shipment
  /// Goods Item
  /// Goods Item
  /// Goods Item
  @xsd(name = "GoodsItem") goods_item:                             list<GoodsItem>
  /// ASBIE
  /// Shipment. Shipment Stage
  /// A stage in the transport movement of this shipment.
  /// 0..n
  /// Shipment
  /// Shipment Stage
  /// Shipment Stage
  /// Shipment Stage
  @xsd(name = "ShipmentStage") shipment_stage:                         list<ShipmentStage>
  /// ASBIE
  /// Shipment. Delivery
  /// The delivery of this shipment.
  /// 0..1
  /// Shipment
  /// Delivery
  /// Delivery
  /// Delivery
  @xsd(name = "Delivery") delivery:                               Delivery?
  /// ASBIE
  /// Shipment. Transport Handling Unit
  /// A transport handling unit associated with this shipment.
  /// 0..n
  /// Shipment
  /// Transport Handling Unit
  /// Transport Handling Unit
  /// Transport Handling Unit
  @xsd(name = "TransportHandlingUnit") transport_handling_unit:                list<TransportHandlingUnit>
  /// ASBIE
  /// Shipment. Return_ Address. Address
  /// The address to which a shipment should be returned.
  /// 0..1
  /// Shipment
  /// Return
  /// Address
  /// Address
  /// Address
  @xsd(name = "ReturnAddress") return_address:                         Address?
  /// ASBIE
  /// Shipment. Origin_ Address. Address
  /// The region in which the goods have been produced or manufactured, according to criteria laid down for the purposes of application of the customs tariff, or of quantitative restrictions, or of any other measure related to trade.
  /// 0..1
  /// Shipment
  /// Origin
  /// Address
  /// Address
  /// Address
  @xsd(name = "OriginAddress") origin_address:                         Address?
  /// ASBIE
  /// Shipment. First Arrival Port_ Location. Location
  /// The first arrival location of a shipment. This would be a port for sea, an airport for air, a terminal for rail, or a border post for land crossing.
  /// 0..1
  /// Shipment
  /// First Arrival Port
  /// Location
  /// Location
  /// Location
  @xsd(name = "FirstArrivalPortLocation") first_arrival_port_location:            ubl_common_aggregate_components_2_1.Location?
  /// ASBIE
  /// Shipment. Last Exit Port_ Location. Location
  /// The final exporting location for a shipment. This would be a port for sea, an airport for air, a terminal for rail, or a border post for land crossing.
  /// 0..1
  /// Shipment
  /// Last Exit Port
  /// Location
  /// Location
  /// Location
  @xsd(name = "LastExitPortLocation") last_exit_port_location:                ubl_common_aggregate_components_2_1.Location?
  /// ASBIE
  /// Shipment. Export_ Country. Country
  /// The country from which the goods were originally exported, without any commercial transaction taking place in intermediate countries.
  /// 0..1
  /// Shipment
  /// Export
  /// Country
  /// Country
  /// Country
  /// Country of exportation (WCO ID 062)
  @xsd(name = "ExportCountry") export_country:                         Country?
  /// ASBIE
  /// Shipment. Freight_ Allowance Charge. Allowance Charge
  /// A cost incurred by the shipper in moving goods, by whatever means, from one place to another under the terms of the contract of carriage. In addition to transport costs, this may include such elements as packing, documentation, loading, unloading, and insurance to the extent that they relate to the freight costs.
  /// 0..n
  /// Shipment
  /// Freight
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  /// Freight Costs
  @xsd(name = "FreightAllowanceCharge") freight_allowance_charge:               list<AllowanceCharge>
}

/// ABIE
/// Shipment Stage. Details
/// A class to describe one stage of movement in a transport of goods.
/// Shipment Stage
record ShipmentStage {
  /// BBIE
  /// Shipment Stage. Identifier
  /// An identifier for this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// 1 , 2 , etc..
  @xsd(name = "ID") id:                                  ubl_common_basic_components_2_1.ID?
  /// BBIE
  /// Shipment Stage. Transport Mode Code. Code
  /// A code signifying the method of transport used for this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Transport Mode Code
  /// Code
  /// Transport Mode
  /// Transport Mode_ Code. Type
  @xsd(name = "TransportModeCode") transport_mode_code:                 ubl_common_basic_components_2_1.TransportModeCode?
  /// BBIE
  /// Shipment Stage. Transport Means Type Code. Code
  /// A code signifying the kind of transport means (truck, vessel, etc.) used for this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Transport Means Type Code
  /// Code
  /// Code. Type
  @xsd(name = "TransportMeansTypeCode") transport_means_type_code:           ubl_common_basic_components_2_1.TransportMeansTypeCode?
  /// BBIE
  /// Shipment Stage. Transit_ Direction Code. Code
  /// A code signifying the direction of transit in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Transit
  /// Direction Code
  /// Code
  /// Code. Type
  @xsd(name = "TransitDirectionCode") transit_direction_code:              ubl_common_basic_components_2_1.TransitDirectionCode?
  /// BBIE
  /// Shipment Stage. Pre Carriage_ Indicator. Indicator
  /// An indicator that this stage takes place before the main carriage of the shipment (true) or not (false).
  /// 0..1
  /// Shipment Stage
  /// Pre Carriage
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// Truck delivery to wharf
  @xsd(name = "PreCarriageIndicator") pre_carriage_indicator:              ubl_common_basic_components_2_1.PreCarriageIndicator?
  /// BBIE
  /// Shipment Stage. On Carriage_ Indicator. Indicator
  /// An indicator that this stage takes place after the main carriage of the shipment (true) or not (false).
  /// 0..1
  /// Shipment Stage
  /// On Carriage
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// Truck delivery from wharf
  @xsd(name = "OnCarriageIndicator") on_carriage_indicator:               ubl_common_basic_components_2_1.OnCarriageIndicator?
  /// BBIE
  /// Shipment Stage. Estimated_ Delivery Date. Date
  /// The estimated date of delivery in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Estimated
  /// Delivery Date
  /// Date
  /// Date. Type
  @xsd(name = "EstimatedDeliveryDate") estimated_delivery_date:             ubl_common_basic_components_2_1.EstimatedDeliveryDate?
  /// BBIE
  /// Shipment Stage. Estimated_ Delivery Time. Time
  /// The estimated time of delivery in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Estimated
  /// Delivery Time
  /// Time
  /// Time. Type
  @xsd(name = "EstimatedDeliveryTime") estimated_delivery_time:             ubl_common_basic_components_2_1.EstimatedDeliveryTime?
  /// BBIE
  /// Shipment Stage. Required_ Delivery Date. Date
  /// The delivery date required by the buyer in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Required
  /// Delivery Date
  /// Date
  /// Date. Type
  @xsd(name = "RequiredDeliveryDate") required_delivery_date:              ubl_common_basic_components_2_1.RequiredDeliveryDate?
  /// BBIE
  /// Shipment Stage. Required_ Delivery Time. Time
  /// The delivery time required by the buyer in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Required
  /// Delivery Time
  /// Time
  /// Time. Type
  @xsd(name = "RequiredDeliveryTime") required_delivery_time:              ubl_common_basic_components_2_1.RequiredDeliveryTime?
  /// BBIE
  /// Shipment Stage. Loading_ Sequence Identifier. Identifier
  /// An identifier for the loading sequence (of consignments) associated with this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Loading
  /// Sequence Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "LoadingSequenceID") loading_sequence_id:                 ubl_common_basic_components_2_1.LoadingSequenceID?
  /// BBIE
  /// Shipment Stage. Successive_ Sequence Identifier. Identifier
  /// Identifies the successive loading sequence (of consignments) associated with a shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Successive
  /// Sequence Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "SuccessiveSequenceID") successive_sequence_id:              ubl_common_basic_components_2_1.SuccessiveSequenceID?
  /// BBIE
  /// Shipment Stage. Instructions. Text
  /// Text of instructions applicable to a shipment stage.
  /// 0..n
  /// Shipment Stage
  /// Instructions
  /// Text
  /// Text. Type
  @xsd(name = "Instructions") instructions:                        list<ubl_common_basic_components_2_1.Instructions>
  /// BBIE
  /// Shipment Stage. Demurrage_ Instructions. Text
  /// Text of instructions relating to demurrage (the case in which a vessel is prevented from loading or discharging cargo within the stipulated laytime).
  /// 0..n
  /// Shipment Stage
  /// Demurrage
  /// Instructions
  /// Text
  /// Text. Type
  @xsd(name = "DemurrageInstructions") demurrage_instructions:              list<ubl_common_basic_components_2_1.DemurrageInstructions>
  /// BBIE
  /// Shipment Stage. Crew Quantity. Quantity
  /// The total number of crew aboard a transport means.
  /// 0..1
  /// Shipment Stage
  /// Crew Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "CrewQuantity") crew_quantity:                       ubl_common_basic_components_2_1.CrewQuantity?
  /// BBIE
  /// Shipment Stage. Passenger Quantity. Quantity
  /// The total number of passengers aboard a transport means.
  /// 0..1
  /// Shipment Stage
  /// Passenger Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "PassengerQuantity") passenger_quantity:                  ubl_common_basic_components_2_1.PassengerQuantity?
  /// ASBIE
  /// Shipment Stage. Transit_ Period. Period
  /// The period during which this shipment stage actually took place.
  /// 0..1
  /// Shipment Stage
  /// Transit
  /// Period
  /// Period
  /// Period
  @xsd(name = "TransitPeriod") transit_period:                      Period?
  /// ASBIE
  /// Shipment Stage. Carrier_ Party. Party
  /// A carrier party responsible for this shipment stage.
  /// 0..n
  /// Shipment Stage
  /// Carrier
  /// Party
  /// Party
  /// Party
  @xsd(name = "CarrierParty") carrier_party:                       list<Party>
  /// ASBIE
  /// Shipment Stage. Transport Means
  /// The means of transport used in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Transport Means
  /// Transport Means
  /// Transport Means
  @xsd(name = "TransportMeans") transport_means:                     TransportMeans?
  /// ASBIE
  /// Shipment Stage. Loading Port_ Location. Location
  /// The location of loading for a shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Loading Port
  /// Location
  /// Location
  /// Location
  @xsd(name = "LoadingPortLocation") loading_port_location:               ubl_common_aggregate_components_2_1.Location?
  /// ASBIE
  /// Shipment Stage. Unloading Port_ Location. Location
  /// The location of unloading for a shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Unloading Port
  /// Location
  /// Location
  /// Location
  @xsd(name = "UnloadingPortLocation") unloading_port_location:             ubl_common_aggregate_components_2_1.Location?
  /// ASBIE
  /// Shipment Stage. Transship Port_ Location. Location
  /// The location of transshipment relating to a shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Transship Port
  /// Location
  /// Location
  /// Location
  @xsd(name = "TransshipPortLocation") transship_port_location:             ubl_common_aggregate_components_2_1.Location?
  /// ASBIE
  /// Shipment Stage. Loading_ Transport Event. Transport Event
  /// The loading of goods in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Loading
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "LoadingTransportEvent") loading_transport_event:             TransportEvent?
  /// ASBIE
  /// Shipment Stage. Examination_ Transport Event. Transport Event
  /// The examination of shipments in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Examination
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "ExaminationTransportEvent") examination_transport_event:         TransportEvent?
  /// ASBIE
  /// Shipment Stage. Availability_ Transport Event. Transport Event
  /// The making available of shipments in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Availability
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "AvailabilityTransportEvent") availability_transport_event:        TransportEvent?
  /// ASBIE
  /// Shipment Stage. Exportation_ Transport Event. Transport Event
  /// The export event associated with this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Exportation
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "ExportationTransportEvent") exportation_transport_event:         TransportEvent?
  /// ASBIE
  /// Shipment Stage. Discharge_ Transport Event. Transport Event
  /// The discharge event associated with this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Discharge
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "DischargeTransportEvent") discharge_transport_event:           TransportEvent?
  /// ASBIE
  /// Shipment Stage. Warehousing_ Transport Event. Transport Event
  /// The warehousing event associated with this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Warehousing
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "WarehousingTransportEvent") warehousing_transport_event:         TransportEvent?
  /// ASBIE
  /// Shipment Stage. Takeover_ Transport Event. Transport Event
  /// The receiver's takeover of the goods in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Takeover
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "TakeoverTransportEvent") takeover_transport_event:            TransportEvent?
  /// ASBIE
  /// Shipment Stage. Optional Takeover_ Transport Event. Transport Event
  /// The optional takeover of the goods in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Optional Takeover
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "OptionalTakeoverTransportEvent") optional_takeover_transport_event:   TransportEvent?
  /// ASBIE
  /// Shipment Stage. Dropoff_ Transport Event. Transport Event
  /// The dropping off of goods in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Dropoff
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "DropoffTransportEvent") dropoff_transport_event:             TransportEvent?
  /// ASBIE
  /// Shipment Stage. Actual Pickup_ Transport Event. Transport Event
  /// The pickup of goods in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Actual Pickup
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "ActualPickupTransportEvent") actual_pickup_transport_event:       TransportEvent?
  /// ASBIE
  /// Shipment Stage. Delivery_ Transport Event. Transport Event
  /// The delivery of goods in this shipment stage.
  /// 0..1
  /// Shipment Stage
  /// Delivery
  /// Transport Event
  /// Transport Event
  /// Transport Event
  @xsd(name = "DeliveryTransportEvent") delivery_transport_event:            TransportEvent?
  /// ASBIE
  /// Shipment Stage. Receipt_ Transport Event. Transport Event
  /// The receipt of goods in this shipment stage.
  /// 0..1
