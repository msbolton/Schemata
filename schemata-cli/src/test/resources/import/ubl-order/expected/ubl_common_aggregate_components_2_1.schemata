  /// Tenderer Requirement
  /// Name
  /// Name
  /// Name. Type
  name                           ubl_common_basic_components_2_1.Name[]                       @xsd(name: "Name")
  /// BBIE
  /// Tenderer Requirement. Tenderer Requirement_ Type Code. Code
