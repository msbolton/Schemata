  /// 0..1
  /// Tenderer Requirement
  /// Tenderer Requirement
  /// Type Code
  /// Code
  /// Code. Type
  tenderer_requirement_type_code ubl_common_basic_components_2_1.TendererRequirementTypeCode? @xsd(name: "TendererRequirementTypeCode")
  /// BBIE
  /// Tenderer Requirement. Description. Text
  /// Text describing this requirement.
  /// 0..n
  /// Tenderer Requirement
  /// Description
  /// Text
  /// Text. Type
  description                    ubl_common_basic_components_2_1.Description[]                @xsd(name: "Description")
  /// BBIE
  /// Tenderer Requirement. Legal Reference. Text
  /// The legal reference of the exclusion criterion.
  /// 0..1
  /// Tenderer Requirement
  /// Legal Reference
  /// Text
  /// Text. Type
  /// Art. 45 2 b
  legal_reference                ubl_common_basic_components_2_1.LegalReference?              @xsd(name: "LegalReference")
  /// ASBIE
  /// Tenderer Requirement. Suggested_ Evidence. Evidence
  /// An item of evidence that should be submitted to satisfy this requirement.
  /// 0..n
  /// Tenderer Requirement
  /// Suggested
  /// Evidence
  /// Evidence
  /// Evidence
  suggested_evidence             Evidence[]                                                   @xsd(name: "SuggestedEvidence")
}

/// ABIE
/// Tendering Process. Details
/// A class to describe the process of a formal offer and response to execute work or supply goods at a stated price.
/// Tendering Process
model TenderingProcess {
  /// BBIE
  /// Tendering Process. Identifier
  /// An identifier for this tendering process.
  /// 0..1
  /// Tendering Process
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                                        ubl_common_basic_components_2_1.ID?                                     @xsd(name: "ID")
  /// BBIE
  /// Tendering Process. Original_ Contracting System. Identifier
  /// When reopening a tendering process, the identifier of the original framework agreement or dynamic purchasing system.
  /// 0..1
  /// Tendering Process
  /// Original
  /// Contracting System
  /// Identifier
  /// Identifier. Type
  original_contracting_system_id            ubl_common_basic_components_2_1.OriginalContractingSystemID?            @xsd(name: "OriginalContractingSystemID")
  /// BBIE
  /// Tendering Process. Description. Text
  /// Text describing the tendering process.
  /// 0..n
  /// Tendering Process
  /// Description
  /// Text
  /// Text. Type
  description                               ubl_common_basic_components_2_1.Description[]                           @xsd(name: "Description")
  /// BBIE
  /// Tendering Process. Negotiation_ Description. Text
  /// Text describing the negotiation to be followed during the tendering process.
  /// 0..n
  /// Tendering Process
  /// Negotiation
  /// Description
  /// Text
  /// Text. Type
  negotiation_description                   ubl_common_basic_components_2_1.NegotiationDescription[]                @xsd(name: "NegotiationDescription")
  /// BBIE
  /// Tendering Process. Procedure Code. Code
  /// A code signifying the type of this tendering procedure.
  /// 0..1
  /// Tendering Process
  /// Procedure Code
  /// Code
  /// Code. Type
  /// Open, Restricted, Negotiated
  procedure_code                            ubl_common_basic_components_2_1.ProcedureCode?                          @xsd(name: "ProcedureCode")
  /// BBIE
  /// Tendering Process. Urgency Code. Code
  /// A code signifying the urgency of this tendering process.
  /// 0..1
  /// Tendering Process
  /// Urgency Code
  /// Code
  /// Code. Type
  /// Urgent, Normal, Emergency
  urgency_code                              ubl_common_basic_components_2_1.UrgencyCode?                            @xsd(name: "UrgencyCode")
  /// BBIE
  /// Tendering Process. Expense Code. Code
  /// A code signifying the type of expense for this tendering process.
  /// 0..1
  /// Tendering Process
  /// Expense Code
  /// Code
  /// Code. Type
  /// Normal, Anticipated
  expense_code                              ubl_common_basic_components_2_1.ExpenseCode?                            @xsd(name: "ExpenseCode")
  /// BBIE
  /// Tendering Process. Part Presentation Code. Code
  /// A code signifying the type of presentation of tenders required (e.g., one lot, multiple lots, or all the lots).
  /// 0..1
  /// Tendering Process
  /// Part Presentation Code
  /// Code
  /// Code. Type
  /// One Lot, Multiple Lots, All Lots
  part_presentation_code                    ubl_common_basic_components_2_1.PartPresentationCode?                   @xsd(name: "PartPresentationCode")
  /// BBIE
  /// Tendering Process. Contracting System Code. Code
  /// A code signifying the type of contracting system (e.g., framework agreement, dynamic purchasing system). If the procedure is individual (nonrepetitive), this code should be omitted.
  /// 0..1
  /// Tendering Process
  /// Contracting System Code
  /// Code
  /// Code. Type
  /// Framework Agreement, Dynamic Purchasing System
  contracting_system_code                   ubl_common_basic_components_2_1.ContractingSystemCode?                  @xsd(name: "ContractingSystemCode")
  /// BBIE
  /// Tendering Process. Submission Method Code. Code
  /// A code signifying the method to be followed in submitting tenders.
  /// 0..1
  /// Tendering Process
  /// Submission Method Code
  /// Code
  /// Code. Type
  /// Manual, Electronically, etc.
  submission_method_code                    ubl_common_basic_components_2_1.SubmissionMethodCode?                   @xsd(name: "SubmissionMethodCode")
  /// BBIE
  /// Tendering Process. Candidate Reduction_ Constraint. Indicator
  /// An indicator that the number of candidates participating in this process has been reduced (true) or not (false).
  /// 0..1
  /// Tendering Process
  /// Candidate Reduction
  /// Constraint
  /// Indicator
  /// Indicator. Type
  candidate_reduction_constraint_indicator  ubl_common_basic_components_2_1.CandidateReductionConstraintIndicator?  @xsd(name: "CandidateReductionConstraintIndicator")
  /// BBIE
  /// Tendering Process. Government Agreement_ Constraint. Indicator
  /// An indicator that the project associated with this tendering process is constrained by a government procurement agreement (true) or not (false).
  /// 0..1
  /// Tendering Process
  /// Government Agreement
  /// Constraint
  /// Indicator
  /// Indicator. Type
  government_agreement_constraint_indicator ubl_common_basic_components_2_1.GovernmentAgreementConstraintIndicator? @xsd(name: "GovernmentAgreementConstraintIndicator")
  /// ASBIE
  /// Tendering Process. Document Availability_ Period. Period
  /// The period during which documents relating to this tendering process must be completed.
  /// 0..1
  /// Tendering Process
  /// Document Availability
  /// Period
  /// Period
  /// Period
  document_availability_period              Period?                                                                 @xsd(name: "DocumentAvailabilityPeriod")
  /// ASBIE
  /// Tendering Process. Tender Submission Deadline_ Period. Period
  /// The period during which tenders must be delivered.
  /// 0..1
  /// Tendering Process
  /// Tender Submission Deadline
  /// Period
  /// Period
  /// Period
  tender_submission_deadline_period         Period?                                                                 @xsd(name: "TenderSubmissionDeadlinePeriod")
  /// ASBIE
  /// Tendering Process. Invitation Submission_ Period. Period
  /// The period during which invitations to tender must be completed and delivered.
  /// 0..1
  /// Tendering Process
  /// Invitation Submission
  /// Period
  /// Period
  /// Period
  invitation_submission_period              Period?                                                                 @xsd(name: "InvitationSubmissionPeriod")
  /// ASBIE
  /// Tendering Process. Participation Request Reception_ Period. Period
  /// The period during which requests for participation must be completed and delivered.
  /// 0..1
  /// Tendering Process
  /// Participation Request Reception
  /// Period
  /// Period
  /// Period
  participation_request_reception_period    Period?                                                                 @xsd(name: "ParticipationRequestReceptionPeriod")
  /// ASBIE
  /// Tendering Process. Notice_ Document Reference. Document Reference
  /// A reference to a notice pertaining to this tendering process.
  /// 0..n
  /// Tendering Process
  /// Notice
  /// Document Reference
  /// Document Reference
  /// Document Reference
  notice_document_reference                 DocumentReference[]                                                     @xsd(name: "NoticeDocumentReference")
  /// ASBIE
  /// Tendering Process. Additional_ Document Reference. Document Reference
  /// A reference to an additional document.
  /// 0..n
  /// Tendering Process
  /// Additional
  /// Document Reference
  /// Document Reference
  /// Document Reference
  additional_document_reference             DocumentReference[]                                                     @xsd(name: "AdditionalDocumentReference")
  /// ASBIE
  /// Tendering Process. Process Justification
  /// A justification for the selection of this tendering process.
  /// 0..n
  /// Tendering Process
  /// Process Justification
  /// Process Justification
  /// Process Justification
  process_justification                     ProcessJustification[]                                                  @xsd(name: "ProcessJustification")
  /// ASBIE
  /// Tendering Process. Economic Operator Short List
  /// A set of criteria used to create a short list of candidates.
  /// 0..1
  /// Tendering Process
  /// Economic Operator Short List
  /// Economic Operator Short List
  /// Economic Operator Short List
  economic_operator_short_list              EconomicOperatorShortList?                                              @xsd(name: "EconomicOperatorShortList")
  /// ASBIE
  /// Tendering Process. Open Tender_ Event. Event
  /// Textual description of the legal form required for potential tenderers.
  /// 0..n
  /// Tendering Process
  /// Open Tender
  /// Event
  /// Event
  /// Event
  open_tender_event                         Event[]                                                                 @xsd(name: "OpenTenderEvent")
  /// ASBIE
  /// Tendering Process. Auction Terms
  /// The terms to be fulfilled by tenderers if an auction is to be executed before the awarding of a tender.
  /// 0..1
  /// Tendering Process
  /// Auction Terms
  /// Auction Terms
  /// Auction Terms
  auction_terms                             AuctionTerms?                                                           @xsd(name: "AuctionTerms")
  /// ASBIE
  /// Tendering Process. Framework Agreement
  /// A tendering framework agreement.
  /// 0..1
  /// Tendering Process
  /// Framework Agreement
  /// Framework Agreement
  /// Framework Agreement
  framework_agreement                       FrameworkAgreement?                                                     @xsd(name: "FrameworkAgreement")

  @@xsd(name: "TenderingProcess")
}

/// ABIE
/// Tendering Terms. Details
/// A class to describe tendering terms for a tendering process.
/// Tendering Terms
model TenderingTerms {
  /// BBIE
  /// Tendering Terms. Awarding Method Type Code. Code
  /// A code signifying the awarding method in a tendering process (e.g., a method favoring the tender with the lowest price or the tender that is most economically advantageous).
  /// 0..1
  /// Tendering Terms
  /// Awarding Method Type Code
  /// Code
  /// Code. Type
  /// Price, Multiple criteria
  awarding_method_type_code                    ubl_common_basic_components_2_1.AwardingMethodTypeCode?           @xsd(name: "AwardingMethodTypeCode")
  /// BBIE
  /// Tendering Terms. Price Evaluation Code. Code
  /// Textual description of the legal form required for potential tenderers.
  /// 0..1
  /// Tendering Terms
  /// Price Evaluation Code
  /// Code
  /// Code. Type
  /// Unit prices, global price
  price_evaluation_code                        ubl_common_basic_components_2_1.PriceEvaluationCode?              @xsd(name: "PriceEvaluationCode")
  /// BBIE
  /// Tendering Terms. Maximum Variant_ Quantity. Quantity
  /// Maximum number of variants the tenderer is allowed to present for this tendering project.
  /// 0..1
  /// Tendering Terms
  /// Maximum Variant
  /// Quantity
  /// Quantity
  /// Quantity. Type
  maximum_variant_quantity                     ubl_common_basic_components_2_1.MaximumVariantQuantity?           @xsd(name: "MaximumVariantQuantity")
  /// BBIE
  /// Tendering Terms. Variant_ Constraint. Indicator
  /// An indicator that variants are allowed and unconstrained in number (true) or not allowed (false).
  /// 0..1
  /// Tendering Terms
  /// Variant
  /// Constraint
  /// Indicator
  /// Indicator. Type
  variant_constraint_indicator                 ubl_common_basic_components_2_1.VariantConstraintIndicator?       @xsd(name: "VariantConstraintIndicator")
  /// BBIE
  /// Tendering Terms. Accepted Variants_ Description. Text
  /// Text specifying the things for which variants are accepted.
  /// 0..n
  /// Tendering Terms
  /// Accepted Variants
  /// Description
  /// Text
  /// Text. Type
  accepted_variants_description                ubl_common_basic_components_2_1.AcceptedVariantsDescription[]     @xsd(name: "AcceptedVariantsDescription")
  /// BBIE
  /// Tendering Terms. Price Revision_ Formula Description. Text
  /// Text describing the formula for price revision.
  /// 0..n
  /// Tendering Terms
  /// Price Revision
  /// Formula Description
  /// Text
  /// Text. Type
  price_revision_formula_description           ubl_common_basic_components_2_1.PriceRevisionFormulaDescription[] @xsd(name: "PriceRevisionFormulaDescription")
  /// BBIE
  /// Tendering Terms. Funding_ Program Code. Code
  /// The program that funds the tendering process (e.g., "National", "European"), expressed as a code.
  /// 0..1
  /// Tendering Terms
  /// Funding
  /// Program Code
  /// Code
  /// Code. Type
  funding_program_code                         ubl_common_basic_components_2_1.FundingProgramCode?               @xsd(name: "FundingProgramCode")
  /// BBIE
  /// Tendering Terms. Funding_ Program. Text
  /// The program that funds the tendering process (e.g., EU 6th Framework Program) expressed as text.
  /// 0..n
  /// Tendering Terms
  /// Funding
  /// Program
  /// Text
  /// Text. Type
  funding_program                              ubl_common_basic_components_2_1.FundingProgram[]                  @xsd(name: "FundingProgram")
  /// BBIE
  /// Tendering Terms. Maximum_ Advertisement. Amount
  /// The maximum advertised monetary value of the tendering process.
  /// 0..1
  /// Tendering Terms
  /// Maximum
  /// Advertisement
  /// Amount
  /// Amount. Type
  maximum_advertisement_amount                 ubl_common_basic_components_2_1.MaximumAdvertisementAmount?       @xsd(name: "MaximumAdvertisementAmount")
  /// BBIE
  /// Tendering Terms. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Tendering Terms
  /// Note
  /// Text
  /// Text. Type
  note                                         ubl_common_basic_components_2_1.Note[]                            @xsd(name: "Note")
  /// BBIE
  /// Tendering Terms. Payment Frequency Code. Code
  /// A code signifying the frequency of payment in the contract associated with the tendering process.
  /// 0..1
  /// Tendering Terms
  /// Payment Frequency Code
  /// Code
  /// Code. Type
