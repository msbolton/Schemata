  /// 0..1
  /// Consumption
  /// Telecommunications Supply
  /// Telecommunications Supply
  /// Telecommunications Supply
  telecommunications_supply   TelecommunicationsSupply?                                 @xsd(name: "TelecommunicationsSupply")
  /// ASBIE
  /// Consumption. Legal_ Monetary Total. Monetary Total
  /// The total amount payable on this consumption, including any allowances, charges, or taxes.
  /// 1
  /// Consumption
  /// Legal
  /// Monetary Total
  /// Monetary Total
  /// Monetary Total
  legal_monetary_total        MonetaryTotal                                             @xsd(name: "LegalMonetaryTotal")

  @@xsd(name: "Consumption")
}

/// ABIE
