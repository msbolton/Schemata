  /// 0..1
  /// Condition
  /// Maximum
  /// Measure
  /// Measure
  /// Measure. Type
  maximum_measure ubl_common_basic_components_2_1.MaximumMeasure? @xsd(name: "MaximumMeasure")

  @@xsd(name: "Condition")
}

/// ABIE
/// Consignment. Details
/// A class to describe an identifiable collection of one or more goods items to be transported between the consignor and the consignee. This information may be defined within a transport contract. A consignment may comprise more than one shipment (e.g., when consolidated by a freight forwarder).
/// Consignment
model Consignment {
  /// BBIE
  /// Consignment. Identifier
  /// An identifier assigned to a collection of goods for both import and export.
  /// 1
  /// Consignment
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// Unique consignment reference number (UCR)
  id                                       ubl_common_basic_components_2_1.ID                                    @xsd(name: "ID")
  /// BBIE
  /// Consignment. Carrier Assigned_ Identifier. Identifier
  /// An identifier for this consignment, assigned by the carrier.
  /// 0..1
  /// Consignment
  /// Carrier Assigned
  /// Identifier
  /// Identifier
  /// Identifier. Type
  carrier_assigned_id                      ubl_common_basic_components_2_1.CarrierAssignedID?                    @xsd(name: "CarrierAssignedID")
  /// BBIE
  /// Consignment. Consignee Assigned_ Identifier. Identifier
  /// An identifier for this consignment, assigned by the consignee.
  /// 0..1
  /// Consignment
  /// Consignee Assigned
  /// Identifier
  /// Identifier
  /// Identifier. Type
  consignee_assigned_id                    ubl_common_basic_components_2_1.ConsigneeAssignedID?                  @xsd(name: "ConsigneeAssignedID")
  /// BBIE
  /// Consignment. Consignor Assigned_ Identifier. Identifier
  /// An identifier for this consignment, assigned by the consignor.
  /// 0..1
  /// Consignment
  /// Consignor Assigned
  /// Identifier
  /// Identifier
  /// Identifier. Type
  consignor_assigned_id                    ubl_common_basic_components_2_1.ConsignorAssignedID?                  @xsd(name: "ConsignorAssignedID")
  /// BBIE
  /// Consignment. Freight Forwarder Assigned_ Identifier. Identifier
  /// An identifier for this consignment, assigned by the freight forwarder.
  /// 0..1
  /// Consignment
  /// Freight Forwarder Assigned
  /// Identifier
  /// Identifier
  /// Identifier. Type
  freight_forwarder_assigned_id            ubl_common_basic_components_2_1.FreightForwarderAssignedID?           @xsd(name: "FreightForwarderAssignedID")
  /// BBIE
  /// Consignment. Broker Assigned_ Identifier. Identifier
  /// An identifier for this consignment, assigned by the broker.
  /// 0..1
  /// Consignment
  /// Broker Assigned
  /// Identifier
  /// Identifier
  /// Identifier. Type
  broker_assigned_id                       ubl_common_basic_components_2_1.BrokerAssignedID?                     @xsd(name: "BrokerAssignedID")
  /// BBIE
  /// Consignment. Contracted Carrier Assigned_ Identifier. Identifier
  /// An identifier for this consignment, assigned by the contracted carrier.
  /// 0..1
  /// Consignment
  /// Contracted Carrier Assigned
  /// Identifier
  /// Identifier
  /// Identifier. Type
  contracted_carrier_assigned_id           ubl_common_basic_components_2_1.ContractedCarrierAssignedID?          @xsd(name: "ContractedCarrierAssignedID")
  /// BBIE
  /// Consignment. Performing Carrier Assigned_ Identifier. Identifier
  /// An identifier for this consignment, assigned by the performing carrier.
  /// 0..1
  /// Consignment
  /// Performing Carrier Assigned
  /// Identifier
  /// Identifier
  /// Identifier. Type
  performing_carrier_assigned_id           ubl_common_basic_components_2_1.PerformingCarrierAssignedID?          @xsd(name: "PerformingCarrierAssignedID")
  /// BBIE
  /// Consignment. Summary_ Description. Text
  /// A textual summary description of the consignment.
  /// 0..n
  /// Consignment
  /// Summary
  /// Description
  /// Text
  /// Text. Type
  summary_description                      ubl_common_basic_components_2_1.SummaryDescription[]                  @xsd(name: "SummaryDescription")
  /// BBIE
  /// Consignment. Total_ Invoice Amount. Amount
  /// The total of all invoice amounts declared in this consignment.
  /// 0..1
  /// Consignment
  /// Total
  /// Invoice Amount
  /// Amount
  /// Amount. Type
  total_invoice_amount                     ubl_common_basic_components_2_1.TotalInvoiceAmount?                   @xsd(name: "TotalInvoiceAmount")
  /// BBIE
  /// Consignment. Declared Customs_ Value. Amount
  /// The total declared value for customs purposes of all the goods in this consignment, regardless of whether they are subject to the same customs procedure, tariff/statistical categorization, country information, or duty regime.
  /// 0..1
  /// Consignment
  /// Declared Customs
  /// Value
  /// Amount
  /// Amount. Type
  declared_customs_value_amount            ubl_common_basic_components_2_1.DeclaredCustomsValueAmount?           @xsd(name: "DeclaredCustomsValueAmount")
  /// BBIE
  /// Consignment. Tariff Description. Text
  /// Text describing the tariff applied to this consignment.
  /// 0..n
  /// Consignment
  /// Tariff Description
  /// Text
  /// Text. Type
  tariff_description                       ubl_common_basic_components_2_1.TariffDescription[]                   @xsd(name: "TariffDescription")
  /// BBIE
  /// Consignment. Tariff Code. Code
  /// A code signifying the tariff applied to this consignment.
  /// 0..1
  /// Consignment
  /// Tariff Code
  /// Code
  /// Code. Type
  /// Tariff code number (WCO ID 145)
  tariff_code                              ubl_common_basic_components_2_1.TariffCode?                           @xsd(name: "TariffCode")
  /// BBIE
  /// Consignment. Insurance Premium Amount. Amount
  /// The amount of the premium payable to an insurance company for insuring the goods contained in this consignment.
  /// 0..1
  /// Consignment
  /// Insurance Premium Amount
  /// Amount
  /// Amount. Type
  /// Insurance Cost
  insurance_premium_amount                 ubl_common_basic_components_2_1.InsurancePremiumAmount?               @xsd(name: "InsurancePremiumAmount")
  /// BBIE
  /// Consignment. Gross_ Weight. Measure
  /// The total declared weight of the goods in this consignment, including packaging but excluding the carrier's equipment.
  /// 0..1
  /// Consignment
  /// Gross
  /// Weight
  /// Measure
  /// Measure. Type
  /// Total gross weight (WCO ID 131)
  /// Total cube of all goods items referred to as one consignment.
  gross_weight_measure                     ubl_common_basic_components_2_1.GrossWeightMeasure?                   @xsd(name: "GrossWeightMeasure")
  /// BBIE
  /// Consignment. Net_ Weight. Measure
  /// The total net weight of all the goods items referred to as one consignment.
  /// 0..1
  /// Consignment
  /// Net
  /// Weight
  /// Measure
  /// Measure. Type
  net_weight_measure                       ubl_common_basic_components_2_1.NetWeightMeasure?                     @xsd(name: "NetWeightMeasure")
  /// BBIE
  /// Consignment. Net Net_ Weight. Measure
  /// The total net weight of the goods in this consignment, exclusive of packaging.
  /// 0..1
  /// Consignment
  /// Net Net
  /// Weight
  /// Measure
  /// Measure. Type
  net_net_weight_measure                   ubl_common_basic_components_2_1.NetNetWeightMeasure?                  @xsd(name: "NetNetWeightMeasure")
  /// BBIE
  /// Consignment. Chargeable_ Weight. Measure
  /// The weight upon which a charge is to be based.
  /// 0..1
  /// Consignment
  /// Chargeable
  /// Weight
  /// Measure
  /// Measure. Type
  /// Chargeable Weight. Basis.Measure
  chargeable_weight_measure                ubl_common_basic_components_2_1.ChargeableWeightMeasure?              @xsd(name: "ChargeableWeightMeasure")
  /// BBIE
  /// Consignment. Gross_ Volume. Measure
  /// The total volume of the goods referred to as one consignment.
  /// 0..1
  /// Consignment
  /// Gross
  /// Volume
  /// Measure
  /// Measure. Type
  /// Cube
  gross_volume_measure                     ubl_common_basic_components_2_1.GrossVolumeMeasure?                   @xsd(name: "GrossVolumeMeasure")
  /// BBIE
  /// Consignment. Net_ Volume. Measure
  /// The total net volume of all goods items referred to as one consignment.
  /// 0..1
  /// Consignment
  /// Net
  /// Volume
  /// Measure
  /// Measure. Type
  net_volume_measure                       ubl_common_basic_components_2_1.NetVolumeMeasure?                     @xsd(name: "NetVolumeMeasure")
  /// BBIE
  /// Consignment. Loading_ Length. Measure
  /// The total length in a means of transport or a piece of transport equipment which, given the width and height of the transport means, will accommodate all of the consignments in a single consolidation.
  /// 0..1
  /// Consignment
  /// Loading
  /// Length
  /// Measure
  /// Measure. Type
  loading_length_measure                   ubl_common_basic_components_2_1.LoadingLengthMeasure?                 @xsd(name: "LoadingLengthMeasure")
  /// BBIE
  /// Consignment. Remarks. Text
  /// Remarks concerning the complete consignment, to be printed on the transport document.
  /// 0..n
  /// Consignment
  /// Remarks
  /// Text
  /// Text. Type
  remarks                                  ubl_common_basic_components_2_1.Remarks[]                             @xsd(name: "Remarks")
  /// BBIE
  /// Consignment. Hazardous Risk_ Indicator. Indicator
  /// An indication that the transported goods in this consignment are subject to an international regulation concerning the carriage of dangerous goods (true) or not (false).
  /// 0..1
  /// Consignment
  /// Hazardous Risk
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// Dangerous Goods RID Indicator
  /// default is negative
  hazardous_risk_indicator                 ubl_common_basic_components_2_1.HazardousRiskIndicator?               @xsd(name: "HazardousRiskIndicator")
  /// BBIE
  /// Consignment. Animal_ Food Indicator. Indicator
  /// An indication that the transported goods in this consignment are animal foodstuffs (true) or not (false).
  /// 0..1
  /// Consignment
  /// Animal
  /// Food Indicator
  /// Indicator
  /// Indicator. Type
  /// default is negative
  animal_food_indicator                    ubl_common_basic_components_2_1.AnimalFoodIndicator?                  @xsd(name: "AnimalFoodIndicator")
  /// BBIE
  /// Consignment. Human_ Food Indicator. Indicator
  /// An indication that the transported goods in this consignment are for human consumption (true) or not (false).
  /// 0..1
  /// Consignment
  /// Human
  /// Food Indicator
  /// Indicator
  /// Indicator. Type
  /// default is negative
  human_food_indicator                     ubl_common_basic_components_2_1.HumanFoodIndicator?                   @xsd(name: "HumanFoodIndicator")
  /// BBIE
  /// Consignment. Livestock_ Indicator. Indicator
  /// An indication that the transported goods are livestock (true) or not (false).
  /// 0..1
  /// Consignment
  /// Livestock
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// default is negative
  livestock_indicator                      ubl_common_basic_components_2_1.LivestockIndicator?                   @xsd(name: "LivestockIndicator")
  /// BBIE
  /// Consignment. Bulk Cargo_ Indicator. Indicator
  /// An indication that the transported goods in this consignment are bulk cargoes (true) or not (false).
  /// 0..1
  /// Consignment
  /// Bulk Cargo
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// default is negative
  bulk_cargo_indicator                     ubl_common_basic_components_2_1.BulkCargoIndicator?                   @xsd(name: "BulkCargoIndicator")
  /// BBIE
  /// Consignment. Containerized_ Indicator. Indicator
  /// An indication that the transported goods in this consignment are containerized cargoes (true) or not (false).
  /// 0..1
  /// Consignment
  /// Containerized
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// default is negative
  containerized_indicator                  ubl_common_basic_components_2_1.ContainerizedIndicator?               @xsd(name: "ContainerizedIndicator")
  /// BBIE
  /// Consignment. General Cargo_ Indicator. Indicator
  /// An indication that the transported goods in this consignment are general cargoes (true) or not (false).
  /// 0..1
  /// Consignment
  /// General Cargo
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// default is negative
  general_cargo_indicator                  ubl_common_basic_components_2_1.GeneralCargoIndicator?                @xsd(name: "GeneralCargoIndicator")
  /// BBIE
  /// Consignment. Special_ Security Indicator. Indicator
  /// An indication that the transported goods in this consignment require special security (true) or not (false).
  /// 0..1
  /// Consignment
  /// Special
  /// Security Indicator
  /// Indicator
  /// Indicator. Type
