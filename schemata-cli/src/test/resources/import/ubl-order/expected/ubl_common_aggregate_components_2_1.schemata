  /// Code
  /// Code. Type
  /// new - announcement only , new and available , deleted - announcement only
  @xsd(name = "LifeCycleStatusCode") life_cycle_status_code:              ubl_common_basic_components_2_1.LifeCycleStatusCode?
  /// BBIE
  /// Catalogue Line. Contract Subdivision. Text
