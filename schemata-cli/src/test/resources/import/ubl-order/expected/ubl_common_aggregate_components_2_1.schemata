  /// Maritime Transport
  /// Registry Port
  /// Location
  /// Location
  /// Location
  @xsd(name = "RegistryPortLocation") registry_port_location:                  ubl_common_aggregate_components_2_1.Location?
}

/// ABIE
/// Meter. Details
/// A class to describe a meter and its readings.
/// Meter
@xsd(name = "Meter")
record Meter {
  /// BBIE
  /// Meter. Meter Number. Text
  /// The meter number, expressed as text.
  /// 0..1
  /// Meter
  /// Meter Number
  /// Text
  /// Text. Type
  /// 61722x
  @xsd(name = "MeterNumber") meter_number:             ubl_common_basic_components_2_1.MeterNumber?
  /// BBIE
  /// Meter. Meter Name. Text
  /// The name of this meter, which serves as an identifier to distinguish a main meter from a submeter.
  /// 0..1
  /// Meter
  /// Meter Name
  /// Text
  /// Text. Type
  @xsd(name = "MeterName") meter_name:               ubl_common_basic_components_2_1.MeterName?
  /// BBIE
  /// Meter. Meter Constant. Text
  /// The factor by which readings of this meter must be multiplied to calculate consumption, expressed as text.
  /// 0..1
  /// Meter
  /// Meter Constant
  /// Text
  /// Text. Type
  /// 1.000
  @xsd(name = "MeterConstant") meter_constant:           ubl_common_basic_components_2_1.MeterConstant?
  /// BBIE
  /// Meter. Meter Constant Code. Code
  /// A code signifying the formula to be used in applying the meter constant.
  /// 0..1
  /// Meter
  /// Meter Constant Code
  /// Code
  /// Code. Type
  /// Factor
  @xsd(name = "MeterConstantCode") meter_constant_code:      ubl_common_basic_components_2_1.MeterConstantCode?
  /// BBIE
  /// Meter. Total_ Delivered Quantity. Quantity
  /// The quantity delivered; the total quantity consumed as calculated from the meter readings.
  /// 0..1
  /// Meter
  /// Total
  /// Delivered Quantity
  /// Quantity
  /// Quantity. Type
  /// 5761.00
  @xsd(name = "TotalDeliveredQuantity") total_delivered_quantity: ubl_common_basic_components_2_1.TotalDeliveredQuantity?
  /// ASBIE
  /// Meter. Meter Reading
  /// A reading of this meter.
  /// 0..n
  /// Meter
  /// Meter Reading
  /// Meter Reading
  /// Meter Reading
  @xsd(name = "MeterReading") meter_reading:            list<MeterReading>
  /// ASBIE
  /// Meter. Meter Property
  /// A property of this meter.
  /// 0..n
  /// Meter
  /// Meter Property
  /// Meter Property
  /// Meter Property
  @xsd(name = "MeterProperty") meter_property:           list<MeterProperty>
}

/// ABIE
/// Meter Property. Details
