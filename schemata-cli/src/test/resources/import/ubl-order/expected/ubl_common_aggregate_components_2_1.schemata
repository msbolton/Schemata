/// ABIE
/// Invoice Line. Details
/// A class to define a line in an Invoice.
/// Invoice Line
@xsd(name = "InvoiceLine")
record InvoiceLine {
  /// BBIE
  /// Invoice Line. Identifier
  /// An identifier for this invoice line.
  /// 1
  /// Invoice Line
  /// Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "ID") id:                       ubl_common_basic_components_2_1.ID
  /// BBIE
  /// Invoice Line. UUID. Identifier
  /// A universally unique identifier for this invoice line.
  /// 0..1
  /// Invoice Line
  /// UUID
  /// Identifier
  /// Identifier. Type
  @xsd(name = "UUID") uuid:                     ubl_common_basic_components_2_1.UUID?
  /// BBIE
  /// Invoice Line. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Invoice Line
  /// Note
  /// Text
  /// Text. Type
  @xsd(name = "Note") note:                     list<ubl_common_basic_components_2_1.Note>
  /// BBIE
  /// Invoice Line. Invoiced_ Quantity. Quantity
  /// The quantity (of items) on this invoice line.
  /// 0..1
  /// Invoice Line
  /// Invoiced
  /// Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "InvoicedQuantity") invoiced_quantity:        ubl_common_basic_components_2_1.InvoicedQuantity?
  /// BBIE
  /// Invoice Line. Line Extension Amount. Amount
  /// The total amount for this invoice line, including allowance charges but net of taxes.
  /// 1
  /// Invoice Line
  /// Line Extension Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "LineExtensionAmount") line_extension_amount:    ubl_common_basic_components_2_1.LineExtensionAmount
  /// BBIE
  /// Invoice Line. Tax Point Date. Date
  /// The date of this invoice line, used to indicate the point at which tax becomes applicable.
  /// 0..1
  /// Invoice Line
  /// Tax Point Date
  /// Date
  /// Date. Type
  @xsd(name = "TaxPointDate") tax_point_date:           ubl_common_basic_components_2_1.TaxPointDate?
  /// BBIE
  /// Invoice Line. Accounting Cost Code. Code
  /// The buyer's accounting cost centre for this invoice line, expressed as a code.
  /// 0..1
  /// Invoice Line
  /// Accounting Cost Code
  /// Code
  /// Code. Type
  @xsd(name = "AccountingCostCode") accounting_cost_code:     ubl_common_basic_components_2_1.AccountingCostCode?
  /// BBIE
  /// Invoice Line. Accounting Cost. Text
  /// The buyer's accounting cost centre for this invoice line, expressed as text.
  /// 0..1
  /// Invoice Line
  /// Accounting Cost
  /// Text
  /// Text. Type
  @xsd(name = "AccountingCost") accounting_cost:          ubl_common_basic_components_2_1.AccountingCost?
  /// BBIE
  /// Invoice Line. Payment Purpose Code. Code
  /// A code signifying the business purpose for this payment.
  /// 0..1
  /// Invoice Line
  /// Payment Purpose Code
  /// Code
  /// Code. Type
  @xsd(name = "PaymentPurposeCode") payment_purpose_code:     ubl_common_basic_components_2_1.PaymentPurposeCode?
  /// BBIE
  /// Invoice Line. Free Of Charge_ Indicator. Indicator
  /// An indicator that this invoice line is free of charge (true) or not (false). The default is false.
  /// 0..1
  /// Invoice Line
  /// Free Of Charge
  /// Indicator
  /// Indicator
  /// Indicator. Type
  @xsd(name = "FreeOfChargeIndicator") free_of_charge_indicator: ubl_common_basic_components_2_1.FreeOfChargeIndicator?
  /// ASBIE
  /// Invoice Line. Invoice_ Period. Period
  /// An invoice period to which this invoice line applies.
  /// 0..n
  /// Invoice Line
  /// Invoice
  /// Period
  /// Period
  /// Period
  @xsd(name = "InvoicePeriod") invoice_period:           list<Period>
  /// ASBIE
  /// Invoice Line. Order Line Reference
  /// A reference to an order line associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Order Line Reference
  /// Order Line Reference
  /// Order Line Reference
  @xsd(name = "OrderLineReference") order_line_reference:     list<OrderLineReference>
  /// ASBIE
  /// Invoice Line. Despatch_ Line Reference. Line Reference
  /// A reference to a despatch line associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Despatch
  /// Line Reference
  /// Line Reference
  /// Line Reference
  @xsd(name = "DespatchLineReference") despatch_line_reference:  list<LineReference>
  /// ASBIE
  /// Invoice Line. Receipt_ Line Reference. Line Reference
  /// A reference to a receipt line associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Receipt
  /// Line Reference
  /// Line Reference
  /// Line Reference
  @xsd(name = "ReceiptLineReference") receipt_line_reference:   list<LineReference>
  /// ASBIE
  /// Invoice Line. Billing Reference
  /// A reference to a billing document associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Billing Reference
  /// Billing Reference
  /// Billing Reference
  @xsd(name = "BillingReference") billing_reference:        list<BillingReference>
  /// ASBIE
  /// Invoice Line. Document Reference
  /// A reference to a document associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Document Reference
  /// Document Reference
  /// Document Reference
  @xsd(name = "DocumentReference") document_reference:       list<DocumentReference>
  /// ASBIE
  /// Invoice Line. Pricing Reference
  /// A reference to pricing and item location information associated with this invoice line.
  /// 0..1
  /// Invoice Line
  /// Pricing Reference
  /// Pricing Reference
  /// Pricing Reference
  @xsd(name = "PricingReference") pricing_reference:        PricingReference?
  /// ASBIE
  /// Invoice Line. Originator_ Party. Party
  /// The party who originated the Order to which the Invoice is related.
  /// 0..1
  /// Invoice Line
  /// Originator
  /// Party
  /// Party
  /// Party
  @xsd(name = "OriginatorParty") originator_party:         Party?
  /// ASBIE
  /// Invoice Line. Delivery
  /// A delivery associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Delivery
  /// Delivery
  /// Delivery
  @xsd(name = "Delivery") delivery:                 list<Delivery>
  /// ASBIE
  /// Invoice Line. Payment Terms
  /// A specification of payment terms associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Payment Terms
  /// Payment Terms
  /// Payment Terms
  @xsd(name = "PaymentTerms") payment_terms:            list<PaymentTerms>
  /// ASBIE
  /// Invoice Line. Allowance Charge
  /// An allowance or charge associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  @xsd(name = "AllowanceCharge") allowance_charge:         list<AllowanceCharge>
  /// ASBIE
  /// Invoice Line. Tax Total
  /// A total amount of taxes of a particular kind applicable to this invoice line.
  /// 0..n
  /// Invoice Line
  /// Tax Total
  /// Tax Total
  /// Tax Total
  @xsd(name = "TaxTotal") tax_total:                list<TaxTotal>
  /// ASBIE
  /// Invoice Line. Withholding_ Tax Total. Tax Total
  /// A reference to a TaxTotal class describing the amount that has been withhold by the authorities, e.g. if the creditor is in dept because of non paid taxes.
  /// 0..n
  /// Invoice Line
  /// Withholding
  /// Tax Total
  /// Tax Total
  /// Tax Total
  @xsd(name = "WithholdingTaxTotal") withholding_tax_total:    list<TaxTotal>
  /// ASBIE
  /// Invoice Line. Item
  /// The item associated with this invoice line.
  /// 1
  /// Invoice Line
  /// Item
  /// Item
  /// Item
  @xsd(name = "Item") item:                     Item
  /// ASBIE
  /// Invoice Line. Price
  /// The price of the item associated with this invoice line.
  /// 0..1
  /// Invoice Line
  /// Price
  /// Price
  /// Price
  /// Unit Price, Base Price
  @xsd(name = "Price") price:                    Price?
  /// ASBIE
  /// Invoice Line. Delivery Terms
  /// Terms and conditions of the delivery associated with this invoice line.
  /// 0..1
  /// Invoice Line
  /// Delivery Terms
  /// Delivery Terms
  /// Delivery Terms
  @xsd(name = "DeliveryTerms") delivery_terms:           DeliveryTerms?
  /// ASBIE
  /// Invoice Line. Sub_ Invoice Line. Invoice Line
  /// An invoice line subsidiary to this invoice line.
  /// 0..n
  /// Invoice Line
  /// Sub
  /// Invoice Line
  /// Invoice Line
  /// Invoice Line
  @xsd(name = "SubInvoiceLine") sub_invoice_line:         list<InvoiceLine>
  /// ASBIE
  /// Invoice Line. Item_ Price Extension. Price Extension
  /// The price extension, calculated by multiplying the price per unit by the quantity of items on this invoice line.
  /// 0..1
  /// Invoice Line
  /// Item
  /// Price Extension
  /// Price Extension
  /// Price Extension
  @xsd(name = "ItemPriceExtension") item_price_extension:     PriceExtension?
}

/// ABIE
/// Item. Details
/// A class to describe an item of trade. It includes a generic description applicable to all examples of the item together with optional subsidiary descriptions of any number of actual instances of the type.
/// Item
/// article, product, goods item
@xsd(name = "Item")
record Item {
  /// BBIE
  /// Item. Description. Text
  /// Text describing this item.
  /// 0..n
  /// Item
  /// Description
  /// Text
  /// Text. Type
  @xsd(name = "Description") description:                           list<ubl_common_basic_components_2_1.Description>
  /// BBIE
  /// Item. Pack Quantity. Quantity
  /// The unit packaging quantity; the number of subunits making up this item.
  /// 0..1
  /// Item
  /// Pack Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "PackQuantity") pack_quantity:                         ubl_common_basic_components_2_1.PackQuantity?
  /// BBIE
  /// Item. Pack Size. Numeric
  /// The number of items in a pack of this item.
  /// 0..1
  /// Item
  /// Pack Size
  /// Numeric
  /// Numeric. Type
  @xsd(name = "PackSizeNumeric") pack_size_numeric:                     ubl_common_basic_components_2_1.PackSizeNumeric?
  /// BBIE
  /// Item. Catalogue_ Indicator. Indicator
  /// An indicator that this item was ordered from a catalogue (true) or not (false).
  /// 0..1
  /// Item
  /// Catalogue
  /// Indicator
  /// Indicator
  /// Indicator. Type
  @xsd(name = "CatalogueIndicator") catalogue_indicator:                   ubl_common_basic_components_2_1.CatalogueIndicator?
  /// BBIE
  /// Item. Name
  /// A short name optionally given to this item, such as a name from a catalogue, as distinct from a description.
  /// 0..1
  /// Item
  /// Name
  /// Name
  /// Name. Type
  @xsd(name = "Name") name:                                  ubl_common_basic_components_2_1.Name?
  /// BBIE
  /// Item. Hazardous Risk_ Indicator. Indicator
  /// An indication that the transported item, as delivered, is subject to an international regulation concerning the carriage of dangerous goods (true) or not (false).
  /// 0..1
  /// Item
  /// Hazardous Risk
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// Default is negative
  @xsd(name = "HazardousRiskIndicator") hazardous_risk_indicator:              ubl_common_basic_components_2_1.HazardousRiskIndicator?
  /// BBIE
  /// Item. Additional_ Information. Text
  /// Further details regarding this item (e.g., the URL of a relevant web page).
  /// 0..n
  /// Item
  /// Additional
  /// Information
  /// Text
  /// Text. Type
  @xsd(name = "AdditionalInformation") additional_information:                list<ubl_common_basic_components_2_1.AdditionalInformation>
  /// BBIE
  /// Item. Keyword. Text
  /// A keyword (search string) for this item, assigned by the seller party. Can also be a synonym for the name of the item.
  /// 0..n
  /// Item
  /// Keyword
  /// Text
  /// Text. Type
  @xsd(name = "Keyword") keyword:                               list<ubl_common_basic_components_2_1.Keyword>
  /// BBIE
  /// Item. Brand Name. Name
  /// A brand name of this item.
  /// 0..n
  /// Item
  /// Brand Name
  /// Name
  /// Name. Type
  /// Coca-Cola
  @xsd(name = "BrandName") brand_name:                            list<ubl_common_basic_components_2_1.BrandName>
  /// BBIE
  /// Item. Model Name. Name
  /// A model name of this item.
  /// 0..n
  /// Item
  /// Model Name
  /// Name
  /// Name. Type
  /// VW Beetle
  @xsd(name = "ModelName") model_name:                            list<ubl_common_basic_components_2_1.ModelName>
  /// ASBIE
  /// Item. Buyers_ Item Identification. Item Identification
  /// Identifying information for this item, assigned by the buyer.
  /// 0..1
  /// Item
  /// Buyers
  /// Item Identification
  /// Item Identification
  /// Item Identification
  @xsd(name = "BuyersItemIdentification") buyers_item_identification:            ItemIdentification?
  /// ASBIE
  /// Item. Sellers_ Item Identification. Item Identification
  /// Identifying information for this item, assigned by the seller.
  /// 0..1
  /// Item
  /// Sellers
  /// Item Identification
  /// Item Identification
  /// Item Identification
  @xsd(name = "SellersItemIdentification") sellers_item_identification:           ItemIdentification?
  /// ASBIE
  /// Item. Manufacturers_ Item Identification. Item Identification
  /// Identifying information for this item, assigned by the manufacturer.
  /// 0..n
  /// Item
  /// Manufacturers
  /// Item Identification
  /// Item Identification
  /// Item Identification
  @xsd(name = "ManufacturersItemIdentification") manufacturers_item_identification:     list<ItemIdentification>
  /// ASBIE
  /// Item. Standard_ Item Identification. Item Identification
  /// Identifying information for this item, assigned according to a standard system.
  /// 0..1
  /// Item
  /// Standard
  /// Item Identification
  /// Item Identification
