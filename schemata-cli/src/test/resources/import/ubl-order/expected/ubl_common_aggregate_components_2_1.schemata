  /// 1
  /// Item Identification
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// CUST001 3333-44-123
  @xsd(name = "ID") id:                    ubl_common_basic_components_2_1.ID
  /// BBIE
  /// Item Identification. Extended_ Identifier. Identifier
  /// An extended identifier for the item that identifies the item with specific properties, e.g., Item 123 = Chair / Item 123 Ext 45 = brown chair. Two chairs can have the same item number, but one is brown. The other is white.
  /// 0..1
  /// Item Identification
  /// Extended
  /// Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "ExtendedID") extended_id:           ubl_common_basic_components_2_1.ExtendedID?
  /// BBIE
  /// Item Identification. Barcode_ Symbology Identifier. Identifier
  /// An identifier for a system of barcodes.
  /// 0..1
  /// Item Identification
  /// Barcode
  /// Symbology Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "BarcodeSymbologyID") barcode_symbology_id:  ubl_common_basic_components_2_1.BarcodeSymbologyID?
  /// ASBIE
  /// Item Identification. Physical Attribute
  /// A physical attribute of the item.
  /// 0..n
  /// Item Identification
  /// Physical Attribute
  /// Physical Attribute
  /// Physical Attribute
  @xsd(name = "PhysicalAttribute") physical_attribute:    list<PhysicalAttribute>
  /// ASBIE
  /// Item Identification. Measurement_ Dimension. Dimension
  /// A measurable dimension (length, mass, weight, or volume) of the item.
  /// 0..n
  /// Item Identification
  /// Measurement
  /// Dimension
  /// Dimension
  /// Dimension
  @xsd(name = "MeasurementDimension") measurement_dimension: list<Dimension>
  /// ASBIE
  /// Item Identification. Issuer_ Party. Party
  /// The party that issued this item identification.
  /// 0..1
  /// Item Identification
  /// Issuer
  /// Party
  /// Party
  /// Party
  @xsd(name = "IssuerParty") issuer_party:          Party?
}

/// ABIE
/// Item Information Request Line. Details
/// A class to define a line in an Item Information Request asking a trading partner for item information.
/// Item Information Request Line
@xsd(name = "ItemInformationRequestLine")
record ItemInformationRequestLine {
  /// BBIE
  /// Item Information Request Line. Time Frequency Code. Code
  /// A code signifying the frequency with which item information should be sent to the requester.
  /// 0..1
  /// Item Information Request Line
  /// Time Frequency Code
  /// Code
  /// Code. Type
  @xsd(name = "TimeFrequencyCode") time_frequency_code:             ubl_common_basic_components_2_1.TimeFrequencyCode?
  /// BBIE
  /// Item Information Request Line. Supply Chain Activity Type Code. Code
  /// A code used to identify the type of supply chain activity about which information request is issued. Examples: CANCELED_ORDERS EMERGENCY_ORDERS ON_HAND ORDERS
  /// 0..1
  /// Item Information Request Line
  /// Supply Chain Activity Type Code
  /// Code
  /// Code. Type
  @xsd(name = "SupplyChainActivityTypeCode") supply_chain_activity_type_code: ubl_common_basic_components_2_1.SupplyChainActivityTypeCode?
  /// BBIE
  /// Item Information Request Line. Forecast Type Code. Code
  /// The information request can be either about supply chain activity or about forecasts or about performance metrics, so it should be optional
  /// 0..1
  /// Item Information Request Line
  /// Forecast Type Code
  /// Code
  /// Code. Type
  @xsd(name = "ForecastTypeCode") forecast_type_code:              ubl_common_basic_components_2_1.ForecastTypeCode?
  /// BBIE
  /// Item Information Request Line. Performance Metric Type Code. Code
  /// A code signifying a measure of performance.
  /// 0..1
  /// Item Information Request Line
  /// Performance Metric Type Code
  /// Code
  /// Code. Type
  @xsd(name = "PerformanceMetricTypeCode") performance_metric_type_code:    ubl_common_basic_components_2_1.PerformanceMetricTypeCode?
  /// ASBIE
  /// Item Information Request Line. Period
  /// A period for which this information is requested.
  /// 1..n
  /// Item Information Request Line
  /// Period
  /// Period
  /// Period
  @xsd(name = "Period") period:                          list<Period>(min = 1)
  /// ASBIE
  /// Item Information Request Line. Sales Item
  /// Sales information for the item to which this line applies.
  /// 1..n
  /// Item Information Request Line
  /// Sales Item
  /// Sales Item
  /// Sales Item
  @xsd(name = "SalesItem") sales_item:                      list<SalesItem>(min = 1)
}

/// ABIE
/// Item Instance. Details
