  /// 0..1
  /// Telecommunications Service
  /// Pay Per View
  /// Text
  /// Text. Type
  pay_per_view                             ubl_common_basic_components_2_1.PayPerView?                            @xsd(name: "PayPerView")
  /// BBIE
  /// Telecommunications Service. Quantity
  /// The number of calls.
  /// 0..1
  /// Telecommunications Service
  /// Quantity
  /// Quantity
  /// Quantity. Type
  /// 5761
  quantity                                 ubl_common_basic_components_2_1.Quantity?                              @xsd(name: "Quantity")
  /// BBIE
  /// Telecommunications Service. Telecommunications Service Call. Text
  /// The telecommunications call described as a text
  /// 0..1
  /// Telecommunications Service
  /// Telecommunications Service Call
  /// Text
  /// Text. Type
  /// CallAttempt
  telecommunications_service_call          ubl_common_basic_components_2_1.TelecommunicationsServiceCall?         @xsd(name: "TelecommunicationsServiceCall")
  /// BBIE
  /// Telecommunications Service. Telecommunications Service Call Code. Code
  /// The telecommunications call described as a code
  /// 0..1
  /// Telecommunications Service
  /// Telecommunications Service Call Code
  /// Code
  /// Code. Type
  /// CallAttempt
  telecommunications_service_call_code     ubl_common_basic_components_2_1.TelecommunicationsServiceCallCode?     @xsd(name: "TelecommunicationsServiceCallCode")
  /// BBIE
  /// Telecommunications Service. Call Base_ Amount. Amount
  /// The amount to be payed as the base for one call
  /// 0..1
  /// Telecommunications Service
  /// Call Base
  /// Amount
  /// Amount
  /// Amount. Type
  call_base_amount                         ubl_common_basic_components_2_1.CallBaseAmount?                        @xsd(name: "CallBaseAmount")
  /// BBIE
  /// Telecommunications Service. Call Extension_ Amount. Amount
  /// The amount to be payed for the call
  /// 0..1
  /// Telecommunications Service
  /// Call Extension
  /// Amount
  /// Amount
  /// Amount. Type
  /// 542.44
  call_extension_amount                    ubl_common_basic_components_2_1.CallExtensionAmount?                   @xsd(name: "CallExtensionAmount")
  /// ASBIE
  /// Telecommunications Service. Price
  /// The price for using the telecommunication service
  /// 0..1
  /// Telecommunications Service
  /// Price
  /// Price
  /// Price
  price                                    Price?                                                                 @xsd(name: "Price")
  /// ASBIE
  /// Telecommunications Service. Country
  /// The country to which the service is provided. In case of a telephone call it is the country where the receiver is located.
  /// 0..1
  /// Telecommunications Service
  /// Country
  /// Country
  /// Country
  country                                  Country?                                                               @xsd(name: "Country")
  /// ASBIE
  /// Telecommunications Service. Exchange Rate
  /// A exchanges rates used in the pricing e.g.. when phone calls has crossed border lines.
  /// 0..n
  /// Telecommunications Service
  /// Exchange Rate
  /// Exchange Rate
  /// Exchange Rate
  exchange_rate                            ExchangeRate[]                                                         @xsd(name: "ExchangeRate")
  /// ASBIE
  /// Telecommunications Service. Allowance Charge
  /// An allowance or charge that applies to the UtilityStatement as a whole.
  /// 0..n
  /// Telecommunications Service
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  allowance_charge                         AllowanceCharge[]                                                      @xsd(name: "AllowanceCharge")
  /// ASBIE
  /// Telecommunications Service. Tax Total
  /// A total amount of taxes of a particular kind applicable to this telecommunications service.
  /// 0..n
  /// Telecommunications Service
  /// Tax Total
  /// Tax Total
  /// Tax Total
  tax_total                                TaxTotal[]                                                             @xsd(name: "TaxTotal")
  /// ASBIE
  /// Telecommunications Service. Call_ Duty. Duty
  /// In the case of a telephone call, a duty on this call.
  /// 0..n
  /// Telecommunications Service
  /// Call
  /// Duty
  /// Duty
  /// Duty
  call_duty                                ubl_common_aggregate_components_2_1.Duty[]                             @xsd(name: "CallDuty")
  /// ASBIE
  /// Telecommunications Service. Time_ Duty. Duty
  /// A duty on a consumption of time.
  /// 0..n
  /// Telecommunications Service
  /// Time
  /// Duty
  /// Duty
  /// Duty
  time_duty                                ubl_common_aggregate_components_2_1.Duty[]                             @xsd(name: "TimeDuty")

  @@xsd(name: "TelecommunicationsService")
}

/// ABIE
