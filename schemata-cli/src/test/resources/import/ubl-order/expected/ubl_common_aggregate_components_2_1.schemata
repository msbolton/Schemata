  /// 0..1
  /// Line Item
  /// Pricing Reference
  /// Pricing Reference
  /// Pricing Reference
  @xsd(name = "PricingReference") pricing_reference:            PricingReference?
  /// ASBIE
  /// Line Item. Allowance Charge
  /// An allowance or charge associated with this line item.
  /// 0..n
  /// Line Item
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  @xsd(name = "AllowanceCharge") allowance_charge:             list<AllowanceCharge>
  /// ASBIE
  /// Line Item. Price
  /// The price of the item of trade associated with this line item.
  /// 0..1
  /// Line Item
  /// Price
  /// Price
  /// Price
  @xsd(name = "Price") price:                        Price?
  /// ASBIE
  /// Line Item. Item
  /// The item of trade associated with this line item.
  /// 1
  /// Line Item
  /// Item
  /// Item
  /// Item
  @xsd(name = "Item") item:                         Item
  /// ASBIE
  /// Line Item. Sub_ Line Item. Line Item
