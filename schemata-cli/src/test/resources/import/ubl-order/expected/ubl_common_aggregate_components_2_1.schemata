  /// 0..1
  /// Exchange Rate
  /// Source
  /// Currency Base Rate
  /// Rate
  /// Rate. Type
  @xsd(name = "SourceCurrencyBaseRate") source_currency_base_rate: ubl_common_basic_components_2_1.SourceCurrencyBaseRate?
  /// BBIE
