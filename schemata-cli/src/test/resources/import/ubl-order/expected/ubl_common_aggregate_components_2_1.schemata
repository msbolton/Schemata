  /// 0..1
  /// External Reference
  /// Document Hash
  /// Text
  /// Text. Type
  @xsd(name = "DocumentHash") document_hash:         ubl_common_basic_components_2_1.DocumentHash?
  /// BBIE
  /// External Reference. Hash Algorithm Method. Text
