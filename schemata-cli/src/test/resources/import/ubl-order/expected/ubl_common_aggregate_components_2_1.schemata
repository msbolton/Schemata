  /// 1
  /// Monetary Total
  /// Payable
  /// Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "PayableAmount") payable_amount:             ubl_common_basic_components_2_1.PayableAmount
  /// BBIE
  /// Monetary Total. Payable_ Alternative Amount. Amount
