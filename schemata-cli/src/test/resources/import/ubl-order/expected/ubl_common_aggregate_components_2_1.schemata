/// ABIE
/// Status. Details
/// A class to describe the condition or position of an object.
/// Status
model Status {
  /// BBIE
  /// Status. Condition Code. Code
  /// Specifies the status condition of the related object.
  /// 0..1
  /// Status
  /// Condition Code
  /// Code
  /// Code. Type
  condition_code       ubl_common_basic_components_2_1.ConditionCode?       @xsd(name: "ConditionCode")
  /// BBIE
  /// Status. Reference Date. Date
  /// The reference date for this status.
  /// 0..1
  /// Status
  /// Reference Date
  /// Date
  /// Date. Type
  reference_date       ubl_common_basic_components_2_1.ReferenceDate?       @xsd(name: "ReferenceDate")
  /// BBIE
  /// Status. Reference Time. Time
  /// The reference time for this status.
  /// 0..1
  /// Status
  /// Reference Time
  /// Time
  /// Time. Type
  reference_time       ubl_common_basic_components_2_1.ReferenceTime?       @xsd(name: "ReferenceTime")
  /// BBIE
  /// Status. Description. Text
  /// Text describing this status.
  /// 0..n
  /// Status
  /// Description
  /// Text
  /// Text. Type
  description          ubl_common_basic_components_2_1.Description[]        @xsd(name: "Description")
  /// BBIE
  /// Status. Status Reason Code. Code
  /// The reason for this status condition or position, expressed as a code.
  /// 0..1
  /// Status
  /// Status Reason Code
  /// Code
  /// Code. Type
  status_reason_code   ubl_common_basic_components_2_1.StatusReasonCode?    @xsd(name: "StatusReasonCode")
  /// BBIE
  /// Status. Status_ Reason. Text
  /// The reason for this status condition or position, expressed as text.
  /// 0..n
  /// Status
  /// Status
  /// Reason
  /// Text
  /// Text. Type
  status_reason        ubl_common_basic_components_2_1.StatusReason[]       @xsd(name: "StatusReason")
  /// BBIE
  /// Status. Sequence Identifier. Identifier
  /// A sequence identifier for this status.
  /// 0..1
  /// Status
  /// Sequence Identifier
  /// Identifier
  /// Identifier. Type
  sequence_id          ubl_common_basic_components_2_1.SequenceID?          @xsd(name: "SequenceID")
  /// BBIE
  /// Status. Text
  /// Provides any textual information related to this status.
  /// 0..n
  /// Status
  /// Text
  /// Text
  /// Text. Type
  text                 ubl_common_basic_components_2_1.Text[]               @xsd(name: "Text")
  /// BBIE
  /// Status. Indication_ Indicator. Indicator
  /// Specifies an indicator relevant to a specific status.
  /// 0..1
  /// Status
  /// Indication
  /// Indicator
  /// Indicator
  /// Indicator. Type
  indication_indicator ubl_common_basic_components_2_1.IndicationIndicator? @xsd(name: "IndicationIndicator")
  /// BBIE
  /// Status. Percent
  /// A percentage meaningful in the context of this status.
  /// 0..1
  /// Status
  /// Percent
  /// Percent
  /// Percent. Type
  percent              ubl_common_basic_components_2_1.Percent?             @xsd(name: "Percent")
  /// BBIE
  /// Status. Reliability Percent. Percent
  /// The reliability of this status, expressed as a percentage.
  /// 0..1
  /// Status
  /// Reliability Percent
  /// Percent
  /// Percent. Type
  reliability_percent  ubl_common_basic_components_2_1.ReliabilityPercent?  @xsd(name: "ReliabilityPercent")
  /// ASBIE
  /// Status. Condition
  /// Measurements that quantify the condition of the objects covered by the status.
  /// 0..n
  /// Status
  /// Condition
  /// Condition
  /// Condition
  condition            ubl_common_aggregate_components_2_1.Condition[]      @xsd(name: "Condition")
}

/// ABIE
/// Stock Availability Report Line. Details
