  @xsd(name = "Value") value:           ubl_common_basic_components_2_1.Value?
  /// BBIE
  /// Meter Property. Value_ Quantity. Quantity
  /// The value of this meter property, expressed as a quantity.
  /// 0..1
  /// Meter Property
  /// Value
  /// Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "ValueQuantity") value_quantity:  ubl_common_basic_components_2_1.ValueQuantity?
  /// BBIE
  /// Meter Property. Value Qualifier. Text
