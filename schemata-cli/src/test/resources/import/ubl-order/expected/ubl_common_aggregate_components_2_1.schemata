  /// Catalogue Reference
  /// Issue Date
  /// Date
  /// Date. Type
  @xsd(name = "IssueDate") issue_date:          ubl_common_basic_components_2_1.IssueDate?
  /// BBIE
  /// Catalogue Reference. Issue Time. Time
  /// The time at which the catalogue was issued.
  /// 0..1
  /// Catalogue Reference
  /// Issue Time
  /// Time
  /// Time. Type
  @xsd(name = "IssueTime") issue_time:          ubl_common_basic_components_2_1.IssueTime?
  /// BBIE
  /// Catalogue Reference. Revision Date. Date
  /// The date on which the information in the catalogue was last revised.
  /// 0..1
  /// Catalogue Reference
  /// Revision Date
  /// Date
  /// Date. Type
  @xsd(name = "RevisionDate") revision_date:       ubl_common_basic_components_2_1.RevisionDate?
  /// BBIE
  /// Catalogue Reference. Revision Time. Time
  /// The time at which the information in the catalogue was last revised.
  /// 0..1
  /// Catalogue Reference
  /// Revision Time
  /// Time
  /// Time. Type
  @xsd(name = "RevisionTime") revision_time:       ubl_common_basic_components_2_1.RevisionTime?
  /// BBIE
  /// Catalogue Reference. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Catalogue Reference
  /// Note
  /// Text
  /// Text. Type
  @xsd(name = "Note") note:                list<ubl_common_basic_components_2_1.Note>
  /// BBIE
  /// Catalogue Reference. Description. Text
  /// Text describing the catalogue.
  /// 0..n
  /// Catalogue Reference
  /// Description
  /// Text
  /// Text. Type
  /// computer accessories for laptops
  @xsd(name = "Description") description:         list<ubl_common_basic_components_2_1.Description>
  /// BBIE
  /// Catalogue Reference. Version. Identifier
  /// An identifier for the current version of the catalogue.
  /// 0..1
  /// Catalogue Reference
  /// Version
  /// Identifier
  /// Identifier. Type
  /// 1.1
  @xsd(name = "VersionID") version_id:          ubl_common_basic_components_2_1.VersionID?
  /// BBIE
