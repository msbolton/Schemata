  @xsd(name = "WarrantyInformation") warranty_information:                list<ubl_common_basic_components_2_1.WarrantyInformation>
  /// BBIE
  /// Catalogue Line. Pack Level Code. Code
  /// A mutually agreed code signifying the level of packaging associated with the item described in this catalogue line.
  /// 0..1
  /// Catalogue Line
  /// Pack Level Code
  /// Code
  /// Code. Type
  /// Consumer Unit, Trading Unit
  /// level 2 , Group 4
  @xsd(name = "PackLevelCode") pack_level_code:                     ubl_common_basic_components_2_1.PackLevelCode?
  /// ASBIE
  /// Catalogue Line. Contractor_ Customer Party. Customer Party
  /// The customer responsible for the contract with which this catalogue line is associated.
  /// 0..1
  /// Catalogue Line
  /// Contractor
  /// Customer Party
  /// Customer Party
  /// Customer Party
  @xsd(name = "ContractorCustomerParty") contractor_customer_party:           CustomerParty?
  /// ASBIE
  /// Catalogue Line. Seller_ Supplier Party. Supplier Party
