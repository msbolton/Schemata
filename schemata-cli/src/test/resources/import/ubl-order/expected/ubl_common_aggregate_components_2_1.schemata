  /// 0..1
  /// Shipment
  /// Last Exit Port
  /// Location
  /// Location
  /// Location
  last_exit_port_location                ubl_common_aggregate_components_2_1.Location?                       @xsd(name: "LastExitPortLocation")
  /// ASBIE
