  /// 0..1
  /// Hazardous Item
  /// Net
  /// Weight
  /// Measure
  /// Measure. Type
  @xsd(name = "NetWeightMeasure") net_weight_measure:             ubl_common_basic_components_2_1.NetWeightMeasure?
  /// BBIE
  /// Hazardous Item. Net_ Volume. Measure
