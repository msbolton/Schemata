  /// The minimum amount of the item described in this catalogue line that can be ordered.
  /// 0..1
  /// Catalogue Line
  /// Minimum
  /// Order Quantity
  /// Quantity
  /// Quantity. Type
  /// 10 boxes
  @xsd(name = "MinimumOrderQuantity") minimum_order_quantity:              ubl_common_basic_components_2_1.MinimumOrderQuantity?
  /// BBIE
  /// Catalogue Line. Maximum_ Order Quantity. Quantity
  /// The maximum amount of the item described in this catalogue line that can be ordered.
  /// 0..1
  /// Catalogue Line
  /// Maximum
  /// Order Quantity
  /// Quantity
  /// Quantity. Type
  /// 1 tonne
  @xsd(name = "MaximumOrderQuantity") maximum_order_quantity:              ubl_common_basic_components_2_1.MaximumOrderQuantity?
  /// BBIE
  /// Catalogue Line. Warranty_ Information. Text
  /// Text about a warranty (provided by WarrantyParty) for the good or service described in this catalogue line.
  /// 0..n
  /// Catalogue Line
  /// Warranty
  /// Information
  /// Text
  /// Text. Type
