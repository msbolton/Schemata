  /// 0..1
  /// Hazardous Item
  /// Emergency
  /// Temperature
  /// Temperature
  /// Temperature
  @xsd(name = "EmergencyTemperature") emergency_temperature:          Temperature?
  /// ASBIE
  /// Hazardous Item. Flashpoint_ Temperature. Temperature
