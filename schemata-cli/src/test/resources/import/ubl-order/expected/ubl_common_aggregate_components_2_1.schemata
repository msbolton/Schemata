  /// On Account Payment
  /// Estimated
  /// Consumed Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "EstimatedConsumedQuantity") estimated_consumed_quantity: ubl_common_basic_components_2_1.EstimatedConsumedQuantity
  /// BBIE
  /// On Account Payment. Note. Text
