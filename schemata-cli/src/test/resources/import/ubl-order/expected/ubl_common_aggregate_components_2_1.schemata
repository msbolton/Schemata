  /// 0..1
  /// Catalogue Line
  /// Line Validity
  /// Period
  /// Period
  /// Period
  @xsd(name = "LineValidityPeriod") line_validity_period:                Period?
  /// ASBIE
  /// Catalogue Line. Item Comparison
