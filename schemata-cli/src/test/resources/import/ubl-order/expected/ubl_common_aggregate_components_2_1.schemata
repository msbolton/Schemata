  /// Exchange Rate
  /// Target
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  @xsd(name = "TargetCurrencyCode") target_currency_code:      ubl_common_basic_components_2_1.TargetCurrencyCode
  /// BBIE
  /// Exchange Rate. Target_ Currency Base Rate. Rate
  /// In the case of a target currency with denominations of small value, the unit base.
  /// 0..1
  /// Exchange Rate
  /// Target
  /// Currency Base Rate
  /// Rate
  /// Rate. Type
  @xsd(name = "TargetCurrencyBaseRate") target_currency_base_rate: ubl_common_basic_components_2_1.TargetCurrencyBaseRate?
  /// BBIE
  /// Exchange Rate. Exchange Market Identifier. Identifier
  /// An identifier for the currency exchange market used as the source of this exchange rate.
  /// 0..1
  /// Exchange Rate
  /// Exchange Market Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "ExchangeMarketID") exchange_market_id:        ubl_common_basic_components_2_1.ExchangeMarketID?
  /// BBIE
  /// Exchange Rate. Calculation Rate. Rate
  /// The factor applied to the source currency to calculate the target currency.
  /// 0..1
  /// Exchange Rate
  /// Calculation Rate
  /// Rate
  /// Rate. Type
  @xsd(name = "CalculationRate") calculation_rate:          ubl_common_basic_components_2_1.CalculationRate?
  /// BBIE
  /// Exchange Rate. Mathematic Operator Code. Code
  /// A code signifying whether the calculation rate is a multiplier or a divisor.
  /// 0..1
  /// Exchange Rate
  /// Mathematic Operator Code
  /// Code
  /// Operator
  /// Operator_ Code. Type
  @xsd(name = "MathematicOperatorCode") mathematic_operator_code:  ubl_common_basic_components_2_1.MathematicOperatorCode?
  /// BBIE
  /// Exchange Rate. Date
  /// The date on which the exchange rate was established.
  /// 0..1
  /// Exchange Rate
  /// Date
  /// Date
  /// Date. Type
  @xsd(name = "Date") date:                      ubl_common_basic_components_2_1.Date?
  /// ASBIE
  /// Exchange Rate. Foreign Exchange_ Contract. Contract
  /// A contract for foreign exchange.
  /// 0..1
  /// Exchange Rate
  /// Foreign Exchange
  /// Contract
  /// Contract
  /// Contract
  @xsd(name = "ForeignExchangeContract") foreign_exchange_contract: Contract?
}

/// ABIE
/// External Reference. Details
/// A class to describe an external object, such as a document stored at a remote location.
/// External Reference
@xsd(name = "ExternalReference")
record ExternalReference {
  /// BBIE
  /// External Reference. URI. Identifier
  /// The Uniform Resource Identifier (URI) that identifies the external object as an Internet resource.
  /// 0..1
  /// External Reference
  /// URI
  /// Identifier
  /// Identifier. Type
  @xsd(name = "URI") uri:                   ubl_common_basic_components_2_1.URI?
  /// BBIE
  /// External Reference. Document Hash. Text
