  /// Text
  /// Text. Type
  /// Remarks
  @xsd(name = "Note") note:                        list<ubl_common_basic_components_2_1.Note>
  /// BBIE
  /// Contract. Version. Identifier
  /// An identifier for the current version of this contract.
  /// 0..1
  /// Contract
  /// Version
  /// Identifier
  /// Identifier. Type
  @xsd(name = "VersionID") version_id:                  ubl_common_basic_components_2_1.VersionID?
  /// BBIE
  /// Contract. Description. Text
  /// Text describing this contract.
  /// 0..n
  /// Contract
  /// Description
  /// Text
  /// Text. Type
  @xsd(name = "Description") description:                 list<ubl_common_basic_components_2_1.Description>
