  /// 0..1
  /// Utility Item
  /// Consumption Type Code
  /// Code
  /// Code. Type
  /// Consumption
  consumption_type_code     ubl_common_basic_components_2_1.ConsumptionTypeCode?   @xsd(name: "ConsumptionTypeCode")
  /// BBIE
