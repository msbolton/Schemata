  contract                  Contract?                                              @xsd(name: "Contract")

  @@xsd(name: "UtilityItem")
}

/// ABIE
/// Web Site Access. Details
/// A class to describe access to a web site.
/// Web Site Access
model WebSiteAccess {
  /// BBIE
