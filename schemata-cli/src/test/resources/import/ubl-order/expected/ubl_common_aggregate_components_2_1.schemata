/// Transport Equipment Seal
/// Container Seal
model TransportEquipmentSeal {
  /// BBIE
  /// Transport Equipment Seal. Identifier
  /// An identifier for this transport equipment seal.
  /// 1
  /// Transport Equipment Seal
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// ACS1234
  id                    ubl_common_basic_components_2_1.ID                  @xsd(name: "ID")
  /// BBIE
  /// Transport Equipment Seal. Seal Issuer Type Code. Code
  /// A code signifying the type of party that issues and is responsible for this transport equipment seal.
  /// 0..1
  /// Transport Equipment Seal
  /// Seal Issuer Type Code
  /// Code
  /// Code. Type
  seal_issuer_type_code ubl_common_basic_components_2_1.SealIssuerTypeCode? @xsd(name: "SealIssuerTypeCode")
  /// BBIE
  /// Transport Equipment Seal. Condition. Text
  /// The condition of this transport equipment seal.
  /// 0..1
  /// Transport Equipment Seal
  /// Condition
  /// Text
  /// Text. Type
  condition             ubl_common_basic_components_2_1.Condition?          @xsd(name: "Condition")
  /// BBIE
  /// Transport Equipment Seal. Seal Status Code. Code
  /// A code signifying the condition of this transport equipment seal.
  /// 0..1
  /// Transport Equipment Seal
  /// Seal Status Code
  /// Code
  /// Code. Type
  seal_status_code      ubl_common_basic_components_2_1.SealStatusCode?     @xsd(name: "SealStatusCode")
  /// BBIE
  /// Transport Equipment Seal. Sealing Party Type. Text
  /// The role of the sealing party.
  /// 0..1
  /// Transport Equipment Seal
  /// Sealing Party Type
  /// Text
  /// Text. Type
  /// Sealing Party
  sealing_party_type    ubl_common_basic_components_2_1.SealingPartyType?   @xsd(name: "SealingPartyType")

  @@xsd(name: "TransportEquipmentSeal")
}

/// ABIE
/// Transport Event. Details
/// A class to describe a significant occurrence or happening related to the transportation of goods.
/// Transport Event
