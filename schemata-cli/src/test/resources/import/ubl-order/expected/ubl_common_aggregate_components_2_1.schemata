  /// 0..1
  /// Tendering Terms
  /// Price Evaluation Code
  /// Code
  /// Code. Type
  /// Unit prices, global price
  @xsd(name = "PriceEvaluationCode") price_evaluation_code:                        ubl_common_basic_components_2_1.PriceEvaluationCode?
