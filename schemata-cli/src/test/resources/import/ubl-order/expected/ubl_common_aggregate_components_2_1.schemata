  /// 0..1
  /// Financial Guarantee
  /// Liability
  /// Amount
  /// Amount. Type
  @xsd(name = "LiabilityAmount") liability_amount:    ubl_common_basic_components_2_1.LiabilityAmount?
  /// BBIE
  /// Financial Guarantee. Amount. Rate
