/// ABIE
/// Capability. Details
/// A class to describe a specific capability of an organization.
/// Capability
model Capability {
  /// BBIE
  /// Capability. Capability Type Code. Code
  /// This class can be used as Financial or Technical capabilities. For instance, "Turnover" or "Qualified Engineers" are two possible codes.
  /// 0..1
  /// Capability
  /// Capability Type Code
  /// Code
  /// Code. Type
  capability_type_code ubl_common_basic_components_2_1.CapabilityTypeCode? @xsd(name: "CapabilityTypeCode")
  /// BBIE
  /// Capability. Description. Text
  /// Text describing this capability.
  /// 0..n
  /// Capability
  /// Description
  /// Text
  /// Text. Type
  description          ubl_common_basic_components_2_1.Description[]       @xsd(name: "Description")
  /// BBIE
  /// Capability. Value. Amount
  /// A monetary amount as a measure of this capability.
  /// 0..1
  /// Capability
  /// Value
  /// Amount
  /// Amount. Type
  value_amount         ubl_common_basic_components_2_1.ValueAmount?        @xsd(name: "ValueAmount")
  /// BBIE
  /// Capability. Value_ Quantity. Quantity
  /// A quantity as a measure of this capability.
  /// 0..1
  /// Capability
  /// Value
  /// Quantity
  /// Quantity
  /// Quantity. Type
  value_quantity       ubl_common_basic_components_2_1.ValueQuantity?      @xsd(name: "ValueQuantity")
  /// ASBIE
  /// Capability. Evidence Supplied
  /// The evidence that supports the capability claim.
  /// 0..n
  /// Capability
  /// Evidence Supplied
  /// Evidence Supplied
  /// Evidence Supplied
  evidence_supplied    EvidenceSupplied[]                                  @xsd(name: "EvidenceSupplied")
  /// ASBIE
  /// Capability. Validity_ Period. Period
  /// The period of time for which this capability is (or has been) valid.
  /// 0..1
  /// Capability
  /// Validity
  /// Period
  /// Period
  /// Period
  validity_period      Period?                                             @xsd(name: "ValidityPeriod")

  @@xsd(name: "Capability")
}

/// ABIE
/// Card Account. Details
/// A class to define a credit card, debit card, or charge card account.
/// Card Account
model CardAccount {
  /// BBIE
  /// Card Account. Primary_ Account Number. Identifier
  /// An identifier of the card (e.g., the Primary Account Number (PAN)).
  /// 1
  /// Card Account
  /// Primary
  /// Account Number
  /// Identifier
  /// Identifier. Type
  /// 4558 XXXX XXXX XXXX (a real card number)
  primary_account_number_id ubl_common_basic_components_2_1.PrimaryAccountNumberID @xsd(name: "PrimaryAccountNumberID")
  /// BBIE
  /// Card Account. Network. Identifier
  /// An identifier for the financial service network provider of the card.
  /// 1
  /// Card Account
  /// Network
  /// Identifier
  /// Identifier. Type
  /// VISA, MasterCard, American Express
  network_id                ubl_common_basic_components_2_1.NetworkID              @xsd(name: "NetworkID")
  /// BBIE
  /// Card Account. Card Type Code. Code
  /// A mutually agreed code signifying the type of card. Examples of types are "debit", "credit" and "purchasing"
  /// 0..1
  /// Card Account
  /// Card Type Code
  /// Code
  /// Code. Type
  /// Debit Card, Credit Card, Procurement Card
  card_type_code            ubl_common_basic_components_2_1.CardTypeCode?          @xsd(name: "CardTypeCode")
  /// BBIE
  /// Card Account. Validity Start Date. Date
  /// The date from which the card is valid.
  /// 0..1
  /// Card Account
  /// Validity Start Date
  /// Date
  /// Date. Type
  validity_start_date       ubl_common_basic_components_2_1.ValidityStartDate?     @xsd(name: "ValidityStartDate")
  /// BBIE
  /// Card Account. Expiry Date. Date
  /// The date on which the card expires.
  /// 0..1
  /// Card Account
  /// Expiry Date
  /// Date
  /// Date. Type
  expiry_date               ubl_common_basic_components_2_1.ExpiryDate?            @xsd(name: "ExpiryDate")
  /// BBIE
  /// Card Account. Issuer. Identifier
  /// An identifier for the institution issuing the card.
  /// 0..1
  /// Card Account
  /// Issuer
  /// Identifier
  /// Identifier. Type
  issuer_id                 ubl_common_basic_components_2_1.IssuerID?              @xsd(name: "IssuerID")
  /// BBIE
  /// Card Account. Issue Number. Identifier
  /// An identifier for the card, specified by the issuer.
  /// 0..1
  /// Card Account
  /// Issue Number
  /// Identifier
  /// Identifier. Type
  issue_number_id           ubl_common_basic_components_2_1.IssueNumberID?         @xsd(name: "IssueNumberID")
  /// BBIE
  /// Card Account. CV2. Identifier
  /// An identifier for the Card Verification Value (often found on the reverse of the card itself).
  /// 0..1
  /// Card Account
  /// CV2
  /// Identifier
  /// Identifier. Type
  cv2_id                    ubl_common_basic_components_2_1.CV2ID?                 @xsd(name: "CV2ID")
  /// BBIE
  /// Card Account. Card Chip Code. Code
  /// A mutually agreed code to distinguish between CHIP and MAG STRIPE cards.
  /// 0..1
  /// Card Account
  /// Card Chip Code
  /// Code
  /// Chip
  /// Chip_ Code. Type
  card_chip_code            ubl_common_basic_components_2_1.CardChipCode?          @xsd(name: "CardChipCode")
  /// BBIE
  /// Card Account. Chip_ Application. Identifier
  /// An identifier on the chip card for the application that provides the quoted information; an AID (application ID).
  /// 0..1
  /// Card Account
  /// Chip
  /// Application
  /// Identifier
  /// Identifier. Type
  chip_application_id       ubl_common_basic_components_2_1.ChipApplicationID?     @xsd(name: "ChipApplicationID")
  /// BBIE
  /// Card Account. Holder. Name
  /// The name of the cardholder.
  /// 0..1
  /// Card Account
  /// Holder
  /// Name
  /// Name. Type
  holder_name               ubl_common_basic_components_2_1.HolderName?            @xsd(name: "HolderName")

  @@xsd(name: "CardAccount")
}

/// ABIE
