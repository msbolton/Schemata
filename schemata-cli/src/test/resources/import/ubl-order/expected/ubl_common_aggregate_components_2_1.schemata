  /// 0..1
  /// Monetary Total
  /// Charge
  /// Total Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "ChargeTotalAmount") charge_total_amount:        ubl_common_basic_components_2_1.ChargeTotalAmount?
  /// BBIE
  /// Monetary Total. Prepaid Amount. Amount
  /// The total prepaid monetary amount.
  /// 0..1
  /// Monetary Total
  /// Prepaid Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "PrepaidAmount") prepaid_amount:             ubl_common_basic_components_2_1.PrepaidAmount?
  /// BBIE
  /// Monetary Total. Payable_ Rounding Amount. Amount
  /// The rounding amount (positive or negative) added to produce the line extension amount.
  /// 0..1
  /// Monetary Total
  /// Payable
  /// Rounding Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "PayableRoundingAmount") payable_rounding_amount:    ubl_common_basic_components_2_1.PayableRoundingAmount?
  /// BBIE
  /// Monetary Total. Payable_ Amount. Amount
