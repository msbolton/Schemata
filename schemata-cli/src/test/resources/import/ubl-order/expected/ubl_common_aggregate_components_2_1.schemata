  /// Code
  /// Code. Type
  resolution_code                 ubl_common_basic_components_2_1.ResolutionCode?              @xsd(name: "ResolutionCode")
  /// BBIE
  /// Exception Notification Line. Compared Value. Measure
  /// The value that was compared with the source value that resulted in the exception
  /// 1
  /// Exception Notification Line
  /// Compared Value
  /// Measure
  /// Measure. Type
  compared_value_measure          ubl_common_basic_components_2_1.ComparedValueMeasure         @xsd(name: "ComparedValueMeasure")
  /// BBIE
  /// Exception Notification Line. Source Value. Measure
  /// The value used as the basis of comparison
  /// 1
  /// Exception Notification Line
  /// Source Value
  /// Measure
  /// Measure. Type
  source_value_measure            ubl_common_basic_components_2_1.SourceValueMeasure           @xsd(name: "SourceValueMeasure")
  /// BBIE
  /// Exception Notification Line. Variance. Quantity
  /// The variance of a data item from an expected value during a particular time interval.
  /// 0..1
  /// Exception Notification Line
  /// Variance
  /// Quantity
  /// Quantity. Type
  variance_quantity               ubl_common_basic_components_2_1.VarianceQuantity?            @xsd(name: "VarianceQuantity")
  /// BBIE
  /// Exception Notification Line. Supply Chain Activity Type Code. Code
  /// Establishes the criterion for one of the three types of exceptions: Operational, performance metric and forecast. This reports an exception notification about an operational exception. Description could be: A code used to identify an operational exception. Possible values are: CANCELED_ORDERS EMERGENCY_ORDERS ON_HAND ORDERS RECEIPTS SALES SHIPMENTS
  /// 0..1
  /// Exception Notification Line
  /// Supply Chain Activity Type Code
  /// Code
  /// Code. Type
  supply_chain_activity_type_code ubl_common_basic_components_2_1.SupplyChainActivityTypeCode? @xsd(name: "SupplyChainActivityTypeCode")
  /// BBIE
  /// Exception Notification Line. Performance Metric Type Code. Code
  /// A code used to identify a measure of performance. It defines the type of the Performance Metric on which an exception criteria is being defined
  /// 0..1
  /// Exception Notification Line
  /// Performance Metric Type Code
  /// Code
  /// Code. Type
  performance_metric_type_code    ubl_common_basic_components_2_1.PerformanceMetricTypeCode?   @xsd(name: "PerformanceMetricTypeCode")
  /// ASBIE
  /// Exception Notification Line. Exception Observation_ Period. Period
  /// The period (start-end date) when this exception is observed
  /// 0..1
  /// Exception Notification Line
  /// Exception Observation
  /// Period
  /// Period
  /// Period
  exception_observation_period    Period?                                                      @xsd(name: "ExceptionObservationPeriod")
  /// ASBIE
  /// Exception Notification Line. Document Reference
  /// A reference to Exception Criteria document can be provided.
  /// 0..n
  /// Exception Notification Line
  /// Document Reference
  /// Document Reference
  /// Document Reference
  document_reference              DocumentReference[]                                          @xsd(name: "DocumentReference")
  /// ASBIE
  /// Exception Notification Line. Forecast Exception
  /// A forecast accuracy or comparison exception.
  /// 0..1
  /// Exception Notification Line
  /// Forecast Exception
  /// Forecast Exception
  /// Forecast Exception
  forecast_exception              ForecastException?                                           @xsd(name: "ForecastException")
  /// ASBIE
  /// Exception Notification Line. Supply_ Item. Item
  /// The product associated with this exception notification line.
  /// 1
  /// Exception Notification Line
  /// Supply
  /// Item
  /// Item
  /// Item
  supply_item                     Item                                                         @xsd(name: "SupplyItem")

  @@xsd(name: "ExceptionNotificationLine")
}

/// ABIE
/// Exchange Rate. Details
/// A class to define an exchange rate.
/// Exchange Rate
model ExchangeRate {
  /// BBIE
  /// Exchange Rate. Source_ Currency Code. Code
  /// The reference currency for this exchange rate; the currency from which the exchange is being made.
  /// 1
  /// Exchange Rate
  /// Source
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  source_currency_code      ubl_common_basic_components_2_1.SourceCurrencyCode      @xsd(name: "SourceCurrencyCode")
  /// BBIE
  /// Exchange Rate. Source_ Currency Base Rate. Rate
  /// In the case of a source currency with denominations of small value, the unit base.
  /// 0..1
  /// Exchange Rate
  /// Source
  /// Currency Base Rate
  /// Rate
  /// Rate. Type
  source_currency_base_rate ubl_common_basic_components_2_1.SourceCurrencyBaseRate? @xsd(name: "SourceCurrencyBaseRate")
  /// BBIE
  /// Exchange Rate. Target_ Currency Code. Code
  /// The target currency for this exchange rate; the currency to which the exchange is being made.
  /// 1
  /// Exchange Rate
  /// Target
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  target_currency_code      ubl_common_basic_components_2_1.TargetCurrencyCode      @xsd(name: "TargetCurrencyCode")
  /// BBIE
  /// Exchange Rate. Target_ Currency Base Rate. Rate
  /// In the case of a target currency with denominations of small value, the unit base.
  /// 0..1
  /// Exchange Rate
  /// Target
  /// Currency Base Rate
  /// Rate
  /// Rate. Type
  target_currency_base_rate ubl_common_basic_components_2_1.TargetCurrencyBaseRate? @xsd(name: "TargetCurrencyBaseRate")
  /// BBIE
  /// Exchange Rate. Exchange Market Identifier. Identifier
  /// An identifier for the currency exchange market used as the source of this exchange rate.
  /// 0..1
  /// Exchange Rate
  /// Exchange Market Identifier
  /// Identifier
  /// Identifier. Type
  exchange_market_id        ubl_common_basic_components_2_1.ExchangeMarketID?       @xsd(name: "ExchangeMarketID")
  /// BBIE
  /// Exchange Rate. Calculation Rate. Rate
  /// The factor applied to the source currency to calculate the target currency.
  /// 0..1
  /// Exchange Rate
  /// Calculation Rate
  /// Rate
  /// Rate. Type
  calculation_rate          ubl_common_basic_components_2_1.CalculationRate?        @xsd(name: "CalculationRate")
  /// BBIE
  /// Exchange Rate. Mathematic Operator Code. Code
  /// A code signifying whether the calculation rate is a multiplier or a divisor.
  /// 0..1
  /// Exchange Rate
  /// Mathematic Operator Code
  /// Code
  /// Operator
  /// Operator_ Code. Type
  mathematic_operator_code  ubl_common_basic_components_2_1.MathematicOperatorCode? @xsd(name: "MathematicOperatorCode")
  /// BBIE
  /// Exchange Rate. Date
  /// The date on which the exchange rate was established.
  /// 0..1
  /// Exchange Rate
  /// Date
  /// Date
  /// Date. Type
  date                      ubl_common_basic_components_2_1.Date?                   @xsd(name: "Date")
  /// ASBIE
  /// Exchange Rate. Foreign Exchange_ Contract. Contract
  /// A contract for foreign exchange.
  /// 0..1
  /// Exchange Rate
  /// Foreign Exchange
  /// Contract
  /// Contract
  /// Contract
  foreign_exchange_contract Contract?                                               @xsd(name: "ForeignExchangeContract")

  @@xsd(name: "ExchangeRate")
}

/// ABIE
/// External Reference. Details
/// A class to describe an external object, such as a document stored at a remote location.
/// External Reference
model ExternalReference {
  /// BBIE
  /// External Reference. URI. Identifier
  /// The Uniform Resource Identifier (URI) that identifies the external object as an Internet resource.
  /// 0..1
  /// External Reference
  /// URI
  /// Identifier
  /// Identifier. Type
  uri                   ubl_common_basic_components_2_1.URI?                 @xsd(name: "URI")
  /// BBIE
  /// External Reference. Document Hash. Text
  /// A hash value for the externally stored object.
  /// 0..1
  /// External Reference
  /// Document Hash
  /// Text
  /// Text. Type
  document_hash         ubl_common_basic_components_2_1.DocumentHash?        @xsd(name: "DocumentHash")
  /// BBIE
  /// External Reference. Hash Algorithm Method. Text
  /// A hash algorithm used to calculate the hash value of the externally stored object.
  /// 0..1
  /// External Reference
  /// Hash Algorithm Method
  /// Text
  /// Text. Type
  hash_algorithm_method ubl_common_basic_components_2_1.HashAlgorithmMethod? @xsd(name: "HashAlgorithmMethod")
  /// BBIE
  /// External Reference. Expiry Date. Date
  /// The date on which availability of the resource can no longer be relied upon.
  /// 0..1
  /// External Reference
  /// Expiry Date
  /// Date
  /// Date. Type
  expiry_date           ubl_common_basic_components_2_1.ExpiryDate?          @xsd(name: "ExpiryDate")
  /// BBIE
  /// External Reference. Expiry Time. Time
  /// The time after which availability of the resource can no longer be relied upon.
  /// 0..1
  /// External Reference
  /// Expiry Time
  /// Time
  /// Time. Type
  expiry_time           ubl_common_basic_components_2_1.ExpiryTime?          @xsd(name: "ExpiryTime")
  /// BBIE
  /// External Reference. Mime Code. Code
  /// A code signifying the mime type of the external object.
  /// 0..1
  /// External Reference
  /// Mime Code
  /// Code
  /// Code. Type
  mime_code             ubl_common_basic_components_2_1.MimeCode?            @xsd(name: "MimeCode")
  /// BBIE
  /// External Reference. Format Code. Code
  /// A code signifying the format of the external object.
  /// 0..1
  /// External Reference
  /// Format Code
  /// Code
  /// Code. Type
  format_code           ubl_common_basic_components_2_1.FormatCode?          @xsd(name: "FormatCode")
  /// BBIE
  /// External Reference. Encoding Code. Code
  /// A code signifying the encoding/decoding algorithm used with the external object.
  /// 0..1
  /// External Reference
  /// Encoding Code
  /// Code
  /// Code. Type
  encoding_code         ubl_common_basic_components_2_1.EncodingCode?        @xsd(name: "EncodingCode")
  /// BBIE
  /// External Reference. Character Set Code. Code
  /// A code signifying the character set of an external document.
  /// 0..1
  /// External Reference
  /// Character Set Code
  /// Code
  /// Code. Type
  character_set_code    ubl_common_basic_components_2_1.CharacterSetCode?    @xsd(name: "CharacterSetCode")
  /// BBIE
  /// External Reference. File Name. Name
  /// The file name of the external object.
  /// 0..1
  /// External Reference
  /// File Name
  /// Name
  /// Name. Type
  file_name             ubl_common_basic_components_2_1.FileName?            @xsd(name: "FileName")
  /// BBIE
  /// External Reference. Description. Text
  /// Text describing the external object.
  /// 0..n
  /// External Reference
  /// Description
  /// Text
  /// Text. Type
  /// computer accessories for laptops
  description           ubl_common_basic_components_2_1.Description[]        @xsd(name: "Description")

  @@xsd(name: "ExternalReference")
}

/// ABIE
/// Financial Account. Details
/// A class to describe a financial account.
/// Financial Account
model FinancialAccount {
  /// BBIE
  /// Financial Account. Identifier
  /// The identifier for this financial account; the bank account number.
  /// 0..1
  /// Financial Account
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// SWIFT(BIC) and IBAN are defined in ISO 9362 and ISO 13616.
  id                           ubl_common_basic_components_2_1.ID?                @xsd(name: "ID")
  /// BBIE
  /// Financial Account. Name
  /// The name of this financial account.
  /// 0..1
  /// Financial Account
  /// Name
  /// Name
  /// Name. Type
  name                         ubl_common_basic_components_2_1.Name?              @xsd(name: "Name")
  /// BBIE
  /// Financial Account. Alias_ Name. Name
  /// An alias for the name of this financial account, to be used in place of the actual account name for security reasons.
  /// 0..1
  /// Financial Account
  /// Alias
  /// Name
  /// Name
  /// Name. Type
  alias_name                   ubl_common_basic_components_2_1.AliasName?         @xsd(name: "AliasName")
  /// BBIE
  /// Financial Account. Account Type Code. Code
  /// A code signifying the type of this financial account.
  /// 0..1
  /// Financial Account
  /// Account Type Code
  /// Code
  /// Code. Type
  account_type_code            ubl_common_basic_components_2_1.AccountTypeCode?   @xsd(name: "AccountTypeCode")
  /// BBIE
  /// Financial Account. Account Format Code. Code
  /// A code signifying the format of this financial account.
  /// 0..1
  /// Financial Account
  /// Account Format Code
  /// Code
  /// Code. Type
  /// ISO20022 Clearing System Identification Code
  account_format_code          ubl_common_basic_components_2_1.AccountFormatCode? @xsd(name: "AccountFormatCode")
  /// BBIE
  /// Financial Account. Currency Code. Code
  /// A code signifying the currency in which this financial account is held.
  /// 0..1
  /// Financial Account
  /// Currency Code
  /// Code
  /// Currency
  /// Currency_ Code. Type
  currency_code                ubl_common_basic_components_2_1.CurrencyCode?      @xsd(name: "CurrencyCode")
  /// BBIE
  /// Financial Account. Payment_ Note. Text
  /// Free-form text applying to the Payment for the owner of this account.
  /// 0..n
  /// Financial Account
  /// Payment
  /// Note
  /// Text
  /// Text. Type
  payment_note                 ubl_common_basic_components_2_1.PaymentNote[]      @xsd(name: "PaymentNote")
  /// ASBIE
  /// Financial Account. Financial Institution_ Branch. Branch
  /// The branch of the financial institution associated with this financial account.
  /// 0..1
  /// Financial Account
  /// Financial Institution
  /// Branch
  /// Branch
  /// Branch
  financial_institution_branch Branch?                                            @xsd(name: "FinancialInstitutionBranch")
  /// ASBIE
  /// Financial Account. Country
  /// The country in which the holder of the financial account is domiciled.
  /// 0..1
  /// Financial Account
  /// Country
  /// Country
  /// Country
  country                      Country?                                           @xsd(name: "Country")

  @@xsd(name: "FinancialAccount")
}

/// ABIE
/// Financial Guarantee. Details
/// A class to describe the bond guarantee of a tenderer or bid submitter's actual entry into a contract in the event that it is the successful bidder.
/// Financial Guarantee
model FinancialGuarantee {
  /// BBIE
  /// Financial Guarantee. Guarantee Type Code. Code
  /// A code signifying the type of financial guarantee. For instance "Provisional Guarantee" or "Final Guarantee"
  /// 1
  /// Financial Guarantee
  /// Guarantee Type Code
  /// Code
  /// Code. Type
  guarantee_type_code ubl_common_basic_components_2_1.GuaranteeTypeCode @xsd(name: "GuaranteeTypeCode")
  /// BBIE
  /// Financial Guarantee. Description. Text
  /// Text describing this financial guarantee.
  /// 0..n
  /// Financial Guarantee
  /// Description
  /// Text
  /// Text. Type
  description         ubl_common_basic_components_2_1.Description[]     @xsd(name: "Description")
  /// BBIE
  /// Financial Guarantee. Liability. Amount
  /// The amount of liability in this financial guarantee.
  /// 0..1
  /// Financial Guarantee
  /// Liability
  /// Amount
  /// Amount. Type
  liability_amount    ubl_common_basic_components_2_1.LiabilityAmount?  @xsd(name: "LiabilityAmount")
  /// BBIE
  /// Financial Guarantee. Amount. Rate
  /// The rate used to calculate the amount of liability in this financial guarantee.
  /// 0..1
  /// Financial Guarantee
  /// Amount
  /// Rate
  /// Rate. Type
  amount_rate         ubl_common_basic_components_2_1.AmountRate?       @xsd(name: "AmountRate")
  /// ASBIE
  /// Financial Guarantee. Constitution_ Period. Period
  /// The period during the tendering process to which this financial guarantee has to be settled.
  /// 0..1
  /// Financial Guarantee
  /// Constitution
  /// Period
  /// Period
  /// Period
  constitution_period Period?                                           @xsd(name: "ConstitutionPeriod")
}

/// ABIE
/// Financial Institution. Details
/// A class to describe a financial institution.
/// Financial Institution
model FinancialInstitution {
  /// BBIE
  /// Financial Institution. Identifier
  /// An identifier for this financial institution. It is recommended that the ISO 9362 Bank Identification Code (BIC) be used as the ID.
  /// 0..1
  /// Financial Institution
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id      ubl_common_basic_components_2_1.ID?   @xsd(name: "ID")
  /// BBIE
  /// Financial Institution. Name
  /// The name of this financial institution.
  /// 0..1
  /// Financial Institution
  /// Name
  /// Name
  /// Name. Type
  name    ubl_common_basic_components_2_1.Name? @xsd(name: "Name")
  /// ASBIE
  /// Financial Institution. Address
  /// The address of this financial institution.
  /// 0..1
  /// Financial Institution
  /// Address
  /// Address
  /// Address
  address Address?                              @xsd(name: "Address")

  @@xsd(name: "FinancialInstitution")
}

/// ABIE
/// Forecast Exception. Details
/// As explained in Exception Criteria Line: Three types of exception criteria can be defined, Operational, Metric or Forecast Exceptions. This class provides criteria for forecast exception type: the identification of the purpose of the forecast, the source of data and the time basis criteria for the exception.
/// Forecast Exception
model ForecastException {
  /// BBIE
  /// Forecast Exception. Forecast_ Purpose Code. Code
  /// It is either Sales forecast or Order Forecast. Definition can be changed like: "The purpose of the Forecast (either sales or order), about which an exception criteria is being defined".
  /// 1
  /// Forecast Exception
  /// Forecast
  /// Purpose Code
  /// Code
  /// Code. Type
  forecast_purpose_code          ubl_common_basic_components_2_1.ForecastPurposeCode          @xsd(name: "ForecastPurposeCode")
  /// BBIE
  /// Forecast Exception. Forecast Type Code. Code
  /// A code signifying the type of forecast. Example of values are:BASE PROMOTIONAL SEASONAL TOTAL
  /// 1
  /// Forecast Exception
  /// Forecast Type Code
  /// Code
  /// Code. Type
  forecast_type_code             ubl_common_basic_components_2_1.ForecastTypeCode             @xsd(name: "ForecastTypeCode")
  /// BBIE
  /// Forecast Exception. Issue Date. Date
  /// The date on which the forecast was issued.
  /// 1
  /// Forecast Exception
  /// Issue Date
  /// Date
  /// Date. Type
  issue_date                     ubl_common_basic_components_2_1.IssueDate                    @xsd(name: "IssueDate")
  /// BBIE
  /// Forecast Exception. Issue Time. Time
  /// The time at which the forecast was issued.
  /// 0..1
  /// Forecast Exception
  /// Issue Time
  /// Time
  /// Time. Type
  issue_time                     ubl_common_basic_components_2_1.IssueTime?                   @xsd(name: "IssueTime")
  /// BBIE
  /// Forecast Exception. Data Source Code. Code
  /// A code signifying the partner who provides this information.
  /// 1
  /// Forecast Exception
  /// Data Source Code
  /// Code
  /// Code. Type
  data_source_code               ubl_common_basic_components_2_1.DataSourceCode               @xsd(name: "DataSourceCode")
  /// BBIE
  /// Forecast Exception. Comparison Data Code. Code
  /// A code signifying the partner providing the information in this forecast exception.
  /// 0..1
  /// Forecast Exception
  /// Comparison Data Code
  /// Code
  /// Code. Type
  comparison_data_code           ubl_common_basic_components_2_1.ComparisonDataCode?          @xsd(name: "ComparisonDataCode")
  /// BBIE
  /// Forecast Exception. Comparison Forecast Issue Time. Time
  /// The time at which this comparison forecast was issued.
  /// 0..1
  /// Forecast Exception
  /// Comparison Forecast Issue Time
  /// Time
  /// Time. Type
  comparison_forecast_issue_time ubl_common_basic_components_2_1.ComparisonForecastIssueTime? @xsd(name: "ComparisonForecastIssueTime")
  /// BBIE
  /// Forecast Exception. Comparison Forecast Issue Date. Date
  /// The date on which this comparison forecast was issued.
  /// 0..1
  /// Forecast Exception
  /// Comparison Forecast Issue Date
  /// Date
  /// Date. Type
  comparison_forecast_issue_date ubl_common_basic_components_2_1.ComparisonForecastIssueDate? @xsd(name: "ComparisonForecastIssueDate")

  @@xsd(name: "ForecastException")
}

/// ABIE
/// Forecast Exception Criterion Line. Details
/// Establishes the criterion for one of the three types of exceptions. This class provides criteria for the kind of forecast exception, the identification of the purpose of the forecast, the source of data and the time basis criterion for the exception.
/// Forecast Exception Criterion Line
model ForecastExceptionCriterionLine {
  /// BBIE
  /// Forecast Exception Criterion Line. Forecast_ Purpose Code. Code
  /// A description of the purpose for the forecast that is assigned to each forecast data item exception criterion.
  /// 1
  /// Forecast Exception Criterion Line
  /// Forecast
  /// Purpose Code
  /// Code
  /// Code. Type
  forecast_purpose_code       ubl_common_basic_components_2_1.ForecastPurposeCode       @xsd(name: "ForecastPurposeCode")
  /// BBIE
  /// Forecast Exception Criterion Line. Forecast Type Code. Code
  /// A description of a Forecast selected from a list.
  /// 1
  /// Forecast Exception Criterion Line
  /// Forecast Type Code
  /// Code
  /// Code. Type
  forecast_type_code          ubl_common_basic_components_2_1.ForecastTypeCode          @xsd(name: "ForecastTypeCode")
  /// BBIE
  /// Forecast Exception Criterion Line. Comparison Data Source Code. Code
  /// If it is a forecast comparison exception, this value indicates the other source of information.
  /// 0..1
  /// Forecast Exception Criterion Line
  /// Comparison Data Source Code
  /// Code
  /// Code. Type
  comparison_data_source_code ubl_common_basic_components_2_1.ComparisonDataSourceCode? @xsd(name: "ComparisonDataSourceCode")
  /// BBIE
  /// Forecast Exception Criterion Line. Data Source Code. Code
  /// Indication of the partner who provides the information.
  /// 1
  /// Forecast Exception Criterion Line
  /// Data Source Code
  /// Code
  /// Code. Type
  data_source_code            ubl_common_basic_components_2_1.DataSourceCode            @xsd(name: "DataSourceCode")
  /// BBIE
  /// Forecast Exception Criterion Line. Time Delta Days Quantity. Quantity
  /// Time basis in days for the Exception.
  /// 0..1
  /// Forecast Exception Criterion Line
  /// Time Delta Days Quantity
  /// Quantity
  /// Quantity. Type
  time_delta_days_quantity    ubl_common_basic_components_2_1.TimeDeltaDaysQuantity?    @xsd(name: "TimeDeltaDaysQuantity")

  @@xsd(name: "ForecastExceptionCriterionLine")
}

/// ABIE
/// Forecast Line. Details
/// Detailed information about a particular Forecast Line within a Forecast Document
/// Forecast Line
model ForecastLine {
  /// BBIE
  /// Forecast Line. Identifier
  /// An identifier for this forecast line.
  /// 1
  /// Forecast Line
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                        ubl_common_basic_components_2_1.ID                       @xsd(name: "ID")
  /// BBIE
  /// Forecast Line. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Forecast Line
  /// Note
  /// Text
  /// Text. Type
  note                      ubl_common_basic_components_2_1.Note[]                   @xsd(name: "Note")
  /// BBIE
  /// Forecast Line. Frozen Document Indicator. Indicator
  /// An indicator that the status of the forecast is modifiable (true) or not (false).
  /// 0..1
  /// Forecast Line
  /// Frozen Document Indicator
  /// Indicator
  /// Indicator. Type
  frozen_document_indicator ubl_common_basic_components_2_1.FrozenDocumentIndicator? @xsd(name: "FrozenDocumentIndicator")
  /// BBIE
  /// Forecast Line. Forecast Type Code. Code
  /// A code signifying the type of forecast. Examples: BASE PROMOTIONAL SEASONAL TOTAL
  /// 1
  /// Forecast Line
  /// Forecast Type Code
  /// Code
  /// Code. Type
  /// seasonal, total
  forecast_type_code        ubl_common_basic_components_2_1.ForecastTypeCode         @xsd(name: "ForecastTypeCode")
  /// ASBIE
  /// Forecast Line. Forecast_ Period. Period
  /// The period to which the forecast applies.
  /// 0..1
  /// Forecast Line
  /// Forecast
  /// Period
  /// Period
  /// Period
  forecast_period           Period?                                                  @xsd(name: "ForecastPeriod")
  /// ASBIE
  /// Forecast Line. Sales Item
  /// Sales information for the item to which this line applies.
  /// 0..1
  /// Forecast Line
  /// Sales Item
  /// Sales Item
  /// Sales Item
  sales_item                SalesItem?                                               @xsd(name: "SalesItem")

  @@xsd(name: "ForecastLine")
}

/// ABIE
/// Forecast Revision Line. Details
/// A class to define a line in a Forecast Revision describing a revision to a line in a Forecast.
/// Forecast Revision Line
model ForecastRevisionLine {
  /// BBIE
  /// Forecast Revision Line. Identifier
  /// An identifier for this forecast revision line.
  /// 1
  /// Forecast Revision Line
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                         ubl_common_basic_components_2_1.ID                      @xsd(name: "ID")
  /// BBIE
  /// Forecast Revision Line. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Forecast Revision Line
  /// Note
  /// Text
  /// Text. Type
  note                       ubl_common_basic_components_2_1.Note[]                  @xsd(name: "Note")
  /// BBIE
  /// Forecast Revision Line. Description. Text
  /// Text describing the revision to this line.
  /// 0..n
  /// Forecast Revision Line
  /// Description
  /// Text
  /// Text. Type
  description                ubl_common_basic_components_2_1.Description[]           @xsd(name: "Description")
  /// BBIE
  /// Forecast Revision Line. Revised_ Forecast Line Identifier. Identifier
  /// An identifier for the revised forecast line.
  /// 1
  /// Forecast Revision Line
  /// Revised
  /// Forecast Line Identifier
  /// Identifier
  /// Identifier. Type
  revised_forecast_line_id   ubl_common_basic_components_2_1.RevisedForecastLineID   @xsd(name: "RevisedForecastLineID")
  /// BBIE
  /// Forecast Revision Line. Source Forecast_ Issue Date. Date
  /// The date on which the forecast modified by this revision was generated or created.
  /// 1
  /// Forecast Revision Line
  /// Source Forecast
  /// Issue Date
  /// Date
  /// Date. Type
  source_forecast_issue_date ubl_common_basic_components_2_1.SourceForecastIssueDate @xsd(name: "SourceForecastIssueDate")
  /// BBIE
  /// Forecast Revision Line. Source Forecast_ Issue Time. Time
  /// The time at which the forecast modified by this revision was generated or created.
  /// 1
  /// Forecast Revision Line
  /// Source Forecast
  /// Issue Time
  /// Time
  /// Time. Type
  source_forecast_issue_time ubl_common_basic_components_2_1.SourceForecastIssueTime @xsd(name: "SourceForecastIssueTime")
  /// BBIE
  /// Forecast Revision Line. Adjustment Reason Code. Code
  /// A code signifying the reason for the adjustment specified in this forecast revision line.
  /// 0..1
  /// Forecast Revision Line
  /// Adjustment Reason Code
  /// Code
  /// Code. Type
  adjustment_reason_code     ubl_common_basic_components_2_1.AdjustmentReasonCode?   @xsd(name: "AdjustmentReasonCode")
  /// ASBIE
  /// Forecast Revision Line. Forecast_ Period. Period
  /// The period to which this forecast revision line applies.
  /// 0..1
  /// Forecast Revision Line
  /// Forecast
  /// Period
  /// Period
  /// Period
  forecast_period            Period?                                                 @xsd(name: "ForecastPeriod")
  /// ASBIE
  /// Forecast Revision Line. Sales Item
  /// Sales information for the item to which this line applies.
  /// 0..1
  /// Forecast Revision Line
  /// Sales Item
  /// Sales Item
  /// Sales Item
  sales_item                 SalesItem?                                              @xsd(name: "SalesItem")

  @@xsd(name: "ForecastRevisionLine")
}

/// ABIE
/// Framework Agreement. Details
/// A class to describe a tendering framework agreement.
/// Framework Agreement
model FrameworkAgreement {
  /// BBIE
  /// Framework Agreement. Expected_ Operator. Quantity
  /// The number of economic operators expected to participate in this framework agreement.
  /// 0..1
  /// Framework Agreement
  /// Expected
  /// Operator
  /// Quantity
  /// Quantity. Type
  expected_operator_quantity            ubl_common_basic_components_2_1.ExpectedOperatorQuantity? @xsd(name: "ExpectedOperatorQuantity")
  /// BBIE
  /// Framework Agreement. Maximum_ Operator. Quantity
  /// The maximum number of economic operators allowed to participate in this framework agreement.
  /// 0..1
  /// Framework Agreement
  /// Maximum
  /// Operator
  /// Quantity
  /// Quantity. Type
  maximum_operator_quantity             ubl_common_basic_components_2_1.MaximumOperatorQuantity?  @xsd(name: "MaximumOperatorQuantity")
  /// BBIE
  /// Framework Agreement. Justification. Text
  /// Text describing the justification for this framework agreement.
  /// 0..n
  /// Framework Agreement
  /// Justification
  /// Text
  /// Text. Type
  justification                         ubl_common_basic_components_2_1.Justification[]           @xsd(name: "Justification")
  /// BBIE
  /// Framework Agreement. Frequency. Text
  /// Text describing the frequency with which subsequent contracts will be awarded.
  /// 0..n
  /// Framework Agreement
  /// Frequency
  /// Text
  /// Text. Type
  frequency                             ubl_common_basic_components_2_1.Frequency[]               @xsd(name: "Frequency")
  /// ASBIE
  /// Framework Agreement. Duration_ Period. Period
  /// The period during which this framework agreement applies.
  /// 0..1
  /// Framework Agreement
  /// Duration
  /// Period
  /// Period
  /// Period
  duration_period                       Period?                                                   @xsd(name: "DurationPeriod")
  /// ASBIE
  /// Framework Agreement. Subsequent Process_ Tender Requirement. Tender Requirement
  /// A tender requirement intended for consumption by downstream tendering processes derived from the establishment of this framework agreement.
  /// 0..n
  /// Framework Agreement
  /// Subsequent Process
  /// Tender Requirement
  /// Tender Requirement
  /// Tender Requirement
  /// Curricula required
  subsequent_process_tender_requirement TenderRequirement[]                                       @xsd(name: "SubsequentProcessTenderRequirement")

  @@xsd(name: "FrameworkAgreement")
}

/// ABIE
/// Goods Item. Details
/// A class to describe a separately identifiable quantity of goods of a single product type.
/// Goods Item
model GoodsItem {
  /// BBIE
  /// Goods Item. Identifier
  /// An identifier for this goods item.
  /// 0..1
  /// Goods Item
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                                  ubl_common_basic_components_2_1.ID?                               @xsd(name: "ID")
  /// BBIE
  /// Goods Item. Sequence Number. Identifier
  /// A sequence number differentiating a specific goods item within a consignment.
  /// 0..1
  /// Goods Item
  /// Sequence Number
  /// Identifier
  /// Identifier. Type
  sequence_number_id                  ubl_common_basic_components_2_1.SequenceNumberID?                 @xsd(name: "SequenceNumberID")
  /// BBIE
  /// Goods Item. Description. Text
  /// Text describing this goods item to identify it for customs, statistical, or transport purposes.
  /// 0..n
  /// Goods Item
  /// Description
  /// Text
  /// Text. Type
  /// Description of goods (WCO ID 137)
  description                         ubl_common_basic_components_2_1.Description[]                     @xsd(name: "Description")
  /// BBIE
  /// Goods Item. Hazardous Risk_ Indicator. Indicator
  /// An indication that the transported goods item is subject to an international regulation concerning the carriage of dangerous goods (true) or not (false).
  /// 0..1
  /// Goods Item
  /// Hazardous Risk
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// default is negative
  hazardous_risk_indicator            ubl_common_basic_components_2_1.HazardousRiskIndicator?           @xsd(name: "HazardousRiskIndicator")
  /// BBIE
  /// Goods Item. Declared Customs_ Value. Amount
  /// The total declared value for customs purposes of the goods item.
  /// 0..1
  /// Goods Item
  /// Declared Customs
  /// Value
  /// Amount
  /// Amount. Type
  /// For Customs Value (WCO ID 108)
  declared_customs_value_amount       ubl_common_basic_components_2_1.DeclaredCustomsValueAmount?       @xsd(name: "DeclaredCustomsValueAmount")
  /// BBIE
  /// Goods Item. Declared For Carriage_ Value. Amount
  /// The value of this goods item, declared by the shipper or his agent solely for the purpose of varying the carrier's level of liability from that provided in the contract of carriage, in case of loss or damage to goods or delayed delivery.
  /// 0..1
  /// Goods Item
  /// Declared For Carriage
  /// Value
  /// Amount
  /// Amount. Type
  /// Interest in delivery, declared value for carriage
  declared_for_carriage_value_amount  ubl_common_basic_components_2_1.DeclaredForCarriageValueAmount?   @xsd(name: "DeclaredForCarriageValueAmount")
  /// BBIE
  /// Goods Item. Declared Statistics_ Value. Amount
  /// The total declared value of all the goods items in the same consignment with this goods item that have the same statistical heading.
  /// 0..1
  /// Goods Item
  /// Declared Statistics
  /// Value
  /// Amount
  /// Amount. Type
  /// Statistical Value (WCO ID 114)
  declared_statistics_value_amount    ubl_common_basic_components_2_1.DeclaredStatisticsValueAmount?    @xsd(name: "DeclaredStatisticsValueAmount")
  /// BBIE
  /// Goods Item. Free On Board_ Value. Amount
  /// The monetary amount that has to be or has been paid as calculated under the applicable trade delivery.
  /// 0..1
  /// Goods Item
  /// Free On Board
  /// Value
  /// Amount
  /// Amount. Type
  /// FOB Value
  free_on_board_value_amount          ubl_common_basic_components_2_1.FreeOnBoardValueAmount?           @xsd(name: "FreeOnBoardValueAmount")
  /// BBIE
  /// Goods Item. Insurance_ Value. Amount
  /// The amount covered by insurance for this goods item.
  /// 0..1
  /// Goods Item
  /// Insurance
  /// Value
  /// Amount
  /// Amount. Type
  /// Value Insured
  insurance_value_amount              ubl_common_basic_components_2_1.InsuranceValueAmount?             @xsd(name: "InsuranceValueAmount")
  /// BBIE
  /// Goods Item. Value. Amount
  /// The amount on which a duty, tax, or fee will be assessed.
  /// 0..1
  /// Goods Item
  /// Value
  /// Amount
  /// Amount. Type
  value_amount                        ubl_common_basic_components_2_1.ValueAmount?                      @xsd(name: "ValueAmount")
  /// BBIE
  /// Goods Item. Gross_ Weight. Measure
  /// The weight of this goods item, including packing and packaging but excluding the carrier's equipment.
  /// 0..1
  /// Goods Item
  /// Gross
  /// Weight
  /// Measure
  /// Measure. Type
  /// Actual Gross Weight
  gross_weight_measure                ubl_common_basic_components_2_1.GrossWeightMeasure?               @xsd(name: "GrossWeightMeasure")
  /// BBIE
  /// Goods Item. Net_ Weight. Measure
  /// The weight of this goods item, excluding packing but including packaging that normally accompanies the goods.
  /// 0..1
  /// Goods Item
  /// Net
  /// Weight
  /// Measure
  /// Measure. Type
  net_weight_measure                  ubl_common_basic_components_2_1.NetWeightMeasure?                 @xsd(name: "NetWeightMeasure")
  /// BBIE
  /// Goods Item. Net Net_ Weight. Measure
  /// The total weight of this goods item, excluding all packing and packaging.
  /// 0..1
  /// Goods Item
  /// Net Net
  /// Weight
  /// Measure
  /// Measure. Type
  /// Customs Weight (WCO ID 128)
  net_net_weight_measure              ubl_common_basic_components_2_1.NetNetWeightMeasure?              @xsd(name: "NetNetWeightMeasure")
  /// BBIE
  /// Goods Item. Chargeable_ Weight. Measure
  /// The weight on which a charge is to be based.
  /// 0..1
  /// Goods Item
  /// Chargeable
  /// Weight
  /// Measure
  /// Measure. Type
  chargeable_weight_measure           ubl_common_basic_components_2_1.ChargeableWeightMeasure?          @xsd(name: "ChargeableWeightMeasure")
  /// BBIE
  /// Goods Item. Gross_ Volume. Measure
  /// The volume of this goods item, normally calculated by multiplying its maximum length, width, and height.
  /// 0..1
  /// Goods Item
  /// Gross
  /// Volume
  /// Measure
  /// Measure. Type
  /// Volume, Gross Measurement Cube (GMC), Cube (WCO ID 134)
  gross_volume_measure                ubl_common_basic_components_2_1.GrossVolumeMeasure?               @xsd(name: "GrossVolumeMeasure")
  /// BBIE
  /// Goods Item. Net_ Volume. Measure
  /// The volume contained by a goods item, excluding the volume of any packaging material.
  /// 0..1
  /// Goods Item
  /// Net
  /// Volume
  /// Measure
  /// Measure. Type
  net_volume_measure                  ubl_common_basic_components_2_1.NetVolumeMeasure?                 @xsd(name: "NetVolumeMeasure")
  /// BBIE
  /// Goods Item. Quantity
  /// The number of units making up this goods item.
  /// 0..1
  /// Goods Item
  /// Quantity
  /// Quantity
  /// Quantity. Type
  quantity                            ubl_common_basic_components_2_1.Quantity?                         @xsd(name: "Quantity")
  /// BBIE
  /// Goods Item. Preference Criterion Code. Code
  /// A code signifying the treatment preference for this goods item according to international trading agreements.
  /// 0..1
  /// Goods Item
  /// Preference Criterion Code
  /// Code
  /// Code. Type
  /// Preference Criterion is used in the following manner in the paper CO of another country (e.g.):
  /// A - The good is wholly obtained or produced entirely in the territory of one or more of the NAFTA countries as reference in Article 415. Note: The purchase of a good in the territory does not necessarily render it wholly obtained or produced . If the good is an agricultural good, see also criterion F and Annex 703.2. (Reference: Article 401(a), 415).
  /// B - ...
  /// C - ...
  /// D - ...
  /// E - ...
  /// F - The good is an originating agricultural good under preference criterion A,B, or C above and is not subjected to quantitative restriction in the importing NAFTA country because....
  /// Thus, the column Preference Criterion will indicate either A, B, C,...
  preference_criterion_code           ubl_common_basic_components_2_1.PreferenceCriterionCode?          @xsd(name: "PreferenceCriterionCode")
  /// BBIE
  /// Goods Item. Required_ Customs Identifier. Identifier
  /// An identifier for a set of tariff codes required to specify a type of goods for customs, transport, statistical, or other regulatory purposes.
  /// 0..1
  /// Goods Item
  /// Required
  /// Customs Identifier
  /// Identifier
  /// Identifier. Type
  /// Tariff code extensions (WCO ID 255)
  required_customs_id                 ubl_common_basic_components_2_1.RequiredCustomsID?                @xsd(name: "RequiredCustomsID")
  /// BBIE
  /// Goods Item. Customs Status Code. Code
  /// A code assigned by customs to signify the status of this goods item.
  /// 0..1
  /// Goods Item
  /// Customs Status Code
  /// Code
  /// Code. Type
  /// Customs status of goods (WCO ID 094)
  customs_status_code                 ubl_common_basic_components_2_1.CustomsStatusCode?                @xsd(name: "CustomsStatusCode")
  /// BBIE
  /// Goods Item. Customs Tariff Quantity. Quantity
  /// Quantity of the units in this goods item as required by customs for tariff, statistical, or fiscal purposes.
  /// 0..1
  /// Goods Item
  /// Customs Tariff Quantity
  /// Quantity
  /// Quantity. Type
  customs_tariff_quantity             ubl_common_basic_components_2_1.CustomsTariffQuantity?            @xsd(name: "CustomsTariffQuantity")
  /// BBIE
  /// Goods Item. Customs Import_ Classified Indicator. Indicator
  /// An indicator that this goods item has been classified for import by customs (true) or not (false).
  /// 0..1
  /// Goods Item
  /// Customs Import
  /// Classified Indicator
  /// Indicator
  /// Indicator. Type
  customs_import_classified_indicator ubl_common_basic_components_2_1.CustomsImportClassifiedIndicator? @xsd(name: "CustomsImportClassifiedIndicator")
  /// BBIE
  /// Goods Item. Chargeable_ Quantity. Quantity
  /// The number of units in the goods item to which charges apply.
  /// 0..1
  /// Goods Item
  /// Chargeable
  /// Quantity
  /// Quantity
  /// Quantity. Type
  chargeable_quantity                 ubl_common_basic_components_2_1.ChargeableQuantity?               @xsd(name: "ChargeableQuantity")
  /// BBIE
  /// Goods Item. Returnable_ Quantity. Quantity
  /// The number of units in the goods item that may be returned.
  /// 0..1
  /// Goods Item
  /// Returnable
  /// Quantity
  /// Quantity
  /// Quantity. Type
  returnable_quantity                 ubl_common_basic_components_2_1.ReturnableQuantity?               @xsd(name: "ReturnableQuantity")
  /// BBIE
  /// Goods Item. Trace_ Identifier. Identifier
  /// An identifier for use in tracing this goods item, such as the EPC number used in RFID.
  /// 0..1
  /// Goods Item
  /// Trace
  /// Identifier
  /// Identifier
  /// Identifier. Type
  trace_id                            ubl_common_basic_components_2_1.TraceID?                          @xsd(name: "TraceID")
  /// ASBIE
  /// Goods Item. Item
  /// Product information relating to a goods item.
  /// 0..n
  /// Goods Item
  /// Item
  /// Item
  /// Item
  item                                Item[]                                                            @xsd(name: "Item")
  /// ASBIE
  /// Goods Item. Goods Item Container
  /// The transporting of a goods item in a unit of transport equipment (e.g., container).
  /// 0..n
  /// Goods Item
  /// Goods Item Container
  /// Goods Item Container
  /// Goods Item Container
  goods_item_container                GoodsItemContainer[]                                              @xsd(name: "GoodsItemContainer")
  /// ASBIE
  /// Goods Item. Freight_ Allowance Charge. Allowance Charge
  /// A cost incurred by the shipper in moving goods, by whatever means, from one place to another under the terms of the contract of carriage. In addition to transport costs, this may include such elements as packing, documentation, loading, unloading, and insurance to the extent that they relate to the freight costs.
  /// 0..n
  /// Goods Item
  /// Freight
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  /// Freight Costs
  freight_allowance_charge            AllowanceCharge[]                                                 @xsd(name: "FreightAllowanceCharge")
  /// ASBIE
  /// Goods Item. Invoice Line
  /// Information about an invoice line relating to this goods item.
  /// 0..n
  /// Goods Item
  /// Invoice Line
  /// Invoice Line
  /// Invoice Line
  invoice_line                        InvoiceLine[]                                                     @xsd(name: "InvoiceLine")
  /// ASBIE
  /// Goods Item. Temperature
  /// The temperature of the goods item.
  /// 0..n
  /// Goods Item
  /// Temperature
  /// Temperature
  /// Temperature
  /// maximum, storage, minimum
  temperature                         Temperature[]                                                     @xsd(name: "Temperature")
  /// ASBIE
  /// Goods Item. Contained_ Goods Item. Goods Item
  /// A goods item contained in this goods item.
  /// 0..n
  /// Goods Item
  /// Contained
  /// Goods Item
  /// Goods Item
  /// Goods Item
  contained_goods_item                GoodsItem[]                                                       @xsd(name: "ContainedGoodsItem")
  /// ASBIE
  /// Goods Item. Origin_ Address. Address
  /// The region in which the goods have been produced or manufactured, according to criteria laid down for the purposes of application of the customs tariff, or of quantitative restrictions, or of any other measure related to trade.
  /// 0..1
  /// Goods Item
  /// Origin
  /// Address
  /// Address
  /// Address
  /// Region of origin (WCO ID 066)
  origin_address                      Address?                                                          @xsd(name: "OriginAddress")
  /// ASBIE
  /// Goods Item. Delivery
  /// The delivery of this goods item.
  /// 0..1
  /// Goods Item
  /// Delivery
  /// Delivery
  /// Delivery
  delivery                            Delivery?                                                         @xsd(name: "Delivery")
  /// ASBIE
  /// Goods Item. Pickup
  /// The pickup of this goods item.
  /// 0..1
  /// Goods Item
  /// Pickup
  /// Pickup
  /// Pickup
  pickup                              Pickup?                                                           @xsd(name: "Pickup")
  /// ASBIE
  /// Goods Item. Despatch
  /// The despatch of this goods item.
  /// 0..1
  /// Goods Item
  /// Despatch
  /// Despatch
  /// Despatch
  despatch                            Despatch?                                                         @xsd(name: "Despatch")
  /// ASBIE
  /// Goods Item. Measurement_ Dimension. Dimension
  /// A measurable dimension (length, mass, weight, or volume) of this goods item.
  /// 0..n
  /// Goods Item
  /// Measurement
  /// Dimension
  /// Dimension
  /// Dimension
  measurement_dimension               Dimension[]                                                       @xsd(name: "MeasurementDimension")
  /// ASBIE
  /// Goods Item. Containing_ Package. Package
  /// A package containing this goods item.
  /// 0..n
  /// Goods Item
  /// Containing
  /// Package
  /// Package
  /// Package
  containing_package                  Package[]                                                         @xsd(name: "ContainingPackage")
  /// ASBIE
  /// Goods Item. Shipment_ Document Reference. Document Reference
  /// A reference to a shipping document associated with this goods item.
  /// 0..1
  /// Goods Item
  /// Shipment
  /// Document Reference
  /// Document Reference
  /// Document Reference
  shipment_document_reference         DocumentReference?                                                @xsd(name: "ShipmentDocumentReference")
  /// ASBIE
  /// Goods Item. Minimum_ Temperature. Temperature
  /// Information about minimum temperature.
  /// 0..1
  /// Goods Item
  /// Minimum
  /// Temperature
  /// Temperature
  /// Temperature
  minimum_temperature                 Temperature?                                                      @xsd(name: "MinimumTemperature")
  /// ASBIE
  /// Goods Item. Maximum_ Temperature. Temperature
  /// Information about maximum temperature.
  /// 0..1
  /// Goods Item
  /// Maximum
  /// Temperature
  /// Temperature
  /// Temperature
  maximum_temperature                 Temperature?                                                      @xsd(name: "MaximumTemperature")
}

/// ABIE
/// Goods Item Container. Details
/// A class defining how goods items are split across transport equipment.
/// Goods Item Container
model GoodsItemContainer {
  /// BBIE
  /// Goods Item Container. Identifier
  /// An identifier for this goods item container.
  /// 1
  /// Goods Item Container
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                  ubl_common_basic_components_2_1.ID        @xsd(name: "ID")
  /// BBIE
  /// Goods Item Container. Quantity
  /// The number of goods items loaded into or onto one piece of transport equipment as a total consignment or part of a consignment.
  /// 0..1
  /// Goods Item Container
  /// Quantity
  /// Quantity
  /// Quantity. Type
  /// Number of packages stuffed
  quantity            ubl_common_basic_components_2_1.Quantity? @xsd(name: "Quantity")
  /// ASBIE
  /// Goods Item Container. Transport Equipment
  /// A piece of transport equipment used to contain a single goods item.
  /// 0..n
  /// Goods Item Container
  /// Transport Equipment
  /// Transport Equipment
  /// Transport Equipment
  transport_equipment TransportEquipment[]                      @xsd(name: "TransportEquipment")

  @@xsd(name: "GoodsItemContainer")
}

/// ABIE
/// Hazardous Goods Transit. Details
/// A class to describe hazardous goods in transit.
/// Hazardous Goods Transit
model HazardousGoodsTransit {
  /// BBIE
  /// Hazardous Goods Transit. Transport Emergency Card Code. Code
  /// An identifier for a transport emergency card describing the actions to be taken in an emergency in transporting the hazardous goods. It may be the identity number of a hazardous emergency response plan assigned by the appropriate authority.
  /// 0..1
  /// Hazardous Goods Transit
  /// Transport Emergency Card Code
  /// Code
  /// Code. Type
  /// TREM card
  transport_emergency_card_code ubl_common_basic_components_2_1.TransportEmergencyCardCode? @xsd(name: "TransportEmergencyCardCode")
  /// BBIE
  /// Hazardous Goods Transit. Packing Criteria Code. Code
  /// A code signifying the packaging requirement for transportation of the hazardous goods as assigned by IATA, IMDB, ADR, RID etc.
  /// 0..1
  /// Hazardous Goods Transit
  /// Packing Criteria Code
  /// Code
  /// Code. Type
  /// Packing Group
  packing_criteria_code         ubl_common_basic_components_2_1.PackingCriteriaCode?        @xsd(name: "PackingCriteriaCode")
  /// BBIE
  /// Hazardous Goods Transit. Hazardous Regulation Code. Code
  /// A code signifying the set of legal regulations governing the transportation of the hazardous goods.
  /// 0..1
  /// Hazardous Goods Transit
  /// Hazardous Regulation Code
  /// Code
  /// Code. Type
  hazardous_regulation_code     ubl_common_basic_components_2_1.HazardousRegulationCode?    @xsd(name: "HazardousRegulationCode")
  /// BBIE
  /// Hazardous Goods Transit. Inhalation Toxicity Zone Code. Code
  /// A code signifying the Inhalation Toxicity Hazard Zone for the hazardous goods, as defined by the US Department of Transportation.
  /// 0..1
  /// Hazardous Goods Transit
  /// Inhalation Toxicity Zone Code
  /// Code
  /// Code. Type
  inhalation_toxicity_zone_code ubl_common_basic_components_2_1.InhalationToxicityZoneCode? @xsd(name: "InhalationToxicityZoneCode")
  /// BBIE
  /// Hazardous Goods Transit. Transport Authorization Code. Code
  /// A code signifying authorization for the transportation of hazardous cargo.
  /// 0..1
  /// Hazardous Goods Transit
  /// Transport Authorization Code
  /// Code
  /// Code. Type
  /// Permission for Transport
  transport_authorization_code  ubl_common_basic_components_2_1.TransportAuthorizationCode? @xsd(name: "TransportAuthorizationCode")
  /// ASBIE
  /// Hazardous Goods Transit. Maximum_ Temperature. Temperature
  /// The maximum temperature at which the hazardous goods can safely be transported.
  /// 0..1
  /// Hazardous Goods Transit
  /// Maximum
  /// Temperature
  /// Temperature
  /// Temperature
  maximum_temperature           Temperature?                                                @xsd(name: "MaximumTemperature")
  /// ASBIE
  /// Hazardous Goods Transit. Minimum_ Temperature. Temperature
  /// The minimum temperature at which the hazardous goods can safely be transported.
  /// 0..1
  /// Hazardous Goods Transit
  /// Minimum
  /// Temperature
  /// Temperature
  /// Temperature
  minimum_temperature           Temperature?                                                @xsd(name: "MinimumTemperature")

  @@xsd(name: "HazardousGoodsTransit")
}

/// ABIE
/// Hazardous Item. Details
/// A class to describe a hazardous item.
/// Hazardous Item
model HazardousItem {
  /// BBIE
  /// Hazardous Item. Identifier
  /// An identifier for this hazardous item.
  /// 0..1
  /// Hazardous Item
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// Round Up
  id                             ubl_common_basic_components_2_1.ID?                         @xsd(name: "ID")
  /// BBIE
  /// Hazardous Item. Placard Notation. Text
  /// Text of the placard notation corresponding to the hazard class of this hazardous item. Can also be the hazard identification number of the orange placard (upper part) required on the means of transport.
  /// 0..1
  /// Hazardous Item
  /// Placard Notation
  /// Text
  /// Text. Type
  /// 5.1
  placard_notation               ubl_common_basic_components_2_1.PlacardNotation?            @xsd(name: "PlacardNotation")
  /// BBIE
  /// Hazardous Item. Placard Endorsement. Text
  /// Text of the placard endorsement that is to be shown on the shipping papers for this hazardous item. Can also be used for the number of the orange placard (lower part) required on the means of transport.
  /// 0..1
  /// Hazardous Item
  /// Placard Endorsement
  /// Text
  /// Text. Type
  /// 2
  placard_endorsement            ubl_common_basic_components_2_1.PlacardEndorsement?         @xsd(name: "PlacardEndorsement")
  /// BBIE
  /// Hazardous Item. Additional_ Information. Text
  /// Text providing further information about the hazardous substance.
  /// 0..n
  /// Hazardous Item
  /// Additional
  /// Information
  /// Text
  /// Text. Type
  /// Must be stored away from flammable materials N.O.S. or a Waste Characteristics Code in conjunction with an EPA Waste Stream code
  additional_information         ubl_common_basic_components_2_1.AdditionalInformation[]     @xsd(name: "AdditionalInformation")
  /// BBIE
  /// Hazardous Item. UNDG Code. Code
  /// The UN code for this kind of hazardous item.
  /// 0..1
  /// Hazardous Item
  /// UNDG Code
  /// Code
  /// Code. Type
  /// UN Code
  undg_code                      ubl_common_basic_components_2_1.UNDGCode?                   @xsd(name: "UNDGCode")
  /// BBIE
  /// Hazardous Item. Emergency Procedures Code. Code
  /// A code signifying the emergency procedures for this hazardous item.
  /// 0..1
  /// Hazardous Item
  /// Emergency Procedures Code
  /// Code
  /// Code. Type
  /// EMG code, EMS Page Number
  emergency_procedures_code      ubl_common_basic_components_2_1.EmergencyProceduresCode?    @xsd(name: "EmergencyProceduresCode")
  /// BBIE
  /// Hazardous Item. Medical First Aid Guide Code. Code
  /// A code signifying a medical first aid guide appropriate to this hazardous item.
  /// 0..1
  /// Hazardous Item
  /// Medical First Aid Guide Code
  /// Code
  /// Code. Type
  /// MFAG page number
  medical_first_aid_guide_code   ubl_common_basic_components_2_1.MedicalFirstAidGuideCode?   @xsd(name: "MedicalFirstAidGuideCode")
  /// BBIE
  /// Hazardous Item. Technical_ Name. Name
  /// The full technical name of a specific hazardous substance contained in this goods item.
  /// 0..1
  /// Hazardous Item
  /// Technical
  /// Name
  /// Name
  /// Name. Type
  /// Granular Sodium Chlorate WeedKiller
  technical_name                 ubl_common_basic_components_2_1.TechnicalName?              @xsd(name: "TechnicalName")
  /// BBIE
  /// Hazardous Item. Category. Name
  /// The name of the category of hazard that applies to the Item.
  /// 0..1
  /// Hazardous Item
  /// Category
  /// Name
  /// Name. Type
  category_name                  ubl_common_basic_components_2_1.CategoryName?               @xsd(name: "CategoryName")
  /// BBIE
  /// Hazardous Item. Hazardous Category Code. Code
  /// A code signifying a kind of hazard for a material.
  /// 0..1
  /// Hazardous Item
  /// Hazardous Category Code
  /// Code
  /// Code. Type
  /// Hazardous material class code
  hazardous_category_code        ubl_common_basic_components_2_1.HazardousCategoryCode?      @xsd(name: "HazardousCategoryCode")
  /// BBIE
  /// Hazardous Item. Upper_ Orange Hazard Placard Identifier. Identifier
  /// The number for the upper part of the orange hazard placard required on the means of transport.
  /// 0..1
  /// Hazardous Item
  /// Upper
  /// Orange Hazard Placard Identifier
  /// Identifier
  /// Identifier. Type
  /// Hazard identification number (upper part)
  upper_orange_hazard_placard_id ubl_common_basic_components_2_1.UpperOrangeHazardPlacardID? @xsd(name: "UpperOrangeHazardPlacardID")
  /// BBIE
  /// Hazardous Item. Lower_ Orange Hazard Placard Identifier. Identifier
  /// The number for the lower part of the orange hazard placard required on the means of transport.
  /// 0..1
  /// Hazardous Item
  /// Lower
  /// Orange Hazard Placard Identifier
  /// Identifier
  /// Identifier. Type
  /// Substance identification number (lower part)
  lower_orange_hazard_placard_id ubl_common_basic_components_2_1.LowerOrangeHazardPlacardID? @xsd(name: "LowerOrangeHazardPlacardID")
  /// BBIE
  /// Hazardous Item. Marking Identifier. Identifier
  /// An identifier to the marking of the Hazardous Item
  /// 0..1
  /// Hazardous Item
  /// Marking Identifier
  /// Identifier
  /// Identifier. Type
  /// Dangerous goods label marking
  marking_id                     ubl_common_basic_components_2_1.MarkingID?                  @xsd(name: "MarkingID")
  /// BBIE
  /// Hazardous Item. Hazard Class Identifier. Identifier
  /// An identifier for the hazard class applicable to this hazardous item as defined by the relevant regulation authority (e.g., the IMDG Class Number of the SOLAS Convention of IMO and the ADR/RID Class Number for the road/rail environment).
  /// 0..1
  /// Hazardous Item
  /// Hazard Class Identifier
  /// Identifier
  /// Identifier. Type
  /// IMDG Class Number, ADR/RID Class Number
  hazard_class_id                ubl_common_basic_components_2_1.HazardClassID?              @xsd(name: "HazardClassID")
  /// BBIE
  /// Hazardous Item. Net_ Weight. Measure
  /// The net weight of this hazardous item, excluding packaging.
  /// 0..1
  /// Hazardous Item
  /// Net
  /// Weight
  /// Measure
  /// Measure. Type
  net_weight_measure             ubl_common_basic_components_2_1.NetWeightMeasure?           @xsd(name: "NetWeightMeasure")
  /// BBIE
  /// Hazardous Item. Net_ Volume. Measure
  /// The volume of this hazardous item, excluding packaging and transport equipment.
  /// 0..1
  /// Hazardous Item
  /// Net
  /// Volume
  /// Measure
  /// Measure. Type
  net_volume_measure             ubl_common_basic_components_2_1.NetVolumeMeasure?           @xsd(name: "NetVolumeMeasure")
  /// BBIE
  /// Hazardous Item. Quantity
  /// The quantity of goods items in this hazardous item that are hazardous.
  /// 0..1
  /// Hazardous Item
  /// Quantity
  /// Quantity
  /// Quantity. Type
  quantity                       ubl_common_basic_components_2_1.Quantity?                   @xsd(name: "Quantity")
  /// ASBIE
  /// Hazardous Item. Contact_ Party. Party
  /// The individual, group, or body to be contacted in case of a hazardous incident associated with this item.
  /// 0..1
  /// Hazardous Item
  /// Contact
  /// Party
  /// Party
  /// Party
  contact_party                  Party?                                                      @xsd(name: "ContactParty")
  /// ASBIE
  /// Hazardous Item. Secondary Hazard
  /// A secondary hazard associated with this hazardous item.
  /// 0..n
  /// Hazardous Item
  /// Secondary Hazard
  /// Secondary Hazard
  /// Secondary Hazard
  secondary_hazard               SecondaryHazard[]                                           @xsd(name: "SecondaryHazard")
  /// ASBIE
  /// Hazardous Item. Hazardous Goods Transit
  /// Information related to the transit of this kind of hazardous goods.
  /// 0..n
  /// Hazardous Item
  /// Hazardous Goods Transit
  /// Hazardous Goods Transit
  /// Hazardous Goods Transit
  hazardous_goods_transit        HazardousGoodsTransit[]                                     @xsd(name: "HazardousGoodsTransit")
  /// ASBIE
  /// Hazardous Item. Emergency_ Temperature. Temperature
  /// The threshold temperature at which emergency procedures apply in the handling of temperature-controlled goods.
  /// 0..1
  /// Hazardous Item
  /// Emergency
  /// Temperature
  /// Temperature
  /// Temperature
  emergency_temperature          Temperature?                                                @xsd(name: "EmergencyTemperature")
  /// ASBIE
  /// Hazardous Item. Flashpoint_ Temperature. Temperature
  /// The flashpoint temperature of this hazardous item; i.e., the lowest temperature at which vapors above a volatile combustible substance ignite in air when exposed to flame.
  /// 0..1
  /// Hazardous Item
  /// Flashpoint
  /// Temperature
  /// Temperature
  /// Temperature
  flashpoint_temperature         Temperature?                                                @xsd(name: "FlashpointTemperature")
  /// ASBIE
  /// Hazardous Item. Additional_ Temperature. Temperature
  /// Another temperature relevant to the handling of this hazardous item.
  /// 0..n
  /// Hazardous Item
  /// Additional
  /// Temperature
  /// Temperature
  /// Temperature
  additional_temperature         Temperature[]                                               @xsd(name: "AdditionalTemperature")

  @@xsd(name: "HazardousItem")
}

/// ABIE
/// Immobilized Security. Details
/// A class to describe an immobilized security to be used as a guarantee.
/// Immobilized Security
model ImmobilizedSecurity {
  /// BBIE
  /// Immobilized Security. Immobilization Certificate Identifier. Identifier
  /// An identifier for the certificate of this immobilized security.
  /// 0..1
  /// Immobilized Security
