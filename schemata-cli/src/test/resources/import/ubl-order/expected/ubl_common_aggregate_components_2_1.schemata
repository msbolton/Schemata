  /// Order Line Reference
  /// Sales Order
  /// Line Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "SalesOrderLineID") sales_order_line_id: ubl_common_basic_components_2_1.SalesOrderLineID?
  /// BBIE
  /// Order Line Reference. UUID. Identifier
