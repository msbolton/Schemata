  /// Person
  ships_surgeon_person                Person?                                                 @xsd(name: "ShipsSurgeonPerson")
}

/// ABIE
/// Signature. Details
/// A class to define a signature.
/// Signature
model Signature {
  /// BBIE
  /// Signature. Identifier
  /// An identifier for this signature.
  /// 1
  /// Signature
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                           ubl_common_basic_components_2_1.ID                      @xsd(name: "ID")
  /// BBIE
  /// Signature. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures; in particular, information regarding the circumstances in which the signature is being used.
  /// 0..n
  /// Signature
  /// Note
  /// Text
  /// Text. Type
  note                         ubl_common_basic_components_2_1.Note[]                  @xsd(name: "Note")
  /// BBIE
  /// Signature. Validation Date. Date
  /// The date upon which this signature was verified.
  /// 0..1
  /// Signature
  /// Validation Date
  /// Date
  /// Date. Type
  validation_date              ubl_common_basic_components_2_1.ValidationDate?         @xsd(name: "ValidationDate")
  /// BBIE
  /// Signature. Validation Time. Time
  /// The time at which this signature was verified.
  /// 0..1
  /// Signature
  /// Validation Time
  /// Time
  /// Time. Type
  validation_time              ubl_common_basic_components_2_1.ValidationTime?         @xsd(name: "ValidationTime")
  /// BBIE
  /// Signature. Validator. Identifier
  /// An identifier for the organization, person, service, or server that verified this signature.
  /// 0..1
  /// Signature
  /// Validator
  /// Identifier
  /// Identifier. Type
  validator_id                 ubl_common_basic_components_2_1.ValidatorID?            @xsd(name: "ValidatorID")
  /// BBIE
  /// Signature. Canonicalization Method. Text
  /// The method used to perform XML canonicalization of this signature.
  /// 0..1
  /// Signature
  /// Canonicalization Method
  /// Text
  /// Text. Type
  canonicalization_method      ubl_common_basic_components_2_1.CanonicalizationMethod? @xsd(name: "CanonicalizationMethod")
  /// BBIE
  /// Signature. Signature Method. Text
  /// Text describing the method of signature.
  /// 0..1
  /// Signature
  /// Signature Method
  /// Text
  /// Text. Type
  signature_method             ubl_common_basic_components_2_1.SignatureMethod?        @xsd(name: "SignatureMethod")
  /// ASBIE
  /// Signature. Signatory_ Party. Party
  /// The signing party.
  /// 0..1
  /// Signature
  /// Signatory
  /// Party
  /// Party
  /// Party
  signatory_party              Party?                                                  @xsd(name: "SignatoryParty")
  /// ASBIE
  /// Signature. Digital Signature_ Attachment. Attachment
  /// The actual encoded signature (e.g., in XMLDsig format).
  /// 0..1
  /// Signature
  /// Digital Signature
  /// Attachment
  /// Attachment
  /// Attachment
  digital_signature_attachment Attachment?                                             @xsd(name: "DigitalSignatureAttachment")
  /// ASBIE
  /// Signature. Original_ Document Reference. Document Reference
  /// A reference to the document that the signature applies to. For evidentiary purposes, this may be the document image that the signatory party saw when applying their signature.
  /// 0..1
  /// Signature
  /// Original
  /// Document Reference
  /// Document Reference
  /// Document Reference
  original_document_reference  DocumentReference?                                      @xsd(name: "OriginalDocumentReference")

  @@xsd(name: "Signature")
}

