  /// 0..1
  /// Monetary Total
  /// Tax Inclusive Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "TaxInclusiveAmount") tax_inclusive_amount:       ubl_common_basic_components_2_1.TaxInclusiveAmount?
  /// BBIE
  /// Monetary Total. Allowance_ Total Amount. Amount
  /// The total monetary amount of all allowances.
  /// 0..1
  /// Monetary Total
  /// Allowance
  /// Total Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "AllowanceTotalAmount") allowance_total_amount:     ubl_common_basic_components_2_1.AllowanceTotalAmount?
  /// BBIE
  /// Monetary Total. Charge_ Total Amount. Amount
