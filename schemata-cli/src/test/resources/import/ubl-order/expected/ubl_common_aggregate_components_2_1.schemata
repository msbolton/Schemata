  /// Catalogue Line
  /// Order Quantity Increment
  /// Numeric
  /// Numeric. Type
  @xsd(name = "OrderQuantityIncrementNumeric") order_quantity_increment_numeric:    ubl_common_basic_components_2_1.OrderQuantityIncrementNumeric?
  /// BBIE
