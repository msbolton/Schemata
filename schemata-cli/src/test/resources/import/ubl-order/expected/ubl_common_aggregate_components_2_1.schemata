  /// 0..1
  /// Catalogue Line
  /// Action Code
  /// Code
  /// Code. Type
  /// Replace , Update , Delete , Add
  @xsd(name = "ActionCode") action_code:                         ubl_common_basic_components_2_1.ActionCode?
