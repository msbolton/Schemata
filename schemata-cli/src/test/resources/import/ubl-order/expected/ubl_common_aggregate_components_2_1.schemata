  /// 6 , 10mg per Kilo
  quantity    ubl_common_basic_components_2_1.Quantity?     @xsd(name: "Quantity")
  /// BBIE
  /// Related Item. Description. Text
  /// Text describing the relationship.
  /// 0..n
  /// Related Item
  /// Description
  /// Text
  /// Text. Type
  /// If used in wet conditions or extreme environments
  description ubl_common_basic_components_2_1.Description[] @xsd(name: "Description")
}

