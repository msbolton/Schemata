  /// 0..n
  /// Catalogue Line
  /// Note
  /// Text
  /// Text. Type
  @xsd(name = "Note") note:                                list<ubl_common_basic_components_2_1.Note>
  /// BBIE
  /// Catalogue Line. Orderable_ Indicator. Indicator
