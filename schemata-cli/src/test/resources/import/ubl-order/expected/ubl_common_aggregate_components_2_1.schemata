  required_item_location_quantity ItemLocationQuantity[]             @xsd(name: "RequiredItemLocationQuantity")

  @@xsd(name: "CataloguePricingUpdateLine")
}

/// ABIE
/// Catalogue Reference. Details
/// A class to define a reference to a catalogue.
/// Catalogue Reference
model CatalogueReference {
  /// BBIE
  /// Catalogue Reference. Identifier
  /// An identifier for a specific catalogue.
  /// 1
  /// Catalogue Reference
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                  ubl_common_basic_components_2_1.ID                 @xsd(name: "ID")
  /// BBIE
  /// Catalogue Reference. UUID. Identifier
  /// A universally unique identifier for a specific catalogue.
  /// 0..1
  /// Catalogue Reference
  /// UUID
  /// Identifier
  /// Identifier. Type
  uuid                ubl_common_basic_components_2_1.UUID?              @xsd(name: "UUID")
  /// BBIE
  /// Catalogue Reference. Issue Date. Date
  /// The date on which the catalogue was issued.
  /// 0..1
  /// Catalogue Reference
  /// Issue Date
  /// Date
  /// Date. Type
  issue_date          ubl_common_basic_components_2_1.IssueDate?         @xsd(name: "IssueDate")
  /// BBIE
  /// Catalogue Reference. Issue Time. Time
  /// The time at which the catalogue was issued.
  /// 0..1
  /// Catalogue Reference
  /// Issue Time
  /// Time
  /// Time. Type
  issue_time          ubl_common_basic_components_2_1.IssueTime?         @xsd(name: "IssueTime")
  /// BBIE
  /// Catalogue Reference. Revision Date. Date
  /// The date on which the information in the catalogue was last revised.
  /// 0..1
  /// Catalogue Reference
  /// Revision Date
  /// Date
  /// Date. Type
  revision_date       ubl_common_basic_components_2_1.RevisionDate?      @xsd(name: "RevisionDate")
  /// BBIE
  /// Catalogue Reference. Revision Time. Time
  /// The time at which the information in the catalogue was last revised.
  /// 0..1
  /// Catalogue Reference
  /// Revision Time
  /// Time
  /// Time. Type
  revision_time       ubl_common_basic_components_2_1.RevisionTime?      @xsd(name: "RevisionTime")
  /// BBIE
  /// Catalogue Reference. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Catalogue Reference
  /// Note
  /// Text
  /// Text. Type
  note                ubl_common_basic_components_2_1.Note[]             @xsd(name: "Note")
  /// BBIE
  /// Catalogue Reference. Description. Text
  /// Text describing the catalogue.
  /// 0..n
  /// Catalogue Reference
  /// Description
  /// Text
  /// Text. Type
  /// computer accessories for laptops
  description         ubl_common_basic_components_2_1.Description[]      @xsd(name: "Description")
  /// BBIE
  /// Catalogue Reference. Version. Identifier
  /// An identifier for the current version of the catalogue.
  /// 0..1
  /// Catalogue Reference
  /// Version
  /// Identifier
  /// Identifier. Type
  /// 1.1
  version_id          ubl_common_basic_components_2_1.VersionID?         @xsd(name: "VersionID")
  /// BBIE
  /// Catalogue Reference. Previous_ Version. Identifier
  /// An identifier for the previous version of the catalogue that is superseded by this version.
  /// 0..1
  /// Catalogue Reference
  /// Previous
  /// Version
  /// Identifier
  /// Identifier. Type
  /// 1.0
  previous_version_id ubl_common_basic_components_2_1.PreviousVersionID? @xsd(name: "PreviousVersionID")

  @@xsd(name: "CatalogueReference")
}

/// ABIE
/// Catalogue Request Line. Details
/// A class to define a line describing a request for a catalogue line.
/// Catalogue Request Line
model CatalogueRequestLine {
  /// BBIE
  /// Catalogue Request Line. Identifier
  /// An identifier for the requested catalogue line.
