  /// 0..n
  /// Catalogue Line
  /// Document Reference
  /// Document Reference
  /// Document Reference
  @xsd(name = "DocumentReference") document_reference:                  list<DocumentReference>
  /// ASBIE
  /// Catalogue Line. Item
  /// A specification of the item itself.
  /// 1
  /// Catalogue Line
  /// Item
  /// Item
  /// Item
  @xsd(name = "Item") item:                                Item
  /// ASBIE
  /// Catalogue Line. Keyword_ Item Property. Item Property
  /// A property of the item in this catalogue line.
  /// 0..n
  /// Catalogue Line
  /// Keyword
  /// Item Property
