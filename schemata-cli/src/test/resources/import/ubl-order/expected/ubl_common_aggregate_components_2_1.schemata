model InstructionForReturnsLine {
  /// BBIE
  /// Instruction For Returns Line. Identifier
  /// An identifier for this instruction for returns line.
  /// 1
  /// Instruction For Returns Line
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                 ubl_common_basic_components_2_1.ID       @xsd(name: "ID")
  /// BBIE
  /// Instruction For Returns Line. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Instruction For Returns Line
  /// Note
  /// Text
  /// Text. Type
  note               ubl_common_basic_components_2_1.Note[]   @xsd(name: "Note")
  /// BBIE
  /// Instruction For Returns Line. Quantity
  /// The quantity of goods being returned.
  /// 1
  /// Instruction For Returns Line
  /// Quantity
  /// Quantity
  /// Quantity. Type
  quantity           ubl_common_basic_components_2_1.Quantity @xsd(name: "Quantity")
  /// ASBIE
  /// Instruction For Returns Line. Manufacturer_ Party. Party
  /// The manufacturer of the goods being returned.
  /// 0..1
  /// Instruction For Returns Line
  /// Manufacturer
  /// Party
  /// Party
  /// Party
  manufacturer_party Party?                                   @xsd(name: "ManufacturerParty")
  /// ASBIE
  /// Instruction For Returns Line. Item
  /// A description of the item being returned.
  /// 1
  /// Instruction For Returns Line
  /// Item
  /// Item
  /// Item
  item               Item                                     @xsd(name: "Item")

  @@xsd(name: "InstructionForReturnsLine")
}

/// ABIE
/// Inventory Report Line. Details
/// A class to define a line in an Inventory Report.
/// Inventory Report Line
model InventoryReportLine {
  /// BBIE
  /// Inventory Report Line. Identifier
  /// An identifier for this inventory report line.
  /// 1
  /// Inventory Report Line
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                       ubl_common_basic_components_2_1.ID                      @xsd(name: "ID")
  /// BBIE
  /// Inventory Report Line. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Inventory Report Line
  /// Note
  /// Text
  /// Text. Type
  note                     ubl_common_basic_components_2_1.Note[]                  @xsd(name: "Note")
  /// BBIE
  /// Inventory Report Line. Quantity
  /// The quantity of the item reported that is currently in stock.
  /// 1
  /// Inventory Report Line
  /// Quantity
  /// Quantity
  /// Quantity. Type
  quantity                 ubl_common_basic_components_2_1.Quantity                @xsd(name: "Quantity")
  /// BBIE
  /// Inventory Report Line. Inventory_ Value. Amount
  /// The value of the quantity of the item reported that is currently in stock.
  /// 0..1
  /// Inventory Report Line
  /// Inventory
  /// Value
  /// Amount
  /// Amount. Type
  inventory_value_amount   ubl_common_basic_components_2_1.InventoryValueAmount?   @xsd(name: "InventoryValueAmount")
  /// BBIE
  /// Inventory Report Line. Availability Date. Date
  /// The date from which the goods will be available. If not present, the goods are available now.
  /// 0..1
  /// Inventory Report Line
  /// Availability Date
  /// Date
  /// Date. Type
  availability_date        ubl_common_basic_components_2_1.AvailabilityDate?       @xsd(name: "AvailabilityDate")
  /// BBIE
  /// Inventory Report Line. Availability Status Code. Code
  /// A code signifying the item's level of availability.
  /// 0..1
  /// Inventory Report Line
  /// Availability Status Code
  /// Code
  /// Code. Type
  availability_status_code ubl_common_basic_components_2_1.AvailabilityStatusCode? @xsd(name: "AvailabilityStatusCode")
  /// ASBIE
  /// Inventory Report Line. Item
  /// The item associated with this inventory report line.
  /// 1
  /// Inventory Report Line
  /// Item
  /// Item
  /// Item
  item                     Item                                                    @xsd(name: "Item")
  /// ASBIE
  /// Inventory Report Line. Inventory_ Location. Location
  /// The location of the reported quantity of goods.
  /// 0..1
  /// Inventory Report Line
  /// Inventory
  /// Location
  /// Location
  /// Location
  inventory_location       ubl_common_aggregate_components_2_1.Location?           @xsd(name: "InventoryLocation")

  @@xsd(name: "InventoryReportLine")
}

/// ABIE
/// Invoice Line. Details
/// A class to define a line in an Invoice.
/// Invoice Line
model InvoiceLine {
  /// BBIE
  /// Invoice Line. Identifier
  /// An identifier for this invoice line.
  /// 1
  /// Invoice Line
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                       ubl_common_basic_components_2_1.ID                     @xsd(name: "ID")
  /// BBIE
  /// Invoice Line. UUID. Identifier
  /// A universally unique identifier for this invoice line.
  /// 0..1
  /// Invoice Line
  /// UUID
  /// Identifier
  /// Identifier. Type
  uuid                     ubl_common_basic_components_2_1.UUID?                  @xsd(name: "UUID")
  /// BBIE
  /// Invoice Line. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Invoice Line
  /// Note
  /// Text
  /// Text. Type
  note                     ubl_common_basic_components_2_1.Note[]                 @xsd(name: "Note")
  /// BBIE
  /// Invoice Line. Invoiced_ Quantity. Quantity
  /// The quantity (of items) on this invoice line.
  /// 0..1
  /// Invoice Line
  /// Invoiced
  /// Quantity
  /// Quantity
  /// Quantity. Type
  invoiced_quantity        ubl_common_basic_components_2_1.InvoicedQuantity?      @xsd(name: "InvoicedQuantity")
  /// BBIE
  /// Invoice Line. Line Extension Amount. Amount
  /// The total amount for this invoice line, including allowance charges but net of taxes.
  /// 1
  /// Invoice Line
  /// Line Extension Amount
  /// Amount
  /// Amount. Type
  line_extension_amount    ubl_common_basic_components_2_1.LineExtensionAmount    @xsd(name: "LineExtensionAmount")
  /// BBIE
  /// Invoice Line. Tax Point Date. Date
  /// The date of this invoice line, used to indicate the point at which tax becomes applicable.
  /// 0..1
  /// Invoice Line
  /// Tax Point Date
  /// Date
  /// Date. Type
  tax_point_date           ubl_common_basic_components_2_1.TaxPointDate?          @xsd(name: "TaxPointDate")
  /// BBIE
  /// Invoice Line. Accounting Cost Code. Code
  /// The buyer's accounting cost centre for this invoice line, expressed as a code.
  /// 0..1
  /// Invoice Line
  /// Accounting Cost Code
  /// Code
  /// Code. Type
  accounting_cost_code     ubl_common_basic_components_2_1.AccountingCostCode?    @xsd(name: "AccountingCostCode")
  /// BBIE
  /// Invoice Line. Accounting Cost. Text
  /// The buyer's accounting cost centre for this invoice line, expressed as text.
  /// 0..1
  /// Invoice Line
  /// Accounting Cost
  /// Text
  /// Text. Type
  accounting_cost          ubl_common_basic_components_2_1.AccountingCost?        @xsd(name: "AccountingCost")
  /// BBIE
  /// Invoice Line. Payment Purpose Code. Code
  /// A code signifying the business purpose for this payment.
  /// 0..1
  /// Invoice Line
  /// Payment Purpose Code
  /// Code
  /// Code. Type
  payment_purpose_code     ubl_common_basic_components_2_1.PaymentPurposeCode?    @xsd(name: "PaymentPurposeCode")
  /// BBIE
  /// Invoice Line. Free Of Charge_ Indicator. Indicator
  /// An indicator that this invoice line is free of charge (true) or not (false). The default is false.
  /// 0..1
  /// Invoice Line
  /// Free Of Charge
  /// Indicator
  /// Indicator
  /// Indicator. Type
  free_of_charge_indicator ubl_common_basic_components_2_1.FreeOfChargeIndicator? @xsd(name: "FreeOfChargeIndicator")
  /// ASBIE
  /// Invoice Line. Invoice_ Period. Period
  /// An invoice period to which this invoice line applies.
  /// 0..n
  /// Invoice Line
  /// Invoice
  /// Period
  /// Period
  /// Period
  invoice_period           Period[]                                               @xsd(name: "InvoicePeriod")
  /// ASBIE
  /// Invoice Line. Order Line Reference
  /// A reference to an order line associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Order Line Reference
  /// Order Line Reference
  /// Order Line Reference
  order_line_reference     OrderLineReference[]                                   @xsd(name: "OrderLineReference")
  /// ASBIE
  /// Invoice Line. Despatch_ Line Reference. Line Reference
  /// A reference to a despatch line associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Despatch
  /// Line Reference
  /// Line Reference
  /// Line Reference
  despatch_line_reference  LineReference[]                                        @xsd(name: "DespatchLineReference")
  /// ASBIE
  /// Invoice Line. Receipt_ Line Reference. Line Reference
  /// A reference to a receipt line associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Receipt
  /// Line Reference
  /// Line Reference
  /// Line Reference
  receipt_line_reference   LineReference[]                                        @xsd(name: "ReceiptLineReference")
  /// ASBIE
  /// Invoice Line. Billing Reference
  /// A reference to a billing document associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Billing Reference
  /// Billing Reference
  /// Billing Reference
  billing_reference        BillingReference[]                                     @xsd(name: "BillingReference")
  /// ASBIE
  /// Invoice Line. Document Reference
  /// A reference to a document associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Document Reference
  /// Document Reference
  /// Document Reference
  document_reference       DocumentReference[]                                    @xsd(name: "DocumentReference")
  /// ASBIE
  /// Invoice Line. Pricing Reference
  /// A reference to pricing and item location information associated with this invoice line.
  /// 0..1
  /// Invoice Line
  /// Pricing Reference
  /// Pricing Reference
  /// Pricing Reference
  pricing_reference        PricingReference?                                      @xsd(name: "PricingReference")
  /// ASBIE
  /// Invoice Line. Originator_ Party. Party
  /// The party who originated the Order to which the Invoice is related.
  /// 0..1
  /// Invoice Line
  /// Originator
  /// Party
  /// Party
  /// Party
  originator_party         Party?                                                 @xsd(name: "OriginatorParty")
  /// ASBIE
  /// Invoice Line. Delivery
  /// A delivery associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Delivery
  /// Delivery
  /// Delivery
  delivery                 Delivery[]                                             @xsd(name: "Delivery")
  /// ASBIE
  /// Invoice Line. Payment Terms
  /// A specification of payment terms associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Payment Terms
  /// Payment Terms
  /// Payment Terms
  payment_terms            PaymentTerms[]                                         @xsd(name: "PaymentTerms")
  /// ASBIE
  /// Invoice Line. Allowance Charge
  /// An allowance or charge associated with this invoice line.
  /// 0..n
  /// Invoice Line
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  allowance_charge         AllowanceCharge[]                                      @xsd(name: "AllowanceCharge")
  /// ASBIE
  /// Invoice Line. Tax Total
  /// A total amount of taxes of a particular kind applicable to this invoice line.
  /// 0..n
  /// Invoice Line
  /// Tax Total
  /// Tax Total
  /// Tax Total
  tax_total                TaxTotal[]                                             @xsd(name: "TaxTotal")
  /// ASBIE
  /// Invoice Line. Withholding_ Tax Total. Tax Total
  /// A reference to a TaxTotal class describing the amount that has been withhold by the authorities, e.g. if the creditor is in dept because of non paid taxes.
  /// 0..n
  /// Invoice Line
  /// Withholding
  /// Tax Total
  /// Tax Total
  /// Tax Total
  withholding_tax_total    TaxTotal[]                                             @xsd(name: "WithholdingTaxTotal")
  /// ASBIE
  /// Invoice Line. Item
  /// The item associated with this invoice line.
  /// 1
  /// Invoice Line
  /// Item
  /// Item
  /// Item
  item                     Item                                                   @xsd(name: "Item")
  /// ASBIE
  /// Invoice Line. Price
  /// The price of the item associated with this invoice line.
  /// 0..1
  /// Invoice Line
  /// Price
  /// Price
  /// Price
  /// Unit Price, Base Price
  price                    Price?                                                 @xsd(name: "Price")
  /// ASBIE
  /// Invoice Line. Delivery Terms
  /// Terms and conditions of the delivery associated with this invoice line.
  /// 0..1
  /// Invoice Line
  /// Delivery Terms
  /// Delivery Terms
  /// Delivery Terms
  delivery_terms           DeliveryTerms?                                         @xsd(name: "DeliveryTerms")
  /// ASBIE
  /// Invoice Line. Sub_ Invoice Line. Invoice Line
  /// An invoice line subsidiary to this invoice line.
  /// 0..n
  /// Invoice Line
  /// Sub
  /// Invoice Line
  /// Invoice Line
  /// Invoice Line
  sub_invoice_line         InvoiceLine[]                                          @xsd(name: "SubInvoiceLine")
  /// ASBIE
  /// Invoice Line. Item_ Price Extension. Price Extension
  /// The price extension, calculated by multiplying the price per unit by the quantity of items on this invoice line.
  /// 0..1
  /// Invoice Line
  /// Item
  /// Price Extension
  /// Price Extension
  /// Price Extension
  item_price_extension     PriceExtension?                                        @xsd(name: "ItemPriceExtension")

  @@xsd(name: "InvoiceLine")
}

/// ABIE
/// Item. Details
/// A class to describe an item of trade. It includes a generic description applicable to all examples of the item together with optional subsidiary descriptions of any number of actual instances of the type.
/// Item
/// article, product, goods item
model Item {
  /// BBIE
  /// Item. Description. Text
  /// Text describing this item.
  /// 0..n
  /// Item
  /// Description
  /// Text
  /// Text. Type
  description                           ubl_common_basic_components_2_1.Description[]           @xsd(name: "Description")
  /// BBIE
  /// Item. Pack Quantity. Quantity
  /// The unit packaging quantity; the number of subunits making up this item.
  /// 0..1
  /// Item
  /// Pack Quantity
  /// Quantity
  /// Quantity. Type
  pack_quantity                         ubl_common_basic_components_2_1.PackQuantity?           @xsd(name: "PackQuantity")
  /// BBIE
  /// Item. Pack Size. Numeric
  /// The number of items in a pack of this item.
  /// 0..1
  /// Item
  /// Pack Size
  /// Numeric
  /// Numeric. Type
  pack_size_numeric                     ubl_common_basic_components_2_1.PackSizeNumeric?        @xsd(name: "PackSizeNumeric")
  /// BBIE
  /// Item. Catalogue_ Indicator. Indicator
  /// An indicator that this item was ordered from a catalogue (true) or not (false).
  /// 0..1
  /// Item
  /// Catalogue
  /// Indicator
  /// Indicator
  /// Indicator. Type
  catalogue_indicator                   ubl_common_basic_components_2_1.CatalogueIndicator?     @xsd(name: "CatalogueIndicator")
  /// BBIE
  /// Item. Name
  /// A short name optionally given to this item, such as a name from a catalogue, as distinct from a description.
  /// 0..1
  /// Item
  /// Name
  /// Name
  /// Name. Type
  name                                  ubl_common_basic_components_2_1.Name?                   @xsd(name: "Name")
  /// BBIE
  /// Item. Hazardous Risk_ Indicator. Indicator
  /// An indication that the transported item, as delivered, is subject to an international regulation concerning the carriage of dangerous goods (true) or not (false).
  /// 0..1
  /// Item
  /// Hazardous Risk
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// Default is negative
  hazardous_risk_indicator              ubl_common_basic_components_2_1.HazardousRiskIndicator? @xsd(name: "HazardousRiskIndicator")
  /// BBIE
  /// Item. Additional_ Information. Text
  /// Further details regarding this item (e.g., the URL of a relevant web page).
  /// 0..n
  /// Item
  /// Additional
  /// Information
  /// Text
  /// Text. Type
  additional_information                ubl_common_basic_components_2_1.AdditionalInformation[] @xsd(name: "AdditionalInformation")
  /// BBIE
  /// Item. Keyword. Text
  /// A keyword (search string) for this item, assigned by the seller party. Can also be a synonym for the name of the item.
  /// 0..n
  /// Item
  /// Keyword
  /// Text
  /// Text. Type
  keyword                               ubl_common_basic_components_2_1.Keyword[]               @xsd(name: "Keyword")
  /// BBIE
  /// Item. Brand Name. Name
  /// A brand name of this item.
  /// 0..n
  /// Item
  /// Brand Name
  /// Name
  /// Name. Type
  /// Coca-Cola
  brand_name                            ubl_common_basic_components_2_1.BrandName[]             @xsd(name: "BrandName")
  /// BBIE
  /// Item. Model Name. Name
  /// A model name of this item.
  /// 0..n
  /// Item
  /// Model Name
  /// Name
  /// Name. Type
  /// VW Beetle
  model_name                            ubl_common_basic_components_2_1.ModelName[]             @xsd(name: "ModelName")
  /// ASBIE
  /// Item. Buyers_ Item Identification. Item Identification
  /// Identifying information for this item, assigned by the buyer.
  /// 0..1
  /// Item
  /// Buyers
  /// Item Identification
  /// Item Identification
  /// Item Identification
  buyers_item_identification            ItemIdentification?                                     @xsd(name: "BuyersItemIdentification")
  /// ASBIE
  /// Item. Sellers_ Item Identification. Item Identification
  /// Identifying information for this item, assigned by the seller.
  /// 0..1
  /// Item
  /// Sellers
  /// Item Identification
  /// Item Identification
  /// Item Identification
  sellers_item_identification           ItemIdentification?                                     @xsd(name: "SellersItemIdentification")
  /// ASBIE
  /// Item. Manufacturers_ Item Identification. Item Identification
  /// Identifying information for this item, assigned by the manufacturer.
  /// 0..n
  /// Item
  /// Manufacturers
  /// Item Identification
  /// Item Identification
  /// Item Identification
  manufacturers_item_identification     ItemIdentification[]                                    @xsd(name: "ManufacturersItemIdentification")
  /// ASBIE
  /// Item. Standard_ Item Identification. Item Identification
  /// Identifying information for this item, assigned according to a standard system.
  /// 0..1
  /// Item
  /// Standard
  /// Item Identification
  /// Item Identification
  /// Item Identification
  standard_item_identification          ItemIdentification?                                     @xsd(name: "StandardItemIdentification")
  /// ASBIE
  /// Item. Catalogue_ Item Identification. Item Identification
  /// Identifying information for this item, assigned according to a cataloguing system.
  /// 0..1
  /// Item
  /// Catalogue
  /// Item Identification
  /// Item Identification
  /// Item Identification
  catalogue_item_identification         ItemIdentification?                                     @xsd(name: "CatalogueItemIdentification")
  /// ASBIE
  /// Item. Additional_ Item Identification. Item Identification
  /// An additional identifier for this item.
  /// 0..n
  /// Item
  /// Additional
  /// Item Identification
  /// Item Identification
  /// Item Identification
  additional_item_identification        ItemIdentification[]                                    @xsd(name: "AdditionalItemIdentification")
  /// ASBIE
  /// Item. Catalogue_ Document Reference. Document Reference
  /// A reference to the catalogue in which this item appears.
  /// 0..1
  /// Item
  /// Catalogue
  /// Document Reference
  /// Document Reference
  /// Document Reference
  catalogue_document_reference          DocumentReference?                                      @xsd(name: "CatalogueDocumentReference")
  /// ASBIE
  /// Item. Item Specification_ Document Reference. Document Reference
  /// A reference to a specification document for this item.
  /// 0..n
  /// Item
  /// Item Specification
  /// Document Reference
  /// Document Reference
  /// Document Reference
  item_specification_document_reference DocumentReference[]                                     @xsd(name: "ItemSpecificationDocumentReference")
  /// ASBIE
  /// Item. Origin_ Country. Country
  /// The country of origin of this item.
  /// 0..1
  /// Item
  /// Origin
  /// Country
  /// Country
  /// Country
  origin_country                        Country?                                                @xsd(name: "OriginCountry")
  /// ASBIE
  /// Item. Commodity Classification
  /// A classification of this item according to a specific system for classifying commodities.
  /// 0..n
  /// Item
  /// Commodity Classification
  /// Commodity Classification
  /// Commodity Classification
  commodity_classification              CommodityClassification[]                               @xsd(name: "CommodityClassification")
  /// ASBIE
  /// Item. Transaction Conditions
  /// A set of sales conditions applying to this item.
  /// 0..n
  /// Item
  /// Transaction Conditions
  /// Transaction Conditions
  /// Transaction Conditions
  transaction_conditions                TransactionConditions[]                                 @xsd(name: "TransactionConditions")
  /// ASBIE
  /// Item. Hazardous Item
  /// Information pertaining to this item as a hazardous item.
  /// 0..n
  /// Item
  /// Hazardous Item
  /// Hazardous Item
  /// Hazardous Item
  hazardous_item                        HazardousItem[]                                         @xsd(name: "HazardousItem")
  /// ASBIE
  /// Item. Classified_ Tax Category. Tax Category
  /// A tax category applicable to this item.
  /// 0..n
  /// Item
  /// Classified
  /// Tax Category
  /// Tax Category
  /// Tax Category
  classified_tax_category               TaxCategory[]                                           @xsd(name: "ClassifiedTaxCategory")
  /// ASBIE
  /// Item. Additional_ Item Property. Item Property
  /// An additional property of this item.
  /// 0..n
  /// Item
  /// Additional
  /// Item Property
  /// Item Property
  /// Item Property
  additional_item_property              ItemProperty[]                                          @xsd(name: "AdditionalItemProperty")
  /// ASBIE
  /// Item. Manufacturer_ Party. Party
  /// The manufacturer of this item.
  /// 0..n
  /// Item
  /// Manufacturer
  /// Party
  /// Party
  /// Party
  manufacturer_party                    Party[]                                                 @xsd(name: "ManufacturerParty")
  /// ASBIE
  /// Item. Information Content Provider_ Party. Party
  /// The party responsible for specification of this item.
  /// 0..1
  /// Item
  /// Information Content Provider
  /// Party
  /// Party
  /// Party
  information_content_provider_party    Party?                                                  @xsd(name: "InformationContentProviderParty")
  /// ASBIE
  /// Item. Origin_ Address. Address
  /// A region (not country) of origin of this item.
  /// 0..n
  /// Item
  /// Origin
  /// Address
  /// Address
  /// Address
  origin_address                        Address[]                                               @xsd(name: "OriginAddress")
  /// ASBIE
  /// Item. Item Instance
  /// A trackable, unique instantiation of this item.
  /// 0..n
  /// Item
  /// Item Instance
  /// Item Instance
  /// Item Instance
  item_instance                         ItemInstance[]                                          @xsd(name: "ItemInstance")
  /// ASBIE
  /// Item. Certificate
  /// A certificate associated with this item.
  /// 0..n
  /// Item
  /// Certificate
  /// Certificate
  /// Certificate
  certificate                           Certificate[]                                           @xsd(name: "Certificate")
  /// ASBIE
  /// Item. Dimension
  /// One of the measurable dimensions (length, mass, weight, or volume) of this item.
  /// 0..n
  /// Item
  /// Dimension
  /// Dimension
  /// Dimension
  dimension                             Dimension[]                                             @xsd(name: "Dimension")

  @@xsd(name: "Item")
}

/// ABIE
/// Item Comparison. Details
/// A class to provide information about price and quantity of an item for use in price comparisons based on price, quantity, or measurements.
/// Item Comparison
model ItemComparison {
  /// BBIE
  /// Item Comparison. Price Amount. Amount
  /// The price for the Item Comparison
  /// 0..1
  /// Item Comparison
  /// Price Amount
  /// Amount
  /// Amount. Type
  price_amount ubl_common_basic_components_2_1.PriceAmount? @xsd(name: "PriceAmount")
  /// BBIE
  /// Item Comparison. Quantity
  /// The quantity for which this comparison is valid.
  /// 0..1
  /// Item Comparison
  /// Quantity
  /// Quantity
  /// Quantity. Type
  /// per unit
  quantity     ubl_common_basic_components_2_1.Quantity?    @xsd(name: "Quantity")

  @@xsd(name: "ItemComparison")
}

/// ABIE
/// Item Identification. Details
/// A class for assigning identifying information to an item.
/// Item Identification
model ItemIdentification {
  /// BBIE
  /// Item Identification. Identifier
  /// An identifier for the item.
  /// 1
  /// Item Identification
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// CUST001 3333-44-123
  id                    ubl_common_basic_components_2_1.ID                  @xsd(name: "ID")
  /// BBIE
  /// Item Identification. Extended_ Identifier. Identifier
  /// An extended identifier for the item that identifies the item with specific properties, e.g., Item 123 = Chair / Item 123 Ext 45 = brown chair. Two chairs can have the same item number, but one is brown. The other is white.
  /// 0..1
  /// Item Identification
  /// Extended
  /// Identifier
  /// Identifier
  /// Identifier. Type
  extended_id           ubl_common_basic_components_2_1.ExtendedID?         @xsd(name: "ExtendedID")
  /// BBIE
  /// Item Identification. Barcode_ Symbology Identifier. Identifier
  /// An identifier for a system of barcodes.
  /// 0..1
  /// Item Identification
  /// Barcode
  /// Symbology Identifier
  /// Identifier
  /// Identifier. Type
  barcode_symbology_id  ubl_common_basic_components_2_1.BarcodeSymbologyID? @xsd(name: "BarcodeSymbologyID")
  /// ASBIE
  /// Item Identification. Physical Attribute
  /// A physical attribute of the item.
  /// 0..n
  /// Item Identification
  /// Physical Attribute
  /// Physical Attribute
  /// Physical Attribute
  physical_attribute    PhysicalAttribute[]                                 @xsd(name: "PhysicalAttribute")
  /// ASBIE
  /// Item Identification. Measurement_ Dimension. Dimension
  /// A measurable dimension (length, mass, weight, or volume) of the item.
  /// 0..n
  /// Item Identification
  /// Measurement
  /// Dimension
  /// Dimension
  /// Dimension
  measurement_dimension Dimension[]                                         @xsd(name: "MeasurementDimension")
  /// ASBIE
  /// Item Identification. Issuer_ Party. Party
  /// The party that issued this item identification.
  /// 0..1
  /// Item Identification
  /// Issuer
  /// Party
  /// Party
  /// Party
  issuer_party          Party?                                              @xsd(name: "IssuerParty")
}

/// ABIE
/// Item Information Request Line. Details
/// A class to define a line in an Item Information Request asking a trading partner for item information.
/// Item Information Request Line
model ItemInformationRequestLine {
  /// BBIE
  /// Item Information Request Line. Time Frequency Code. Code
  /// A code signifying the frequency with which item information should be sent to the requester.
  /// 0..1
  /// Item Information Request Line
  /// Time Frequency Code
  /// Code
  /// Code. Type
  time_frequency_code             ubl_common_basic_components_2_1.TimeFrequencyCode?           @xsd(name: "TimeFrequencyCode")
  /// BBIE
  /// Item Information Request Line. Supply Chain Activity Type Code. Code
  /// A code used to identify the type of supply chain activity about which information request is issued. Examples: CANCELED_ORDERS EMERGENCY_ORDERS ON_HAND ORDERS
  /// 0..1
  /// Item Information Request Line
  /// Supply Chain Activity Type Code
  /// Code
  /// Code. Type
  supply_chain_activity_type_code ubl_common_basic_components_2_1.SupplyChainActivityTypeCode? @xsd(name: "SupplyChainActivityTypeCode")
  /// BBIE
  /// Item Information Request Line. Forecast Type Code. Code
  /// The information request can be either about supply chain activity or about forecasts or about performance metrics, so it should be optional
  /// 0..1
  /// Item Information Request Line
  /// Forecast Type Code
  /// Code
  /// Code. Type
  forecast_type_code              ubl_common_basic_components_2_1.ForecastTypeCode?            @xsd(name: "ForecastTypeCode")
  /// BBIE
  /// Item Information Request Line. Performance Metric Type Code. Code
  /// A code signifying a measure of performance.
  /// 0..1
  /// Item Information Request Line
  /// Performance Metric Type Code
  /// Code
  /// Code. Type
  performance_metric_type_code    ubl_common_basic_components_2_1.PerformanceMetricTypeCode?   @xsd(name: "PerformanceMetricTypeCode")
  /// ASBIE
  /// Item Information Request Line. Period
  /// A period for which this information is requested.
  /// 1..n
  /// Item Information Request Line
  /// Period
  /// Period
  /// Period
  period                          Period[]                                                     { minItems 1 } @xsd(name: "Period")
  /// ASBIE
  /// Item Information Request Line. Sales Item
  /// Sales information for the item to which this line applies.
  /// 1..n
  /// Item Information Request Line
  /// Sales Item
  /// Sales Item
  /// Sales Item
  sales_item                      SalesItem[]                                                  { minItems 1 } @xsd(name: "SalesItem")

  @@xsd(name: "ItemInformationRequestLine")
}

/// ABIE
/// Item Instance. Details
/// A class to describe a specific, trackable instance of an item.
/// Item Instance
model ItemInstance {
  /// BBIE
  /// Item Instance. Product Trace_ Identifier. Identifier
  /// An identifier used for tracing this item instance, such as the EPC number used in RFID.
  /// 0..1
  /// Item Instance
  /// Product Trace
  /// Identifier
  /// Identifier
  /// Identifier. Type
  product_trace_id         ubl_common_basic_components_2_1.ProductTraceID?  @xsd(name: "ProductTraceID")
  /// BBIE
  /// Item Instance. Manufacture Date. Date
  /// The date on which this item instance was manufactured.
  /// 0..1
  /// Item Instance
  /// Manufacture Date
  /// Date
  /// Date. Type
  manufacture_date         ubl_common_basic_components_2_1.ManufactureDate? @xsd(name: "ManufactureDate")
  /// BBIE
  /// Item Instance. Manufacture Time. Time
  /// The time at which this item instance was manufactured.
  /// 0..1
  /// Item Instance
  /// Manufacture Time
  /// Time
  /// Time. Type
  manufacture_time         ubl_common_basic_components_2_1.ManufactureTime? @xsd(name: "ManufactureTime")
  /// BBIE
  /// Item Instance. Best Before Date. Date
  /// The date before which it is best to use this item instance.
  /// 0..1
  /// Item Instance
  /// Best Before Date
  /// Date
  /// Date. Type
  best_before_date         ubl_common_basic_components_2_1.BestBeforeDate?  @xsd(name: "BestBeforeDate")
  /// BBIE
  /// Item Instance. Registration Identifier. Identifier
  /// The registration identifier of this item instance.
  /// 0..1
  /// Item Instance
  /// Registration Identifier
  /// Identifier
  /// Identifier. Type
  /// car registration or licensing number
  registration_id          ubl_common_basic_components_2_1.RegistrationID?  @xsd(name: "RegistrationID")
  /// BBIE
  /// Item Instance. Serial Identifier. Identifier
  /// The serial number of this item instance.
  /// 0..1
  /// Item Instance
  /// Serial Identifier
  /// Identifier
  /// Identifier. Type
  /// chassis number of a car
  serial_id                ubl_common_basic_components_2_1.SerialID?        @xsd(name: "SerialID")
  /// ASBIE
  /// Item Instance. Additional_ Item Property. Item Property
  /// An additional property of this item instance.
  /// 0..n
  /// Item Instance
  /// Additional
  /// Item Property
  /// Item Property
  /// Item Property
  additional_item_property ItemProperty[]                                   @xsd(name: "AdditionalItemProperty")
  /// ASBIE
  /// Item Instance. Lot Identification
  /// The lot identifier of this item instance (the identifier that allows recall of the item if necessary).
  /// 0..1
  /// Item Instance
  /// Lot Identification
  /// Lot Identification
  /// Lot Identification
  lot_identification       LotIdentification?                               @xsd(name: "LotIdentification")

  @@xsd(name: "ItemInstance")
}

/// ABIE
/// Item Location Quantity. Details
/// A class for information about pricing structure, lead time, and location associated with an item.
/// Item Location Quantity
model ItemLocationQuantity {
  /// BBIE
  /// Item Location Quantity. Lead Time. Measure
  /// The lead time, i.e., the time taken from the time at which an item is ordered to the time of its delivery.
  /// 0..1
  /// Item Location Quantity
  /// Lead Time
  /// Measure
  /// Measure. Type
  /// 2 days , 24 hours
  lead_time_measure            ubl_common_basic_components_2_1.LeadTimeMeasure?        @xsd(name: "LeadTimeMeasure")
  /// BBIE
  /// Item Location Quantity. Minimum_ Quantity. Quantity
  /// The minimum quantity that can be ordered to qualify for a specific price.
  /// 0..1
  /// Item Location Quantity
  /// Minimum
  /// Quantity
  /// Quantity
  /// Quantity. Type
  /// 10 boxes , 1 carton , 1000 sheets
  minimum_quantity             ubl_common_basic_components_2_1.MinimumQuantity?        @xsd(name: "MinimumQuantity")
  /// BBIE
  /// Item Location Quantity. Maximum_ Quantity. Quantity
  /// The maximum quantity that can be ordered to qualify for a specific price.
  /// 0..1
  /// Item Location Quantity
  /// Maximum
  /// Quantity
  /// Quantity
  /// Quantity. Type
  /// 10 boxes , 1 carton , 1000 sheets
  maximum_quantity             ubl_common_basic_components_2_1.MaximumQuantity?        @xsd(name: "MaximumQuantity")
  /// BBIE
  /// Item Location Quantity. Hazardous Risk_ Indicator. Indicator
  /// An indication that the transported item, as delivered, in the stated quantity to the stated location, is subject to an international regulation concerning the carriage of dangerous goods (true) or not (false).
  /// 0..1
  /// Item Location Quantity
  /// Hazardous Risk
  /// Indicator
  /// Indicator
  /// Indicator. Type
  /// Default is negative
  hazardous_risk_indicator     ubl_common_basic_components_2_1.HazardousRiskIndicator? @xsd(name: "HazardousRiskIndicator")
  /// BBIE
  /// Item Location Quantity. Trading Restrictions. Text
  /// Text describing trade restrictions on the quantity of this item or on the item itself.
  /// 0..n
  /// Item Location Quantity
  /// Trading Restrictions
  /// Text
  /// Text. Type
  /// not for export
  trading_restrictions         ubl_common_basic_components_2_1.TradingRestrictions[]   @xsd(name: "TradingRestrictions")
  /// ASBIE
  /// Item Location Quantity. Applicable Territory_ Address. Address
  /// The applicable sales territory.
  /// 0..n
  /// Item Location Quantity
  /// Applicable Territory
  /// Address
  /// Address
  /// Address
  applicable_territory_address Address[]                                               @xsd(name: "ApplicableTerritoryAddress")
  /// ASBIE
  /// Item Location Quantity. Price
  /// The price associated with the given location.
  /// 0..1
  /// Item Location Quantity
  /// Price
  /// Price
  /// Price
  price                        Price?                                                  @xsd(name: "Price")
  /// ASBIE
  /// Item Location Quantity. Delivery Unit
  /// A delivery unit in which the item is located.
  /// 0..n
  /// Item Location Quantity
  /// Delivery Unit
  /// Delivery Unit
  /// Delivery Unit
  delivery_unit                DeliveryUnit[]                                          @xsd(name: "DeliveryUnit")
  /// ASBIE
  /// Item Location Quantity. Applicable_ Tax Category. Tax Category
  /// A tax category applicable to this item location quantity.
  /// 0..n
  /// Item Location Quantity
  /// Applicable
  /// Tax Category
  /// Tax Category
  /// Tax Category
  applicable_tax_category      TaxCategory[]                                           @xsd(name: "ApplicableTaxCategory")
  /// ASBIE
  /// Item Location Quantity. Package
  /// The package to which this price applies.
  /// 0..1
  /// Item Location Quantity
  /// Package
  /// Package
  /// Package
  package                      Package?                                                @xsd(name: "Package")
  /// ASBIE
  /// Item Location Quantity. Allowance Charge
  /// An allowance or charge associated with this item location quantity.
  /// 0..n
  /// Item Location Quantity
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  allowance_charge             AllowanceCharge[]                                       @xsd(name: "AllowanceCharge")
  /// ASBIE
  /// Item Location Quantity. Dependent Price Reference
  /// The price of the item as a percentage of the price of some other item.
  /// 0..1
  /// Item Location Quantity
  /// Dependent Price Reference
  /// Dependent Price Reference
  /// Dependent Price Reference
  dependent_price_reference    DependentPriceReference?                                @xsd(name: "DependentPriceReference")

  @@xsd(name: "ItemLocationQuantity")
}

/// ABIE
/// Item Management Profile. Details
/// A class to define a management profile for an item.
/// Item Management Profile
model ItemManagementProfile {
  /// BBIE
  /// Item Management Profile. Frozen Period Days. Numeric
  /// The number of days in the future that an order forecast quantity automatically becomes a confirmed order for a product.
  /// 0..1
  /// Item Management Profile
  /// Frozen Period Days
  /// Numeric
  /// Numeric. Type
  frozen_period_days_numeric      ubl_common_basic_components_2_1.FrozenPeriodDaysNumeric?        @xsd(name: "FrozenPeriodDaysNumeric")
  /// BBIE
  /// Item Management Profile. Minimum_ Inventory Quantity. Quantity
  /// The quantity of the item that should trigger a replenishment order to avoid depleting the safety stock.
  /// 0..1
  /// Item Management Profile
  /// Minimum
  /// Inventory Quantity
  /// Quantity
  /// Quantity. Type
  minimum_inventory_quantity      ubl_common_basic_components_2_1.MinimumInventoryQuantity?       @xsd(name: "MinimumInventoryQuantity")
  /// BBIE
  /// Item Management Profile. Multiple_ Order Quantity. Quantity
  /// The order quantity multiples in which the product may be ordered.
  /// 0..1
  /// Item Management Profile
  /// Multiple
  /// Order Quantity
  /// Quantity
  /// Quantity. Type
  multiple_order_quantity         ubl_common_basic_components_2_1.MultipleOrderQuantity?          @xsd(name: "MultipleOrderQuantity")
  /// BBIE
  /// Item Management Profile. Order Interval Days. Numeric
  /// The number of days between regular replenishment orders for the product.
  /// 0..1
  /// Item Management Profile
  /// Order Interval Days
  /// Numeric
  /// Numeric. Type
  order_interval_days_numeric     ubl_common_basic_components_2_1.OrderIntervalDaysNumeric?       @xsd(name: "OrderIntervalDaysNumeric")
  /// BBIE
  /// Item Management Profile. Replenishment Owner Description. Text
  /// The trading partner maintaining this item management profile.
  /// 0..n
  /// Item Management Profile
  /// Replenishment Owner Description
  /// Text
  /// Text. Type
  replenishment_owner_description ubl_common_basic_components_2_1.ReplenishmentOwnerDescription[] @xsd(name: "ReplenishmentOwnerDescription")
  /// BBIE
  /// Item Management Profile. Target Service Percent. Percent
  /// The Unit Service Level the trading partners expect to be maintained, expressed as a percentage. Unite Service Level (USL) is a term used in Inventory Management, which is sometimes known as "fill rate", counts the average number of units short expressed as the percentage of the order quantity.
  /// 0..1
  /// Item Management Profile
  /// Target Service Percent
  /// Percent
  /// Percent. Type
  target_service_percent          ubl_common_basic_components_2_1.TargetServicePercent?           @xsd(name: "TargetServicePercent")
  /// BBIE
  /// Item Management Profile. Target_ Inventory Quantity. Quantity
  /// The target inventory quantity.
  /// 0..1
  /// Item Management Profile
  /// Target
  /// Inventory Quantity
  /// Quantity
  /// Quantity. Type
  target_inventory_quantity       ubl_common_basic_components_2_1.TargetInventoryQuantity?        @xsd(name: "TargetInventoryQuantity")
  /// ASBIE
  /// Item Management Profile. Effective_ Period. Period
  /// The period during which this profile is effective.
  /// 1
  /// Item Management Profile
  /// Effective
  /// Period
  /// Period
  /// Period
  effective_period                Period                                                          @xsd(name: "EffectivePeriod")
  /// ASBIE
  /// Item Management Profile. Item
  /// The item associated with this item management profile.
  /// 1
  /// Item Management Profile
  /// Item
  /// Item
  /// Item
  item                            Item                                                            @xsd(name: "Item")
  /// ASBIE
  /// Item Management Profile. Item Location Quantity
  /// A set of location-specific properties (e.g., price and quantity) associated with the item.
  /// 0..1
  /// Item Management Profile
  /// Item Location Quantity
  /// Item Location Quantity
  /// Item Location Quantity
  item_location_quantity          ItemLocationQuantity?                                           @xsd(name: "ItemLocationQuantity")

  @@xsd(name: "ItemManagementProfile")
}

/// ABIE
/// Item Property. Details
/// A class to describe a specific property of an item.
/// Item Property
model ItemProperty {
  /// BBIE
  /// Item Property. Identifier
  /// An identifier for this property of an item.
  /// 0..1
  /// Item Property
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                  ubl_common_basic_components_2_1.ID?              @xsd(name: "ID")
  /// BBIE
  /// Item Property. Name
  /// The name of this item property.
  /// 1
  /// Item Property
  /// Name
  /// Name
  /// Name. Type
  /// Energy Rating , Collar Size , Fat Content
  name                ubl_common_basic_components_2_1.Name             @xsd(name: "Name")
  /// BBIE
  /// Item Property. Name Code. Code
  /// The name of this item property, expressed as a code.
  /// 0..1
  /// Item Property
  /// Name Code
  /// Code
  /// Code. Type
  name_code           ubl_common_basic_components_2_1.NameCode?        @xsd(name: "NameCode")
  /// BBIE
  /// Item Property. Test Method. Text
  /// The method of testing the value of this item property.
  /// 0..1
  /// Item Property
  /// Test Method
  /// Text
  /// Text. Type
  /// 100 watts , 15 European , 20% +/- 5%
  test_method         ubl_common_basic_components_2_1.TestMethod?      @xsd(name: "TestMethod")
  /// BBIE
  /// Item Property. Value. Text
  /// The value of this item property, expressed as text.
  /// 0..1
  /// Item Property
  /// Value
  /// Text
  /// Text. Type
  /// 100 watts , 15 European , 20% +/- 5%
  value               ubl_common_basic_components_2_1.Value?           @xsd(name: "Value")
  /// BBIE
  /// Item Property. Value_ Quantity. Quantity
  /// The value of this item property, expressed as a quantity.
  /// 0..1
  /// Item Property
  /// Value
  /// Quantity
  /// Quantity
  /// Quantity. Type
  value_quantity      ubl_common_basic_components_2_1.ValueQuantity?   @xsd(name: "ValueQuantity")
  /// BBIE
  /// Item Property. Value Qualifier. Text
  /// Text qualifying the value of the property.
  /// 0..n
  /// Item Property
  /// Value Qualifier
  /// Text
  /// Text. Type
  value_qualifier     ubl_common_basic_components_2_1.ValueQualifier[] @xsd(name: "ValueQualifier")
  /// BBIE
  /// Item Property. Importance Code. Code
  /// A code signifying the importance of this property in using it to describe a related Item.
  /// 0..1
  /// Item Property
  /// Importance Code
  /// Code
  /// Code. Type
  importance_code     ubl_common_basic_components_2_1.ImportanceCode?  @xsd(name: "ImportanceCode")
  /// BBIE
  /// Item Property. List Value. Text
  /// The value expressed as a text in case the property is a value in a list. For example, a colour.
  /// 0..n
  /// Item Property
  /// List Value
  /// Text
  /// Text. Type
  list_value          ubl_common_basic_components_2_1.ListValue[]      @xsd(name: "ListValue")
  /// ASBIE
  /// Item Property. Usability_ Period. Period
  /// The period during which this item property is valid.
  /// 0..1
  /// Item Property
  /// Usability
  /// Period
  /// Period
  /// Period
  usability_period    Period?                                          @xsd(name: "UsabilityPeriod")
  /// ASBIE
  /// Item Property. Item Property Group
  /// A description of the property group to which this item property belongs.
  /// 0..n
  /// Item Property
  /// Item Property Group
  /// Item Property Group
  /// Item Property Group
  item_property_group ItemPropertyGroup[]                              @xsd(name: "ItemPropertyGroup")
  /// ASBIE
  /// Item Property. Range_ Dimension. Dimension
  /// The range of values for the dimensions of this property.
  /// 0..1
  /// Item Property
  /// Range
  /// Dimension
  /// Dimension
  /// Dimension
  range_dimension     Dimension?                                       @xsd(name: "RangeDimension")
  /// ASBIE
  /// Item Property. Item Property Range
  /// A range of values for this item property.
  /// 0..1
  /// Item Property
  /// Item Property Range
  /// Item Property Range
  /// Item Property Range
  item_property_range ItemPropertyRange?                               @xsd(name: "ItemPropertyRange")
}

/// ABIE
/// Item Property Group. Details
/// A class to describe a property group or classification.
/// Item Property Group
model ItemPropertyGroup {
  /// BBIE
  /// Item Property Group. Identifier
  /// An identifier for this group of item properties.
  /// 1
  /// Item Property Group
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// 233-004
  id              ubl_common_basic_components_2_1.ID              @xsd(name: "ID")
  /// BBIE
  /// Item Property Group. Name
  /// The name of this item property group.
  /// 0..1
  /// Item Property Group
  /// Name
  /// Name
  /// Name. Type
  /// Electrical Specifications , Dietary Content
  name            ubl_common_basic_components_2_1.Name?           @xsd(name: "Name")
  /// BBIE
  /// Item Property Group. Importance Code. Code
  /// A code signifying the importance of this property group in using it to describe a required Item.
  /// 0..1
  /// Item Property Group
  /// Importance Code
  /// Code
  /// Code. Type
  importance_code ubl_common_basic_components_2_1.ImportanceCode? @xsd(name: "ImportanceCode")

  @@xsd(name: "ItemPropertyGroup")
}

/// ABIE
/// Item Property Range. Details
/// A class to describe a range of values for an item property.
/// Item Property Range
model ItemPropertyRange {
  /// BBIE
  /// Item Property Range. Minimum_ Value. Text
  /// The minimum value in this range of values.
  /// 0..1
  /// Item Property Range
  /// Minimum
  /// Value
  /// Text
  /// Text. Type
  minimum_value ubl_common_basic_components_2_1.MinimumValue? @xsd(name: "MinimumValue")
  /// BBIE
  /// Item Property Range. Maximum_ Value. Text
  /// The maximum value in this range of values.
  /// 0..1
  /// Item Property Range
  /// Maximum
  /// Value
  /// Text
  /// Text. Type
  maximum_value ubl_common_basic_components_2_1.MaximumValue? @xsd(name: "MaximumValue")

  @@xsd(name: "ItemPropertyRange")
}

/// ABIE
/// Language. Details
/// A class to describe a language.
/// Language
model Language {
  /// BBIE
  /// Language. Identifier
  /// An identifier for this language.
  /// 0..1
  /// Language
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id          ubl_common_basic_components_2_1.ID?         @xsd(name: "ID")
  /// BBIE
  /// Language. Name
  /// The name of this language.
  /// 0..1
  /// Language
  /// Name
  /// Name
  /// Name. Type
  name        ubl_common_basic_components_2_1.Name?       @xsd(name: "Name")
  /// BBIE
  /// Language. Locale Code. Code
  /// A code signifying the locale in which this language is used.
  /// 0..1
  /// Language
  /// Locale Code
  /// Code
  /// Code. Type
  locale_code ubl_common_basic_components_2_1.LocaleCode? @xsd(name: "LocaleCode")
}

/// ABIE
/// Line Item. Details
/// A class to describe a line item.
/// Line Item
model LineItem {
  /// BBIE
  /// Line Item. Identifier
  /// An identifier for this line item, assigned by the buyer.
  /// 1
  /// Line Item
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                           ubl_common_basic_components_2_1.ID                         @xsd(name: "ID")
  /// BBIE
  /// Line Item. Sales_ Order Identifier. Identifier
  /// An identifier for this line item, assigned by the seller.
  /// 0..1
  /// Line Item
  /// Sales
  /// Order Identifier
  /// Identifier
  /// Identifier. Type
  sales_order_id               ubl_common_basic_components_2_1.SalesOrderID?              @xsd(name: "SalesOrderID")
  /// BBIE
  /// Line Item. UUID. Identifier
  /// A universally unique identifier for this line item.
  /// 0..1
  /// Line Item
  /// UUID
  /// Identifier
  /// Identifier. Type
  uuid                         ubl_common_basic_components_2_1.UUID?                      @xsd(name: "UUID")
  /// BBIE
  /// Line Item. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Line Item
  /// Note
  /// Text
  /// Text. Type
  note                         ubl_common_basic_components_2_1.Note[]                     @xsd(name: "Note")
  /// BBIE
  /// Line Item. Line Status Code. Code
  /// A code signifying the status of this line item with respect to its original state.
  /// 0..1
  /// Line Item
  /// Line Status Code
  /// Code
  /// Line Status
  /// Line Status_ Code. Type
  line_status_code             ubl_common_basic_components_2_1.LineStatusCode?            @xsd(name: "LineStatusCode")
  /// BBIE
  /// Line Item. Quantity
  /// The quantity of items associated with this line item.
  /// 0..1
  /// Line Item
  /// Quantity
  /// Quantity
  /// Quantity. Type
  quantity                     ubl_common_basic_components_2_1.Quantity?                  @xsd(name: "Quantity")
  /// BBIE
  /// Line Item. Line Extension Amount. Amount
  /// The total amount for this line item, including allowance charges but net of taxes.
  /// 0..1
  /// Line Item
  /// Line Extension Amount
  /// Amount
  /// Amount. Type
  line_extension_amount        ubl_common_basic_components_2_1.LineExtensionAmount?       @xsd(name: "LineExtensionAmount")
  /// BBIE
  /// Line Item. Total_ Tax Amount. Amount
  /// The total tax amount for this line item.
  /// 0..1
  /// Line Item
  /// Total
  /// Tax Amount
  /// Amount
  /// Amount. Type
  total_tax_amount             ubl_common_basic_components_2_1.TotalTaxAmount?            @xsd(name: "TotalTaxAmount")
  /// BBIE
  /// Line Item. Minimum_ Quantity. Quantity
  /// The minimum quantity of the item associated with this line.
  /// 0..1
  /// Line Item
  /// Minimum
  /// Quantity
  /// Quantity
  /// Quantity. Type
  minimum_quantity             ubl_common_basic_components_2_1.MinimumQuantity?           @xsd(name: "MinimumQuantity")
  /// BBIE
  /// Line Item. Maximum_ Quantity. Quantity
  /// The maximum quantity of the item associated with this line.
  /// 0..1
  /// Line Item
  /// Maximum
  /// Quantity
  /// Quantity
  /// Quantity. Type
  maximum_quantity             ubl_common_basic_components_2_1.MaximumQuantity?           @xsd(name: "MaximumQuantity")
  /// BBIE
  /// Line Item. Minimum_ Backorder. Quantity
  /// The minimum back order quantity of the item associated with this line (where back order is allowed).
  /// 0..1
  /// Line Item
  /// Minimum
  /// Backorder
  /// Quantity
  /// Quantity. Type
  minimum_backorder_quantity   ubl_common_basic_components_2_1.MinimumBackorderQuantity?  @xsd(name: "MinimumBackorderQuantity")
  /// BBIE
  /// Line Item. Maximum_ Backorder. Quantity
  /// The maximum back order quantity of the item associated with this line (where back order is allowed).
  /// 0..1
  /// Line Item
  /// Maximum
  /// Backorder
  /// Quantity
  /// Quantity. Type
  maximum_backorder_quantity   ubl_common_basic_components_2_1.MaximumBackorderQuantity?  @xsd(name: "MaximumBackorderQuantity")
  /// BBIE
  /// Line Item. Inspection Method Code. Code
  /// A code signifying the inspection requirements for the item associated with this line item.
  /// 0..1
  /// Line Item
  /// Inspection Method Code
  /// Code
  /// Code. Type
  inspection_method_code       ubl_common_basic_components_2_1.InspectionMethodCode?      @xsd(name: "InspectionMethodCode")
  /// BBIE
  /// Line Item. Partial Delivery Indicator. Indicator
  /// An indicator that a partial delivery is allowed (true) or not (false).
  /// 0..1
  /// Line Item
  /// Partial Delivery Indicator
  /// Indicator
  /// Indicator. Type
  partial_delivery_indicator   ubl_common_basic_components_2_1.PartialDeliveryIndicator?  @xsd(name: "PartialDeliveryIndicator")
  /// BBIE
  /// Line Item. Back Order Allowed Indicator. Indicator
  /// An indicator that back order is allowed (true) or not (false).
  /// 0..1
  /// Line Item
  /// Back Order Allowed Indicator
  /// Indicator
  /// Indicator. Type
  back_order_allowed_indicator ubl_common_basic_components_2_1.BackOrderAllowedIndicator? @xsd(name: "BackOrderAllowedIndicator")
  /// BBIE
  /// Line Item. Accounting Cost Code. Code
  /// The buyer's accounting cost centre for this line item, expressed as a code.
  /// 0..1
  /// Line Item
  /// Accounting Cost Code
  /// Code
  /// Code. Type
  accounting_cost_code         ubl_common_basic_components_2_1.AccountingCostCode?        @xsd(name: "AccountingCostCode")
  /// BBIE
  /// Line Item. Accounting Cost. Text
  /// The buyer's accounting cost centre for this line item, expressed as text.
  /// 0..1
  /// Line Item
  /// Accounting Cost
  /// Text
  /// Text. Type
  accounting_cost              ubl_common_basic_components_2_1.AccountingCost?            @xsd(name: "AccountingCost")
  /// BBIE
  /// Line Item. Warranty_ Information. Text
  /// Text describing a warranty (provided by WarrantyParty) for the good or service described in this line item.
  /// 0..n
  /// Line Item
  /// Warranty
  /// Information
  /// Text
  /// Text. Type
  /// Unless specified otherwise and in addition to any rights the Customer may have under statute, Dell warrants to the Customer that Dell branded Products (excluding third party products and software), will be free from defects in materials and workmanship affecting normal use for a period of one year from invoice date ( Standard Warranty ).
  warranty_information         ubl_common_basic_components_2_1.WarrantyInformation[]      @xsd(name: "WarrantyInformation")
  /// ASBIE
  /// Line Item. Delivery
  /// A delivery associated with this line item.
  /// 0..n
  /// Line Item
  /// Delivery
  /// Delivery
  /// Delivery
  delivery                     Delivery[]                                                 @xsd(name: "Delivery")
  /// ASBIE
  /// Line Item. Delivery Terms
  /// Terms and conditions of the delivery associated with this line item.
  /// 0..1
  /// Line Item
  /// Delivery Terms
  /// Delivery Terms
  /// Delivery Terms
  delivery_terms               DeliveryTerms?                                             @xsd(name: "DeliveryTerms")
  /// ASBIE
  /// Line Item. Originator_ Party. Party
  /// The party who originated the Order associated with this line item.
  /// 0..1
  /// Line Item
  /// Originator
  /// Party
  /// Party
  /// Party
  originator_party             Party?                                                     @xsd(name: "OriginatorParty")
  /// ASBIE
  /// Line Item. Ordered Shipment
  /// An ordered shipment associated with this line item.
  /// 0..n
  /// Line Item
  /// Ordered Shipment
  /// Ordered Shipment
  /// Ordered Shipment
  ordered_shipment             OrderedShipment[]                                          @xsd(name: "OrderedShipment")
  /// ASBIE
  /// Line Item. Pricing Reference
  /// A reference to pricing and item location information associated with this line item.
  /// 0..1
  /// Line Item
  /// Pricing Reference
  /// Pricing Reference
  /// Pricing Reference
  pricing_reference            PricingReference?                                          @xsd(name: "PricingReference")
  /// ASBIE
  /// Line Item. Allowance Charge
  /// An allowance or charge associated with this line item.
  /// 0..n
  /// Line Item
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  allowance_charge             AllowanceCharge[]                                          @xsd(name: "AllowanceCharge")
  /// ASBIE
  /// Line Item. Price
  /// The price of the item of trade associated with this line item.
  /// 0..1
  /// Line Item
  /// Price
  /// Price
  /// Price
  price                        Price?                                                     @xsd(name: "Price")
  /// ASBIE
  /// Line Item. Item
  /// The item of trade associated with this line item.
  /// 1
  /// Line Item
  /// Item
  /// Item
  /// Item
  item                         Item                                                       @xsd(name: "Item")
  /// ASBIE
  /// Line Item. Sub_ Line Item. Line Item
  /// The subsidiary line items that constitute the main line item, such as in a bill of materials.
  /// 0..n
  /// Line Item
  /// Sub
  /// Line Item
  /// Line Item
  /// Line Item
  sub_line_item                LineItem[]                                                 @xsd(name: "SubLineItem")
  /// ASBIE
  /// Line Item. Warranty Validity_ Period. Period
  /// The period during which the warranty associated with this line item is valid.
  /// 0..1
  /// Line Item
  /// Warranty Validity
  /// Period
  /// Period
  /// Period
  warranty_validity_period     Period?                                                    @xsd(name: "WarrantyValidityPeriod")
  /// ASBIE
  /// Line Item. Warranty_ Party. Party
  /// The party responsible for any warranty associated with this line item.
  /// 0..1
  /// Line Item
  /// Warranty
  /// Party
  /// Party
  /// Party
  warranty_party               Party?                                                     @xsd(name: "WarrantyParty")
  /// ASBIE
  /// Line Item. Tax Total
  /// A total amount of taxes of a particular kind applicable to this item.
  /// 0..n
  /// Line Item
  /// Tax Total
  /// Tax Total
  /// Tax Total
  tax_total                    TaxTotal[]                                                 @xsd(name: "TaxTotal")
  /// ASBIE
  /// Line Item. Item_ Price Extension. Price Extension
  /// The price extension, calculated by multiplying the price per unit by the quantity of items.
  /// 0..1
  /// Line Item
  /// Item
  /// Price Extension
  /// Price Extension
  /// Price Extension
  item_price_extension         PriceExtension?                                            @xsd(name: "ItemPriceExtension")
  /// ASBIE
  /// Line Item. Line Reference
  /// A reference to a line in a document associated with this line item.
  /// 0..n
  /// Line Item
  /// Line Reference
  /// Line Reference
  /// Line Reference
  line_reference               LineReference[]                                            @xsd(name: "LineReference")
}

/// ABIE
/// Line Reference. Details
/// A class to define a reference to a line in a document.
/// Line Reference
model LineReference {
  /// BBIE
  /// Line Reference. Line Identifier. Identifier
  /// Identifies the referenced line in the document.
  /// 1
  /// Line Reference
  /// Line Identifier
  /// Identifier
  /// Identifier. Type
  line_id            ubl_common_basic_components_2_1.LineID          @xsd(name: "LineID")
  /// BBIE
  /// Line Reference. UUID. Identifier
  /// A universally unique identifier for this line reference.
  /// 0..1
  /// Line Reference
  /// UUID
  /// Identifier
  /// Identifier. Type
  uuid               ubl_common_basic_components_2_1.UUID?           @xsd(name: "UUID")
  /// BBIE
  /// Line Reference. Line Status Code. Code
  /// A code signifying the status of the referenced line with respect to its original state.
  /// 0..1
  /// Line Reference
  /// Line Status Code
  /// Code
  /// Line Status
  /// Line Status_ Code. Type
  line_status_code   ubl_common_basic_components_2_1.LineStatusCode? @xsd(name: "LineStatusCode")
  /// ASBIE
  /// Line Reference. Document Reference
  /// A reference to the document containing the referenced line.
  /// 0..1
  /// Line Reference
  /// Document Reference
  /// Document Reference
  /// Document Reference
  document_reference DocumentReference?                              @xsd(name: "DocumentReference")
}

/// ABIE
/// Line Response. Details
/// A class to describe responses to a line in a document.
/// Line Response
model LineResponse {
  /// ASBIE
  /// Line Response. Line Reference
  /// A reference to the line being responded to.
  /// 1
  /// Line Response
  /// Line Reference
  /// Line Reference
  /// Line Reference
  line_reference LineReference @xsd(name: "LineReference")
  /// ASBIE
  /// Line Response. Response
  /// A response to the referenced line.
  /// 1..n
  /// Line Response
  /// Response
  /// Response
  /// Response
  response       Response[]    { minItems 1 } @xsd(name: "Response")

  @@xsd(name: "LineResponse")
}

/// ABIE
/// Location. Details
/// A class to describe a location.
/// Location
model Location {
  /// BBIE
  /// Location. Identifier
  /// An identifier for this location, e.g., the EAN Location Number, GLN.
  /// 0..1
  /// Location
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// 5790002221134
  id                     ubl_common_basic_components_2_1.ID?                   @xsd(name: "ID")
  /// BBIE
  /// Location. Description. Text
  /// Text describing this location.
  /// 0..n
  /// Location
  /// Description
  /// Text
  /// Text. Type
  description            ubl_common_basic_components_2_1.Description[]         @xsd(name: "Description")
  /// BBIE
  /// Location. Conditions. Text
  /// Free-form text describing the physical conditions of the location.
  /// 0..n
  /// Location
  /// Conditions
  /// Text
  /// Text. Type
  conditions             ubl_common_basic_components_2_1.Conditions[]          @xsd(name: "Conditions")
  /// BBIE
  /// Location. Country Subentity. Text
  /// A territorial division of a country, such as a county or state, expressed as text.
  /// 0..1
  /// Location
  /// Country Subentity
  /// Text
  /// Text. Type
  /// AdministrativeArea, State, Country, Shire, Canton
  /// Florida , Tamilnadu
  country_subentity      ubl_common_basic_components_2_1.CountrySubentity?     @xsd(name: "CountrySubentity")
  /// BBIE
  /// Location. Country Subentity Code. Code
  /// A territorial division of a country, such as a county or state, expressed as a code.
  /// 0..1
  /// Location
  /// Country Subentity Code
  /// Code
  /// Code. Type
  /// AdministrativeAreaCode, State Code
  country_subentity_code ubl_common_basic_components_2_1.CountrySubentityCode? @xsd(name: "CountrySubentityCode")
  /// BBIE
  /// Location. Location Type Code. Code
  /// A code signifying the type of location.
  /// 0..1
  /// Location
  /// Location Type Code
  /// Code
  /// Code. Type
  location_type_code     ubl_common_basic_components_2_1.LocationTypeCode?     @xsd(name: "LocationTypeCode")
  /// BBIE
  /// Location. Information_ URI. Identifier
  /// The Uniform Resource Identifier (URI) of a document providing information about this location.
  /// 0..1
  /// Location
  /// Information
  /// URI
  /// Identifier
  /// Identifier. Type
  information_uri        ubl_common_basic_components_2_1.InformationURI?       @xsd(name: "InformationURI")
  /// BBIE
  /// Location. Name
  /// The name of this location.
  /// 0..1
  /// Location
  /// Name
  /// Name
  /// Name. Type
  /// winter 2005 collection
  name                   ubl_common_basic_components_2_1.Name?                 @xsd(name: "Name")
  /// ASBIE
  /// Location. Validity_ Period. Period
  /// A period during which this location can be used (e.g., for delivery).
  /// 0..n
  /// Location
  /// Validity
  /// Period
  /// Period
  /// Period
  validity_period        Period[]                                              @xsd(name: "ValidityPeriod")
  /// ASBIE
  /// Location. Address
  /// The address of this location.
  /// 0..1
  /// Location
  /// Address
  /// Address
  /// Address
  address                Address?                                              @xsd(name: "Address")
  /// ASBIE
  /// Location. Subsidiary_ Location. Location
  /// A location subsidiary to this location.
  /// 0..n
  /// Location
  /// Subsidiary
  /// Location
  /// Location
  /// Location
  subsidiary_location    ubl_common_aggregate_components_2_1.Location[]        @xsd(name: "SubsidiaryLocation")
  /// ASBIE
  /// Location. Location Coordinate
  /// The geographical coordinates of this location.
  /// 0..n
  /// Location
  /// Location Coordinate
  /// Location Coordinate
  /// Location Coordinate
  location_coordinate    LocationCoordinate[]                                  @xsd(name: "LocationCoordinate")
}

/// ABIE
/// Location Coordinate. Details
/// A class for defining a set of geographical coordinates (apparently misnamed).
/// Location Coordinate
model LocationCoordinate {
  /// BBIE
  /// Location Coordinate. Coordinate System Code. Code
  /// A code signifying the location system used.
  /// 0..1
  /// Location Coordinate
  /// Coordinate System Code
  /// Code
  /// Code. Type
  coordinate_system_code    ubl_common_basic_components_2_1.CoordinateSystemCode?    @xsd(name: "CoordinateSystemCode")
  /// BBIE
  /// Location Coordinate. Latitude_ Degrees. Measure
  /// The degree component of a latitude measured in degrees and minutes.
  /// 0..1
  /// Location Coordinate
  /// Latitude
  /// Degrees
  /// Measure
  /// Measure. Type
  latitude_degrees_measure  ubl_common_basic_components_2_1.LatitudeDegreesMeasure?  @xsd(name: "LatitudeDegreesMeasure")
  /// BBIE
  /// Location Coordinate. Latitude_ Minutes. Measure
  /// The minutes component of a latitude measured in degrees and minutes (modulo 60).
  /// 0..1
  /// Location Coordinate
  /// Latitude
  /// Minutes
  /// Measure
  /// Measure. Type
  latitude_minutes_measure  ubl_common_basic_components_2_1.LatitudeMinutesMeasure?  @xsd(name: "LatitudeMinutesMeasure")
  /// BBIE
  /// Location Coordinate. Latitude Direction Code. Code
  /// A code signifying the direction of latitude measurement from the equator (north or south).
  /// 0..1
  /// Location Coordinate
  /// Latitude Direction Code
  /// Code
  /// Latitude Direction
  /// Latitude Direction_ Code. Type
  latitude_direction_code   ubl_common_basic_components_2_1.LatitudeDirectionCode?   @xsd(name: "LatitudeDirectionCode")
  /// BBIE
  /// Location Coordinate. Longitude_ Degrees. Measure
  /// The degree component of a longitude measured in degrees and minutes.
  /// 0..1
  /// Location Coordinate
  /// Longitude
  /// Degrees
  /// Measure
  /// Measure. Type
  longitude_degrees_measure ubl_common_basic_components_2_1.LongitudeDegreesMeasure? @xsd(name: "LongitudeDegreesMeasure")
  /// BBIE
  /// Location Coordinate. Longitude_ Minutes. Measure
  /// The minutes component of a longitude measured in degrees and minutes (modulo 60).
  /// 0..1
  /// Location Coordinate
  /// Longitude
  /// Minutes
  /// Measure
  /// Measure. Type
  longitude_minutes_measure ubl_common_basic_components_2_1.LongitudeMinutesMeasure? @xsd(name: "LongitudeMinutesMeasure")
  /// BBIE
  /// Location Coordinate. Longitude Direction Code. Code
  /// A code signifying the direction of longitude measurement from the prime meridian (east or west).
  /// 0..1
  /// Location Coordinate
  /// Longitude Direction Code
  /// Code
  /// Longitude Direction
  /// Longitude Direction_ Code. Type
  longitude_direction_code  ubl_common_basic_components_2_1.LongitudeDirectionCode?  @xsd(name: "LongitudeDirectionCode")
  /// BBIE
  /// Location Coordinate. Altitude. Measure
  /// The altitude of the location.
  /// 0..1
  /// Location Coordinate
  /// Altitude
  /// Measure
  /// Measure. Type
  altitude_measure          ubl_common_basic_components_2_1.AltitudeMeasure?         @xsd(name: "AltitudeMeasure")

  @@xsd(name: "LocationCoordinate")
}

/// ABIE
/// Lot Identification. Details
/// A class for defining a lot identifier (the identifier of a set of item instances that would be used in case of a recall of that item).
/// Lot Identification
model LotIdentification {
  /// BBIE
  /// Lot Identification. Lot Number. Identifier
  /// An identifier for the lot.
  /// 0..1
  /// Lot Identification
  /// Lot Number
  /// Identifier
  /// Identifier. Type
  lot_number_id            ubl_common_basic_components_2_1.LotNumberID? @xsd(name: "LotNumberID")
  /// BBIE
  /// Lot Identification. Expiry Date. Date
  /// The expiry date of the lot.
  /// 0..1
  /// Lot Identification
  /// Expiry Date
  /// Date
  /// Date. Type
  expiry_date              ubl_common_basic_components_2_1.ExpiryDate?  @xsd(name: "ExpiryDate")
  /// ASBIE
  /// Lot Identification. Additional_ Item Property. Item Property
  /// An additional property of the lot.
  /// 0..n
  /// Lot Identification
  /// Additional
  /// Item Property
  /// Item Property
  /// Item Property
  additional_item_property ItemProperty[]                               @xsd(name: "AdditionalItemProperty")

  @@xsd(name: "LotIdentification")
}

/// ABIE
/// Maritime Transport. Details
/// A class to describe a vessel used for transport by water (including sea, river, and canal).
/// Maritime Transport
model MaritimeTransport {
  /// BBIE
  /// Maritime Transport. Vessel Identifier. Identifier
  /// An identifier for a specific vessel.
  /// 0..1
  /// Maritime Transport
  /// Vessel Identifier
  /// Identifier
  /// Identifier. Type
  /// Lloyds Number, Registration Number (WCO ID 167)
  /// International Maritime Organisation number of a vessel
  vessel_id                               ubl_common_basic_components_2_1.VesselID?            @xsd(name: "VesselID")
  /// BBIE
  /// Maritime Transport. Vessel Name. Name
  /// The name of the vessel.
  /// 0..1
  /// Maritime Transport
  /// Vessel Name
  /// Name
  /// Name. Type
  /// Ships Name
  vessel_name                             ubl_common_basic_components_2_1.VesselName?          @xsd(name: "VesselName")
  /// BBIE
  /// Maritime Transport. Radio Call Sign Identifier. Identifier
  /// The radio call sign of the vessel.
  /// 0..1
  /// Maritime Transport
  /// Radio Call Sign Identifier
  /// Identifier
  /// Identifier. Type
  /// NES
  radio_call_sign_id                      ubl_common_basic_components_2_1.RadioCallSignID?     @xsd(name: "RadioCallSignID")
  /// BBIE
  /// Maritime Transport. Ships Requirements. Text
  /// Information about what services a vessel will require when it arrives at a port, such as refueling, maintenance, waste disposal etc.
  /// 0..n
  /// Maritime Transport
  /// Ships Requirements
  /// Text
  /// Text. Type
  ships_requirements                      ubl_common_basic_components_2_1.ShipsRequirements[]  @xsd(name: "ShipsRequirements")
  /// BBIE
  /// Maritime Transport. Gross Tonnage. Measure
  /// Gross tonnage is calculated by measuring a ship's volume (from keel to funnel, to the outside of the hull framing) and applying a mathematical formula and is used to determine things such as a ship's manning regulations, safety rules, registration fees and port dues.
  /// 0..1
  /// Maritime Transport
  /// Gross Tonnage
  /// Measure
  /// Measure. Type
  gross_tonnage_measure                   ubl_common_basic_components_2_1.GrossTonnageMeasure? @xsd(name: "GrossTonnageMeasure")
  /// BBIE
  /// Maritime Transport. Net Tonnage. Measure
  /// Net tonnage is calculated by measuring a ship's internal volume and applying a mathematical formula and is used to calculate the port duties.
  /// 0..1
  /// Maritime Transport
  /// Net Tonnage
  /// Measure
  /// Measure. Type
  net_tonnage_measure                     ubl_common_basic_components_2_1.NetTonnageMeasure?   @xsd(name: "NetTonnageMeasure")
  /// ASBIE
  /// Maritime Transport. Registry Certificate_ Document Reference. Document Reference
  /// The certificate issued to the ship by the ships registry in a given flag state.
  /// 0..1
  /// Maritime Transport
  /// Registry Certificate
  /// Document Reference
  /// Document Reference
  /// Document Reference
  registry_certificate_document_reference DocumentReference?                                   @xsd(name: "RegistryCertificateDocumentReference")
  /// ASBIE
  /// Maritime Transport. Registry Port_ Location. Location
  /// The port in which a vessel is registered or permanently based.
  /// 0..1
  /// Maritime Transport
  /// Registry Port
  /// Location
  /// Location
  /// Location
  registry_port_location                  ubl_common_aggregate_components_2_1.Location?        @xsd(name: "RegistryPortLocation")

  @@xsd(name: "MaritimeTransport")
}

/// ABIE
/// Meter. Details
/// A class to describe a meter and its readings.
/// Meter
model Meter {
  /// BBIE
  /// Meter. Meter Number. Text
  /// The meter number, expressed as text.
  /// 0..1
  /// Meter
  /// Meter Number
  /// Text
  /// Text. Type
  /// 61722x
  meter_number             ubl_common_basic_components_2_1.MeterNumber?            @xsd(name: "MeterNumber")
  /// BBIE
  /// Meter. Meter Name. Text
  /// The name of this meter, which serves as an identifier to distinguish a main meter from a submeter.
  /// 0..1
  /// Meter
  /// Meter Name
  /// Text
  /// Text. Type
  meter_name               ubl_common_basic_components_2_1.MeterName?              @xsd(name: "MeterName")
  /// BBIE
  /// Meter. Meter Constant. Text
  /// The factor by which readings of this meter must be multiplied to calculate consumption, expressed as text.
  /// 0..1
  /// Meter
  /// Meter Constant
  /// Text
  /// Text. Type
  /// 1.000
  meter_constant           ubl_common_basic_components_2_1.MeterConstant?          @xsd(name: "MeterConstant")
  /// BBIE
  /// Meter. Meter Constant Code. Code
  /// A code signifying the formula to be used in applying the meter constant.
  /// 0..1
  /// Meter
  /// Meter Constant Code
  /// Code
  /// Code. Type
  /// Factor
  meter_constant_code      ubl_common_basic_components_2_1.MeterConstantCode?      @xsd(name: "MeterConstantCode")
  /// BBIE
  /// Meter. Total_ Delivered Quantity. Quantity
  /// The quantity delivered; the total quantity consumed as calculated from the meter readings.
  /// 0..1
  /// Meter
  /// Total
  /// Delivered Quantity
  /// Quantity
  /// Quantity. Type
  /// 5761.00
  total_delivered_quantity ubl_common_basic_components_2_1.TotalDeliveredQuantity? @xsd(name: "TotalDeliveredQuantity")
  /// ASBIE
  /// Meter. Meter Reading
  /// A reading of this meter.
  /// 0..n
  /// Meter
  /// Meter Reading
  /// Meter Reading
  /// Meter Reading
  meter_reading            MeterReading[]                                          @xsd(name: "MeterReading")
  /// ASBIE
  /// Meter. Meter Property
  /// A property of this meter.
  /// 0..n
  /// Meter
  /// Meter Property
  /// Meter Property
  /// Meter Property
  meter_property           MeterProperty[]                                         @xsd(name: "MeterProperty")

  @@xsd(name: "Meter")
}

/// ABIE
/// Meter Property. Details
/// The name of this meter property.
/// Meter Property
model MeterProperty {
  /// BBIE
  /// Meter Property. Name
  /// The name of this meter property, expressed as a code.
  /// 0..1
  /// Meter Property
  /// Name
  /// Name
  /// Name. Type
  /// Energy Rating , Collar Size , Fat Content
  name            ubl_common_basic_components_2_1.Name?            @xsd(name: "Name")
  /// BBIE
  /// Meter Property. Name Code. Code
  /// The value of this meter property, expressed as text.
  /// 0..1
  /// Meter Property
  /// Name Code
  /// Code
  /// Code. Type
  name_code       ubl_common_basic_components_2_1.NameCode?        @xsd(name: "NameCode")
  /// BBIE
  /// Meter Property. Value. Text
  /// The value of this meter property, expressed as a quantity.
  /// 0..1
  /// Meter Property
  /// Value
  /// Text
  /// Text. Type
  /// 100 watts , 15 European , 20% +/- 5%
  value           ubl_common_basic_components_2_1.Value?           @xsd(name: "Value")
  /// BBIE
  /// Meter Property. Value_ Quantity. Quantity
  /// The value of this meter property, expressed as a quantity.
  /// 0..1
  /// Meter Property
  /// Value
  /// Quantity
  /// Quantity
  /// Quantity. Type
  value_quantity  ubl_common_basic_components_2_1.ValueQuantity?   @xsd(name: "ValueQuantity")
  /// BBIE
  /// Meter Property. Value Qualifier. Text
  /// An additional value to qualify the value of the meter
  /// 0..n
  /// Meter Property
  /// Value Qualifier
  /// Text
  /// Text. Type
  value_qualifier ubl_common_basic_components_2_1.ValueQualifier[] @xsd(name: "ValueQualifier")

  @@xsd(name: "MeterProperty")
}

/// ABIE
/// Meter Reading. Details
/// A class to describe a meter reading.
/// Meter Reading
model MeterReading {
  /// BBIE
  /// Meter Reading. Identifier
  /// An identifier for this meter reading.
  /// 0..1
  /// Meter Reading
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// 7411013716x
  id                                 ubl_common_basic_components_2_1.ID?                             @xsd(name: "ID")
  /// BBIE
  /// Meter Reading. Meter Reading Type. Text
  /// The type of this meter reading, expressed as text.
  /// 0..1
  /// Meter Reading
  /// Meter Reading Type
  /// Text
  /// Text. Type
  /// Electricity
  meter_reading_type                 ubl_common_basic_components_2_1.MeterReadingType?               @xsd(name: "MeterReadingType")
  /// BBIE
  /// Meter Reading. Meter Reading Type Code. Code
  /// The type of this meter reading, expressed as a code.
  /// 0..1
  /// Meter Reading
  /// Meter Reading Type Code
  /// Code
  /// Code. Type
  /// Electricity
  meter_reading_type_code            ubl_common_basic_components_2_1.MeterReadingTypeCode?           @xsd(name: "MeterReadingTypeCode")
  /// BBIE
  /// Meter Reading. Previous_ Meter Reading Date. Date
  /// The date of the previous meter reading.
  /// 1
  /// Meter Reading
  /// Previous
  /// Meter Reading Date
  /// Date
  /// Date. Type
  /// 2006-09-01
  previous_meter_reading_date        ubl_common_basic_components_2_1.PreviousMeterReadingDate        @xsd(name: "PreviousMeterReadingDate")
  /// BBIE
  /// Meter Reading. Previous_ Meter Quantity. Quantity
  /// The quantity of the previous meter reading.
  /// 1
  /// Meter Reading
  /// Previous
  /// Meter Quantity
  /// Quantity
  /// Quantity. Type
  /// 122604.00
  previous_meter_quantity            ubl_common_basic_components_2_1.PreviousMeterQuantity           @xsd(name: "PreviousMeterQuantity")
  /// BBIE
  /// Meter Reading. Latest_ Meter Reading Date. Date
  /// The date of the latest meter reading.
  /// 1
  /// Meter Reading
  /// Latest
  /// Meter Reading Date
  /// Date
  /// Date. Type
  /// 2006-09-01
  latest_meter_reading_date          ubl_common_basic_components_2_1.LatestMeterReadingDate          @xsd(name: "LatestMeterReadingDate")
  /// BBIE
  /// Meter Reading. Latest_ Meter Quantity. Quantity
  /// The quantity of the latest meter reading.
  /// 1
  /// Meter Reading
  /// Latest
  /// Meter Quantity
  /// Quantity
  /// Quantity. Type
  /// 128365.00
  latest_meter_quantity              ubl_common_basic_components_2_1.LatestMeterQuantity             @xsd(name: "LatestMeterQuantity")
  /// BBIE
  /// Meter Reading. Previous Meter Reading_ Method. Text
  /// The method used for the previous meter reading, expressed as text.
  /// 0..1
  /// Meter Reading
  /// Previous Meter Reading
  /// Method
  /// Text
  /// Text. Type
  /// Manuel
  previous_meter_reading_method      ubl_common_basic_components_2_1.PreviousMeterReadingMethod?     @xsd(name: "PreviousMeterReadingMethod")
  /// BBIE
  /// Meter Reading. Previous Meter Reading_ Method Code. Code
  /// The method used for the previous meter reading, expressed as a code.
  /// 0..1
  /// Meter Reading
  /// Previous Meter Reading
  /// Method Code
  /// Code
  /// Code. Type
  /// Estimated
  previous_meter_reading_method_code ubl_common_basic_components_2_1.PreviousMeterReadingMethodCode? @xsd(name: "PreviousMeterReadingMethodCode")
  /// BBIE
  /// Meter Reading. Latest Meter Reading_ Method. Text
  /// The method used for the latest meter reading, expressed as text.
  /// 0..1
  /// Meter Reading
  /// Latest Meter Reading
  /// Method
  /// Text
  /// Text. Type
  /// Manuel
  latest_meter_reading_method        ubl_common_basic_components_2_1.LatestMeterReadingMethod?       @xsd(name: "LatestMeterReadingMethod")
  /// BBIE
  /// Meter Reading. Latest Meter Reading_ Method Code. Code
  /// The method used for the latest meter reading, expressed as a code.
  /// 0..1
  /// Meter Reading
  /// Latest Meter Reading
  /// Method Code
  /// Code
  /// Code. Type
  /// Estimated
  latest_meter_reading_method_code   ubl_common_basic_components_2_1.LatestMeterReadingMethodCode?   @xsd(name: "LatestMeterReadingMethodCode")
  /// BBIE
  /// Meter Reading. Meter Reading_ Comments. Text
  /// Text containing comments on this meter reading.
  /// 0..n
  /// Meter Reading
  /// Meter Reading
  /// Comments
  /// Text
  /// Text. Type
  /// The last stated meterstand is estimated
  meter_reading_comments             ubl_common_basic_components_2_1.MeterReadingComments[]          @xsd(name: "MeterReadingComments")
  /// BBIE
  /// Meter Reading. Delivered_ Quantity. Quantity
  /// Consumption in the period from PreviousMeterReadingDate to LatestMeterReadingDate.
  /// 1
  /// Meter Reading
  /// Delivered
  /// Quantity
  /// Quantity
  /// Quantity. Type
  delivered_quantity                 ubl_common_basic_components_2_1.DeliveredQuantity               @xsd(name: "DeliveredQuantity")

  @@xsd(name: "MeterReading")
}

/// ABIE
/// Miscellaneous Event. Details
/// A class to describe a miscellaneous event associated with a retail event.
/// Miscellaneous Event
model MiscellaneousEvent {
  /// BBIE
  /// Miscellaneous Event. Miscellaneous Event Type Code. Code
  /// A code signifying the type of this miscellaneous event. Examples are: ASSORTMENT_CHARGE DISASTER FORECAST_DECREASE FORECAST_INCREASE FREIGHT_FLOW_ALLOCATION INVENTORY_POLICY_CHANGE LOCATION_CLOSING LOCATION_OPENING OTHER OUT_OF_STOCK PACKAGING_LABELING_CHANGE PRICE_DECREASE PRICE_INCREASE STORE_FORMAT_OR_PLANOGRAM_CHANGE TEST_MARKET WEATHER
  /// 1
  /// Miscellaneous Event
  /// Miscellaneous Event Type Code
  /// Code
  /// Code. Type
  miscellaneous_event_type_code ubl_common_basic_components_2_1.MiscellaneousEventTypeCode @xsd(name: "MiscellaneousEventTypeCode")
  /// ASBIE
  /// Miscellaneous Event. Event Line Item
  /// An event line item for this miscellaneous retail event.
  /// 1..n
  /// Miscellaneous Event
  /// Event Line Item
  /// Event Line Item
  /// Event Line Item
  event_line_item               EventLineItem[]                                            { minItems 1 } @xsd(name: "EventLineItem")

  @@xsd(name: "MiscellaneousEvent")
}

/// ABIE
/// Monetary Total. Details
/// A class to define a monetary total.
/// Monetary Total
model MonetaryTotal {
  /// BBIE
  /// Monetary Total. Line Extension Amount. Amount
  /// The monetary amount of an extended transaction line, net of tax and settlement discounts, but inclusive of any applicable rounding amount.
  /// 0..1
  /// Monetary Total
  /// Line Extension Amount
  /// Amount
  /// Amount. Type
  line_extension_amount      ubl_common_basic_components_2_1.LineExtensionAmount?      @xsd(name: "LineExtensionAmount")
  /// BBIE
  /// Monetary Total. Tax Exclusive Amount. Amount
  /// The monetary amount of an extended transaction line, exclusive of taxes.
  /// 0..1
  /// Monetary Total
  /// Tax Exclusive Amount
  /// Amount
  /// Amount. Type
  tax_exclusive_amount       ubl_common_basic_components_2_1.TaxExclusiveAmount?       @xsd(name: "TaxExclusiveAmount")
  /// BBIE
  /// Monetary Total. Tax Inclusive Amount. Amount
  /// The monetary amount including taxes; the sum of payable amount and prepaid amount.
  /// 0..1
  /// Monetary Total
  /// Tax Inclusive Amount
  /// Amount
  /// Amount. Type
  tax_inclusive_amount       ubl_common_basic_components_2_1.TaxInclusiveAmount?       @xsd(name: "TaxInclusiveAmount")
  /// BBIE
  /// Monetary Total. Allowance_ Total Amount. Amount
  /// The total monetary amount of all allowances.
  /// 0..1
  /// Monetary Total
  /// Allowance
  /// Total Amount
  /// Amount
  /// Amount. Type
  allowance_total_amount     ubl_common_basic_components_2_1.AllowanceTotalAmount?     @xsd(name: "AllowanceTotalAmount")
  /// BBIE
  /// Monetary Total. Charge_ Total Amount. Amount
  /// The total monetary amount of all charges.
  /// 0..1
  /// Monetary Total
  /// Charge
  /// Total Amount
  /// Amount
  /// Amount. Type
  charge_total_amount        ubl_common_basic_components_2_1.ChargeTotalAmount?        @xsd(name: "ChargeTotalAmount")
  /// BBIE
  /// Monetary Total. Prepaid Amount. Amount
  /// The total prepaid monetary amount.
  /// 0..1
  /// Monetary Total
  /// Prepaid Amount
  /// Amount
  /// Amount. Type
  prepaid_amount             ubl_common_basic_components_2_1.PrepaidAmount?            @xsd(name: "PrepaidAmount")
  /// BBIE
  /// Monetary Total. Payable_ Rounding Amount. Amount
  /// The rounding amount (positive or negative) added to produce the line extension amount.
  /// 0..1
  /// Monetary Total
  /// Payable
  /// Rounding Amount
  /// Amount
  /// Amount. Type
  payable_rounding_amount    ubl_common_basic_components_2_1.PayableRoundingAmount?    @xsd(name: "PayableRoundingAmount")
  /// BBIE
  /// Monetary Total. Payable_ Amount. Amount
  /// The amount of the monetary total to be paid.
  /// 1
  /// Monetary Total
  /// Payable
  /// Amount
  /// Amount
  /// Amount. Type
  payable_amount             ubl_common_basic_components_2_1.PayableAmount             @xsd(name: "PayableAmount")
  /// BBIE
  /// Monetary Total. Payable_ Alternative Amount. Amount
  /// The amount of the monetary total to be paid, expressed in an alternative currency.
  /// 0..1
  /// Monetary Total
  /// Payable
  /// Alternative Amount
  /// Amount
  /// Amount. Type
  payable_alternative_amount ubl_common_basic_components_2_1.PayableAlternativeAmount? @xsd(name: "PayableAlternativeAmount")
}

/// ABIE
/// Notification Requirement. Details
/// A class to describe a notification requirement.
/// Notification Requirement
model NotificationRequirement {
  /// BBIE
  /// Notification Requirement. Notification Type Code. Code
  /// A code signifying the type of notification (e.g., pickup status).
  /// 1
  /// Notification Requirement
  /// Notification Type Code
  /// Code
  /// Code. Type
  notification_type_code                   ubl_common_basic_components_2_1.NotificationTypeCode                  @xsd(name: "NotificationTypeCode")
  /// BBIE
  /// Notification Requirement. Post Event Notification Duration. Measure
  /// The length of time between the occurrence of a given event and the issuance of a notification.
  /// 0..1
  /// Notification Requirement
  /// Post Event Notification Duration
  /// Measure
  /// Measure. Type
  post_event_notification_duration_measure ubl_common_basic_components_2_1.PostEventNotificationDurationMeasure? @xsd(name: "PostEventNotificationDurationMeasure")
  /// BBIE
  /// Notification Requirement. Pre Event Notification Duration. Measure
  /// The length of time to elapse between the issuance of a notification and the occurrence of the event it relates to.
  /// 0..1
  /// Notification Requirement
  /// Pre Event Notification Duration
  /// Measure
  /// Measure. Type
  pre_event_notification_duration_measure  ubl_common_basic_components_2_1.PreEventNotificationDurationMeasure?  @xsd(name: "PreEventNotificationDurationMeasure")
  /// ASBIE
  /// Notification Requirement. Notify_ Party. Party
  /// A party to be notified.
  /// 0..n
  /// Notification Requirement
  /// Notify
  /// Party
  /// Party
  /// Party
  notify_party                             Party[]                                                               @xsd(name: "NotifyParty")
  /// ASBIE
  /// Notification Requirement. Notification_ Period. Period
  /// A period during which a notification should be issued.
  /// 0..n
  /// Notification Requirement
  /// Notification
  /// Period
  /// Period
  /// Period
  notification_period                      Period[]                                                              @xsd(name: "NotificationPeriod")
  /// ASBIE
  /// Notification Requirement. Notification_ Location. Location
  /// A location at which a notification should be issued.
  /// 0..n
  /// Notification Requirement
  /// Notification
  /// Location
  /// Location
  /// Location
  notification_location                    ubl_common_aggregate_components_2_1.Location[]                        @xsd(name: "NotificationLocation")

  @@xsd(name: "NotificationRequirement")
}

/// ABIE
/// On Account Payment. Details
/// A scheduled prepayment (on-account payment) for a estimated utility consumption
/// On Account Payment
model OnAccountPayment {
  /// BBIE
  /// On Account Payment. Estimated_ Consumed Quantity. Quantity
  /// The estimated consumed quantity covered by the payment.
  /// 1
  /// On Account Payment
  /// Estimated
  /// Consumed Quantity
  /// Quantity
  /// Quantity. Type
  estimated_consumed_quantity ubl_common_basic_components_2_1.EstimatedConsumedQuantity @xsd(name: "EstimatedConsumedQuantity")
  /// BBIE
  /// On Account Payment. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// On Account Payment
  /// Note
  /// Text
  /// Text. Type
  /// We make a reservation for price regulations. You will receive you next yearly statement about one year from today.
  note                        ubl_common_basic_components_2_1.Note[]                    @xsd(name: "Note")
  /// ASBIE
  /// On Account Payment. Payment Terms
  /// A specification of payment terms associated with this payment.
  /// 1..n
  /// On Account Payment
  /// Payment Terms
  /// Payment Terms
  /// Payment Terms
  payment_terms               PaymentTerms[]                                            { minItems 1 } @xsd(name: "PaymentTerms")
}

/// ABIE
/// Order Line. Details
/// A class to define a line in an order document (e.g., Order, Order Change, or Order Response) describing an item being ordered.
/// Order Line
model OrderLine {
  /// BBIE
  /// Order Line. Substitution Status Code. Code
  /// A code signifying the substitution status of the item on this order line. The order line may indicate that the substitute is proposed by the buyer (in Order) or by the seller (in Order Response) or that a substitution has been made by the seller (in Order Response).
  /// 0..1
  /// Order Line
  /// Substitution Status Code
  /// Code
  /// Substitution Status
  /// Substitution Status_ Code. Type
  substitution_status_code             ubl_common_basic_components_2_1.SubstitutionStatusCode? @xsd(name: "SubstitutionStatusCode")
  /// BBIE
  /// Order Line. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Order Line
  /// Note
  /// Text
  /// Text. Type
  note                                 ubl_common_basic_components_2_1.Note[]                  @xsd(name: "Note")
  /// ASBIE
  /// Order Line. Line Item
  /// The line item itself.
  /// 1
  /// Order Line
  /// Line Item
  /// Line Item
  /// Line Item
  line_item                            LineItem                                                @xsd(name: "LineItem")
  /// ASBIE
  /// Order Line. Seller Proposed Substitute_ Line Item. Line Item
  /// In Order Response, a line item proposed by the seller describing a product that might substitute for the product described in this order line.
  /// 0..n
  /// Order Line
  /// Seller Proposed Substitute
  /// Line Item
  /// Line Item
  /// Line Item
  seller_proposed_substitute_line_item LineItem[]                                              @xsd(name: "SellerProposedSubstituteLineItem")
  /// ASBIE
  /// Order Line. Seller Substituted_ Line Item. Line Item
  /// In Order Response, a line item that has replaced the original order line item. The specified quantity and pricing may differ from those in the original line item, but when a line item is substituted by the seller, it is assumed that other information, such as shipment details, will remain the same.
  /// 0..n
  /// Order Line
  /// Seller Substituted
  /// Line Item
  /// Line Item
  /// Line Item
  seller_substituted_line_item         LineItem[]                                              @xsd(name: "SellerSubstitutedLineItem")
  /// ASBIE
  /// Order Line. Buyer Proposed Substitute_ Line Item. Line Item
  /// A description of an item proposed by the buyer as a possible alternative to the item associated with this order line.
  /// 0..n
  /// Order Line
  /// Buyer Proposed Substitute
  /// Line Item
  /// Line Item
  /// Line Item
  buyer_proposed_substitute_line_item  LineItem[]                                              @xsd(name: "BuyerProposedSubstituteLineItem")
  /// ASBIE
  /// Order Line. Catalogue_ Line Reference. Line Reference
  /// A reference to a catalogue line associated with this order line.
  /// 0..1
  /// Order Line
  /// Catalogue
  /// Line Reference
  /// Line Reference
  /// Line Reference
  catalogue_line_reference             LineReference?                                          @xsd(name: "CatalogueLineReference")
  /// ASBIE
  /// Order Line. Quotation_ Line Reference. Line Reference
  /// A reference to a quotation line associated with this order line.
  /// 0..1
  /// Order Line
  /// Quotation
  /// Line Reference
  /// Line Reference
  /// Line Reference
  quotation_line_reference             LineReference?                                          @xsd(name: "QuotationLineReference")
  /// ASBIE
  /// Order Line. Order Line Reference
  /// A reference to another order line, such as in a replacement order or another line on the same order that is related.
  /// 0..n
  /// Order Line
  /// Order Line Reference
  /// Order Line Reference
  /// Order Line Reference
  order_line_reference                 OrderLineReference[]                                    @xsd(name: "OrderLineReference")
  /// ASBIE
  /// Order Line. Document Reference
  /// A reference to a document associated with this order line.
  /// 0..n
  /// Order Line
  /// Document Reference
  /// Document Reference
  /// Document Reference
  document_reference                   DocumentReference[]                                     @xsd(name: "DocumentReference")

  @@xsd(name: "OrderLine")
}

/// ABIE
/// Order Line Reference. Details
/// A class to define a reference to an order line.
/// Order Line Reference
model OrderLineReference {
  /// BBIE
  /// Order Line Reference. Line Identifier. Identifier
  /// An identifier for the referenced order line, assigned by the buyer.
  /// 1
  /// Order Line Reference
  /// Line Identifier
  /// Identifier
  /// Identifier. Type
  line_id             ubl_common_basic_components_2_1.LineID            @xsd(name: "LineID")
  /// BBIE
  /// Order Line Reference. Sales Order_ Line Identifier. Identifier
  /// An identifier for the referenced order line, assigned by the seller.
  /// 0..1
  /// Order Line Reference
  /// Sales Order
  /// Line Identifier
  /// Identifier
  /// Identifier. Type
  sales_order_line_id ubl_common_basic_components_2_1.SalesOrderLineID? @xsd(name: "SalesOrderLineID")
  /// BBIE
  /// Order Line Reference. UUID. Identifier
  /// A universally unique identifier for this order line reference.
  /// 0..1
  /// Order Line Reference
  /// UUID
  /// Identifier
  /// Identifier. Type
  uuid                ubl_common_basic_components_2_1.UUID?             @xsd(name: "UUID")
  /// BBIE
  /// Order Line Reference. Line Status Code. Code
  /// A code signifying the status of the referenced order line with respect to its original state.
  /// 0..1
  /// Order Line Reference
  /// Line Status Code
  /// Code
  /// Line Status
  /// Line Status_ Code. Type
  line_status_code    ubl_common_basic_components_2_1.LineStatusCode?   @xsd(name: "LineStatusCode")
  /// ASBIE
  /// Order Line Reference. Order Reference
  /// A reference to the Order containing the referenced order line.
  /// 0..1
  /// Order Line Reference
  /// Order Reference
  /// Order Reference
  /// Order Reference
  order_reference     OrderReference?                                   @xsd(name: "OrderReference")

  @@xsd(name: "OrderLineReference")
}

/// ABIE
/// Order Reference. Details
/// A class to define a reference to an Order.
/// Order Reference
model OrderReference {
  /// BBIE
  /// Order Reference. Identifier
  /// An identifier for this order reference, assigned by the buyer.
  /// 1
  /// Order Reference
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// PO-001 3333-44-123
  id                 ubl_common_basic_components_2_1.ID                 @xsd(name: "ID")
  /// BBIE
  /// Order Reference. Sales_ Order Identifier. Identifier
  /// An identifier for this order reference, assigned by the seller.
  /// 0..1
  /// Order Reference
  /// Sales
  /// Order Identifier
  /// Identifier
  /// Identifier. Type
  sales_order_id     ubl_common_basic_components_2_1.SalesOrderID?      @xsd(name: "SalesOrderID")
  /// BBIE
  /// Order Reference. Copy_ Indicator. Indicator
  /// Indicates whether the referenced Order is a copy (true) or the original (false).
  /// 0..1
  /// Order Reference
  /// Copy
  /// Indicator
  /// Indicator
  /// Indicator. Type
  copy_indicator     ubl_common_basic_components_2_1.CopyIndicator?     @xsd(name: "CopyIndicator")
  /// BBIE
  /// Order Reference. UUID. Identifier
  /// A universally unique identifier for this order reference.
  /// 0..1
  /// Order Reference
  /// UUID
  /// Identifier
  /// Identifier. Type
  uuid               ubl_common_basic_components_2_1.UUID?              @xsd(name: "UUID")
