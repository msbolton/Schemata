  /// 0..1
  /// Hazardous Item
  /// Quantity
  /// Quantity
  /// Quantity. Type
  @xsd(name = "Quantity") quantity:                       ubl_common_basic_components_2_1.Quantity?
  /// ASBIE
  /// Hazardous Item. Contact_ Party. Party
