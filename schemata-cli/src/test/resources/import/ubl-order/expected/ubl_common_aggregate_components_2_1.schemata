  /// 0..n
  /// Supplier Party
  /// Additional
  /// Account Identifier
  /// Identifier
  /// Identifier. Type
  additional_account_id        ubl_common_basic_components_2_1.AdditionalAccountID[]      @xsd(name: "AdditionalAccountID")
  /// BBIE
  /// Supplier Party. Data Sending Capability. Text
