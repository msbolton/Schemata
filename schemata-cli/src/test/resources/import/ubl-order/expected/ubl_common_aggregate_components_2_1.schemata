  /// 0..1
  /// Line Item
  /// Warranty Validity
  /// Period
  /// Period
  /// Period
  @xsd(name = "WarrantyValidityPeriod") warranty_validity_period:     Period?
  /// ASBIE
  /// Line Item. Warranty_ Party. Party
