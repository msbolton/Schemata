  /// Code. Type
  @xsd(name = "AdjustmentReasonCode") adjustment_reason_code:     ubl_common_basic_components_2_1.AdjustmentReasonCode?
  /// ASBIE
  /// Forecast Revision Line. Forecast_ Period. Period
  /// The period to which this forecast revision line applies.
  /// 0..1
  /// Forecast Revision Line
  /// Forecast
  /// Period
  /// Period
  /// Period
  @xsd(name = "ForecastPeriod") forecast_period:            Period?
  /// ASBIE
  /// Forecast Revision Line. Sales Item
  /// Sales information for the item to which this line applies.
  /// 0..1
  /// Forecast Revision Line
  /// Sales Item
  /// Sales Item
  /// Sales Item
  @xsd(name = "SalesItem") sales_item:                 SalesItem?
}

/// ABIE
/// Framework Agreement. Details
