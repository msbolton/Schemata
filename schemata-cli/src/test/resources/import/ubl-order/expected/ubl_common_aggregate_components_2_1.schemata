  /// Order Reference
  /// Sales
  /// Order Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "SalesOrderID") sales_order_id:     ubl_common_basic_components_2_1.SalesOrderID?
  /// BBIE
  /// Order Reference. Copy_ Indicator. Indicator
  /// Indicates whether the referenced Order is a copy (true) or the original (false).
  /// 0..1
  /// Order Reference
  /// Copy
  /// Indicator
  /// Indicator
  /// Indicator. Type
  @xsd(name = "CopyIndicator") copy_indicator:     ubl_common_basic_components_2_1.CopyIndicator?
  /// BBIE
  /// Order Reference. UUID. Identifier
  /// A universally unique identifier for this order reference.
  /// 0..1
  /// Order Reference
  /// UUID
  /// Identifier
  /// Identifier. Type
  @xsd(name = "UUID") uuid:               ubl_common_basic_components_2_1.UUID?
  /// BBIE
  /// Order Reference. Issue Date. Date
  /// The date on which the referenced Order was issued.
  /// 0..1
  /// Order Reference
  /// Issue Date
  /// Date
  /// Date. Type
  @xsd(name = "IssueDate") issue_date:         ubl_common_basic_components_2_1.IssueDate?
  /// BBIE
  /// Order Reference. Issue Time. Time
  /// The time at which the referenced Order was issued.
  /// 0..1
  /// Order Reference
  /// Issue Time
  /// Time
  /// Time. Type
  @xsd(name = "IssueTime") issue_time:         ubl_common_basic_components_2_1.IssueTime?
  /// BBIE
