  /// Utility Item
  /// Current
  /// Charge Type
  /// Text
  /// Text. Type
  current_charge_type       ubl_common_basic_components_2_1.CurrentChargeType?     @xsd(name: "CurrentChargeType")
  /// BBIE
  /// Utility Item. Current_ Charge Type Code. Code
