schema ubl_common_aggregate_components_2_1 @xsd(namespace: "urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2")

import ubl_common_basic_components_2_1

/// ABIE
/// Activity Data Line. Details
/// A class to associate a time period and locations (activity data) with an item for inventory planning purposes.
/// Activity Data Line
model ActivityDataLine {
  /// BBIE
  /// Activity Data Line. Identifier
  /// An identifier for this activity data line.
  /// 1
  /// Activity Data Line
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                              ubl_common_basic_components_2_1.ID                          @xsd(name: "ID")
  /// BBIE
  /// Activity Data Line. Supply Chain Activity Type Code. Code
  /// A code signifying the type of supply chain activity.
  /// 1
  /// Activity Data Line
  /// Supply Chain Activity Type Code
  /// Code
  /// Code. Type
  supply_chain_activity_type_code ubl_common_basic_components_2_1.SupplyChainActivityTypeCode @xsd(name: "SupplyChainActivityTypeCode")
  /// ASBIE
  /// Activity Data Line. Buyer_ Customer Party. Customer Party
  /// The buyer of the item.
  /// 0..1
  /// Activity Data Line
  /// Buyer
  /// Customer Party
  /// Customer Party
  /// Customer Party
  buyer_customer_party            CustomerParty?                                              @xsd(name: "BuyerCustomerParty")
  /// ASBIE
  /// Activity Data Line. Seller_ Supplier Party. Supplier Party
  /// The seller of the item.
  /// 0..1
  /// Activity Data Line
  /// Seller
  /// Supplier Party
  /// Supplier Party
  /// Supplier Party
  seller_supplier_party           SupplierParty?                                              @xsd(name: "SellerSupplierParty")
  /// ASBIE
  /// Activity Data Line. Activity_ Period. Period
  /// The period during which the activity is realized.
  /// 0..1
  /// Activity Data Line
  /// Activity
  /// Period
  /// Period
  /// Period
  activity_period                 Period?                                                     @xsd(name: "ActivityPeriod")
  /// ASBIE
  /// Activity Data Line. Activity Origin_ Location. Location
  /// Either the location where the movement of goods is observed or the location from which the goods are moved.
  /// 1
  /// Activity Data Line
  /// Activity Origin
  /// Location
  /// Location
  /// Location
  activity_origin_location        ubl_common_aggregate_components_2_1.Location                @xsd(name: "ActivityOriginLocation")
  /// ASBIE
  /// Activity Data Line. Activity Final_ Location. Location
  /// The location to which the goods are moved.
  /// 0..1
  /// Activity Data Line
  /// Activity Final
  /// Location
  /// Location
  /// Location
  activity_final_location         ubl_common_aggregate_components_2_1.Location?               @xsd(name: "ActivityFinalLocation")
  /// ASBIE
  /// Activity Data Line. Sales Item
  /// Sales information for an item to which this line applies.
  /// 1..n
  /// Activity Data Line
  /// Sales Item
  /// Sales Item
  /// Sales Item
  sales_item                      SalesItem[]                                                 { minItems 1 } @xsd(name: "SalesItem")

  @@xsd(name: "ActivityDataLine")
}

/// ABIE
/// Activity Property. Details
/// A class to define a name/value pair for a property of an inventory planning activity.
/// Activity Property
model ActivityProperty {
  /// BBIE
  /// Activity Property. Name
  /// The name of this activity property.
  /// 1
  /// Activity Property
  /// Name
  /// Name
  /// Name. Type
  name  ubl_common_basic_components_2_1.Name  @xsd(name: "Name")
  /// BBIE
  /// Activity Property. Value. Text
  /// The value of this activity property.
  /// 1
  /// Activity Property
  /// Value
  /// Text
  /// Text. Type
  value ubl_common_basic_components_2_1.Value @xsd(name: "Value")

  @@xsd(name: "ActivityProperty")
}

/// ABIE
/// Address. Details
/// A class to define common information related to an address.
/// Address
model Address {
  /// BBIE
  /// Address. Identifier
  /// An identifier for this address within an agreed scheme of address identifiers.
  /// 0..1
  /// Address
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// DetailsKey
  id                     ubl_common_basic_components_2_1.ID?                   @xsd(name: "ID")
  /// BBIE
  /// Address. Address Type Code. Code
  /// A mutually agreed code signifying the type of this address.
  /// 0..1
  /// Address
  /// Address Type Code
  /// Code
  /// Code. Type
  address_type_code      ubl_common_basic_components_2_1.AddressTypeCode?      @xsd(name: "AddressTypeCode")
  /// BBIE
  /// Address. Address Format Code. Code
  /// A mutually agreed code signifying the format of this address.
  /// 0..1
  /// Address
  /// Address Format Code
  /// Code
  /// Code. Type
  address_format_code    ubl_common_basic_components_2_1.AddressFormatCode?    @xsd(name: "AddressFormatCode")
  /// BBIE
  /// Address. Postbox. Text
  /// A post office box number registered for postal delivery by a postal service provider.
  /// 0..1
  /// Address
  /// Postbox
  /// Text
  /// Text. Type
  /// PostBox, PO Box
  /// 123
  postbox                ubl_common_basic_components_2_1.Postbox?              @xsd(name: "Postbox")
  /// BBIE
  /// Address. Floor. Text
  /// An identifiable floor of a building.
  /// 0..1
  /// Address
  /// Floor
  /// Text
  /// Text. Type
  /// SubPremiseNumber
  /// 30
  floor                  ubl_common_basic_components_2_1.Floor?                @xsd(name: "Floor")
  /// BBIE
  /// Address. Room. Text
  /// An identifiable room, suite, or apartment of a building.
  /// 0..1
  /// Address
  /// Room
  /// Text
  /// Text. Type
  /// SubPremiseNumber
  /// Reception
  room                   ubl_common_basic_components_2_1.Room?                 @xsd(name: "Room")
  /// BBIE
  /// Address. Street Name. Name
  /// The name of the street, road, avenue, way, etc. to which the number of the building is attached.
  /// 0..1
  /// Address
  /// Street Name
  /// Name
  /// Name. Type
  /// Thoroughfare
  /// Kwun Tong Road
  street_name            ubl_common_basic_components_2_1.StreetName?           @xsd(name: "StreetName")
  /// BBIE
  /// Address. Additional_ Street Name. Name
  /// An additional street name used to further clarify the address.
  /// 0..1
  /// Address
  /// Additional
  /// Street Name
  /// Name
  /// Name. Type
  /// Thoroughfare
  /// Cnr Aberdeen Road
  additional_street_name ubl_common_basic_components_2_1.AdditionalStreetName? @xsd(name: "AdditionalStreetName")
  /// BBIE
  /// Address. Block Name. Name
  /// The name of the block (an area surrounded by streets and usually containing several buildings) in which this address is located.
  /// 0..1
  /// Address
  /// Block Name
  /// Name
  /// Name. Type
  /// Seabird
  block_name             ubl_common_basic_components_2_1.BlockName?            @xsd(name: "BlockName")
  /// BBIE
  /// Address. Building Name. Name
  /// The name of a building.
  /// 0..1
  /// Address
  /// Building Name
  /// Name
  /// Name. Type
  /// BuildingName
  /// Plot 421
  building_name          ubl_common_basic_components_2_1.BuildingName?         @xsd(name: "BuildingName")
  /// BBIE
  /// Address. Building Number. Text
  /// The number of a building within the street.
  /// 0..1
  /// Address
  /// Building Number
  /// Text
  /// Text. Type
  /// PremiseNumber
  /// 388
  building_number        ubl_common_basic_components_2_1.BuildingNumber?       @xsd(name: "BuildingNumber")
  /// BBIE
  /// Address. Inhouse_ Mail. Text
  /// The specific identifable location within a building where mail is delivered.
  /// 0..1
  /// Address
  /// Inhouse
  /// Mail
  /// Text
  /// Text. Type
  /// MailStop
  inhouse_mail           ubl_common_basic_components_2_1.InhouseMail?          @xsd(name: "InhouseMail")
  /// BBIE
  /// Address. Department. Text
  /// The department of the addressee.
  /// 0..1
  /// Address
  /// Department
  /// Text
  /// Text. Type
  /// Department
  /// Accounts Payable
  department             ubl_common_basic_components_2_1.Department?           @xsd(name: "Department")
  /// BBIE
  /// Address. Mark Attention. Text
  /// The name, expressed as text, of a person or department in an organization to whose attention incoming mail is directed; corresponds to the printed forms "for the attention of", "FAO", and ATTN:".
  /// 0..1
  /// Address
  /// Mark Attention
  /// Text
  /// Text. Type
  mark_attention         ubl_common_basic_components_2_1.MarkAttention?        @xsd(name: "MarkAttention")
  /// BBIE
  /// Address. Mark Care. Text
  /// The name, expressed as text, of a person or organization at this address into whose care incoming mail is entrusted; corresponds to the printed forms "care of" and "c/o".
  /// 0..1
  /// Address
  /// Mark Care
  /// Text
  /// Text. Type
  mark_care              ubl_common_basic_components_2_1.MarkCare?             @xsd(name: "MarkCare")
  /// BBIE
  /// Address. Plot Identification. Text
  /// An identifier (e.g., a parcel number) for the piece of land associated with this address.
  /// 0..1
  /// Address
  /// Plot Identification
  /// Text
  /// Text. Type
  plot_identification    ubl_common_basic_components_2_1.PlotIdentification?   @xsd(name: "PlotIdentification")
  /// BBIE
  /// Address. City Subdivision Name. Name
  /// The name of the subdivision of a city, town, or village in which this address is located, such as the name of its district or borough.
  /// 0..1
  /// Address
  /// City Subdivision Name
  /// Name
  /// Name. Type
  city_subdivision_name  ubl_common_basic_components_2_1.CitySubdivisionName?  @xsd(name: "CitySubdivisionName")
  /// BBIE
  /// Address. City Name. Name
  /// The name of a city, town, or village.
  /// 0..1
  /// Address
  /// City Name
  /// Name
  /// Name. Type
  /// LocalityName
  /// Hong Kong
  city_name              ubl_common_basic_components_2_1.CityName?             @xsd(name: "CityName")
  /// BBIE
  /// Address. Postal_ Zone. Text
  /// The postal identifier for this address according to the relevant national postal service, such as a ZIP code or Post Code.
  /// 0..1
  /// Address
  /// Postal
  /// Zone
  /// Text
  /// Text. Type
  /// PostalCodeNumber
  /// SW11 4EW 2500 GG
  postal_zone            ubl_common_basic_components_2_1.PostalZone?           @xsd(name: "PostalZone")
  /// BBIE
  /// Address. Country Subentity. Text
  /// The political or administrative division of a country in which this address is located, such as the name of its county, province, or state, expressed as text.
  /// 0..1
  /// Address
  /// Country Subentity
  /// Text
  /// Text. Type
  /// AdministrativeArea, State, Country, Shire, Canton
  /// Florida , Tamilnadu
  country_subentity      ubl_common_basic_components_2_1.CountrySubentity?     @xsd(name: "CountrySubentity")
  /// BBIE
  /// Address. Country Subentity Code. Code
  /// The political or administrative division of a country in which this address is located, such as a county, province, or state, expressed as a code (typically nationally agreed).
  /// 0..1
  /// Address
  /// Country Subentity Code
  /// Code
  /// Code. Type
  /// AdministrativeAreaCode, State Code
  country_subentity_code ubl_common_basic_components_2_1.CountrySubentityCode? @xsd(name: "CountrySubentityCode")
  /// BBIE
  /// Address. Region. Text
  /// The recognized geographic or economic region or group of countries in which this address is located.
  /// 0..1
  /// Address
  /// Region
  /// Text
  /// Text. Type
  /// LocalityName, Economic Zone
  /// European Union
  region                 ubl_common_basic_components_2_1.Region?               @xsd(name: "Region")
  /// BBIE
  /// Address. District. Text
  /// The district or geographical division of a country or region in which this address is located.
  /// 0..1
  /// Address
  /// District
  /// Text
  /// Text. Type
  /// LocalityName, Area
  /// East Coast
  district               ubl_common_basic_components_2_1.District?             @xsd(name: "District")
  /// BBIE
  /// Address. Timezone Offset. Text
  /// The time zone in which this address is located (as an offset from Universal Coordinated Time (UTC)) at the time of exchange.
  /// 0..1
  /// Address
  /// Timezone Offset
  /// Text
  /// Text. Type
  /// +8:00 -3:00
  timezone_offset        ubl_common_basic_components_2_1.TimezoneOffset?       @xsd(name: "TimezoneOffset")
  /// ASBIE
  /// Address. Address Line
  /// An unstructured address line.
  /// 0..n
  /// Address
  /// Address Line
  /// Address Line
  /// Address Line
  address_line           AddressLine[]                                         @xsd(name: "AddressLine")
  /// ASBIE
  /// Address. Country
  /// The country in which this address is situated.
  /// 0..1
  /// Address
  /// Country
  /// Country
  /// Country
  country                Country?                                              @xsd(name: "Country")
  /// ASBIE
  /// Address. Location Coordinate
  /// The geographical coordinates of this address.
  /// 0..n
  /// Address
  /// Location Coordinate
  /// Location Coordinate
  /// Location Coordinate
  location_coordinate    LocationCoordinate[]                                  @xsd(name: "LocationCoordinate")

  @@xsd(name: "Address")
}

/// ABIE
/// Address Line. Details
/// A class to define an unstructured address line.
/// Address Line
model AddressLine {
  /// BBIE
  /// Address Line. Line. Text
  /// An address line expressed as unstructured text.
  /// 1
  /// Address Line
  /// Line
  /// Text
  /// Text. Type
  /// 123 Standard Chartered Tower
  line ubl_common_basic_components_2_1.Line @xsd(name: "Line")

  @@xsd(name: "AddressLine")
}

/// ABIE
/// Air Transport. Details
/// A class to identify a specific aircraft used for transportation.
/// Air Transport
model AirTransport {
  /// BBIE
  /// Air Transport. Aircraft Identifier. Identifier
  /// An identifer for a specific aircraft.
  /// 1
  /// Air Transport
  /// Aircraft Identifier
  /// Identifier
  /// Identifier. Type
  aircraft_id ubl_common_basic_components_2_1.AircraftID @xsd(name: "AircraftID")

  @@xsd(name: "AirTransport")
}

/// ABIE
/// Allowance Charge. Details
/// A class to describe information about a charge or discount as applied to a price component.
/// Allowance Charge
model AllowanceCharge {
  /// BBIE
  /// Allowance Charge. Identifier
  /// An identifier for this allowance or charge.
  /// 0..1
  /// Allowance Charge
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                           ubl_common_basic_components_2_1.ID?                        @xsd(name: "ID")
  /// BBIE
  /// Allowance Charge. Charge_ Indicator. Indicator
  /// An indicator that this AllowanceCharge describes a charge (true) or a discount (false).
  /// 1
  /// Allowance Charge
  /// Charge
  /// Indicator
  /// Indicator
  /// Indicator. Type
  charge_indicator             ubl_common_basic_components_2_1.ChargeIndicator            @xsd(name: "ChargeIndicator")
  /// BBIE
  /// Allowance Charge. Allowance Charge Reason Code. Code
  /// A mutually agreed code signifying the reason for this allowance or charge.
  /// 0..1
  /// Allowance Charge
  /// Allowance Charge Reason Code
  /// Code
  /// Allowance Charge Reason
  /// Allowance Charge Reason_ Code. Type
  allowance_charge_reason_code ubl_common_basic_components_2_1.AllowanceChargeReasonCode? @xsd(name: "AllowanceChargeReasonCode")
  /// BBIE
  /// Allowance Charge. Allowance Charge_ Reason. Text
  /// The reason for this allowance or charge.
  /// 0..n
  /// Allowance Charge
  /// Allowance Charge
  /// Reason
  /// Text
  /// Text. Type
  allowance_charge_reason      ubl_common_basic_components_2_1.AllowanceChargeReason[]    @xsd(name: "AllowanceChargeReason")
  /// BBIE
  /// Allowance Charge. Multiplier_ Factor. Numeric
  /// A number by which the base amount is multiplied to calculate the actual amount of this allowance or charge.
  /// 0..1
  /// Allowance Charge
  /// Multiplier
  /// Factor
  /// Numeric
  /// Numeric. Type
  /// 0.20
  multiplier_factor_numeric    ubl_common_basic_components_2_1.MultiplierFactorNumeric?   @xsd(name: "MultiplierFactorNumeric")
  /// BBIE
  /// Allowance Charge. Prepaid_ Indicator. Indicator
  /// An indicator that this allowance or charge is prepaid (true) or not (false).
  /// 0..1
  /// Allowance Charge
  /// Prepaid
  /// Indicator
  /// Indicator
  /// Indicator. Type
  prepaid_indicator            ubl_common_basic_components_2_1.PrepaidIndicator?          @xsd(name: "PrepaidIndicator")
  /// BBIE
  /// Allowance Charge. Sequence. Numeric
  /// A number indicating the order of this allowance or charge in the sequence of calculations applied when there are multiple allowances or charges.
  /// 0..1
  /// Allowance Charge
  /// Sequence
  /// Numeric
  /// Numeric. Type
  /// 1, 2, 3, 4, etc.
  sequence_numeric             ubl_common_basic_components_2_1.SequenceNumeric?           @xsd(name: "SequenceNumeric")
  /// BBIE
  /// Allowance Charge. Amount
  /// The monetary amount of this allowance or charge to be applied.
  /// 1
  /// Allowance Charge
  /// Amount
  /// Amount
  /// Amount. Type
  /// 35,23
  amount                       ubl_common_basic_components_2_1.Amount                     @xsd(name: "Amount")
  /// BBIE
  /// Allowance Charge. Base_ Amount. Amount
  /// The monetary amount to which the multiplier factor is applied in calculating the amount of this allowance or charge.
  /// 0..1
  /// Allowance Charge
  /// Base
  /// Amount
  /// Amount
  /// Amount. Type
  base_amount                  ubl_common_basic_components_2_1.BaseAmount?                @xsd(name: "BaseAmount")
  /// BBIE
  /// Allowance Charge. Accounting Cost Code. Code
  /// The accounting cost centre used by the buyer to account for this allowance or charge, expressed as a code.
  /// 0..1
  /// Allowance Charge
  /// Accounting Cost Code
  /// Code
  /// Code. Type
  accounting_cost_code         ubl_common_basic_components_2_1.AccountingCostCode?        @xsd(name: "AccountingCostCode")
  /// BBIE
  /// Allowance Charge. Accounting Cost. Text
  /// The accounting cost centre used by the buyer to account for this allowance or charge, expressed as text.
  /// 0..1
  /// Allowance Charge
  /// Accounting Cost
  /// Text
  /// Text. Type
  accounting_cost              ubl_common_basic_components_2_1.AccountingCost?            @xsd(name: "AccountingCost")
  /// BBIE
  /// Allowance Charge. Per Unit_ Amount. Amount
  /// The allowance or charge per item; the total allowance or charge is calculated by multiplying the per unit amount by the quantity of items, either at the level of the individual transaction line or for the total number of items in the document, depending on the context in which it appears.
  /// 0..1
  /// Allowance Charge
  /// Per Unit
  /// Amount
  /// Amount
  /// Amount. Type
  per_unit_amount              ubl_common_basic_components_2_1.PerUnitAmount?             @xsd(name: "PerUnitAmount")
  /// ASBIE
  /// Allowance Charge. Tax Category
  /// A tax category applicable to this allowance or charge.
  /// 0..n
  /// Allowance Charge
  /// Tax Category
  /// Tax Category
  /// Tax Category
  tax_category                 TaxCategory[]                                              @xsd(name: "TaxCategory")
  /// ASBIE
  /// Allowance Charge. Tax Total
  /// The total of all the taxes applicable to this allowance or charge.
  /// 0..1
  /// Allowance Charge
  /// Tax Total
  /// Tax Total
  /// Tax Total
  tax_total                    TaxTotal?                                                  @xsd(name: "TaxTotal")
  /// ASBIE
  /// Allowance Charge. Payment Means
  /// A means of payment for this allowance or charge.
  /// 0..n
  /// Allowance Charge
  /// Payment Means
  /// Payment Means
  /// Payment Means
  payment_means                PaymentMeans[]                                             @xsd(name: "PaymentMeans")

  @@xsd(name: "AllowanceCharge")
}

/// ABIE
/// Appeal Terms. Details
/// A class to describe the terms and conditions, set by the contracting authority, under which an appeal can be lodged for a tender award.
/// Appeal Terms
model AppealTerms {
  /// BBIE
  /// Appeal Terms. Description. Text
  /// Text describing the terms of an appeal.
  /// 0..n
  /// Appeal Terms
  /// Description
  /// Text
  /// Text. Type
  description              ubl_common_basic_components_2_1.Description[] @xsd(name: "Description")
  /// ASBIE
  /// Appeal Terms. Presentation_ Period. Period
  /// The period during which an appeal can be presented.
  /// 0..1
  /// Appeal Terms
  /// Presentation
  /// Period
  /// Period
  /// Period
  presentation_period      Period?                                       @xsd(name: "PresentationPeriod")
  /// ASBIE
  /// Appeal Terms. Appeal Information_ Party. Party
  /// The party presenting the information for an appeal.
  /// 0..1
  /// Appeal Terms
  /// Appeal Information
  /// Party
  /// Party
  /// Party
  appeal_information_party Party?                                        @xsd(name: "AppealInformationParty")
  /// ASBIE
  /// Appeal Terms. Appeal Receiver_ Party. Party
  /// The party to whom an appeal should be presented.
  /// 0..1
  /// Appeal Terms
  /// Appeal Receiver
  /// Party
  /// Party
  /// Party
  appeal_receiver_party    Party?                                        @xsd(name: "AppealReceiverParty")
  /// ASBIE
  /// Appeal Terms. Mediation_ Party. Party
  /// The party that has been appointed to mediate any appeal.
  /// 0..1
  /// Appeal Terms
  /// Mediation
  /// Party
  /// Party
  /// Party
  mediation_party          Party?                                        @xsd(name: "MediationParty")

  @@xsd(name: "AppealTerms")
}

/// ABIE
/// Attachment. Details
/// A class to describe an attached document. An attachment can refer to an external document or be included with the document being exchanged.
/// Attachment
model Attachment {
  /// BBIE
  /// Attachment. Embedded_ Document. Binary Object
  /// A binary large object containing an attached document.
  /// 0..1
  /// Attachment
  /// Embedded
  /// Document
  /// Binary Object
  /// Binary Object. Type
  embedded_document_binary_object ubl_common_basic_components_2_1.EmbeddedDocumentBinaryObject? @xsd(name: "EmbeddedDocumentBinaryObject")
  /// ASBIE
  /// Attachment. External Reference
  /// A reference to an attached document that is external to the document(s) being exchanged.
  /// 0..1
  /// Attachment
  /// External Reference
  /// External Reference
  /// External Reference
  external_reference              ExternalReference?                                            @xsd(name: "ExternalReference")

  @@xsd(name: "Attachment")
}

/// ABIE
/// Auction Terms. Details
/// A class to describe the terms to be fulfilled by tenderers if an auction is to be executed before the awarding of a tender.
/// Auction Terms
model AuctionTerms {
  /// BBIE
  /// Auction Terms. Auction_ Constraint. Indicator
  /// Indicates whether an electronic auction will be used before the awarding of a contract (true) or not (false).
  /// 0..1
  /// Auction Terms
  /// Auction
  /// Constraint
  /// Indicator
  /// Indicator. Type
  auction_constraint_indicator  ubl_common_basic_components_2_1.AuctionConstraintIndicator?   @xsd(name: "AuctionConstraintIndicator")
  /// BBIE
  /// Auction Terms. Justification_ Description. Text
  /// Text describing a justification for the use of an auction in awarding the tender.
  /// 0..n
  /// Auction Terms
  /// Justification
  /// Description
  /// Text
  /// Text. Type
  justification_description     ubl_common_basic_components_2_1.JustificationDescription[]    @xsd(name: "JustificationDescription")
  /// BBIE
  /// Auction Terms. Description. Text
  /// Text for tenderers describing terms governing the auction.
  /// 0..n
  /// Auction Terms
  /// Description
  /// Text
  /// Text. Type
  description                   ubl_common_basic_components_2_1.Description[]                 @xsd(name: "Description")
  /// BBIE
  /// Auction Terms. Process_ Description. Text
  /// Text describing the auction process.
  /// 0..n
  /// Auction Terms
  /// Process
  /// Description
  /// Text
  /// Text. Type
  process_description           ubl_common_basic_components_2_1.ProcessDescription[]          @xsd(name: "ProcessDescription")
  /// BBIE
  /// Auction Terms. Conditions_ Description. Text
  /// Text describing the conditions under which the tenderers will be able to bid as part of the auction.
  /// 0..n
  /// Auction Terms
  /// Conditions
  /// Description
  /// Text
  /// Text. Type
  conditions_description        ubl_common_basic_components_2_1.ConditionsDescription[]       @xsd(name: "ConditionsDescription")
  /// BBIE
  /// Auction Terms. Electronic Device_ Description. Text
  /// Text describing an electronic device used for the auction, including associated connectivity specifications.
  /// 0..n
  /// Auction Terms
  /// Electronic Device
  /// Description
  /// Text
  /// Text. Type
  electronic_device_description ubl_common_basic_components_2_1.ElectronicDeviceDescription[] @xsd(name: "ElectronicDeviceDescription")
  /// BBIE
  /// Auction Terms. Auction_ URI. Identifier
  /// The Uniform Resource Identifier (URI) of the electronic device used for the auction.
  /// 0..1
  /// Auction Terms
  /// Auction
  /// URI
  /// Identifier
  /// Identifier. Type
  auction_uri                   ubl_common_basic_components_2_1.AuctionURI?                   @xsd(name: "AuctionURI")

  @@xsd(name: "AuctionTerms")
}

/// ABIE
/// Awarding Criterion. Details
/// A class to define a criterion from the contracting party that will be taken into account when awarding a contract. An awarding criterion can be objective, when it can be evaluated following a formula, or subjective, when human analysis is required.
/// Awarding Criterion
model AwardingCriterion {
  /// BBIE
  /// Awarding Criterion. Identifier
  /// Identifies a specific awarding criterion.
  /// 0..1
  /// Awarding Criterion
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                             ubl_common_basic_components_2_1.ID?                        @xsd(name: "ID")
  /// BBIE
  /// Awarding Criterion. Awarding Criterion Type Code. Code
  /// A code used to define this awarding criterion.
  /// 0..1
  /// Awarding Criterion
  /// Awarding Criterion Type Code
  /// Code
  /// Code. Type
  awarding_criterion_type_code   ubl_common_basic_components_2_1.AwardingCriterionTypeCode? @xsd(name: "AwardingCriterionTypeCode")
  /// BBIE
  /// Awarding Criterion. Description. Text
  /// A description of the awarding criterion.
  /// 0..n
  /// Awarding Criterion
  /// Description
  /// Text
  /// Text. Type
  description                    ubl_common_basic_components_2_1.Description[]              @xsd(name: "Description")
  /// BBIE
  /// Awarding Criterion. Weight Numeric. Numeric
  /// A number defining the comparative weighting assigned to this awarding criterion, to enable formulaic evaluation.
  /// 0..1
  /// Awarding Criterion
  /// Weight Numeric
  /// Numeric
  /// Numeric. Type
  weight_numeric                 ubl_common_basic_components_2_1.WeightNumeric?             @xsd(name: "WeightNumeric")
  /// BBIE
  /// Awarding Criterion. Weight. Text
  /// A description of the comparative weighting for this awarding criterion.
  /// 0..n
  /// Awarding Criterion
  /// Weight
  /// Text
  /// Text. Type
  weight                         ubl_common_basic_components_2_1.Weight[]                   @xsd(name: "Weight")
  /// BBIE
  /// Awarding Criterion. Calculation Expression. Text
  /// The mathematical expression that will be used to evaluate this criterion.
  /// 0..n
  /// Awarding Criterion
  /// Calculation Expression
  /// Text
  /// Text. Type
  calculation_expression         ubl_common_basic_components_2_1.CalculationExpression[]    @xsd(name: "CalculationExpression")
  /// BBIE
  /// Awarding Criterion. Calculation Expression Code. Code
  /// A code identifying the mathematical expression that will be used to evaluate this criterion.
  /// 0..1
  /// Awarding Criterion
  /// Calculation Expression Code
  /// Code
  /// Code. Type
  calculation_expression_code    ubl_common_basic_components_2_1.CalculationExpressionCode? @xsd(name: "CalculationExpressionCode")
  /// BBIE
  /// Awarding Criterion. Minimum_ Quantity. Quantity
  /// The minimum quantity for an awarding criterion.
  /// 0..1
  /// Awarding Criterion
  /// Minimum
  /// Quantity
  /// Quantity
  /// Quantity. Type
  minimum_quantity               ubl_common_basic_components_2_1.MinimumQuantity?           @xsd(name: "MinimumQuantity")
  /// BBIE
  /// Awarding Criterion. Maximum_ Quantity. Quantity
  /// The maximum quantity for an awarding criterion.
  /// 0..1
  /// Awarding Criterion
  /// Maximum
  /// Quantity
  /// Quantity
  /// Quantity. Type
  maximum_quantity               ubl_common_basic_components_2_1.MaximumQuantity?           @xsd(name: "MaximumQuantity")
  /// BBIE
  /// Awarding Criterion. Minimum_ Amount. Amount
  /// The minimum monetary amount for an awarding criterion.
  /// 0..1
  /// Awarding Criterion
  /// Minimum
  /// Amount
  /// Amount
  /// Amount. Type
  minimum_amount                 ubl_common_basic_components_2_1.MinimumAmount?             @xsd(name: "MinimumAmount")
  /// BBIE
  /// Awarding Criterion. Maximum_ Amount. Amount
  /// The maximum monetary amount for an awarding criterion.
  /// 0..1
  /// Awarding Criterion
  /// Maximum
  /// Amount
  /// Amount
  /// Amount. Type
  maximum_amount                 ubl_common_basic_components_2_1.MaximumAmount?             @xsd(name: "MaximumAmount")
  /// BBIE
  /// Awarding Criterion. Minimum Improvement Bid. Text
  /// Describes the minimum improvement bid for this awarding criterion when used in an auction.
  /// 0..n
  /// Awarding Criterion
  /// Minimum Improvement Bid
  /// Text
  /// Text. Type
  minimum_improvement_bid        ubl_common_basic_components_2_1.MinimumImprovementBid[]    @xsd(name: "MinimumImprovementBid")
  /// ASBIE
  /// Awarding Criterion. Subordinate_ Awarding Criterion. Awarding Criterion
  /// Defines any subsidiary awarding criterion.
  /// 0..n
  /// Awarding Criterion
  /// Subordinate
  /// Awarding Criterion
  /// Awarding Criterion
  /// Awarding Criterion
  subordinate_awarding_criterion AwardingCriterion[]                                        @xsd(name: "SubordinateAwardingCriterion")

  @@xsd(name: "AwardingCriterion")
}

/// ABIE
/// Awarding Criterion Response. Details
/// Defines the response for an awarding criterion from the tendering party.
/// Awarding Criterion Response
model AwardingCriterionResponse {
  /// BBIE
  /// Awarding Criterion Response. Identifier
  /// An identification of this awarding criterion response.
  /// 0..1
  /// Awarding Criterion Response
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                                      ubl_common_basic_components_2_1.ID?                            @xsd(name: "ID")
  /// BBIE
  /// Awarding Criterion Response. Awarding Criterion Identifier. Identifier
  /// An identifer of the awarding criterion being referred to.
  /// 0..1
  /// Awarding Criterion Response
  /// Awarding Criterion Identifier
  /// Identifier
  /// Identifier. Type
  awarding_criterion_id                   ubl_common_basic_components_2_1.AwardingCriterionID?           @xsd(name: "AwardingCriterionID")
  /// BBIE
  /// Awarding Criterion Response. Awarding Criterion_ Description. Text
  /// Describes the awarding criterion.
  /// 0..n
  /// Awarding Criterion Response
  /// Awarding Criterion
  /// Description
  /// Text
  /// Text. Type
  awarding_criterion_description          ubl_common_basic_components_2_1.AwardingCriterionDescription[] @xsd(name: "AwardingCriterionDescription")
  /// BBIE
  /// Awarding Criterion Response. Description. Text
  /// Describes the awarding criterion response.
  /// 0..n
  /// Awarding Criterion Response
  /// Description
  /// Text
  /// Text. Type
  description                             ubl_common_basic_components_2_1.Description[]                  @xsd(name: "Description")
  /// BBIE
  /// Awarding Criterion Response. Quantity
  /// Specifies the quantity tendered for this awarding criterion.
  /// 0..1
  /// Awarding Criterion Response
  /// Quantity
  /// Quantity
  /// Quantity. Type
  quantity                                ubl_common_basic_components_2_1.Quantity?                      @xsd(name: "Quantity")
  /// BBIE
  /// Awarding Criterion Response. Amount
  /// Specifies the monetary amount tendered for this awarding criterion.
  /// 0..1
  /// Awarding Criterion Response
  /// Amount
  /// Amount
  /// Amount. Type
  amount                                  ubl_common_basic_components_2_1.Amount?                        @xsd(name: "Amount")
  /// ASBIE
  /// Awarding Criterion Response. Subordinate_ Awarding Criterion Response. Awarding Criterion Response
  /// Defines responses to any subsidiary awarding criterion.
  /// 0..n
  /// Awarding Criterion Response
  /// Subordinate
  /// Awarding Criterion Response
  /// Awarding Criterion Response
  /// Awarding Criterion Response
  subordinate_awarding_criterion_response AwardingCriterionResponse[]                                    @xsd(name: "SubordinateAwardingCriterionResponse")

  @@xsd(name: "AwardingCriterionResponse")
}

/// ABIE
/// Awarding Terms. Details
/// A class to define the terms for awarding a contract.
/// Awarding Terms
model AwardingTerms {
  /// BBIE
  /// Awarding Terms. Weighting Algorithm Code. Code
  /// A code signifying the weighting algorithm for awarding criteria. When multiple awarding criteria is used, different weighting and choices management algorithms based upon scores and weights of all award criteria can be used. An algorithm for weighting criteria shall be reported in the call for tenders document. It is used to determine how to perform the final management of tenders based on the results in each of the established award criteria
  /// 0..1
  /// Awarding Terms
  /// Weighting Algorithm Code
  /// Code
  /// Code. Type
  weighting_algorithm_code        ubl_common_basic_components_2_1.WeightingAlgorithmCode?         @xsd(name: "WeightingAlgorithmCode")
  /// BBIE
  /// Awarding Terms. Description. Text
  /// Text describing terms under which the contract is to be awarded.
  /// 0..n
  /// Awarding Terms
  /// Description
  /// Text
  /// Text. Type
  description                     ubl_common_basic_components_2_1.Description[]                   @xsd(name: "Description")
  /// BBIE
  /// Awarding Terms. Technical Committee_ Description. Text
  /// Text describing the committee of experts evaluating the subjective criteria for awarding the contract.
  /// 0..n
  /// Awarding Terms
  /// Technical Committee
  /// Description
  /// Text
  /// Text. Type
  technical_committee_description ubl_common_basic_components_2_1.TechnicalCommitteeDescription[] @xsd(name: "TechnicalCommitteeDescription")
  /// BBIE
  /// Awarding Terms. Low Tenders_ Description. Text
  /// Text describing the exclusion criterion for abnormally low tenders.
  /// 0..n
  /// Awarding Terms
  /// Low Tenders
  /// Description
  /// Text
  /// Text. Type
  low_tenders_description         ubl_common_basic_components_2_1.LowTendersDescription[]         @xsd(name: "LowTendersDescription")
  /// BBIE
  /// Awarding Terms. Prize Indicator. Indicator
  /// Indicates whether a prize will be awarded (true) or not (false).
  /// 0..1
  /// Awarding Terms
  /// Prize Indicator
  /// Indicator
  /// Indicator. Type
  prize_indicator                 ubl_common_basic_components_2_1.PrizeIndicator?                 @xsd(name: "PrizeIndicator")
  /// BBIE
  /// Awarding Terms. Prize Description. Text
  /// Number and value of the prizes to be awarded.
  /// 0..n
  /// Awarding Terms
  /// Prize Description
  /// Text
  /// Text. Type
  prize_description               ubl_common_basic_components_2_1.PrizeDescription[]              @xsd(name: "PrizeDescription")
  /// BBIE
  /// Awarding Terms. Payment Description. Text
  /// Details of payments to all participants.
  /// 0..n
  /// Awarding Terms
  /// Payment Description
  /// Text
  /// Text. Type
  payment_description             ubl_common_basic_components_2_1.PaymentDescription[]            @xsd(name: "PaymentDescription")
  /// BBIE
  /// Awarding Terms. Followup Contract Indicator. Indicator
  /// Indicates if any service contract following the contest will be awarded to the winner or one of the winners of the contest (true) or not (false).
  /// 0..1
  /// Awarding Terms
  /// Followup Contract Indicator
  /// Indicator
  /// Indicator. Type
  followup_contract_indicator     ubl_common_basic_components_2_1.FollowupContractIndicator?      @xsd(name: "FollowupContractIndicator")
  /// BBIE
  /// Awarding Terms. Binding On Buyer Indicator. Indicator
  /// Indicates if the decision is binding on the buyer (true) or not (false).
  /// 0..1
  /// Awarding Terms
  /// Binding On Buyer Indicator
  /// Indicator
  /// Indicator. Type
  binding_on_buyer_indicator      ubl_common_basic_components_2_1.BindingOnBuyerIndicator?        @xsd(name: "BindingOnBuyerIndicator")
  /// ASBIE
  /// Awarding Terms. Awarding Criterion
  /// Defines a criterion for awarding this tender.
  /// 0..n
  /// Awarding Terms
  /// Awarding Criterion
  /// Awarding Criterion
  /// Awarding Criterion
  awarding_criterion              AwardingCriterion[]                                             @xsd(name: "AwardingCriterion")
  /// ASBIE
  /// Awarding Terms. Technical Committee_ Person. Person
  /// A member of a committee of experts evaluating the subjective criteria for awarding the contract.
  /// 0..n
  /// Awarding Terms
  /// Technical Committee
  /// Person
  /// Person
  /// Person
  technical_committee_person      Person[]                                                        @xsd(name: "TechnicalCommitteePerson")

  @@xsd(name: "AwardingTerms")
}

/// ABIE
/// Billing Reference. Details
