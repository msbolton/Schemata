  /// Transportation Service
  /// Sequence
  /// Numeric
  /// Numeric. Type
  sequence_numeric                             ubl_common_basic_components_2_1.SequenceNumeric?                   @xsd(name: "SequenceNumeric")
  /// ASBIE
