  /// 0..1
  /// Utility Item
  /// Current
  /// Charge Type Code
  /// Code
  /// Code. Type
  current_charge_type_code  ubl_common_basic_components_2_1.CurrentChargeTypeCode? @xsd(name: "CurrentChargeTypeCode")
  /// BBIE
  /// Utility Item. One Time_ Charge Type. Text
  /// Information about the one-time payment type in case everything is paid One time
  /// 0..1
  /// Utility Item
  /// One Time
  /// Charge Type
  /// Text
  /// Text. Type
  one_time_charge_type      ubl_common_basic_components_2_1.OneTimeChargeType?     @xsd(name: "OneTimeChargeType")
  /// BBIE
  /// Utility Item. One Time_ Charge Type Code. Code
  /// Information about the one-time payment type code
  /// 0..1
  /// Utility Item
