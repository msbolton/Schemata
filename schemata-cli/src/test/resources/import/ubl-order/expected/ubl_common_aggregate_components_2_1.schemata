  issue_time                 ubl_common_basic_components_2_1.IssueTime?    @xsd(name: "IssueTime")
  /// BBIE
  /// Power Of Attorney. Description. Text
  /// Text describing this power of attorney.
  /// 0..n
  /// Power Of Attorney
  /// Description
  /// Text
  /// Text. Type
  description                ubl_common_basic_components_2_1.Description[] @xsd(name: "Description")
  /// ASBIE
  /// Power Of Attorney. Notary_ Party. Party
  /// The party notarizing this power of attorney.
  /// 0..1
  /// Power Of Attorney
  /// Notary
  /// Party
  /// Party
  /// Party
  notary_party               Party?                                        @xsd(name: "NotaryParty")
  /// ASBIE
  /// Power Of Attorney. Agent_ Party. Party
  /// The party who acts as an agent or fiduciary for the principal and who holds this power of attorney on behalf of the principal.
  /// 1
  /// Power Of Attorney
  /// Agent
  /// Party
  /// Party
  /// Party
  agent_party                Party                                         @xsd(name: "AgentParty")
  /// ASBIE
  /// Power Of Attorney. Witness_ Party. Party
  /// An association to a WitnessParty.
  /// 0..n
  /// Power Of Attorney
  /// Witness
  /// Party
  /// Party
  /// Party
  witness_party              Party[]                                       @xsd(name: "WitnessParty")
  /// ASBIE
  /// Power Of Attorney. Mandate_ Document Reference. Document Reference
  /// A reference to a mandate associated with this power of attorney.
  /// 0..n
  /// Power Of Attorney
  /// Mandate
  /// Document Reference
  /// Document Reference
  /// Document Reference
  mandate_document_reference DocumentReference[]                           @xsd(name: "MandateDocumentReference")

  @@xsd(name: "PowerOfAttorney")
}

/// ABIE
/// Price. Details
/// A class to describe a price, expressed in a data structure containing multiple properties (compare with UnstructuredPrice).
/// Price
model Price {
  /// BBIE
  /// Price. Price Amount. Amount
  /// The amount of the price.
  /// 1
  /// Price
  /// Price Amount
  /// Amount
  /// Amount. Type
  /// unit price
  /// 23.45
  price_amount               ubl_common_basic_components_2_1.PriceAmount              @xsd(name: "PriceAmount")
  /// BBIE
  /// Price. Base_ Quantity. Quantity
  /// The quantity at which this price applies.
  /// 0..1
  /// Price
  /// Base
  /// Quantity
  /// Quantity
  /// Quantity. Type
  base_quantity              ubl_common_basic_components_2_1.BaseQuantity?            @xsd(name: "BaseQuantity")
  /// BBIE
  /// Price. Price Change_ Reason. Text
  /// A reason for a price change.
  /// 0..n
  /// Price
  /// Price Change
  /// Reason
  /// Text
  /// Text. Type
  /// Clearance of old stock , New contract applies
  price_change_reason        ubl_common_basic_components_2_1.PriceChangeReason[]      @xsd(name: "PriceChangeReason")
  /// BBIE
  /// Price. Price Type Code. Code
  /// The type of price, expressed as a code.
  /// 0..1
  /// Price
  /// Price Type Code
  /// Code
  /// Code. Type
  price_type_code            ubl_common_basic_components_2_1.PriceTypeCode?           @xsd(name: "PriceTypeCode")
  /// BBIE
  /// Price. Price Type. Text
  /// The type of price, expressed as text.
  /// 0..1
  /// Price
  /// Price Type
  /// Text
  /// Text. Type
  /// retail, wholesale, discount, contract
  price_type                 ubl_common_basic_components_2_1.PriceType?               @xsd(name: "PriceType")
  /// BBIE
  /// Price. Orderable Unit Factor. Rate
  /// The factor by which the base price unit can be converted to the orderable unit.
  /// 0..1
  /// Price
  /// Orderable Unit Factor
  /// Rate
  /// Rate. Type
  /// Nails are priced by weight but ordered by quantity. So this would say how many nails per kilo
  orderable_unit_factor_rate ubl_common_basic_components_2_1.OrderableUnitFactorRate? @xsd(name: "OrderableUnitFactorRate")
  /// ASBIE
  /// Price. Validity_ Period. Period
  /// A period during which this price is valid.
  /// 0..n
  /// Price
  /// Validity
  /// Period
  /// Period
  /// Period
  validity_period            Period[]                                                 @xsd(name: "ValidityPeriod")
  /// ASBIE
  /// Price. Price List
  /// Information about a price list applicable to this price.
  /// 0..1
  /// Price
  /// Price List
  /// Price List
  /// Price List
  price_list                 PriceList?                                               @xsd(name: "PriceList")
  /// ASBIE
  /// Price. Allowance Charge
  /// An allowance or charge associated with this price.
  /// 0..n
  /// Price
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  allowance_charge           AllowanceCharge[]                                        @xsd(name: "AllowanceCharge")
  /// ASBIE
  /// Price. Pricing_ Exchange Rate. Exchange Rate
  /// The exchange rate applicable to this price, if it differs from the exchange rate applicable to the document as a whole.
  /// 0..1
  /// Price
  /// Pricing
  /// Exchange Rate
  /// Exchange Rate
  /// Exchange Rate
  pricing_exchange_rate      ExchangeRate?                                            @xsd(name: "PricingExchangeRate")
}

/// ABIE
/// Price Extension. Details
/// A class to describe a price extension, calculated by multiplying the price per unit by the quantity of items.
/// Price Extension
model PriceExtension {
  /// BBIE
  /// Price Extension. Amount
  /// The amount of this price extension.
  /// 1
  /// Price Extension
  /// Amount
  /// Amount
  /// Amount. Type
  amount    ubl_common_basic_components_2_1.Amount @xsd(name: "Amount")
  /// ASBIE
  /// Price Extension. Tax Total
  /// A total amount of taxes of a particular kind applicable to this price extension.
  /// 0..n
  /// Price Extension
  /// Tax Total
  /// Tax Total
  /// Tax Total
  tax_total TaxTotal[]                             @xsd(name: "TaxTotal")
}

/// ABIE
/// Price List. Details
/// A class to describe a price list.
/// Price List
model PriceList {
  /// BBIE
  /// Price List. Identifier
  /// An identifier for this price list.
  /// 0..1
  /// Price List
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                  ubl_common_basic_components_2_1.ID?         @xsd(name: "ID")
  /// BBIE
  /// Price List. Status Code. Code
  /// A code signifying whether this price list is an original, copy, revision, or cancellation.
  /// 0..1
  /// Price List
  /// Status Code
  /// Code
  /// Code. Type
  /// new - announcement only , new and available , deleted - announcement only
  status_code         ubl_common_basic_components_2_1.StatusCode? @xsd(name: "StatusCode")
  /// ASBIE
  /// Price List. Validity_ Period. Period
  /// A period during which this price list is valid.
  /// 0..n
  /// Price List
  /// Validity
  /// Period
  /// Period
  /// Period
  validity_period     Period[]                                    @xsd(name: "ValidityPeriod")
  /// ASBIE
  /// Price List. Previous_ Price List. Price List
  /// The previous price list.
  /// 0..1
  /// Price List
  /// Previous
  /// Price List
  /// Price List
  /// Price List
  previous_price_list PriceList?                                  @xsd(name: "PreviousPriceList")
}

/// ABIE
/// Pricing Reference. Details
/// A reference to the basis for pricing. This may be based on a catalogue or a quoted amount from a price list and include some alternative pricing conditions.
/// Pricing Reference
model PricingReference {
  /// ASBIE
  /// Pricing Reference. Original_ Item Location Quantity. Item Location Quantity
  /// An original set of location-specific properties (e.g., price and quantity) associated with this item.
  /// 0..1
  /// Pricing Reference
  /// Original
  /// Item Location Quantity
  /// Item Location Quantity
  /// Item Location Quantity
  original_item_location_quantity ItemLocationQuantity? @xsd(name: "OriginalItemLocationQuantity")
  /// ASBIE
  /// Pricing Reference. Alternative Condition_ Price. Price
  /// The price expressed in terms other than the actual price, e.g., the list price v. the contracted price, or the price in bags v. the price in kilos, or the list price in bags v. the contracted price in kilos.
  /// 0..n
  /// Pricing Reference
  /// Alternative Condition
  /// Price
  /// Price
  /// Price
  alternative_condition_price     Price[]               @xsd(name: "AlternativeConditionPrice")

  @@xsd(name: "PricingReference")
}

/// ABIE
/// Process Justification. Details
/// A class to describe a justification for the choice of tendering process.
/// Process Justification
model ProcessJustification {
  /// BBIE
  /// Process Justification. Previous_ Cancellation Reason Code. Code
  /// A code signifying the type of the previous tendering process (which is now being cancelled).
  /// 0..1
  /// Process Justification
  /// Previous
  /// Cancellation Reason Code
  /// Code
  /// Code. Type
  previous_cancellation_reason_code ubl_common_basic_components_2_1.PreviousCancellationReasonCode? @xsd(name: "PreviousCancellationReasonCode")
  /// BBIE
  /// Process Justification. Process_ Reason Code. Code
  /// The reason why the contracting authority has followed a particular tendering procedure for the awarding of a contract, expressed as a code.
  /// 0..1
  /// Process Justification
  /// Process
  /// Reason Code
  /// Code
  /// Code. Type
  process_reason_code               ubl_common_basic_components_2_1.ProcessReasonCode?              @xsd(name: "ProcessReasonCode")
  /// BBIE
  /// Process Justification. Process_ Reason. Text
  /// The reason why the contracting authority has followed a particular tendering procedure for the awarding of a contract, expressed as text.
  /// 0..n
  /// Process Justification
  /// Process
  /// Reason
  /// Text
  /// Text. Type
  process_reason                    ubl_common_basic_components_2_1.ProcessReason[]                 @xsd(name: "ProcessReason")
  /// BBIE
  /// Process Justification. Description. Text
  /// Text providing justification for the selection of this process.
  /// 0..n
  /// Process Justification
  /// Description
  /// Text
  /// Text. Type
  description                       ubl_common_basic_components_2_1.Description[]                   @xsd(name: "Description")

  @@xsd(name: "ProcessJustification")
}

/// ABIE
/// Procurement Project. Details
/// A class to describe a project to procure goods, works, or services.
/// Procurement Project
model ProcurementProject {
  /// BBIE
  /// Procurement Project. Identifier
  /// An identifier for this procurement project.
  /// 0..1
  /// Procurement Project
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                                  ubl_common_basic_components_2_1.ID?                               @xsd(name: "ID")
  /// BBIE
  /// Procurement Project. Name
  /// A name of this procurement project.
  /// 1..n
  /// Procurement Project
  /// Name
  /// Name
  /// Name. Type
  name                                ubl_common_basic_components_2_1.Name[]                            { minItems 1 } @xsd(name: "Name")
  /// BBIE
  /// Procurement Project. Description. Text
  /// Text describing this procurement project.
  /// 0..n
  /// Procurement Project
  /// Description
  /// Text
  /// Text. Type
  description                         ubl_common_basic_components_2_1.Description[]                     @xsd(name: "Description")
  /// BBIE
  /// Procurement Project. Procurement_ Type Code. Code
  /// A code signifying the type of procurement project (e.g., goods, works, services).
  /// 0..1
  /// Procurement Project
  /// Procurement
  /// Type Code
  /// Code
  /// Code. Type
  procurement_type_code               ubl_common_basic_components_2_1.ProcurementTypeCode?              @xsd(name: "ProcurementTypeCode")
  /// BBIE
  /// Procurement Project. Procurement Sub_ Type Code. Code
  /// A code signifying the subcategory of the type of work for this project (e.g., land surveying, IT consulting).
  /// 0..1
  /// Procurement Project
  /// Procurement Sub
  /// Type Code
  /// Code
  /// Code. Type
  procurement_sub_type_code           ubl_common_basic_components_2_1.ProcurementSubTypeCode?           @xsd(name: "ProcurementSubTypeCode")
  /// BBIE
  /// Procurement Project. Quality Control Code. Code
  /// The indication of whether or not the control quality is included in the works project.
  /// 0..1
  /// Procurement Project
  /// Quality Control Code
  /// Code
  /// Code. Type
  quality_control_code                ubl_common_basic_components_2_1.QualityControlCode?               @xsd(name: "QualityControlCode")
  /// BBIE
  /// Procurement Project. Required_ Fee. Amount
