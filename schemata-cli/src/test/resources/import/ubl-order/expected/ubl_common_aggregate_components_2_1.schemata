  /// 1..n
  /// Promotional Event
  /// Promotional Specification
  /// Promotional Specification
  /// Promotional Specification
  @xsd(name = "PromotionalSpecification") promotional_specification:        list<PromotionalSpecification>(min = 1)
}

/// ABIE
