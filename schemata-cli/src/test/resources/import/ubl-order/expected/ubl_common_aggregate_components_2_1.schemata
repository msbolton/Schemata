  /// 0..n
  /// Subcontract Terms
  /// Description
  /// Text
  /// Text. Type
  @xsd(name = "Description") description:                    list<ubl_common_basic_components_2_1.Description>
  /// BBIE
  /// Subcontract Terms. Amount
  /// The monetary amount assigned to the subcontracted task.
  /// 0..1
  /// Subcontract Terms
  /// Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "Amount") amount:                         ubl_common_basic_components_2_1.Amount?
  /// BBIE
  /// Subcontract Terms. Subcontracting Conditions Code. Code
  /// A code specifying the conditions for subcontracting.
  /// 0..1
  /// Subcontract Terms
  /// Subcontracting Conditions Code
  /// Code
  /// Code. Type
  @xsd(name = "SubcontractingConditionsCode") subcontracting_conditions_code: ubl_common_basic_components_2_1.SubcontractingConditionsCode?
  /// BBIE
  /// Subcontract Terms. Maximum_ Percent. Percent
  /// The maximum percentage allowed to be subcontracted.
  /// 0..1
  /// Subcontract Terms
  /// Maximum
  /// Percent
  /// Percent
  /// Percent. Type
  @xsd(name = "MaximumPercent") maximum_percent:                ubl_common_basic_components_2_1.MaximumPercent?
  /// BBIE
  /// Subcontract Terms. Minimum_ Percent. Percent
  /// The minimum percentage allowed to be subcontracted.
  /// 0..1
  /// Subcontract Terms
  /// Minimum
  /// Percent
  /// Percent
  /// Percent. Type
  @xsd(name = "MinimumPercent") minimum_percent:                ubl_common_basic_components_2_1.MinimumPercent?
}

/// ABIE
/// Subscriber Consumption. Details
/// The consumption for a specific party for given consumption point provided by a numbers of suppliers. An enterprise can have one utility statement for several parties (e.g. a ministry of defence receiving a telephone bill). In this way each subscriber consumption represent a sub utility statement.
/// Subscriber Consumption
@xsd(name = "SubscriberConsumption")
record SubscriberConsumption {
  /// BBIE
  /// Subscriber Consumption. Consumption Identifier. Identifier
  /// The identifier tor this specification.
  /// 0..1
  /// Subscriber Consumption
  /// Consumption Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "ConsumptionID") consumption_id:            ubl_common_basic_components_2_1.ConsumptionID?
  /// BBIE
  /// Subscriber Consumption. Specification Type Code. Code
  /// The code which specifies the type of this specification, e.g. an on account specification or the yearly specification.
  /// 0..1
  /// Subscriber Consumption
  /// Specification Type Code
  /// Code
  /// Code. Type
  @xsd(name = "SpecificationTypeCode") specification_type_code:   ubl_common_basic_components_2_1.SpecificationTypeCode?
  /// BBIE
  /// Subscriber Consumption. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Subscriber Consumption
  /// Note
  /// Text
  /// Text. Type
  /// This is how we have calculating your yearly statement
  @xsd(name = "Note") note:                      list<ubl_common_basic_components_2_1.Note>
  /// BBIE
  /// Subscriber Consumption. Total Metered Quantity. Quantity
  /// The total quantity consumed, as calculated from meter readings.
  /// 0..1
  /// Subscriber Consumption
  /// Total Metered Quantity
  /// Quantity
  /// Quantity. Type
  /// 2000.0
  @xsd(name = "TotalMeteredQuantity") total_metered_quantity:    ubl_common_basic_components_2_1.TotalMeteredQuantity?
  /// ASBIE
  /// Subscriber Consumption. Subscriber_ Party. Party
  /// The party subscribing to the utility.
  /// 0..1
  /// Subscriber Consumption
  /// Subscriber
  /// Party
  /// Party
  /// Party
  @xsd(name = "SubscriberParty") subscriber_party:          Party?
  /// ASBIE
  /// Subscriber Consumption. Utility_ Consumption Point. Consumption Point
  /// The point at which the utility is consumed.
  /// 1
  /// Subscriber Consumption
  /// Utility
  /// Consumption Point
  /// Consumption Point
  /// Consumption Point
  @xsd(name = "UtilityConsumptionPoint") utility_consumption_point: ConsumptionPoint
  /// ASBIE
  /// Subscriber Consumption. On Account Payment
  /// The planned prepayments (on account) regarding this subscription.
  /// 0..n
  /// Subscriber Consumption
  /// On Account Payment
  /// On Account Payment
  /// On Account Payment
  @xsd(name = "OnAccountPayment") on_account_payment:        list<OnAccountPayment>
  /// ASBIE
  /// Subscriber Consumption. Consumption
  /// The consumption in case the consumption is from one and only one supplier.
  /// 0..1
  /// Subscriber Consumption
  /// Consumption
  /// Consumption
  /// Consumption
  @xsd(name = "Consumption") consumption:               Consumption?
  /// ASBIE
  /// Subscriber Consumption. Supplier Consumption
  /// The consumption in case the consumption is from more than one supplier.
  /// 0..n
  /// Subscriber Consumption
  /// Supplier Consumption
  /// Supplier Consumption
  /// Supplier Consumption
  @xsd(name = "SupplierConsumption") supplier_consumption:      list<SupplierConsumption>
}

/// ABIE
/// Supplier Consumption. Details
/// The consumption in case the consumption is for one and only one supplier.
/// Supplier Consumption
@xsd(name = "SupplierConsumption")
record SupplierConsumption {
  /// BBIE
  /// Supplier Consumption. Description. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Supplier Consumption
  /// Description
  /// Text
  /// Text. Type
  /// This is what you pay for electricity to DONG Energy North Utility
  @xsd(name = "Description") description:            list<ubl_common_basic_components_2_1.Description>
  /// ASBIE
  /// Supplier Consumption. Utility Supplier_ Party. Party
  /// The party supplying the utility.
  /// 0..1
  /// Supplier Consumption
  /// Utility Supplier
  /// Party
  /// Party
  /// Party
  @xsd(name = "UtilitySupplierParty") utility_supplier_party: Party?
  /// ASBIE
  /// Supplier Consumption. Utility Customer_ Party. Party
  /// The utility customer.
  /// 0..1
  /// Supplier Consumption
  /// Utility Customer
  /// Party
  /// Party
  /// Party
  @xsd(name = "UtilityCustomerParty") utility_customer_party: Party?
  /// ASBIE
  /// Supplier Consumption. Consumption
  /// The consumption regarding this supplier
  /// 1
  /// Supplier Consumption
  /// Consumption
  /// Consumption
  /// Consumption
  @xsd(name = "Consumption") consumption:            Consumption
  /// ASBIE
  /// Supplier Consumption. Contract
  /// A contract setting forth conditions regulating the consumption.
  /// 0..1
  /// Supplier Consumption
  /// Contract
  /// Contract
  /// Contract
  @xsd(name = "Contract") contract:               Contract?
  /// ASBIE
  /// Supplier Consumption. Consumption Line
  /// The consumption of a utility product.
  /// 1..n
  /// Supplier Consumption
  /// Consumption Line
  /// Consumption Line
  /// Consumption Line
  @xsd(name = "ConsumptionLine") consumption_line:       list<ConsumptionLine>(min = 1)
}

/// ABIE
/// Supplier Party. Details
/// A class to describe a supplier party.
/// Supplier Party
record SupplierParty {
  /// BBIE
  /// Supplier Party. Customer Assigned_ Account Identifier. Identifier
  /// An identifier for this supplier party, assigned by the customer.
  /// 0..1
  /// Supplier Party
  /// Customer Assigned
  /// Account Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "CustomerAssignedAccountID") customer_assigned_account_id: ubl_common_basic_components_2_1.CustomerAssignedAccountID?
  /// BBIE
  /// Supplier Party. Additional_ Account Identifier. Identifier
  /// An additional identifier for this supplier party.
  /// 0..n
  /// Supplier Party
  /// Additional
  /// Account Identifier
  /// Identifier
  /// Identifier. Type
  @xsd(name = "AdditionalAccountID") additional_account_id:        list<ubl_common_basic_components_2_1.AdditionalAccountID>
  /// BBIE
  /// Supplier Party. Data Sending Capability. Text
