  /// 0..1
  /// Catalogue Line
  /// Orderable
  /// Unit
  /// Text
  /// Text. Type
  @xsd(name = "OrderableUnit") orderable_unit:                      ubl_common_basic_components_2_1.OrderableUnit?
  /// BBIE
