  /// Promotional Event
  /// Latest
  /// Proposal Acceptance Date
  /// Date
  /// Date. Type
  latest_proposal_acceptance_date  ubl_common_basic_components_2_1.LatestProposalAcceptanceDate?  @xsd(name: "LatestProposalAcceptanceDate")
  /// ASBIE
  /// Promotional Event. Promotional Specification
  /// A specification for a promotional event.
  /// 1..n
  /// Promotional Event
  /// Promotional Specification
  /// Promotional Specification
  /// Promotional Specification
  promotional_specification        PromotionalSpecification[]                                     { minItems 1 } @xsd(name: "PromotionalSpecification")

  @@xsd(name: "PromotionalEvent")
}

/// ABIE
/// Promotional Event Line Item. Details
/// A class to describe a line item associated with a promotional event.
/// Promotional Event Line Item
model PromotionalEventLineItem {
  /// BBIE
  /// Promotional Event Line Item. Amount
  /// The amount associated with this promotional event line item.
  /// 1
  /// Promotional Event Line Item
  /// Amount
  /// Amount
  /// Amount. Type
  amount          ubl_common_basic_components_2_1.Amount @xsd(name: "Amount")
  /// ASBIE
