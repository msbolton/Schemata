  /// Date. Type
  /// 2006-09-01
  @xsd(name = "PreviousMeterReadingDate") previous_meter_reading_date:        ubl_common_basic_components_2_1.PreviousMeterReadingDate
  /// BBIE
  /// Meter Reading. Previous_ Meter Quantity. Quantity
  /// The quantity of the previous meter reading.
