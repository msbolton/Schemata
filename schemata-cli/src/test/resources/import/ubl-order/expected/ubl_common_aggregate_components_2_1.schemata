  /// 0..1
  /// Item Instance
  /// Manufacture Date
  /// Date
  /// Date. Type
  @xsd(name = "ManufactureDate") manufacture_date:         ubl_common_basic_components_2_1.ManufactureDate?
  /// BBIE
  /// Item Instance. Manufacture Time. Time
  /// The time at which this item instance was manufactured.
  /// 0..1
  /// Item Instance
  /// Manufacture Time
  /// Time
  /// Time. Type
  @xsd(name = "ManufactureTime") manufacture_time:         ubl_common_basic_components_2_1.ManufactureTime?
  /// BBIE
