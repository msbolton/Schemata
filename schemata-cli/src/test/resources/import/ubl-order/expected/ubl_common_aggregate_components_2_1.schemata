  party Party                                 @xsd(name: "Party")

  @@xsd(name: "WinningParty")
}

/// ABIE
/// Work Phase Reference. Details
/// A class that refers to a phase of work. Used for instance to specify what part of the contract the billing is referring to.
/// Work Phase Reference
model WorkPhaseReference {
  /// BBIE
  /// Work Phase Reference. Identifier
  /// An identifier for this phase of work.
  /// 0..1
  /// Work Phase Reference
  /// Identifier
  /// Identifier
  /// Identifier. Type
  id                            ubl_common_basic_components_2_1.ID?              @xsd(name: "ID")
  /// BBIE
  /// Work Phase Reference. Work Phase Code. Code
  /// A code signifying this phase of work.
  /// 0..1
  /// Work Phase Reference
  /// Work Phase Code
  /// Code
  /// Code. Type
  work_phase_code               ubl_common_basic_components_2_1.WorkPhaseCode?   @xsd(name: "WorkPhaseCode")
  /// BBIE
  /// Work Phase Reference. Work Phase. Text
  /// Text describing this phase of work.
  /// 0..n
  /// Work Phase Reference
  /// Work Phase
  /// Text
  /// Text. Type
  work_phase                    ubl_common_basic_components_2_1.WorkPhase[]      @xsd(name: "WorkPhase")
  /// BBIE
  /// Work Phase Reference. Progress Percent. Percent
  /// The progress percentage of the work phase.
  /// 0..1
  /// Work Phase Reference
  /// Progress Percent
  /// Percent
  /// Percent. Type
  progress_percent              ubl_common_basic_components_2_1.ProgressPercent? @xsd(name: "ProgressPercent")
  /// BBIE
  /// Work Phase Reference. Start Date. Date
  /// The date on which this phase of work begins.
  /// 0..1
  /// Work Phase Reference
  /// Start Date
  /// Date
  /// Date. Type
  start_date                    ubl_common_basic_components_2_1.StartDate?       @xsd(name: "StartDate")
  /// BBIE
  /// Work Phase Reference. End Date. Date
  /// The date on which this phase of work ends.
  /// 0..1
  /// Work Phase Reference
  /// End Date
  /// Date
  /// Date. Type
  end_date                      ubl_common_basic_components_2_1.EndDate?         @xsd(name: "EndDate")
  /// ASBIE
  /// Work Phase Reference. Work Order_ Document Reference. Document Reference
  /// A reference to a document regarding the work order for the project in which this phase of work takes place.
  /// 0..n
  /// Work Phase Reference
  /// Work Order
  /// Document Reference
  /// Document Reference
  /// Document Reference
  work_order_document_reference DocumentReference[]                              @xsd(name: "WorkOrderDocumentReference")

  @@xsd(name: "WorkPhaseReference")
}
