  /// 0..1
  /// Catalogue Line
  /// Warranty
  /// Party
  /// Party
  /// Party
  @xsd(name = "WarrantyParty") warranty_party:                      Party?
  /// ASBIE
  /// Catalogue Line. Warranty Validity_ Period. Period
