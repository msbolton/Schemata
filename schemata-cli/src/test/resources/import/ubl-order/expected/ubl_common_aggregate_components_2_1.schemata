  /// ASBIE
  /// Project Reference. Work Phase Reference
  /// A specific phase of work in the referenced project.
  /// 0..n
  /// Project Reference
  /// Work Phase Reference
  /// Work Phase Reference
  /// Work Phase Reference
  work_phase_reference WorkPhaseReference[]                       @xsd(name: "WorkPhaseReference")

  @@xsd(name: "ProjectReference")
}

/// ABIE
/// Promotional Event. Details
/// Agree can be renamed as PromotionalEvents
/// Promotional Event
model PromotionalEvent {
  /// BBIE
  /// Promotional Event. Promotional Event Type Code. Code
  /// A code signifying the type of this promotional event. Examples can be: Holiday, Seasonal Event, Store Closing, Trade Item Introduction
  /// 1
  /// Promotional Event
  /// Promotional Event Type Code
  /// Code
  /// Code. Type
  promotional_event_type_code      ubl_common_basic_components_2_1.PromotionalEventTypeCode       @xsd(name: "PromotionalEventTypeCode")
  /// BBIE
  /// Promotional Event. Submission. Date
  /// The date on which a proposal for this promotional event was submitted.
  /// 0..1
  /// Promotional Event
  /// Submission
  /// Date
  /// Date. Type
  submission_date                  ubl_common_basic_components_2_1.SubmissionDate?                @xsd(name: "SubmissionDate")
  /// BBIE
  /// Promotional Event. First Shipment Availibility Date. Date
  /// The first day that products will be available to ship from buyer to seller if the proposal for this promotional event is accepted.
  /// 0..1
  /// Promotional Event
  /// First Shipment Availibility Date
  /// Date
  /// Date. Type
  first_shipment_availibility_date ubl_common_basic_components_2_1.FirstShipmentAvailibilityDate? @xsd(name: "FirstShipmentAvailibilityDate")
  /// BBIE
