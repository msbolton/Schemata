  /// Catalogue Line
  /// Component
  /// Related Item
  /// Related Item
  /// Related Item
  @xsd(name = "ComponentRelatedItem") component_related_item:              list<RelatedItem>
  /// ASBIE
  /// Catalogue Line. Accessory_ Related Item. Related Item
  /// An item that may be an optional accessory of the item in this catalogue line.
  /// 0..n
  /// Catalogue Line
  /// Accessory
  /// Related Item
  /// Related Item
  /// Related Item
  @xsd(name = "AccessoryRelatedItem") accessory_related_item:              list<RelatedItem>
  /// ASBIE
  /// Catalogue Line. Required_ Related Item. Related Item
