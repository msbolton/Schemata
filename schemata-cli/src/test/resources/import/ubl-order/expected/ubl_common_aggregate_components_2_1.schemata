  /// 0..1
  /// Catalogue Line
  /// Seller
  /// Supplier Party
  /// Supplier Party
  /// Supplier Party
  @xsd(name = "SellerSupplierParty") seller_supplier_party:               SupplierParty?
  /// ASBIE
  /// Catalogue Line. Warranty_ Party. Party
