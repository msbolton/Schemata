  /// 0..1
  /// Item Instance
  /// Best Before Date
  /// Date
  /// Date. Type
  @xsd(name = "BestBeforeDate") best_before_date:         ubl_common_basic_components_2_1.BestBeforeDate?
  /// BBIE
  /// Item Instance. Registration Identifier. Identifier
