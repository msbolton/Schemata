  /// 0..1
  /// Item Comparison
  /// Quantity
  /// Quantity
  /// Quantity. Type
  /// per unit
  @xsd(name = "Quantity") quantity:     ubl_common_basic_components_2_1.Quantity?
}

/// ABIE
/// Item Identification. Details
/// A class for assigning identifying information to an item.
/// Item Identification
record ItemIdentification {
  /// BBIE
  /// Item Identification. Identifier
