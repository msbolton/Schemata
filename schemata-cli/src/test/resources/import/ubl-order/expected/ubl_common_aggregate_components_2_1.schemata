  /// 0..1
  /// Monetary Total
  /// Payable
  /// Alternative Amount
  /// Amount
  /// Amount. Type
  @xsd(name = "PayableAlternativeAmount") payable_alternative_amount: ubl_common_basic_components_2_1.PayableAlternativeAmount?
}

/// ABIE
