  /// 0..n
  /// Catalogue Line
  /// Replaced
  /// Related Item
  /// Related Item
  /// Related Item
  @xsd(name = "ReplacedRelatedItem") replaced_related_item:               list<RelatedItem>
  /// ASBIE
