  /// Financial Guarantee
  /// Amount
  /// Rate
  /// Rate. Type
  @xsd(name = "AmountRate") amount_rate:         ubl_common_basic_components_2_1.AmountRate?
  /// ASBIE
  /// Financial Guarantee. Constitution_ Period. Period
  /// The period during the tendering process to which this financial guarantee has to be settled.
  /// 0..1
  /// Financial Guarantee
