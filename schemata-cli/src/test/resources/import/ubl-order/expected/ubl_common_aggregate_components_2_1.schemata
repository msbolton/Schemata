  id                  ubl_common_basic_components_2_1.ID?             @xsd(name: "ID")
  /// BBIE
  /// Contact. Name
  /// The name of this contact. It is recommended that this be used for a functional name and not a personal name.
  /// 0..1
  /// Contact
  /// Name
  /// Name
  /// Name. Type
  /// Delivery Dock
  name                ubl_common_basic_components_2_1.Name?           @xsd(name: "Name")
  /// BBIE
  /// Contact. Telephone. Text
  /// The primary telephone number of this contact.
  /// 0..1
  /// Contact
  /// Telephone
  /// Text
  /// Text. Type
  telephone           ubl_common_basic_components_2_1.Telephone?      @xsd(name: "Telephone")
  /// BBIE
  /// Contact. Telefax. Text
  /// The primary fax number of this contact.
  /// 0..1
  /// Contact
  /// Telefax
  /// Text
  /// Text. Type
  telefax             ubl_common_basic_components_2_1.Telefax?        @xsd(name: "Telefax")
  /// BBIE
  /// Contact. Electronic_ Mail. Text
  /// The primary email address of this contact.
  /// 0..1
  /// Contact
  /// Electronic
  /// Mail
  /// Text
  /// Text. Type
  electronic_mail     ubl_common_basic_components_2_1.ElectronicMail? @xsd(name: "ElectronicMail")
  /// BBIE
  /// Contact. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures; in particular, a textual description of the circumstances under which this contact can be used (e.g., "emergency" or "after hours").
  /// 0..n
  /// Contact
  /// Note
  /// Text
  /// Text. Type
  note                ubl_common_basic_components_2_1.Note[]          @xsd(name: "Note")
  /// ASBIE
  /// Contact. Other_ Communication. Communication
  /// Another means of communication with this contact.
  /// 0..n
  /// Contact
  /// Other
  /// Communication
  /// Communication
  /// Communication
  other_communication Communication[]                                 @xsd(name: "OtherCommunication")
}

/// ABIE
/// Contract. Details
/// A class to describe a contract.
/// Contract
model Contract {
  /// BBIE
  /// Contract. Identifier
  /// An identifier for this contract.
  /// 0..1
  /// Contract
  /// Identifier
  /// Identifier
  /// Identifier. Type
  /// CC23
  id                          ubl_common_basic_components_2_1.ID?               @xsd(name: "ID")
  /// BBIE
  /// Contract. Issue Date. Date
  /// The date on which this contract was issued.
  /// 0..1
  /// Contract
  /// Issue Date
  /// Date
  /// Date. Type
  issue_date                  ubl_common_basic_components_2_1.IssueDate?        @xsd(name: "IssueDate")
  /// BBIE
  /// Contract. Issue Time. Time
  /// The time at which this contract was issued.
  /// 0..1
  /// Contract
  /// Issue Time
  /// Time
  /// Time. Type
  issue_time                  ubl_common_basic_components_2_1.IssueTime?        @xsd(name: "IssueTime")
  /// BBIE
  /// Contract. Nomination Date. Date
  /// In a transportation contract, the deadline date by which the services referred to in the transport execution plan have to be booked. For example, if this service is a carrier service scheduled for Wednesday 16 February 2011 at 10 a.m. CET, the nomination date might be Tuesday15 February 2011.
  /// 0..1
  /// Contract
  /// Nomination Date
  /// Date
  /// Date. Type
  nomination_date             ubl_common_basic_components_2_1.NominationDate?   @xsd(name: "NominationDate")
  /// BBIE
  /// Contract. Nomination Time. Time
  /// In a transportation contract, the deadline time by which the services referred to in the transport execution plan have to be booked. For example, if this service is a carrier service scheduled for Wednesday 16 February 2011 at 10 a.m. CET, the nomination date might be Tuesday15 February 2011 and the nomination time 4 p.m. at the latest.
  /// 0..1
  /// Contract
  /// Nomination Time
  /// Time
  /// Time. Type
  nomination_time             ubl_common_basic_components_2_1.NominationTime?   @xsd(name: "NominationTime")
  /// BBIE
  /// Contract. Contract Type Code. Code
  /// The type of this contract, expressed as a code, such as "Cost plus award fee" and "Cost plus fixed fee" from UNCEFACT Contract Type code list.
  /// 0..1
  /// Contract
  /// Contract Type Code
  /// Code
  /// Code. Type
  contract_type_code          ubl_common_basic_components_2_1.ContractTypeCode? @xsd(name: "ContractTypeCode")
  /// BBIE
  /// Contract. Contract Type. Text
  /// The type of this contract, expressed as text, such as "Cost plus award fee" and "Cost plus fixed fee" from UNCEFACT Contract Type code list.
  /// 0..1
  /// Contract
  /// Contract Type
  /// Text
  /// Text. Type
  contract_type               ubl_common_basic_components_2_1.ContractType?     @xsd(name: "ContractType")
  /// BBIE
  /// Contract. Note. Text
  /// Free-form text conveying information that is not contained explicitly in other structures.
  /// 0..n
  /// Contract
  /// Note
  /// Text
  /// Text. Type
  /// Remarks
  note                        ubl_common_basic_components_2_1.Note[]            @xsd(name: "Note")
  /// BBIE
  /// Contract. Version. Identifier
  /// An identifier for the current version of this contract.
  /// 0..1
  /// Contract
  /// Version
  /// Identifier
  /// Identifier. Type
  version_id                  ubl_common_basic_components_2_1.VersionID?        @xsd(name: "VersionID")
  /// BBIE
  /// Contract. Description. Text
  /// Text describing this contract.
  /// 0..n
  /// Contract
  /// Description
  /// Text
  /// Text. Type
  description                 ubl_common_basic_components_2_1.Description[]     @xsd(name: "Description")
  /// ASBIE
  /// Contract. Validity_ Period. Period
  /// The period during which this contract is valid.
  /// 0..1
  /// Contract
  /// Validity
  /// Period
  /// Period
  /// Period
  validity_period             Period?                                           @xsd(name: "ValidityPeriod")
  /// ASBIE
  /// Contract. Contract_ Document Reference. Document Reference
  /// A reference to a contract document.
  /// 0..n
  /// Contract
  /// Contract
  /// Document Reference
  /// Document Reference
  /// Document Reference
  contract_document_reference DocumentReference[]                               @xsd(name: "ContractDocumentReference")
  /// ASBIE
  /// Contract. Nomination_ Period. Period
  /// In a transportation contract, the period required to book the services specified in the contract before the services can begin.
  /// 0..1
  /// Contract
  /// Nomination
  /// Period
  /// Period
  /// Period
  nomination_period           Period?                                           @xsd(name: "NominationPeriod")
  /// ASBIE
  /// Contract. Contractual_ Delivery. Delivery
  /// In a transportation contract, the delivery of the services required to book the services specified in the contract.
  /// 0..1
  /// Contract
  /// Contractual
  /// Delivery
  /// Delivery
  /// Delivery
  contractual_delivery        Delivery?                                         @xsd(name: "ContractualDelivery")

  @@xsd(name: "Contract")
}

