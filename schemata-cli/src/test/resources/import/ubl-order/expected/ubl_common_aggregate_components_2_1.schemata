  /// 0..n
  /// Consignment
  /// Freight
  /// Allowance Charge
  /// Allowance Charge
  /// Allowance Charge
  /// Freight Costs
  @xsd(name = "FreightAllowanceCharge") freight_allowance_charge:                 list<AllowanceCharge>
