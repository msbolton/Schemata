namespace escapes

enum Flag { on, @xsd(name = "null") null_value }

record Parcel {
  code:       string(pattern = "^[A-Z]{2}\d{4}$")
  label:      string(pattern = "^[a-z]+\n[a-z]+$")
  quoted:     string
  address:    string = "line one\nline two\tend"
  flag:       Flag = null_value
  @xsd(name = "null") null_value: string
}
