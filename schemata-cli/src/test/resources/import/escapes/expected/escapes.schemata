schema escapes

enum Flag { on @xsd(name: "null") null_value }

model Parcel {
  code       string { match "^[A-Z]{2}\d{4}$" }
  label      string { match "^[a-z]+\n[a-z]+$" }
  quoted     string
  address    string = "line one\nline two\tend"
  flag       Flag   = null_value
  null_value string @xsd(name: "null")
}
