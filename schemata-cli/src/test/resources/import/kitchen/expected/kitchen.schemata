/// A hand-written schema exercising every import diagnostic.
schema kitchen @xsd(namespace: "http://example.com/kitchen")

/// The kitchen sink.
model Kitchen {
  rack    BikeRack?
  built   string?
  code    string?
  note    string?
  dish    Dish?
  special SpecialDish?
  any     string?      @xsd(any) @xsd(wildcard: "##other")

  @@xsd(name: "kitchen")
}

model BikeRack {
  slots int32

  @@xsd(name: "bike-rack")
  @@xsd(root: false)
}

model Dish {
  name string
  text string? @xsd(mixed)

  @@xsd(name: "dish")
  @@xsd(root: false)
}

model BaseDish {
  garnish string

  @@xsd(name: "baseDish")
  @@xsd(root: false)
  @@xsd(all)
}

model SpecialDish {
  garnish string
  sauce   string

  @@xsd(name: "specialDish")
  @@xsd(root: false)
}
