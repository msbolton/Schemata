<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/kitchen"
           targetNamespace="http://example.com/kitchen"
           elementFormDefault="qualified">

  <xs:annotation>
    <xs:documentation>A hand-written schema exercising every import diagnostic.</xs:documentation>
  </xs:annotation>

  <xs:element name="kitchen" type="tns:kitchenType"/>

  <xs:complexType name="kitchenType">
    <xs:annotation>
      <xs:documentation>The kitchen sink.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="rack" type="tns:bike-rackType" minOccurs="0"/>
      <xs:element name="built" type="xs:gYear" minOccurs="0"/>
      <xs:element name="code" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:whiteSpace value="collapse"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="note" type="xs:string" minOccurs="0" substitutionGroup="tns:comment"/>
      <xs:element name="dish" type="tns:dishType" minOccurs="0"/>
      <xs:element name="special" type="tns:specialDishType" minOccurs="0"/>
      <xs:any namespace="##other" processContents="lax" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="bike-rackType">
    <xs:sequence>
      <xs:element name="slots" type="xs:int"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="dishType" mixed="true">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="baseDishType">
    <xs:all>
      <xs:element name="garnish" type="xs:string"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="specialDishType">
    <xs:complexContent>
      <xs:extension base="tns:baseDishType">
        <xs:sequence>
          <xs:element name="sauce" type="xs:string"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

</xs:schema>
