<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msg="urn:example:exchange:message" xmlns:exc="urn:example:exchange:core" xmlns:structures="http://release.niem.gov/niem/structures/5.0/" xmlns:ism="urn:us:gov:ic:ism" targetNamespace="urn:example:exchange:message" elementFormDefault="qualified" version="1">
  <xs:annotation><xs:documentation>A message carrying entities.</xs:documentation></xs:annotation>
  <xs:import namespace="urn:example:exchange:core" schemaLocation="ex-core.xsd"/>
  <xs:import namespace="http://release.niem.gov/niem/structures/5.0/" schemaLocation="../include/niem/xsd/utility/structures.xsd"/>
  <xs:import namespace="urn:us:gov:ic:ism" schemaLocation="../include/IC-TDF/Schema/ISM/IC-ISM.xsd"/>
  <xs:element name="SituationMessage" type="msg:SituationMessageType"><xs:annotation><xs:documentation>A report of the entities a system knows about.</xs:documentation></xs:annotation></xs:element>
  <xs:element name="MessageID" type="xs:string"><xs:annotation><xs:documentation>An identifier of a message.</xs:documentation></xs:annotation></xs:element>
  <xs:complexType name="SituationMessageType">
    <xs:annotation><xs:documentation>A data type for a report of entities.</xs:documentation></xs:annotation>
    <xs:complexContent>
      <xs:extension base="structures:ObjectType">
        <xs:sequence>
          <xs:element ref="msg:MessageID"/>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element ref="exc:Entity"/>
            <xs:element ref="exc:EntityName"/>
          </xs:choice>
        </xs:sequence>
        <xs:attributeGroup ref="ism:ISMRootNodeAttributeOptionGroup"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
