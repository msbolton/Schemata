/// A data type for a representation of an identity.
model Identification {
  /// A document-relative identifier for an XML element.
  id                                       string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                                      string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                                      string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata                                 string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata                    string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id                              int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes                               map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// An identifier.
  identification_id                        niem_xs.String[]    { minItems 1 } @xsd(name: "IdentificationID")
  /// A description of a kind of identification.
  identification_category_description_text Text[]              @xsd(name: "IdentificationCategoryDescriptionText")

  @@xsd(name: "Identification")
}

/// A data type for a measurement of the angular distance between a point on the Earth and the Equator.
model LatitudeCoordinate {
  /// A document-relative identifier for an XML element.
  id                    string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                   string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                   string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata              string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id           int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes            map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A value that specifies the degree of a latitude. The value comes from a restricted range between -90 (inclusive) and +90 (inclusive).
  latitude_degree_value LatitudeDegree      @xsd(name: "LatitudeDegreeValue")
}

/// A data type for a degree of latitude.
model LatitudeDegree {
  value                 decimal(38, 9)
  /// A document-relative identifier for an XML element.
  id                    string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                   string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                   string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata              string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id           int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes            map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
}

/// A data type for a measure of a distance or extent.
model LengthMeasure {
  /// A document-relative identifier for an XML element.
  id                     string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                    string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                    string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata               string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata  string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id            int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes             map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A data concept for a measurement value.
  measure_value_abstract niem_xs.Double?     @xsd(name: "MeasureValueAbstract")
}

/// A data type for a location identified by latitude and longitude.
model Location2DGeospatialCoordinate {
  /// A document-relative identifier for an XML element.
  id                              string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                             string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                             string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata                        string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata           string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id                     int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes                      map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A measurement of the angular distance between a point on the Earth and the Equator.
  geographic_coordinate_latitude  LatitudeCoordinate  @xsd(name: "GeographicCoordinateLatitude")
  /// A measurement of the angular distance between a point on the Earth and the Prime Meridian.
  geographic_coordinate_longitude LongitudeCoordinate @xsd(name: "GeographicCoordinateLongitude")
}

/// A data type for a location identified by latitude, longitude, and height.
model Location3DGeospatialCoordinate {
  /// A document-relative identifier for an XML element.
  id                              string?                @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                             string?                @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                             string?                @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata                        string[]?              @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata           string[]?              @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id                     int64?                 { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes                      map<string, string>    @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A measurement of the angular distance between a point on the Earth and the Equator.
  geographic_coordinate_latitude  LatitudeCoordinate     @xsd(name: "GeographicCoordinateLatitude")
  /// A measurement of the angular distance between a point on the Earth and the Prime Meridian.
  geographic_coordinate_longitude LongitudeCoordinate    @xsd(name: "GeographicCoordinateLongitude")
  /// A data concept for a measure of the height of a location.
  location_height_abstract        LocationHeightMeasure? @xsd(name: "LocationHeightAbstract")

  @@xsd(name: "Location3DGeospatialCoordinate")
}

/// A data type for a measurement of the height of a location relative to a reference point.
model LocationHeightMeasure {
  /// A document-relative identifier for an XML element.
  id                     string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                    string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                    string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata               string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata  string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id            int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes             map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A data concept for a measurement value.
  measure_value_abstract niem_xs.Double?     @xsd(name: "MeasureValueAbstract")
}

/// A data type for geospatial location.
model Location {
  /// A document-relative identifier for an XML element.
  id                                      string?                         @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                                     string?                         @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                                     string?                         @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata                                string[]?                       @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata                   string[]?                       @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id                             int64?                          { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes                              map<string, string>             @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A location identified by geographic boundaries.
  location_area                           Area?                           @xsd(name: "LocationArea")
  /// A data concept for a geospatial location.
  location_geospatial_coordinate_abstract Location3DGeospatialCoordinate? @xsd(name: "LocationGeospatialCoordinateAbstract")

  @@xsd(name: "Location")
}

/// A data type for a measurement of the angular distance between a point on the Earth and the Prime Meridian.
model LongitudeCoordinate {
  /// A document-relative identifier for an XML element.
  id                     string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                    string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
