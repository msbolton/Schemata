  attributes            map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A magnitude of a one-sigma deviation of a normal (Gaussian) distribution followed by the true value of the quantity.
  sigma_error_value     decimal(38, 9)?     @xsd(name: "sigmaErrorValue") @xsd(attribute)

