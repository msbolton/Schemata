  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id            int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes             map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A data concept for a measurement value.
  measure_value_abstract niem_xs.Double?     @xsd(name: "MeasureValueAbstract")

  @@xsd(root: false)
}

/// A data type for information that further qualifies primary data; data about data.
model Metadata {
  /// A document-relative identifier for an XML element.
  id         string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref        string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri        string?             @xsd(attribute)
  attributes map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")

  @@xsd(root: false)
}

/// A data type for a polygon area identified by a set of coordinates.
model PolygonRegion {
  /// A document-relative identifier for an XML element.
  id                    string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                   string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                   string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata              string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id           int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes            map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A location of a vertex of a polygon region.
  polygon_node_location Location[]          { minItems 1 } @xsd(name: "PolygonNodeLocation")
}

/// A data type for a state of something or someone.
model Status {
  /// A document-relative identifier for an XML element.
  id                    string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                   string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                   string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata              string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id           int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes            map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A comment regarding a status.
  status_comment_text   Text?               @xsd(name: "StatusCommentText")
}

/// A data type for a clearly defined action or activity specifically assigned to an individual or organization that must be done as it is imposed by an appropriate authority.
model Task {
  /// A document-relative identifier for an XML element.
  id                    string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                   string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                   string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata              string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id           int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes            map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")
  /// A description of the task in detail.
  task_description_text niem_xs.String?     @xsd(name: "TaskDescriptionText")
  /// A date for the actual end of a task.
  task_end_date         niem_core.Date?     @xsd(name: "TaskEndDate")
  /// A date for the start of a task.
  task_start_date       niem_core.Date?     @xsd(name: "TaskStartDate")
  /// A status of the task.
  task_status           Status?             @xsd(name: "TaskStatus")

  @@xsd(name: "Task")
}

/// A data type for a character string.
model Text {
  value                 string
  /// True if only partial information was available to the information source at the time when the data was captured in the system; false otherwise.
  partial_indicator     bool?     @xsd(name: "partialIndicator") @xsd(attribute)
  /// True if the length of a string is greater than the length of the field within which the string was stored in the exporting system; false otherwise.
  truncation_indicator  bool?     @xsd(name: "truncationIndicator") @xsd(attribute)
  lang                  string?   @xsd(attribute)
  /// A document-relative identifier for an XML element.
  id                    string?   @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                   string?   @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                   string?   @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata              string[]? @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata string[]? @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id           int64?    { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
}

/// A data type for a dateTime constrained to always be Zulu time, time at the Zero Meridian.
model ZuluDateTime {
  value                 instant
  /// A document-relative identifier for an XML element.
  id                    string?             @xsd(attribute)
  /// A document-relative reference to an XML element.
  ref                   string?             @xsd(attribute)
  /// An internationalized resource identifier or uniform resource identifier for a node or object.
  uri                   string?             @xsd(attribute)
  /// A list of metadata objects that apply to a node or object represented by an XML element.
  metadata              string[]?           @xsd(list) @xsd(attribute)
  /// A list of metadata objects that apply to a relationship or property occurrence represented by an XML element.
  relationship_metadata string[]?           @xsd(name: "relationshipMetadata") @xsd(list) @xsd(attribute)
  /// An identifier that establishes the relative order of a property occurrence among sibling properties of a node or object.
  sequence_id           int64?              { min 1 } @xsd(name: "sequenceID") @xsd(attribute)
  attributes            map<string, string> @xsd(any_attribute) @xsd(wildcard: "urn:us:gov:ic:ism urn:us:gov:ic:ntk")

  @@xsd(name: "ZuluDateTime")
}

/// A data concept for a location identified by geographic boundaries.
union AreaRegionAbstract = CircularRegion | PolygonRegion
