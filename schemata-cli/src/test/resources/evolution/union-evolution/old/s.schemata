schema s

model Card { #1 last4 string { max 4 } }

model BankTransfer { #1 iban string { max 34 } }

model Cash {}

model Wallet { #1 provider string { max 32 } }

model Voucher { #1 code string { max 16 } }

union Payment = #1 Card | #2 BankTransfer | #3 Cash

model Order { #1 id uuid { id }  #2 payment Payment }

model Holdings {
  #1 id       uuid          { id }
  #2 card     Card?
  #3 transfer BankTransfer?
  #4 cash     Cash?
  #5 wallet   Wallet?
  #6 voucher  Voucher?
}
