schema s

model Customer { #1 id uuid { id }  #2 name string { max 64 } }

model Line { #1 sku string { max 32 }  #2 qty int32 }

model Order {
  #1 id       uuid       { id }
  #2 customer Customer   @sql(strategy: table)
  #3 watchers Customer[] @sql(strategy: table)
  #4 lines    Line[]     @sql(strategy: table)
  #5 tags     string[]   @sql(strategy: table)
}
