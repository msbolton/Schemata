schema s @openapi(bearer, api_key: "header X-API-Key", oauth2_token_url: "https://auth.example.com/token", auth: bearer)

model OrderId { #1 id uuid { id } }

model PlaceOrder { #1 sku string { id }  #2 quantity int32  #3 request_id string? }

model Order { #1 id uuid { id }  #2 total decimal(12, 2)  #3 etag string? }

model Problem { #1 type string { id }  #2 title string }

model Conflict { #1 type string { id }  #2 current uuid }

service Orders {
  errors { 400 Problem  500 }
  #1 get(OrderId): Order  get "/orders/{id}"  errors { 404 Problem }
  #2 place(PlaceOrder): Order  post "/orders"  errors { 409 Problem }
  @openapi(auth: (bearer, api_key))
  #3 cancel(OrderId)  delete "/orders/{id}"
  @openapi(auth: none)
  #4 ping()  get "/ping"
}
