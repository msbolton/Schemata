schema s

model OrderId { #1 id uuid { id } }

model Filter { #1 status string? { max 20 } }

model PlaceOrder { #1 customer_id uuid }

model Order { #1 id uuid { id }  #2 total decimal(19, 4) }

model Count { #1 n int64 }

service Orders {
  #1 fetch(OrderId): Order  get "/orders/{id}"
  #2 list(Filter): Order  get "/orders"
  #3 place(PlaceOrder): Order  post "/orders/new"
  @deprecated #5 old(OrderId): Order
  #6 count(): Count
  reserved #4, "cancel"
}

service Audit {
  #1 log(Order)
}
