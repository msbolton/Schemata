schema s

model OrderId { #1 id uuid { id } }

model Filter { #1 status string? { max 20 } }

model PlaceOrder { #1 customer_id uuid }

model Order { #1 id uuid { id }  #2 total decimal(19, 4) }

model Count { #1 n int64 }

service Orders {
  #1 get(OrderId): Order  get "/orders/{id}"
  #2 list(Filter): stream Order  get "/orders"
  #3 place(PlaceOrder): Order  post "/orders"
  #4 cancel(OrderId)  delete "/orders/{id}"
  #5 old(OrderId): Order
}
