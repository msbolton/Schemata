/// Double-entry journal.
schema ledger.journal @sql(schema: "ledger_journal") @proto(package: "ledger.journal.v1")

import ledger.accounts

enum Source { #1 manual #2 imported #3 accrual }

enum Side { #1 debit #2 credit }

model Invoice { #1 number string { max 32 } }

model Payment { #1 reference string { max 64 } }

/// What an entry refers back to; a bare source when nothing else applies.
union Reference = #1 Invoice | #2 Payment | #3 Source

/// A balanced entry: at least two lines.
model Entry {
  #1 id     uuid      { id }
  #2 posted date
  #3 memo   string?   { max 500 }
  #4 lines  Line[]    { minItems 2 }
  #5 ref    Reference
  reserved #6

  model Line { #1 account Account  #2 amount Money  #3 side Side }
}
