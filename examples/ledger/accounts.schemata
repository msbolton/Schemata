/// Chart of accounts. Every account is owned by a tenant.
schema ledger.accounts @sql(schema: "ledger") @proto(package: "ledger.accounts.v1")

alias Money = decimal(19, 4)

enum Kind { #1 asset #2 liability #3 equity #4 revenue #5 expense }

/// An account, keyed by tenant and code.
model Account {
  #1 tenant_id int64
  #2 code      string             { max 16 }
  #3 name      string             { max 120 }
  #4 kind      Kind
  #5 opened    date
  #6 closed    date?
  #7 limits    Limits
  #8 balances  map<string, Money> @sql(strategy: table)

  /// Overdraft and daily limits in the account's currency.
  model Limits { #1 overdraft Money  #2 daily Money? }

  @@id(tenant_id, code)
}
