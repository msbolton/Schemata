{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemata:shop.catalog",
  "title": "shop.catalog",
  "$defs": {
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  }
}
