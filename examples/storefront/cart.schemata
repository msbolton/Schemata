/// The signed-in customer's cart.
schema storefront.cart @openapi(bearer: "JWT", auth: bearer)

import storefront.catalog
import storefront.common

/// What the customer means to buy.
model Cart {
  #1 id         uuid    { id }
  #2 lines      Line[]
  #3 subtotal   Money
  #4 updated_at instant

  /// A variant of a product, and how many of it.
  model Line {
    #1 product    Product
    #2 sku        string  { max 64 }
    #3 quantity   int32   { min 1, max 99 }
    #4 unit_price Money
  }
}

/// A variant to put in the cart; one already there gains the quantity.
model AddItem {
  #1 sku      string  { id, max 64 }
  #2 product  Product
  #3 quantity int32   { min 1, max 99 } = 1
}

/// A new quantity for a variant in the cart.
model SetQuantity { #1 sku string { id, max 64 }  #2 quantity int32 { min 1, max 99 } }

model ItemSku { #1 sku string { id, max 64 } }

/// Fill and empty the cart.
service Carts {
  errors { 401 Problem  default Problem }
  #1 get_cart(): Cart  get "/cart"
  #2 add_item(AddItem): Cart  post "/cart/items"  errors { 404 Problem  409 Problem }
  #3 set_quantity(SetQuantity): Cart  patch "/cart/items/{sku}"  errors { 404 Problem }
  #4 remove_item(ItemSku): Cart  delete "/cart/items/{sku}"  errors { 404 Problem }
  #5 clear()  delete "/cart"
}
