<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="urn:schemata:storefront.auth"
           targetNamespace="urn:schemata:storefront.auth"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:complexType name="RegisterType">
    <xs:annotation>
      <xs:documentation>A new account.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="email">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="254"/>
            <xs:pattern value="[^@]+@[^@]+"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="password">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="12"/>
            <xs:maxLength value="128"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="name">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="100"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="LoginType">
    <xs:annotation>
      <xs:documentation>The credentials a session starts from.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="email">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="254"/>
            <xs:pattern value="[^@]+@[^@]+"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="password">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="128"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefreshTokenType">
    <xs:annotation>
      <xs:documentation>A refresh token, traded for a new session or given up at sign-out.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="refresh_token">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="512"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="SessionType">
    <xs:annotation>
      <xs:documentation>A session: a short-lived access token, sent as `Authorization: Bearer …`, and the refresh
token that renews it.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="access_token">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="4096"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="token_type" type="xs:string" minOccurs="0" default="Bearer"/>
      <xs:element name="expires_in">
        <xs:annotation>
          <xs:documentation>Seconds until the access token expires.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:int">
            <xs:minInclusive value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="refresh_token">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="512"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="user_id">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="register" type="tns:RegisterType"/>
  <xs:element name="login" type="tns:LoginType"/>
  <xs:element name="refresh_token" type="tns:RefreshTokenType"/>
  <xs:element name="session" type="tns:SessionType"/>
</xs:schema>
