<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="urn:schemata:storefront.admin"
           xmlns:ns1="urn:schemata:storefront.catalog"
           targetNamespace="urn:schemata:storefront.admin"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:import namespace="urn:schemata:storefront.catalog" schemaLocation="catalog.xsd"/>
  <xs:complexType name="SetAvailabilityType">
    <xs:annotation>
      <xs:documentation>Which variant's stock to change, and to what.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="sku">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="64"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="availability" type="ns1:AvailabilityType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ProductIdType">
    <xs:sequence>
      <xs:element name="id">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShipType">
    <xs:annotation>
      <xs:documentation>Hands an order to a carrier.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="id">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="carrier">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="tracking_number">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="100"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="set_availability" type="tns:SetAvailabilityType"/>
  <xs:element name="product_id" type="tns:ProductIdType"/>
  <xs:element name="ship" type="tns:ShipType"/>
</xs:schema>
