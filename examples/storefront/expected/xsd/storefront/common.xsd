<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="urn:schemata:storefront.common"
           targetNamespace="urn:schemata:storefront.common"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:complexType name="MoneyType">
    <xs:annotation>
      <xs:documentation>An amount in one currency.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="amount">
        <xs:simpleType>
          <xs:restriction base="xs:decimal">
            <xs:totalDigits value="19"/>
            <xs:fractionDigits value="4"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="currency">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="3"/>
            <xs:maxLength value="3"/>
            <xs:pattern value="[A-Z]{3}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PageInfoType">
    <xs:annotation>
      <xs:documentation>Where a page sits in its listing.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="next_cursor" minOccurs="0">
        <xs:annotation>
          <xs:documentation>The cursor of the next page; absent on the last one.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="200"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="total">
        <xs:annotation>
          <xs:documentation>How many items the listing holds in all.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:long">
            <xs:minInclusive value="0"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ProblemType">
    <xs:annotation>
      <xs:documentation>A problem report in a stricter profile of RFC 9457, the body of every error response: `title`,
`status` and `instance` are required, `instance` because a top-level model needs a key. Members
beyond those declared are allowed, as the RFC allows extensions.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="type" minOccurs="0" default="about:blank">
        <xs:annotation>
          <xs:documentation>A URI naming the kind of problem; `about:blank` when the status says it all.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2048"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="title">
        <xs:annotation>
          <xs:documentation>A short summary of the kind of problem, the same for every occurrence.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="200"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="status">
        <xs:annotation>
          <xs:documentation>The HTTP status code of the response.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:int">
            <xs:minInclusive value="400"/>
            <xs:maxInclusive value="599"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="detail" minOccurs="0">
        <xs:annotation>
          <xs:documentation>What went wrong this time.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2000"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="instance">
        <xs:annotation>
          <xs:documentation>A URI naming this occurrence, to quote when asking for help.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2048"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="errors" type="tns:ProblemViolationType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>The request's fields that failed their checks, when it failed on its fields.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ProblemViolationType">
    <xs:annotation>
      <xs:documentation>One field of the request and what is wrong with it.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="field">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="200"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="message">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="500"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="money" type="tns:MoneyType"/>
  <xs:element name="page_info" type="tns:PageInfoType"/>
  <xs:element name="problem" type="tns:ProblemType"/>
</xs:schema>
