{
  "openapi": "3.1.0",
  "info": {
    "title": "storefront.catalog",
    "version": "1.0.0",
    "description": "Categories and products: browse, search, and read one. Partners call it with an API key,\ncustomers with their session's token."
  },
  "security": [
    {
      "bearer": []
    },
    {
      "api_key": []
    }
  ],
  "tags": [
    {
      "name": "Catalog",
      "description": "Browse and search the catalog."
    }
  ],
  "paths": {
    "/categories": {
      "get": {
        "operationId": "Catalog_list_categories",
        "tags": [
          "Catalog"
        ],
        "summary": "Every category. Anyone may read them.",
        "responses": {
          "200": {
            "description": "CategoryList",
            "headers": {
              "ETag": {
                "required": true,
                "schema": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "Every category, parents before their children.",
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/storefront.catalog.Category"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/products": {
      "get": {
        "operationId": "Catalog_search",
        "tags": [
          "Catalog"
        ],
        "summary": "Search products, one page at a time.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words to look for in a product's name and description.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category's slug; its subcategories match too.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Any of these brands.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100
              },
              "maxItems": 10
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$"
            }
          },
          {
            "name": "availability",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/storefront.catalog.Availability"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/storefront.catalog.ProductSort",
              "default": "relevance"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ProductPage",
            "headers": {
              "ETag": {
                "required": true,
                "schema": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "One page of a search.",
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/storefront.catalog.Product"
                      }
                    },
                    "page": {
                      "$ref": "#/components/schemas/storefront.common.PageInfo"
                    },
                    "query": {
                      "description": "The search this page answers, with which to ask for the next one.",
                      "$ref": "#/components/schemas/storefront.catalog.ProductSearch"
                    }
                  },
                  "required": [
                    "items",
                    "page",
                    "query"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      }
    },
    "/products/{slug}": {
      "get": {
        "operationId": "Catalog_get_product",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.catalog.Product"
                }
              }
            }
          },
          "400": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "404": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "storefront.catalog.Category": {
        "description": "A category; categories nest under a parent.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ],
        "additionalProperties": false
      },
      "storefront.common.Problem": {
        "description": "A problem report in the shape of RFC 9457, the body of every error response. Members beyond\nthose declared are allowed, as the RFC allows extensions. `instance` stays required because a\ntop-level model needs a key.",
        "type": "object",
        "properties": {
          "type": {
            "description": "A URI naming the kind of problem; `about:blank` when the status says it all.",
            "type": "string",
            "maxLength": 2048,
            "default": "about:blank"
          },
          "title": {
            "description": "A short summary of the kind of problem, the same for every occurrence.",
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "description": "The HTTP status code of the response.",
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "description": "What went wrong this time.",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "instance": {
            "description": "A URI naming this occurrence, to quote when asking for help.",
            "type": "string",
            "maxLength": 2048
          },
          "errors": {
            "description": "The request's fields that failed their checks, when it failed on its fields.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/storefront.common.Problem.Violation"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "status",
          "instance"
        ]
      },
      "storefront.common.Problem.Violation": {
        "description": "One field of the request and what is wrong with it.",
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "field",
          "message"
        ],
        "additionalProperties": false
      },
      "storefront.catalog.Availability": {
        "type": "string",
        "enum": [
          "in_stock",
          "backorder",
          "out_of_stock"
        ]
      },
      "storefront.catalog.ProductSort": {
        "type": "string",
        "enum": [
          "relevance",
          "price_asc",
          "price_desc",
          "newest",
          "rating"
        ]
      },
      "storefront.catalog.Product": {
        "description": "A product and the variants it is sold in.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000
          },
          "category_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "brand": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/storefront.catalog.Product.Variant"
            },
            "minItems": 1
          },
          "images": {
            "description": "Image URLs, the first one the product's main image.",
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048
            },
            "maxItems": 20
          },
          "rating": {
            "description": "The average review rating, absent until the first review.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "category_id",
          "variants",
          "images"
        ],
        "additionalProperties": false
      },
      "storefront.catalog.Product.Variant": {
        "description": "One form of a product that can be bought, such as a size and a colour.",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64
          },
          "size": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          },
          "color": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 30
          },
          "price": {
            "$ref": "#/components/schemas/storefront.common.Money"
          },
          "availability": {
            "$ref": "#/components/schemas/storefront.catalog.Availability"
          }
        },
        "required": [
          "sku",
          "price",
          "availability"
        ],
        "additionalProperties": false
      },
      "storefront.common.Money": {
        "description": "An amount in one currency.",
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "minLength": 3,
            "maxLength": 3
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "additionalProperties": false
      },
      "storefront.common.PageInfo": {
        "description": "Where a page sits in its listing.",
        "type": "object",
        "properties": {
          "next_cursor": {
            "description": "The cursor of the next page; absent on the last one.",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "total": {
            "description": "How many items the listing holds in all.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "total"
        ],
        "additionalProperties": false
      },
      "storefront.catalog.ProductSearch": {
        "description": "What a search asks for. Each filter is a query parameter, and a filter left out matches every\nproduct.",
        "type": "object",
        "properties": {
          "q": {
            "description": "Words to look for in a product's name and description.",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "category": {
            "description": "A category's slug; its subcategories match too.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 100
          },
          "brand": {
            "description": "Any of these brands.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100
                },
                "maxItems": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "min_price": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$"
          },
          "max_price": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$"
          },
          "availability": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/storefront.catalog.Availability"
              },
              {
                "type": "null"
              }
            ]
          },
          "sort": {
            "$ref": "#/components/schemas/storefront.catalog.ProductSort",
            "default": "relevance"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "api_key": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header"
      }
    }
  }
}
