{
  "openapi": "3.1.0",
  "info": {
    "title": "storefront.cart",
    "version": "1.0.0",
    "description": "The signed-in customer's cart."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Carts",
      "description": "Fill and empty the cart."
    }
  ],
  "paths": {
    "/cart": {
      "get": {
        "operationId": "Carts_get_cart",
        "tags": [
          "Carts"
        ],
        "responses": {
          "200": {
            "description": "Cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.cart.Cart"
                }
              }
            }
          },
          "401": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "Carts_clear",
        "tags": [
          "Carts"
        ],
        "responses": {
          "204": {
            "description": "No content"
          },
          "401": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      }
    },
    "/cart/items": {
      "post": {
        "operationId": "Carts_add_item",
        "tags": [
          "Carts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/storefront.cart.AddItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.cart.Cart"
                }
              }
            }
          },
          "401": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "404": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "409": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      }
    },
    "/cart/items/{sku}": {
      "patch": {
        "operationId": "Carts_set_quantity",
        "tags": [
          "Carts"
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "A new quantity for a variant in the cart.",
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  }
                },
                "required": [
                  "quantity"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.cart.Cart"
                }
              }
            }
          },
          "401": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "404": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "Carts_remove_item",
        "tags": [
          "Carts"
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.cart.Cart"
                }
              }
            }
          },
          "401": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "404": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "storefront.cart.Cart": {
        "description": "What the customer means to buy.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/storefront.cart.Cart.Line"
            }
          },
          "subtotal": {
            "$ref": "#/components/schemas/storefront.common.Money"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "lines",
          "subtotal",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "storefront.cart.Cart.Line": {
        "description": "A variant of a product, and how many of it.",
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "sku": {
            "type": "string",
            "maxLength": 64
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "unit_price": {
            "$ref": "#/components/schemas/storefront.common.Money"
          }
        },
        "required": [
          "product_id",
          "sku",
          "quantity",
          "unit_price"
        ],
        "additionalProperties": false
      },
      "storefront.common.Money": {
        "description": "An amount in one currency.",
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "minLength": 3,
            "maxLength": 3
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "additionalProperties": false
      },
      "storefront.common.Problem": {
        "description": "A problem report in a stricter profile of RFC 9457, the body of every error response: `title`,\n`status` and `instance` are required, `instance` because a top-level model needs a key. Members\nbeyond those declared are allowed, as the RFC allows extensions.",
        "type": "object",
        "properties": {
          "type": {
            "description": "A URI naming the kind of problem; `about:blank` when the status says it all.",
            "type": "string",
            "maxLength": 2048,
            "default": "about:blank"
          },
          "title": {
            "description": "A short summary of the kind of problem, the same for every occurrence.",
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "description": "The HTTP status code of the response.",
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "description": "What went wrong this time.",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "instance": {
            "description": "A URI naming this occurrence, to quote when asking for help.",
            "type": "string",
            "maxLength": 2048
          },
          "errors": {
            "description": "The request's fields that failed their checks, when it failed on its fields.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/storefront.common.Problem.Violation"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "status",
          "instance"
        ]
      },
      "storefront.common.Problem.Violation": {
        "description": "One field of the request and what is wrong with it.",
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "field",
          "message"
        ],
        "additionalProperties": false
      },
      "storefront.cart.AddItem": {
        "description": "A variant to put in the cart; one already there gains the quantity.",
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64
          },
          "product_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "default": 1
          }
        },
        "required": [
          "sku",
          "product_id"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
