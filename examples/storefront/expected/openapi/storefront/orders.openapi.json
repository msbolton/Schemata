{
  "openapi": "3.1.0",
  "info": {
    "title": "storefront.orders",
    "version": "1.0.0",
    "description": "Checkout and the orders it places."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Orders",
      "description": "Check out, and follow the orders placed."
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "operationId": "Orders_list",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/storefront.orders.OrderStatus"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OrderPage",
            "headers": {
              "ETag": {
                "required": true,
                "schema": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "One page of the customer's orders.",
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/storefront.orders.Order"
                      }
                    },
                    "page": {
                      "$ref": "#/components/schemas/storefront.common.PageInfo"
                    },
                    "query": {
                      "description": "The listing this page answers, with which to ask for the next one.",
                      "$ref": "#/components/schemas/storefront.orders.ListOrders"
                    }
                  },
                  "required": [
                    "items",
                    "page",
                    "query"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "401": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "Orders_checkout",
        "tags": [
          "Orders"
        ],
        "summary": "Place an order for the cart. The `Location` header is the new order's URL.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "A key the client makes up, so a retried checkout places one order.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Places an order for everything in the cart.",
                "type": "object",
                "properties": {
                  "cart_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "shipping_address_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 500
                  }
                },
                "required": [
                  "cart_id",
                  "shipping_address_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Placed",
            "headers": {
              "Location": {
                "description": "The URL of the new order.",
                "required": true,
                "schema": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "The order checkout placed, and where to read it from now on.",
                  "type": "object",
                  "properties": {
                    "order_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "number": {
                      "type": "string",
                      "maxLength": 20
                    },
                    "total": {
                      "$ref": "#/components/schemas/storefront.common.Money"
                    }
                  },
                  "required": [
                    "order_id",
                    "number",
                    "total"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "401": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "409": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "422": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "Orders_get",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.orders.Order"
                }
              }
            }
          },
          "400": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "401": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "404": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}/cancel": {
      "post": {
        "operationId": "Orders_cancel",
        "tags": [
          "Orders"
        ],
        "summary": "Cancel an order that has not shipped.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Why the customer cancels.",
                "type": "object",
                "properties": {
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 500
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.orders.Order"
                }
              }
            }
          },
          "400": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "401": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "404": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "409": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/storefront.common.Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "storefront.common.Money": {
        "description": "An amount in one currency.",
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "minLength": 3,
            "maxLength": 3
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "additionalProperties": false
      },
      "storefront.common.Problem": {
        "description": "A problem report in the shape of RFC 9457, the body of every error response. Members beyond\nthose declared are allowed, as the RFC allows extensions. `instance` stays required because a\ntop-level model needs a key.",
        "type": "object",
        "properties": {
          "type": {
            "description": "A URI naming the kind of problem; `about:blank` when the status says it all.",
            "type": "string",
            "maxLength": 2048,
            "default": "about:blank"
          },
          "title": {
            "description": "A short summary of the kind of problem, the same for every occurrence.",
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "description": "The HTTP status code of the response.",
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "description": "What went wrong this time.",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "instance": {
            "description": "A URI naming this occurrence, to quote when asking for help.",
            "type": "string",
            "maxLength": 2048
          },
          "errors": {
            "description": "The request's fields that failed their checks, when it failed on its fields.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/storefront.common.Problem.Violation"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "status",
          "instance"
        ]
      },
      "storefront.common.Problem.Violation": {
        "description": "One field of the request and what is wrong with it.",
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "field",
          "message"
        ],
        "additionalProperties": false
      },
      "storefront.orders.OrderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "paid",
          "shipped",
          "delivered",
          "cancelled",
          "refunded"
        ]
      },
      "storefront.orders.Order": {
        "description": "An order checkout placed.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "number": {
            "description": "The number the customer quotes, such as `SF-104223`.",
            "type": "string",
            "maxLength": 20
          },
          "customer_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "status": {
            "$ref": "#/components/schemas/storefront.orders.OrderStatus",
            "default": "pending"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/storefront.orders.Order.Line"
            },
            "minItems": 1
          },
          "shipping": {
            "description": "The address the order ships to, as it was at checkout.",
            "$ref": "#/components/schemas/storefront.users.Address"
          },
          "subtotal": {
            "$ref": "#/components/schemas/storefront.common.Money"
          },
          "shipping_cost": {
            "$ref": "#/components/schemas/storefront.common.Money"
          },
          "tax": {
            "$ref": "#/components/schemas/storefront.common.Money"
          },
          "total": {
            "$ref": "#/components/schemas/storefront.common.Money"
          },
          "placed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "number",
          "customer_id",
          "lines",
          "shipping",
          "subtotal",
          "shipping_cost",
          "tax",
          "total",
          "placed_at"
        ],
        "additionalProperties": false
      },
      "storefront.orders.Order.Line": {
        "description": "A variant bought, at the price it had at checkout.",
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "sku": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "unit_price": {
            "$ref": "#/components/schemas/storefront.common.Money"
          }
        },
        "required": [
          "product_id",
          "sku",
          "name",
          "quantity",
          "unit_price"
        ],
        "additionalProperties": false
      },
      "storefront.users.Address": {
        "description": "A postal address in the address book.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "kind": {
            "$ref": "#/components/schemas/storefront.users.AddressKind"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "line1": {
            "type": "string",
            "maxLength": 200
          },
          "line2": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "region": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "postal_code": {
            "type": "string",
            "maxLength": 20
          },
          "country": {
            "description": "A two-letter ISO 3166-1 country code.",
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "minLength": 2,
            "maxLength": 2
          },
          "is_default": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "line1",
          "city",
          "postal_code",
          "country"
        ],
        "additionalProperties": false
      },
      "storefront.users.AddressKind": {
        "type": "string",
        "enum": [
          "shipping",
          "billing"
        ]
      },
      "storefront.common.PageInfo": {
        "description": "Where a page sits in its listing.",
        "type": "object",
        "properties": {
          "next_cursor": {
            "description": "The cursor of the next page; absent on the last one.",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "total": {
            "description": "How many items the listing holds in all.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "total"
        ],
        "additionalProperties": false
      },
      "storefront.orders.ListOrders": {
        "description": "Which orders to list, newest first.",
        "type": "object",
        "properties": {
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/storefront.orders.OrderStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
