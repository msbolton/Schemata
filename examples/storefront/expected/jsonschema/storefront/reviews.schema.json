{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemata:storefront.reviews",
  "title": "storefront.reviews",
  "$defs": {
    "Review": {
      "description": "A customer's review of a product.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "product_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "author_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 5000
        },
        "verified": {
          "description": "Whether the author bought the product here.",
          "type": "boolean",
          "default": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "product_id",
        "author_id",
        "rating",
        "title",
        "created_at"
      ],
      "additionalProperties": false
    },
    "ListReviews": {
      "description": "Which reviews of a product to list, newest first.",
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "rating": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "required": [
        "product_id"
      ],
      "additionalProperties": false
    },
    "ReviewPage": {
      "description": "One page of a product's reviews.",
      "type": "object",
      "properties": {
        "etag": {
          "type": "string",
          "maxLength": 64
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Review"
          }
        },
        "page": {
          "$ref": "urn:schemata:storefront.common#/$defs/PageInfo"
        }
      },
      "required": [
        "etag",
        "items",
        "page"
      ],
      "additionalProperties": false
    },
    "WriteReview": {
      "description": "A new review of a product.",
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 5000
        }
      },
      "required": [
        "product_id",
        "rating",
        "title"
      ],
      "additionalProperties": false
    },
    "ReviewId": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
}
