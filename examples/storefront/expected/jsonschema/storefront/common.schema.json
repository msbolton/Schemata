{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schemata:storefront.common",
  "title": "storefront.common",
  "$defs": {
    "Money": {
      "description": "An amount in one currency.",
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "PageInfo": {
      "description": "Where a page sits in its listing.",
      "type": "object",
      "properties": {
        "next_cursor": {
          "description": "The cursor of the next page; absent on the last one.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "total": {
          "description": "How many items the listing holds in all.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "total"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "description": "A problem report in a stricter profile of RFC 9457, the body of every error response: `title`,\n`status` and `instance` are required, `instance` because a top-level model needs a key. Members\nbeyond those declared are allowed, as the RFC allows extensions.",
      "type": "object",
      "properties": {
        "type": {
          "description": "A URI naming the kind of problem; `about:blank` when the status says it all.",
          "type": "string",
          "maxLength": 2048,
          "default": "about:blank"
        },
        "title": {
          "description": "A short summary of the kind of problem, the same for every occurrence.",
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "description": "The HTTP status code of the response.",
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "description": "What went wrong this time.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "instance": {
          "description": "A URI naming this occurrence, to quote when asking for help.",
          "type": "string",
          "maxLength": 2048
        },
        "errors": {
          "description": "The request's fields that failed their checks, when it failed on its fields.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Problem.Violation"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "status",
        "instance"
      ]
    },
    "Problem.Violation": {
      "description": "One field of the request and what is wrong with it.",
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "field",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
