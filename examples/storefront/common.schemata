/// Shapes every part of the storefront API shares: money, pages, and problem reports.
schema storefront.common

/// A three-letter ISO 4217 currency code.
alias Currency = string { min 3, max 3, match "^[A-Z]{3}$" }

alias Email = string { max 254, match "^[^@]+@[^@]+$" }

/// Where a listing goes on from: a page returns one, and the next request sends it back.
alias Cursor = string { max 200 }

/// How many items one page holds.
alias Limit = int32 { min 1, max 100 }

/// An amount in one currency.
model Money { #1 amount decimal(19, 4)  #2 currency Currency }

/// Where a page sits in its listing.
model PageInfo {
  /// The cursor of the next page; absent on the last one.
  #1 next_cursor Cursor?
  /// How many items the listing holds in all.
  #2 total       int64   { min 0 }
}

/// A problem report in a stricter profile of RFC 9457, the body of every error response: `title`,
/// `status` and `instance` are required, `instance` because a top-level model needs a key. Members
/// beyond those declared are allowed, as the RFC allows extensions.
model Problem {
  /// A URI naming the kind of problem; `about:blank` when the status says it all.
  #1 type     string       { max 2048 } = "about:blank"
  /// A short summary of the kind of problem, the same for every occurrence.
  #2 title    string       { max 200 }
  /// The HTTP status code of the response.
  #3 status   int32        { min 400, max 599 }
  /// What went wrong this time.
  #4 detail   string?      { max 2000 }
  /// A URI naming this occurrence, to quote when asking for help.
  #5 instance string       { id, max 2048 }
  /// The request's fields that failed their checks, when it failed on its fields.
  #6 errors   Violation[]?

  /// One field of the request and what is wrong with it.
  model Violation { #1 field string { max 200 }  #2 message string { max 500 } }

  @@jsonschema(open)
}
