/// A personal address book.
schema contacts

enum Kind { personal work }

/// One person. Postgres checks the name, email, and age but not the tags; Protobuf checks none.
model Contact {
  id    int64    { id }
  name  string   { max 100 }
  email string   { max 254, match "^[^@]+@[^@]+$" }
  age   int32?   { min 0, max 150 }
  kind  Kind     = personal
  born  date?
  tags  string[] { max 20 }
}
