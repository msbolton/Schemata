/// GPX schema version 1.1.
schema gpx @xsd(namespace: "http://www.topografix.com/GPX/1/1")

import shop.customers

enum Fix {
  /// No fix.
  none
  @xsd(name: "2d") _2d
}

/// How it was paid.
union Payment = Card | int64

/// GPX is the root element.
model Gpx {
  version   string                  @xsd(attribute) = "1.1"
  /// Who wrote it.
  creator   string?                 { max 100 } @xsd(attribute)
  full_name string                  @xsd(name: "full-name")
  customer  shop.customers.Customer
  /// Waypoints.
  wpt       Wpt[]
  tags      string?[]?              { maxItems 2, max 3 }
  counts    map<int64, Wpt?>        { minItems 1 }
  total     decimal(19, 4)          { min 0 } = 0.0000
  fix       Fix                     = none

  /// A point.
  model Wpt {
    lat float64 { min -90.0, max 90.0 }

    @@xsd(root: false)
  }

  @@xsd(name: "gpxType")
}
